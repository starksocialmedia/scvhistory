{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
{% endblock %}

{% block content %}
{% set F = {} %}
{% for h in ['body','eventDate','eventDateStart','eventDateEnd','eventSignificance','eventChlNumber','eventFrequency','eventNextOccurrence','eventLegacyUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set era = entry.historicalEra.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set periods = entry.historicalPeriod.all() %}
{% set whenLine = F.eventDate ?: (F.eventDateStart ? F.eventDateStart ~ (F.eventDateEnd ? ' to ' ~ F.eventDateEnd : '') : '') %}
{% set mentions = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'articleEvents' }).status(null).orderBy('title asc').all() %}

<div class="rec">
  <section class="rec-band">
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('events') }}">Events</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-head rec-head--noart">
        <div>
          <div class="rec-kick"><span class="a">EVENTS</span>{% if era %}<span class="sep"></span><span class="b">{{ era.title|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title ?: entry.slug }}</h1>
          {% if F.eventSignificance %}<div class="rec-sub">{{ F.eventSignificance }}</div>{% endif %}
          {% if whenLine or F.eventChlNumber %}
            <div class="rec-facts">
              {% if whenLine %}<div><div class="l">DATE</div><div class="v">{{ whenLine }}</div></div>{% endif %}
              {% if F.eventChlNumber %}<div><div class="l">LANDMARK</div><div class="v">CHL No. {{ F.eventChlNumber }}</div></div>{% endif %}
            </div>
          {% endif %}
          {% if periods|length or communities|length %}
            <div class="rec-chips">
              {% for p in periods %}<span class="rec-chip">{{ p.title }}</span>{% endfor %}
              {% for c in communities %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% if F.body %}<div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body } %}</div>{% endif %}
        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}
        {% include "_partials/record/cite" with { entry: entry, label: 'Events', date: whenLine } only %}
      </article>

      <aside class="rec-side">
        {% set detail = [['DATE', F.eventDate], ['BEGAN', F.eventDateStart], ['ENDED', F.eventDateEnd], ['SIGNIFICANCE', F.eventSignificance], ['LANDMARK', F.eventChlNumber ? 'CHL No. ' ~ F.eventChlNumber : ''], ['RECURS', entry.eventRecurring ? F.eventFrequency : ''], ['NEXT', entry.eventRecurring ? F.eventNextOccurrence : '']]|filter(r => r[1]) %}
        {% if detail|length %}
          <div class="rec-box"><div class="rec-lab">THE EVENT</div>
            <div class="rec-rows">{% for r in detail %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}</div>
          </div>
        {% endif %}

        {% set people = entry.eventPersons.all() %}
        {% if people|length %}
          <div class="rec-box"><div class="rec-lab">PEOPLE</div>
            {% for p in people %}
              {% set pimg = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
              {% set pp = p.title|split(' ')|filter(x => x|trim) %}
              <a class="rec-person" href="{{ p.url }}">
                <div class="th">{% if pimg %}<img src="{{ pimg.url }}" alt="">{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : p.title|slice(0,1))|upper }}{% endif %}</div>
                <div style="min-width:0"><div class="n">{{ p.title }}</div>{% if p.occupation is defined and p.occupation %}<div class="r">{{ p.occupation }}</div>{% endif %}</div>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        {% set boxes = [
          { lab: 'PLACES', key: 'PLACE', rows: entry.eventPlaces.all() },
          { lab: 'ORGANIZATIONS', key: 'ORG', rows: entry.eventOrganizations.all() },
          { lab: 'GROUPS', key: 'GROUP', rows: entry.eventGroups.all() },
          { lab: 'ARTICLES', key: 'ARTICLE', rows: entry.eventArticles.all() },
          { lab: 'ARTICLES MENTIONING', key: 'ARTICLE', rows: mentions },
          { lab: 'RELATED EVENTS', key: 'EVENT', rows: entry.relatedEvents.all() }
        ]|filter(b => b.rows|length) %}
        {% for b in boxes %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            <div class="rec-rows">{% for r in b.rows %}<div class="k">{{ b.key }}</div><div class="v"><a href="{{ r.url }}">{{ r.title ?: r.slug }}</a></div>{% endfor %}</div>
          </div>
        {% endfor %}

        {% if communities|length %}
          <div class="rec-box"><div class="rec-lab">COMMUNITIES</div>
            <div class="rec-rows">{% for c in communities %}<div class="k">AREA</div><div class="v"><a href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% set links = [] %}
        {% if entry.eventWikipediaUrl is defined and entry.eventWikipediaUrl %}{% set links = links|merge([{u: entry.eventWikipediaUrl, t: 'Wikipedia'}]) %}{% endif %}
        {% set legacy = F.eventLegacyUrl ?: F.legacyUrl %}
        {% if legacy %}{% set links = links|merge([{u: 'https://scvhistory.com' ~ legacy, t: 'View on legacy site'}]) %}{% endif %}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>
{% endblock %}
