{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
{% set mentions = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'articleEvents' }).status(null).all() %}
{% set whenLine = entry.eventDate ?: (entry.eventDateStart ? entry.eventDateStart ~ (entry.eventDateEnd ? ' to ' ~ entry.eventDateEnd : '') : null) %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('events') }}">Events</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">Event</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if whenLine or entry.eventSignificance %}
        <div class="scv-facts">
          {% if whenLine %}<div><b>Date</b>{{ whenLine }}</div>{% endif %}
          {% if entry.eventSignificance %}<div><b>Significance</b>{{ entry.eventSignificance }}</div>{% endif %}
        </div>
      {% endif %}
      {% if era or entry.historicalPeriod.all()|length or communities|length %}
        <div class="scv-chips">
          {% if era %}<span class="scv-chip">{{ era.title }}</span>{% endif %}
          {% for p in entry.historicalPeriod.all() %}<span class="scv-chip">{{ p.title }}</span>{% endfor %}
          {% for c in communities %}<span class="scv-chip solid">{{ c.title }}</span>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}"></figure>
          {% endif %}
          {% if entry.body or entry.culturalSensitivityNote %}
            <article class="scv-card">
              {% if entry.body %}{% include "_partials/prose" with { text: entry.body } %}{% endif %}
              {% if entry.culturalSensitivityNote %}<div class="scv-note">{{ entry.culturalSensitivityNote }}</div>{% endif %}
            </article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/meta" with { entry: entry } only %}

          {% set rows = [] %}
          {% if entry.eventDate %}{% set rows = rows|merge([{k: 'Date', v: entry.eventDate}]) %}{% endif %}
          {% if entry.eventDateStart %}{% set rows = rows|merge([{k: 'Began', v: entry.eventDateStart}]) %}{% endif %}
          {% if entry.eventDateEnd %}{% set rows = rows|merge([{k: 'Ended', v: entry.eventDateEnd}]) %}{% endif %}
          {% if entry.eventSignificance %}{% set rows = rows|merge([{k: 'Significance', v: entry.eventSignificance}]) %}{% endif %}
          {% if entry.eventChlNumber %}{% set rows = rows|merge([{k: 'Landmark', v: 'CHL No. ' ~ entry.eventChlNumber}]) %}{% endif %}
          {% if entry.eventRecurring and entry.eventFrequency %}{% set rows = rows|merge([{k: 'Recurs', v: entry.eventFrequency}]) %}{% endif %}
          {% if entry.eventRecurring and entry.eventNextOccurrence %}{% set rows = rows|merge([{k: 'Next occurrence', v: entry.eventNextOccurrence}]) %}{% endif %}
          {% if rows|length %}
            {% embed "_partials/sidebar/box" with { title: 'The event', rows: rows } only %}
              {% block body %}<ul>{% for r in rows %}<li><span class="scv-boxlab">{{ r.k }}</span>{{ r.v }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/cite" with { entry: entry, date: whenLine } only %}

          {% include "_partials/sidebar/related-list" with { title: 'Places', entries: entry.eventPlaces.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'People', entries: entry.eventPersons.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Organizations', entries: entry.eventOrganizations.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Groups', entries: entry.eventGroups.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles', entries: entry.eventArticles.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles mentioning this event', entries: mentions } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Related events', entries: entry.relatedEvents.all() } only %}

          {% if communities|length %}
            {% embed "_partials/sidebar/box" with { title: 'Communities', communities: communities } only %}
              {% block body %}<ul>{% for c in communities %}<li>{{ c.title }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/external" with {
            wikipedia: entry.eventWikipediaUrl ?? null,
            legacy: entry.eventLegacyUrl ?: entry.legacyUrl
          } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
