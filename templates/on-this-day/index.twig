{% extends "_layouts/base" %}
{% set metaDescription = 'What happened in the Santa Clarita Valley on this day: confirmed dates drawn from the records themselves.' %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/scv-extra-css" %}
{% endblock %}

{% block content %}
{#
  On This Day, read from templates/_data/calendar.json, which is generated by
  scripts/import/build_calendar_index.php from confirmed recordDates rows.

  The file is regenerated whole after each round of confirmations, so this
  template never queries recordDates itself and never needs to know which rows
  are still proposals.

  ?d=MM-DD shows that day. Anything else falls back to today.
#}
{% set raw = source('_data/calendar.json', true) %}
{% set data = raw ? raw|json_decode(true) : {} %}
{% set days = data.days ?? {} %}

{% set today = now|date('m-d') %}
{% set asked = craft.app.request.getParam('d') %}
{% set key = (asked and asked matches '/^\\d{2}-\\d{2}$/') ? asked : today %}
{% set isToday = key == today %}

{% set entries = days[key] ?? [] %}
{% set MONTHS = {'01':'January','02':'February','03':'March','04':'April','05':'May','06':'June','07':'July','08':'August','09':'September','10':'October','11':'November','12':'December'} %}
{% set mm = key|slice(0,2) %}
{% set dd = key|slice(3,2) %}
{% set monthName = MONTHS[mm] ?? '' %}
{% set prettyDate = monthName ~ ' ' ~ (dd|trim('0') ?: dd) %}

{# how many days that month has, so the strip is right for February and the 31s #}
{% set LENGTHS = {'01':31,'02':29,'03':31,'04':30,'05':31,'06':30,'07':31,'08':31,'09':30,'10':31,'11':30,'12':31} %}
{% set monthLen = LENGTHS[mm] ?? 31 %}

{# nearest day with entries, for when this one is empty #}
{% set nearest = null %}
{% if not entries|length and days|length %}
  {% set best = null %}
  {% for k, rows in days %}
    {% set a = (key|slice(0,2))|number_format * 31 + (key|slice(3,2))|number_format %}
    {% set b = (k|slice(0,2))|number_format * 31 + (k|slice(3,2))|number_format %}
    {% set gap = (a - b)|abs %}
    {% set gap = gap > 186 ? 372 - gap : gap %}
    {% if best is null or gap < best %}{% set best = gap %}{% set nearest = { key: k, rows: rows } %}{% endif %}
  {% endfor %}
{% endif %}

<div class="rec">
  <section class="rec-band">
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>On This Day</span></div>
      <div class="rec-head rec-head--noart">
        <div>
          <div class="rec-kick"><span class="a">ON THIS DAY</span>{% if not isToday %}<span class="sep"></span><span class="b">{{ 'TODAY IS ' ~ (MONTHS[today|slice(0,2)] ~ ' ' ~ (today|slice(3,2)|trim('0')))|upper }}</span>{% endif %}</div>
          <h1>{{ prettyDate }}</h1>
          <p class="rec-sub">{{ entries|length ? entries|length ~ (entries|length == 1 ? ' record in the archive carries this date' : ' records in the archive carry this date') : 'Nothing in the archive carries this date yet' }}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main rec-main--wide">
      <article style="min-width:0">

        <nav class="otd-strip" aria-label="Choose a day">
          <div class="otd-months">
            {% for m, name in MONTHS %}
              <a class="otd-m {{ m == mm ? 'on' : '' }}" href="{{ url('on-this-day', {d: m ~ '-01'}) }}">{{ name|slice(0,3) }}</a>
            {% endfor %}
          </div>
          <div class="otd-days">
            {% for d in 1..monthLen %}
              {% set dk = mm ~ '-' ~ (d < 10 ? '0' ~ d : d) %}
              {% set n = (days[dk] ?? [])|length %}
              <a class="otd-d {{ dk == key ? 'on' : '' }} {{ n ? 'has' : '' }}"
                 href="{{ url('on-this-day', {d: dk}) }}"
                 {% if n %}title="{{ n }} record{{ n == 1 ? '' : 's' }}"{% endif %}>{{ d }}</a>
            {% endfor %}
          </div>
        </nav>

        {% if entries|length %}
          <div class="otd-cards">
            {% for e in entries %}
              <a class="otd-card" href="{{ e.url }}">
                <span class="ph">
                  {% if e.image %}<img src="{{ e.image }}" alt="">
                  {% else %}<span class="yr" aria-hidden="true">{{ e.year }}</span>{% endif %}
                </span>
                <span style="min-width:0">
                  <span class="dt">{{ e.printed ?: e.iso }}</span>
                  <span class="t">{{ e.title }}</span>
                  {% if e.label %}<span class="lb">{{ e.label }}</span>{% endif %}
                  <span class="sc">{{ e.section }}</span>
                </span>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <div class="otd-empty">
            <p>Nothing in the archive is dated {{ prettyDate }}.</p>
            {% if nearest %}
              {% set nm = MONTHS[nearest.key|slice(0,2)] %}
              {% set nd = nearest.key|slice(3,2)|trim('0') %}
              <p>The nearest day with entries is <a href="{{ url('on-this-day', {d: nearest.key}) }}">{{ nm }} {{ nd }}</a>, with {{ nearest.rows|length }} record{{ nearest.rows|length == 1 ? '' : 's' }}.</p>
            {% elseif not days|length %}
              <p>No dates have been confirmed yet. The index is built from recordDates rows once a person has ticked Confirmed, by running <code>scripts/import/build_calendar_index.php</code>.</p>
            {% endif %}
          </div>
        {% endif %}

        {% if not isToday %}
          <p class="otd-back"><a href="{{ url('on-this-day') }}">&larr; Back to today</a></p>
        {% endif %}
      </article>
    </main>
  </div>
</div>

{% css %}
.otd-strip{background:#fff;border:1px solid #E2E4E8;padding:16px 18px;margin:0 0 28px}
.otd-months{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.otd-m{font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.06em;color:#7A5C1B;border:1px solid #DCC98F;padding:5px 10px;border-radius:3px;text-decoration:none}
.otd-m:hover{background:#FDF7EA}
.otd-m.on{background:#17254C;border-color:#17254C;color:#fff}
.otd-days{display:flex;flex-wrap:wrap;gap:4px}
.otd-d{font-family:'Jost',sans-serif;font-size:12.5px;min-width:30px;text-align:center;color:#5B6472;border:1px solid #E2E4E8;padding:5px 0;border-radius:3px;text-decoration:none}
.otd-d:hover{border-color:#C4A031;color:#7A5C1B}
.otd-d.has{color:#7A5C1B;border-color:#DCC98F;font-weight:500}
.otd-d.on{background:#C4A031;border-color:#C4A031;color:#17254C;font-weight:500}
.otd-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:14px}
.otd-card{display:flex;gap:15px;background:#fff;border:1px solid #E2E4E8;padding:14px 16px;text-decoration:none;color:inherit}
.otd-card:hover{border-color:#C4A031;background:#FDF7EA}
.otd-card .ph{width:74px;height:74px;flex:none;border:1px solid #E2E4E8;background:#FDF7EA;overflow:hidden;display:flex;align-items:center;justify-content:center}
.otd-card .ph img{width:100%;height:100%;object-fit:cover}
.otd-card .yr{font-family:'Playfair Display',serif;font-size:19px;color:#7A5C1B}
.otd-card .dt{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.12em;color:#7A5C1B;display:block;text-transform:uppercase}
.otd-card .t{font-family:'Playfair Display',serif;font-size:18px;line-height:1.25;color:#17254C;display:block;margin-top:3px}
.otd-card .lb{font-size:13.5px;line-height:1.5;color:#5B6472;display:block;margin-top:4px}
.otd-card .sc{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.1em;color:#5B6472;display:block;margin-top:6px;text-transform:uppercase}
.otd-empty{background:#fff;border:1px solid #E2E4E8;padding:26px 28px;font-size:16px;line-height:1.7;color:#2C2C2C}
.otd-empty p{margin:0 0 10px}.otd-empty p:last-child{margin-bottom:0}
.otd-empty a{color:#7A5C1B}
.otd-empty code{font-size:13.5px;background:#FDF7EA;padding:2px 5px;border:1px solid #EFE6D0}
.otd-back{margin:26px 0 0}.otd-back a{font-family:'Jost',sans-serif;font-size:14px;color:#7A5C1B;text-decoration:none}
{% endcss %}
{% endblock %}
