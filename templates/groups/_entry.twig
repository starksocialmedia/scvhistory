{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
{% set members = craft.entries().section('persons').relatedTo({ targetElement: entry, field: 'personGroups' }).status(null).all() %}
{% set articles = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'subjectGroup' }).status(null).all() %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('groups') }}">Groups</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">Group</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if entry.groupAliases %}<p class="scv-aka">Also known as {{ entry.groupAliases }}</p>{% endif %}
      {% if entry.groupDateStart or entry.groupDateEnd %}
        <div class="scv-facts">
          {% if entry.groupDateStart %}<div><b>From</b>{{ entry.groupDateStart }}</div>{% endif %}
          {% if entry.groupDateEnd %}<div><b>To</b>{{ entry.groupDateEnd }}</div>{% endif %}
        </div>
      {% endif %}
      {% if era or entry.historicalPeriod.all()|length or communities|length %}
        <div class="scv-chips">
          {% if era %}<span class="scv-chip">{{ era.title }}</span>{% endif %}
          {% for p in entry.historicalPeriod.all() %}<span class="scv-chip">{{ p.title }}</span>{% endfor %}
          {% for c in communities %}<span class="scv-chip solid">{{ c.title }}</span>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}"></figure>
          {% endif %}
          {% if entry.body or entry.culturalSensitivityNote %}
            <article class="scv-card">
              {% if entry.body %}{% include "_partials/prose" with { text: entry.body } %}{% endif %}
              {% if entry.culturalSensitivityNote %}<div class="scv-note">{{ entry.culturalSensitivityNote }}</div>{% endif %}
            </article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/meta" with { entry: entry } only %}
          {% include "_partials/sidebar/cite" with { entry: entry } only %}

          {% include "_partials/sidebar/related-list" with { title: 'People', entries: entry.groupPersons.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Members', entries: members } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Events', entries: entry.groupEvents.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles', entries: articles } only %}

          {% if communities|length %}
            {% embed "_partials/sidebar/box" with { title: 'Communities', communities: communities } only %}
              {% block body %}<ul>{% for c in communities %}<li>{{ c.title }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/external" with {
            website: entry.groupWebsite ?? null,
            legacy: entry.groupLegacyUrl ?: entry.legacyUrl
          } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
