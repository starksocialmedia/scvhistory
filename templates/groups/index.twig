{% extends "_layouts/base" %}
{% block title %}Groups | SCVHistory.com{% endblock %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}
{% block content %}
{% set eraSlug = craft.app.request.getParam('era') %}
{% set query = craft.entries().section('groups').status(null).orderBy('title asc') %}
{% if eraSlug %}
  {% set eraTerm = craft.categories().group('historicalEra').slug(eraSlug).status(null).one() %}
  {% if eraTerm %}{% set query = query.relatedTo(eraTerm) %}{% endif %}
{% endif %}
{% set groups = query.all() %}
<div class="scv-doc">
  <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; Groups</div>
  <div style="padding:10px 0 60px">
    <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:44px;color:#b8860b;margin:6px 0 8px">Groups</h1>
    <p style="max-width:660px;color:#3c3934">Collectives that are not formal organizations: families, tribes and nations, expeditions, and military units.</p>
    <div class="scv-chips" style="margin-top:22px">
      <a class="scv-chip {{ not eraSlug ? 'on' : '' }}" href="{{ url('groups') }}">All eras</a>
      {% for e in craft.categories().group('historicalEra').status(null).all() %}
        {% set n = craft.entries().section('groups').relatedTo(e).status(null).count() %}
        {% if n %}<a class="scv-chip {{ eraSlug == e.slug ? 'on' : '' }}" href="{{ url('groups', { era: e.slug }) }}">{{ e.title }} ({{ n }})</a>{% endif %}
      {% endfor %}
    </div>
    <p class="scv-small">{{ groups|length }} group{{ groups|length == 1 ? '' : 's' }}</p>
    {% if groups|length %}
      <ul class="scv-list">
        {% for g in groups %}
          {% set era = g.historicalEra.one() ?? null %}
          {% set n = g.groupPersons.count() %}
          <li>
            <a href="{{ g.url }}">{{ g.title ?: g.slug }}</a>
            <div class="scv-small">
              {% if g.groupDateStart %}{{ g.groupDateStart }}{% if g.groupDateEnd %} to {{ g.groupDateEnd }}{% endif %}{% endif %}
              {% if g.groupDateStart and era %} &middot; {% endif %}
              {% if era %}{{ era.title }}{% endif %}
              {% if n and (g.groupDateStart or era) %} &middot; {% endif %}
              {% if n %}{{ n }} {{ n == 1 ? 'person' : 'people' }}{% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="scv-small">No groups match this filter.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
