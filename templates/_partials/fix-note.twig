{#
  The fix list's capture form. In the footer of every page, for a logged-in
  admin and nobody else.

  The point of it is five seconds: notice something wrong, write a line, carry
  on reading. So it posts to Craft's own entries/save-entry action rather than
  sending anybody to the control panel, and it comes back to the page you were
  on. No module, no endpoint of our own, no JavaScript beyond opening the panel.

  The record you are looking at is attached automatically where there is one,
  and the URL always is. A note taken on an index page, or on a page about
  something that has no record yet, has neither and is still a note.

  Renders nothing at all until add_fixes_section.php has been run.
#}
{% set fixSection = craft.app.entries.getSectionByHandle('fixes') %}
{% set fixType = craft.app.entries.getEntryTypeByHandle('fix') %}

{% if currentUser and currentUser.admin and fixSection and fixType %}
  {% set here = craft.app.request.absoluteUrl %}
  {% set aboutId = (entry is defined and entry and entry.id) ? entry.id : null %}

  {% css %}
  .fixw{position:fixed;right:18px;bottom:18px;z-index:60;font-family:'Jost',sans-serif}
  .fixw summary{list-style:none;cursor:pointer;background:#17254C;color:#fff;border:0;
    padding:9px 15px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    box-shadow:0 2px 10px rgba(0,0,0,.22);display:inline-block}
  .fixw summary::-webkit-details-marker{display:none}
  .fixw summary:hover{background:#243a73}
  .fixw[open] summary{background:#C4A031;color:#17254C}
  .fixw form{background:#fff;border:1px solid #E2E4E8;box-shadow:0 6px 26px rgba(0,0,0,.2);
    padding:14px;width:330px;margin-top:8px}
  .fixw textarea{width:100%;min-height:76px;font:inherit;font-family:'Public Sans',sans-serif;
    font-size:13.5px;padding:8px;border:1px solid #D7DBE2;resize:vertical;box-sizing:border-box}
  .fixw .ctx{font-size:11px;color:#8A919E;margin:7px 0 9px;line-height:1.45;word-break:break-all}
  .fixw button{font:inherit;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.08em;
    text-transform:uppercase;background:#17254C;color:#fff;border:0;padding:8px 16px;cursor:pointer}
  .fixw button:hover{background:#243a73}
  .fixw a.all{font-size:11.5px;color:#5B6472;margin-left:12px}
  @media print{.fixw{display:none}}
  {% endcss %}

  <details class="fixw">
    <summary>Note a fix</summary>
    <form method="post" accept-charset="UTF-8">
      {{ csrfInput() }}
      {{ actionInput('entries/save-entry') }}
      {{ redirectInput(craft.app.request.pathInfo ~ (craft.app.request.queryStringWithoutPath ? '?' ~ craft.app.request.queryStringWithoutPath : '')) }}
      <input type="hidden" name="sectionId" value="{{ fixSection.id }}">
      <input type="hidden" name="typeId" value="{{ fixType.id }}">
      <input type="hidden" name="enabled" value="1">
      <input type="hidden" name="fields[fixStatus]" value="open">
      <input type="hidden" name="fields[fixSeenOn]" value="{{ here }}">
      {% if aboutId %}<input type="hidden" name="fields[fixRecord][]" value="{{ aboutId }}">{% endif %}
      {% if entry is defined and entry %}
        {% set handles = [] %}
        {% for f in entry.fieldLayout.customFields %}{% set handles = handles|merge([f.handle]) %}{% endfor %}
        {% if 'legacyUrl' in handles and entry.legacyUrl %}
          <input type="hidden" name="fields[fixLegacyUrl]" value="{{ entry.legacyUrl }}">
        {% endif %}
      {% endif %}

      <textarea name="fields[fixNote]" required
        placeholder="What is wrong? A line is enough."></textarea>
      <p class="ctx">
        {% if aboutId %}Attached to {{ entry.title }} (#{{ entry.id }}).
        {% else %}No record attached: this note is about the page itself.{% endif %}
        <br>Noted on {{ craft.app.request.pathInfo ?: '/' }}
      </p>
      <button type="submit">Save</button>
      <a class="all" href="/admin-fixes">All fixes</a>
    </form>
  </details>
{% endif %}
