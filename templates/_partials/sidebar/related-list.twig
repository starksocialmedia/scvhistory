{#
  A sidebar box listing related entries. Each row: 44px square thumbnail from
  the entry's featuredImage, the title as a link, and a one-line subtitle.

  Subtitle by section: persons -> occupation, events -> date,
  places -> first community, everything else -> none.

  Thumbnail fallback: cream square with two initials for people, first letter
  for everything else.

  featuredImage is only in the person, organization and warMemorial field
  layouts, so it is guarded with `is defined` on every entry.

  Params:
    title    heading text
    entries  array of entries (skipped entirely when empty)
    sub      optional override: 'occupation' | 'date' | 'community' | 'none'
#}
{% if entries is defined and entries|length %}
<div class="scv-box">
  {% if title is defined and title %}<h3>{{ title }}</h3>{% endif %}
  <ul>
    {% for e in entries %}
      {% set handle = e.section.handle ?? '' %}
      {% set mode = sub is defined and sub ? sub : (handle == 'persons' ? 'occupation' : (handle == 'events' ? 'date' : (handle == 'places' ? 'community' : 'none'))) %}
      {% set label = e.title ?: e.slug %}

      {% set thumb = (e.featuredImage is defined and e.featuredImage) ? e.featuredImage.one() ?? null : null %}

      {% set parts = label|split(' ')|filter(w => w|trim) %}
      {% set initials = handle == 'persons' and parts|length > 1
        ? (parts|first|slice(0,1) ~ parts|last|slice(0,1))
        : label|slice(0,1) %}

      {% set line = null %}
      {% if mode == 'occupation' %}
        {% set line = e.occupation is defined ? e.occupation : null %}
      {% elseif mode == 'date' %}
        {% set line = e.eventDate is defined and e.eventDate ? e.eventDate : (e.eventDateStart is defined ? e.eventDateStart : null) %}
      {% elseif mode == 'community' %}
        {% set com = e.neighborhood is defined and e.neighborhood ? e.neighborhood.one() ?? null : null %}
        {% set line = com ? com.title : null %}
      {% endif %}

      <li>
        <div class="scv-rel">
          {% if thumb %}
            <img class="scv-thumb" src="{{ thumb.url }}" alt="">
          {% else %}
            <div class="scv-thumb scv-thumb--ph" aria-hidden="true">{{ initials|upper }}</div>
          {% endif %}
          <div class="scv-reltext">
            <a href="{{ e.url }}">{{ label }}</a>
            {% if line %}<span class="scv-itemsub">{{ line }}</span>{% endif %}
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
