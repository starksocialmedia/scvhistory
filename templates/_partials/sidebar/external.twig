{#
  External links box. Renders only the links that have a value, and nothing at
  all when none do.

  Wikipedia, Find a Grave, CHL and website are Link fields, which stringify to
  their URL. The handles differ per section (placeWikipediaUrl, orgWikipediaUrl,
  personWikipediaUrl and so on), so the caller passes the values it has rather
  than this partial guessing a handle.

  legacy is a path stored with a leading slash, resolved against scvhistory.com.

  Params (all optional):
    wikipedia, grave, chl, scvhl, website   Link field values or URL strings
    chlNumber                               shown when there is no chl link
    legacy                                  legacy path, for example /scvhistory/lw3730.htm
    archive                                 Archive.org URL
#}
{% set rows = [] %}
{% if website is defined and website %}{% set rows = rows|merge([{u: website, l: 'Official website'}]) %}{% endif %}
{% if wikipedia is defined and wikipedia %}{% set rows = rows|merge([{u: wikipedia, l: 'Wikipedia'}]) %}{% endif %}
{% if grave is defined and grave %}{% set rows = rows|merge([{u: grave, l: 'Find a Grave'}]) %}{% endif %}
{% if chl is defined and chl %}
  {% set rows = rows|merge([{u: chl, l: 'California Historical Landmark' ~ (chlNumber is defined and chlNumber ? ' No. ' ~ chlNumber : '')}]) %}
{% endif %}
{% if scvhl is defined and scvhl %}{% set rows = rows|merge([{u: scvhl, l: 'SCV Historical Landmark'}]) %}{% endif %}
{% if archive is defined and archive %}{% set rows = rows|merge([{u: archive, l: 'Archive.org'}]) %}{% endif %}
{% if legacy is defined and legacy %}{% set rows = rows|merge([{u: include('_partials/legacy-url', { value: legacy })|trim, l: 'View on legacy site'}]) %}{% endif %}

{% set plainChl = (chl is not defined or not chl) and chlNumber is defined and chlNumber %}

{% if rows|length or plainChl %}
<div class="scv-box">
  <h3>External</h3>
  <ul>
    {% if plainChl %}<li>California Historical Landmark No. {{ chlNumber }}</li>{% endif %}
    {% for r in rows %}<li><a href="{{ r.u }}" target="_blank" rel="noopener">{{ r.l }} &nearr;</a></li>{% endfor %}
  </ul>
</div>
{% endif %}
