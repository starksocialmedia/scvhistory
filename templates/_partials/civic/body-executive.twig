{#
  A body's chief executive, in the sidebar with a portrait (Nathan, 4 October
  2026: "superintendent in the sidebar with their portrait").

  Read only from affiliation records with years (scripts/import/add_affiliations.php):
  a superintendent is employed by the board, not elected to it. The present one is
  the affiliation recorded as serving; when there is none, the box says the archive
  has not recorded who it is. Everyone else is past, with their years. It was once
  filled from whoever the archive held with the role, which put H. Clyde Smyth,
  retired in 1992 and dead since 2012, in the box as if he held the post (Nathan,
  4 October 2026: "That is the worst kind of error: a reader would take it as
  fact"). A role with no dated affiliation is never shown here.

    body   the organization
    title  the title as the affiliations print it ("Superintendent")
    label  the box's label ("SUPERINTENDENT")
    as     'box': the sidebar, the present holder only, and a link to the
           section. 'section': in the body, every holder with years (Nathan,
           4 October 2026: "The superintendent box will not hold a list ...
           Past superintendents are a section, not a sidebar item").
#}
{% import "_partials/record/portrait" as portrait %}
{% set affs = craft.entries().section('affiliations').relatedTo({ targetElement: body, field: 'affiliationBody' }).affiliationTitle(title).with(['affiliationPerson']).all()
    |filter(a => a.affiliationPerson|first) %}
{% set present = affs|filter(a => a.affiliationEnded.value == 'serving') %}
{% set past = affs|filter(a => a.affiliationEnded.value != 'serving')|sort((x, y) => (y.termEndEdtf ?: y.termStartEdtf) <=> (x.termEndEdtf ?: x.termStartEdtf)) %}
{% set as = as ?? 'box' %}
{% set plural = label|lower ~ 's' %}
{% if as == 'box' %}
<div class="rec-box"><div class="rec-lab">{{ label }}</div>
  {% for a in present %}
    {% set p = a.affiliationPerson|first %}
    {% set img = 'featuredImage' in p.fieldLayout.customFields|map(f => f.handle) ? p.featuredImage.one() : null %}
    <a href="{{ p.url }}" style="display:block;text-decoration:none;color:#17254C;margin-bottom:10px">
      {% if img %}<div style="aspect-ratio:4/5;max-width:200px;overflow:hidden;background:#EEF0F4;margin-bottom:10px">{{ portrait.img(img, 1.25, p.title, true) }}</div>{% endif %}
      <div style="font-family:'Playfair Display',serif;font-size:18px">{{ p.title }}</div>
    </a>
    <p style="font-size:13.5px;line-height:1.55;color:#5B6472;margin:0 0 4px">{{ a.termStart ? 'Since ' ~ a.termStart : 'Serving; the archive has not recorded since when' }}{% include "_partials/record/evidence" with { ev: a.startEvidence.value ? a.startEvidence : 'certified' } only %}</p>
  {% else %}
    <p style="font-size:13.5px;line-height:1.55;color:#5B6472;margin:0">The archive has not recorded who the present {{ label|lower }} is.</p>
  {% endfor %}
  {% if past|length %}<p style="font-size:13.5px;margin:10px 0 0"><a href="#{{ plural|replace({' ': '-'}) }}" style="color:#7A5C1B" data-tab-link="history">Past {{ plural }} &darr;</a></p>{% endif %}
</div>
{% elseif past|length %}
{#- Past holders only: the present one is in the sidebar (Nathan, 4 October 2026: "drop him from the Superintendents section in
    the body. Rename it 'Past superintendents' and show it as a timeline or chart rather than cards"). One bar per holder on a
    shared axis of years; a holder whose years are not recorded is listed beneath the chart with that said. -#}
{% set dated = past|filter(a => a.termStartEdtf or a.termEndEdtf) %}
{% set undated = past|filter(a => not (a.termStartEdtf or a.termEndEdtf)) %}
<h2 class="rec-h2 hub-h" id="{{ plural|replace({' ': '-'}) }}">Past {{ plural }}</h2>
{% if dated|length %}
  {% set starts = [] %}{% set ends = [] %}
  {% for a in dated %}
    {% set starts = starts|merge([(a.termStartEdtf ?: a.termEndEdtf)|replace({'[': '', ']': ''})|split(',')|first|slice(0, 4) * 1]) %}
    {% set ends = ends|merge([(a.termEndEdtf ?: a.termStartEdtf)|replace({'[': '', ']': ''})|split(',')|last|slice(0, 4) * 1]) %}
  {% endfor %}
  {% set Y0 = (min(starts) / 10)|round(0, 'floor') * 10 %}{% set Y1 = (max(ends) / 10)|round(0, 'ceil') * 10 %}{% set Y1 = Y1 > Y0 ? Y1 : Y0 + 10 %}
  <div class="ex-chart">
    {% for a in dated|sort((x, y) => x.termStartEdtf <=> y.termStartEdtf) %}
      {% set p = a.affiliationPerson|first %}
      {% set s0 = (a.termStartEdtf ?: a.termEndEdtf)|replace({'[': '', ']': ''})|split(',')|first|slice(0, 4) * 1 %}
      {% set e0 = (a.termEndEdtf ?: a.termStartEdtf)|replace({'[': '', ']': ''})|split(',')|last|slice(0, 4) * 1 %}
      <div class="ex-row">
        <a class="ex-n" href="{{ p.url }}">{{ p.title }}</a>
        <div class="ex-track"><span class="ex-bar" style="left:{{ ((s0 - Y0) / (Y1 - Y0) * 100)|round(2) }}%;width:{{ (max(e0 - s0, 1) / (Y1 - Y0) * 100)|round(2) }}%" title="{{ a.termStart ?: '?' }} to {{ a.termEnd ?: '?' }}"></span></div>
        <div class="ex-y">{{ a.termStart ?: '?' }} to {{ a.termEnd ?: '?' }}{% include "_partials/record/evidence" with { ev: a.endEvidence.value ? a.endEvidence : (a.startEvidence.value ? a.startEvidence : 'certified') } only %}</div>
      </div>
    {% endfor %}
    <div class="ex-axis"><span>{{ Y0 }}</span><span>{{ Y1 }}</span></div>
  </div>
{% endif %}
{% if undated|length %}<p class="hub-lede">Also held, with no years recorded: {{ undated|map(a => (a.affiliationPerson|first).title)|join(', ') }}.</p>{% endif %}
<p class="hub-lede">The archive holds {{ past|length == 1 ? 'one past ' ~ label|lower : past|length ~ ' past ' ~ plural }} so far; the others are not yet recorded.</p>
{% css %}
.ex-chart{background:#fff;border:1px solid #E2E4E8;padding:14px 16px 10px;margin:0 0 12px}
.ex-row{display:grid;grid-template-columns:170px minmax(0,1fr) 190px;gap:12px;align-items:center;padding:6px 0}
@media(max-width:700px){.ex-row{grid-template-columns:1fr}}
.ex-n{color:#17254C;font-family:'Playfair Display',serif;font-size:16px;text-decoration:none}
.ex-track{position:relative;height:12px;background:#F3F4F6}
.ex-bar{position:absolute;top:0;height:12px;background:#17254C}
.ex-y{font-size:13px;color:#5B6472}
.ex-axis{display:flex;justify-content:space-between;font-family:'Jost',sans-serif;font-size:11px;color:#8A93A3;margin:4px 202px 0 182px}
@media(max-width:700px){.ex-axis{margin:4px 0 0}}
{% endcss %}
{% endif %}
