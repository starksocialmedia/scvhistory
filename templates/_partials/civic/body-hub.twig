{#
  A body's page as the hub for its people and its seats (inventory/review/
  body-hub-proposal-2026-10-03.md, approved 3 October 2026; the tabs,
  inventory/review/body-hub-tabs-proposal-2026-10-04.md, approved 4 October 2026).
  One partial for every body with office holdings. Nothing here names a body;
  everything is read from the data. organizations/_entry.twig places the parts
  in its tabs; the seat control filters every part inside the element whose id
  is `scope`.

    part      control | board | past | elections | people
    body      the organization
    seats     its seat place records (placeOrganizations, with a districtKind), in order
    scope     the id of the element the seat control filters
    exclude   ids of people the sidebar already shows (the chief executive)
#}
{% set exclude = exclude ?? [] %}
{% set part = part ?? 'board' %}
{% set NOUNS = { 'trustee-area': 'trustee areas', 'water-division': 'divisions', 'council-district': 'council districts' } %}
{% set noun = seats|length ? (NOUNS[(seats|first).districtKind.value ?? ''] ?? 'seats') : 'seats' %}
{% set short = {} %}
{% for s in seats %}{% set short = short|merge({ (s.slug): s.title|split(', ')|last }) %}{% endfor %}
{% set HOW = { appointed: 'appointed', elected: 'elected', succeeded: 'succeeded', 'sole-candidate': 'appointed in lieu of an election', unopposed: 'elected unopposed; no election held' } %}
{% set ENDED = { expired: 'term ended', reelected: 're-elected', resigned: 'resigned', recalled: 'recalled', removed: 'removed from office', died: 'died in office', left: 'left office', unknown: 'end not recorded' } %}
{% import "_partials/record/portrait" as portrait %}
{#- How the page speaks of the body's members (Nathan, 4 October 2026: "The board now" is wrong for a body that is not a
    board). A legislature's members are the valley's members: every district holding part of the valley, each term with
    its district number (seatLabel) and plan (districtPlan); the heading is plural whenever more than one sits for the
    valley. Any other body is a board. -#}
{% set LEG = { now: 'The valley\'s member now', nowPl: 'The valley\'s members now', past: 'Past members for the valley', left: 'who have represented all or part of the valley', gap: 'The archive does not yet hold the present member.', since: 'for the valley since', earlier: 'Earlier for the valley' } %}
{% set VOICES = { 'california-state-assembly': LEG, 'california-state-senate': LEG, 'united-states-house-of-representatives': LEG,
    'los-angeles-county-board-of-supervisors': { now: 'The valley\'s supervisor now', past: 'Past supervisors for the valley', left: 'who have been the valley\'s supervisor', gap: 'The archive does not yet hold the present supervisor.', since: 'for the valley since', earlier: 'Earlier for the valley' } } %}
{% set voice = VOICES[body.slug] ?? null %}
{#- A legislature's districts and their shares of the valley (templates/_data/valley-districts.json), by plan and number:
    the valley has had more than one member in a chamber whenever its people were split between districts. -#}
{% set VDB = (source('_data/valley-districts.json', ignore_missing = true)|json_decode).bodies[body.slug] ?? null %}
{% set shareOf = {} %}
{% if VDB %}{% for P in VDB.plans %}{% for X in P.districts %}{% set shareOf = shareOf|merge({ (P.plan ~ '-' ~ X.n): X.share == 'the whole valley' ? 'the whole valley' : X.share ~ ' of the valley' }) %}{% endfor %}{% endfor %}{% endif %}
{% macro shareFor(h, shareOf) %}{{ h.districtPlan.value ?? false ? (shareOf[h.districtPlan.value ~ '-' ~ ((h.seatLabel|split(' ')|first)|replace({ 'th': '', 'st': '', 'nd': '', 'rd': '' }))] ?? '') : '' }}{% endmacro %}
{% set W = voice ? voice : { now: 'The board now', past: 'Past members', left: 'who have left the board, or whose last term has no end recorded', gap: 'The archive does not yet hold the present board.', since: 'on the board since', earlier: 'Earlier on the board' } %}
{#- The seat as each term names it: a legislature's number in force, otherwise the seat record's short name. -#}
{% macro seatName(h, short, seatOf, voice) %}{{ voice and h.seatLabel ? h.seatLabel : (seatOf['h' ~ h.id] ? short[seatOf['h' ~ h.id]] : '') }}{% endmacro %}
{#- A term's plan and district as one key ("2011-38"), which the district map's control filters on (_partials/civic/valley-districts). -#}
{% macro vdKey(h) %}{{ (h.districtPlan.value ?? false) ? h.districtPlan.value ~ '-' ~ ((h.seatLabel|split(' ')|first)|replace({ 'th': '', 'st': '', 'nd': '', 'rd': '' })) : '' }}{% endmacro %}
{% import _self as HB %}

{% if part == 'control' %}
  {% if seats|length > 1 %}{% include "_partials/civic/seat-control" with { seats: seats, scope: scope, noun: noun } only %}{% endif %}

{% elseif part in ['board', 'past'] %}
  {% set holdings = craft.entries().section('officeHoldings').relatedTo({ targetElement: body, field: 'holdingBody' })
      .with(['holdingPerson', 'holdingDistrict']).orderBy('termStartEdtf desc').all()
      |filter(h => h.selectionMethod.value != 'rotated') %}
  {% set seatOf = {} %}
  {% for h in holdings %}{% set d = h.holdingDistrict|first %}{% set seatOf = seatOf|merge({ ('h' ~ h.id): d ? d.slug : '' }) %}{% endfor %}
  {#- The board now: a term recorded as serving whose end, if one is given, has
      not passed. A term whose end is not recorded is never counted as current
      (Nathan, 4 October 2026); it is listed under past members. The same rule as
      the council roster and /districts. -#}
  {% set ym = now|date('Y-m') %}
  {% set sitting = holdings|filter(h => h.howEnded.value == 'serving' and (not h.termEndEdtf or h.termEndEdtf|slice(0, 7) >= ym) and (h.holdingPerson|first)) %}
  {% set sittingPids = sitting|map(h => (h.holdingPerson|first).id) %}

  {% if part == 'board' %}
    {#- Ordered by office as the body gives it (Nathan, 4 October 2026: "President, Clerk, Assistant Clerk, then members"),
        then by seat. Offices are read from templates/_data/board-officers.json, dated; not stored by year. -#}
    {% set OFFICES = (source('_data/board-officers.json', ignore_missing = true)|json_decode).bodies ?? {} %}
    {% set offs = OFFICES[body.id ~ ''] ?? null %}
    {% set RANK = { 'president': 1, 'board president': 1, 'governing board president': 1, 'vice president': 2, 'vice-president': 2, 'clerk': 3, 'governing board clerk': 3, 'assistant clerk': 4, 'governing board clerk pro tem': 4, 'clerk pro tem': 4 } %}
    {% set rankOf = {} %}
    {% for h in sitting %}{% set o = offs ? (offs.officers[(h.holdingPerson|first).id ~ ''] ?? '') : '' %}{% set rankOf = rankOf|merge({ ('h' ~ h.id): RANK[o|lower] ?? 9 }) %}{% endfor %}
    {% set sitting = sitting|sort((a, b) => rankOf['h' ~ a.id] <=> rankOf['h' ~ b.id] ?: (seatOf['h' ~ a.id] ?: 'zz') <=> (seatOf['h' ~ b.id] ?: 'zz')) %}
    {#- A legislature's members in order of the share of the valley each holds, largest first. -#}
    {% if voice and shareOf|length %}{% set sitting = sitting|sort((a, b) => ((HB.shareFor(b, shareOf)|trim|replace({ 'the whole valley': '100', '% of the valley': '' })) * 1) <=> ((HB.shareFor(a, shareOf)|trim|replace({ 'the whole valley': '100', '% of the valley': '' })) * 1)) %}{% endif %}
    {% set heldSeats = sitting|map(h => seatOf['h' ~ h.id])|filter(s => s) %}
    {% set openSeats = seats|filter(s => s.slug not in heldSeats) %}
    <h2 class="rec-h2 hub-h" id="board">{{ voice and sitting|length > 1 and voice.nowPl is defined ? voice.nowPl : W.now }}</h2>
    {% if sitting|length %}
    {#- A card is not one link: the evidence words inside it link to /evidence, and a link inside a link splits the card. -#}
    <div class="hub-cards" data-seat-list="board">
      {% for h in sitting %}
        {% set p = h.holdingPerson|first %}
        {% set img = 'featuredImage' in p.fieldLayout.customFields|map(f => f.handle) ? p.featuredImage.one() : null %}
        {% set since = holdings|filter(x => (x.holdingPerson|first).id ?? null == p.id)|map(x => x.termStartEdtf|slice(0, 4))|filter(y => y)|sort|first %}
        {#- A sitting member's earlier terms belong on the card, not among the people who have left (Nathan, 4 October 2026). -#}
        {% set earlier = holdings|filter(x => (x.holdingPerson|first).id ?? null == p.id and x.id != h.id)|sort((x, y) => x.termStartEdtf <=> y.termStartEdtf) %}
        {% set espans = [] %}
        {% for x in earlier %}
          {% set sy = x.termStartEdtf|slice(0, 4) %}{% set ey = x.termEndEdtf ? x.termEndEdtf|slice(0, 4) : '?' %}
          {% if espans|length and (espans|last)[1] != '?' and sy <= (espans|last)[1] %}{% set espans = espans|slice(0, espans|length - 1)|merge([[(espans|last)[0], ey]]) %}{% else %}{% set espans = espans|merge([[sy, ey]]) %}{% endif %}
        {% endfor %}
        {% set office = offs ? (offs.officers[p.id ~ ''] ?? null) : null %}
        {% set vks = [] %}{% for x in holdings|filter(x => (x.holdingPerson|first).id ?? null == p.id) %}{% set k = HB.vdKey(x)|trim %}{% if k %}{% set vks = vks|merge([k]) %}{% endif %}{% endfor %}
        <div class="hub-card" data-seat="{{ seatOf['h' ~ h.id] }}"{% if vks|length %} data-vd="{{ vks|join(' ') }}"{% endif %}>
          <a class="hub-ph" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% if img %}{{ portrait.img(img, 0.8, p.title, true, 480) }}{% else %}<span>{{ p.title|split(' ')|map(w => w|slice(0,1))|join('')|slice(0,2) }}</span>{% endif %}</a>
          <div class="hub-tx">
            <a class="hub-n" href="{{ p.url }}">{{ p.title }}</a>
            {% set sn = HB.seatName(h, short, seatOf, voice)|trim %}
            {% set sh = HB.shareFor(h, shareOf)|trim %}
            <div class="hub-m">{{ sn ? sn ~ ' · ' : '' }}{{ since ? W.since ~ ' ' ~ since : W.since|replace({ ' since': '' }) }}</div>
            {% if sh %}<div class="hub-t">Holds {{ sh }}</div>{% endif %}
            {% if office %}<div class="hub-o">{{ office }}<span>{{ offs.term ? ' for ' ~ offs.term : '' }}, as the body lists it, {{ offs.read }}</span></div>{% endif %}
            <div class="hub-t">{{ h.termEndEdtf ? 'Term ' ~ h.termStartEdtf|slice(0, 4) ~ ' to ' ~ h.termEndEdtf|slice(0, 4) : (h.termStartEdtf ? 'Serving from ' ~ h.termStartEdtf|slice(0, 4) : 'Serving; the years of this term are not given') }}{{ HOW[h.selectionMethod.value] is defined ? ', ' ~ HOW[h.selectionMethod.value] : '' }}{% include "_partials/record/evidence" with { ev: h.startEvidence } only %}</div>
            {% if espans|length %}<div class="hub-t">{{ W.earlier }}: {{ espans|map(x => x[0] == x[1] ? x[0] : x[0] ~ '–' ~ x[1])|join(', ') }}</div>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {#- Shown by the seat control when a filter leaves the list empty; with one seat there is no control, so no message. -#}
    {% if seats|length > 1 %}<p data-seat-empty="board">The archive does not yet hold the present term for this seat.</p>{% endif %}
    {% endif %}
    {% if openSeats|length or not sitting|length %}
      {% set seatless = sitting|filter(h => not seatOf['h' ~ h.id])|map(h => (h.holdingPerson|first).title) %}
      <p class="hub-gap">{% if not sitting|length %}{{ W.gap }}{% else %}{% if seatless|length %}The archive does not record which seat {{ seatless|join(', ', ' and ') }} {{ seatless|length > 1 ? 'hold' : 'holds' }}{{ openSeats|length ? ', and holds no present term for ' ~ openSeats|map(s => short[s.slug])|join(', ', ' or ') : '' }}.{% else %}The archive does not yet hold the present term for {{ openSeats|map(s => short[s.slug])|join(', ', ' or ') }}.{% endif %}{% endif %}</p>
    {% endif %}

  {% else %}
    {#- Past members: people whose service has ended, one compact card each, three across (Nathan, 4 October 2026:
        "avatar, name, years served, trustee area. Not a wide table"). A sitting member is never here. -#}
    {% set byP = {} %}
    {% for h in holdings|sort((a, b) => a.termStartEdtf <=> b.termStartEdtf) %}
      {% set p = h.holdingPerson|first %}
      {% if p and p.id not in sittingPids %}
        {% set k = 'p' ~ p.id %}
        {% set byP = byP|merge({ (k): { person: p, terms: (byP[k].terms ?? [])|merge([h]) } }) %}
      {% endif %}
    {% endfor %}
    {% set pastPeople = byP|sort((a, b) => ((b.terms|last).termEndEdtf ?: (b.terms|last).termStartEdtf) <=> ((a.terms|last).termEndEdtf ?: (a.terms|last).termStartEdtf)) %}
    {% if pastPeople|length %}
    <h2 class="rec-h2 hub-h" id="past-members">{{ W.past }}</h2>
    <p class="hub-lede">{{ pastPeople|length }} {{ pastPeople|length == 1 ? 'person' : 'people' }} {{ W.left }}, most recent first.{% if seats|length > 1 %} A member with no {{ noun|trim('s', 'right') }} served before the board was elected by area, or the seat is not recorded; they show under All.{% endif %}</p>
    <div class="hub-past" data-seat-list="past">
      {% for r in pastPeople %}
        {% set spans = [] %}
        {% for x in r.terms %}
          {% set sy = x.termStartEdtf|slice(0, 4) %}{% set ey = x.termEndEdtf ? x.termEndEdtf|slice(0, 4) : '?' %}
          {% if spans|length and (spans|last)[1] != '?' and sy <= (spans|last)[1] %}{% set spans = spans|slice(0, spans|length - 1)|merge([[(spans|last)[0], ey]]) %}{% else %}{% set spans = spans|merge([[sy, ey]]) %}{% endif %}
        {% endfor %}
        {% set pseats = [] %}{% for x in r.terms %}{% if seatOf['h' ~ x.id] and seatOf['h' ~ x.id] not in pseats %}{% set pseats = pseats|merge([seatOf['h' ~ x.id]]) %}{% endif %}{% endfor %}
        {% set pnames = [] %}{% for x in r.terms %}{% set nm = HB.seatName(x, short, seatOf, voice)|trim %}{% if nm and nm not in pnames %}{% set pnames = pnames|merge([nm]) %}{% endif %}{% endfor %}
        {% set l = r.terms|last %}
        {% set pimg = 'featuredImage' in r.person.fieldLayout.customFields|map(f => f.handle) ? r.person.featuredImage.one() : null %}
        {% set pp = r.person.title|split(' ')|filter(x => x|trim) %}
        {% set vks = [] %}{% for x in r.terms %}{% set k = HB.vdKey(x)|trim %}{% if k %}{% set vks = vks|merge([k]) %}{% endif %}{% endfor %}
        <div class="rec-person hub-pp" data-seat="{{ pseats|join(' ') }}"{% if vks|length %} data-vd="{{ vks|join(' ') }}"{% endif %}>
          <a class="th" href="{{ r.person.url }}" tabindex="-1" aria-hidden="true">{% if pimg %}{{ portrait.img(pimg, 1, '', true, 120) }}{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : r.person.title|slice(0,1))|upper }}{% endif %}</a>
          <div style="min-width:0"><a class="n" href="{{ r.person.url }}">{{ r.person.title }}</a>
            <div class="r">{{ spans|map(x => x[0] == x[1] ? x[0] : x[0] ~ '–' ~ x[1])|join(', ') }}{{ pnames|length ? ' · ' ~ pnames|join(', ') : '' }}{{ ENDED[l.howEnded.value] is defined and l.howEnded.value not in ['expired', 'unknown', 'reelected'] ? ' · ' ~ ENDED[l.howEnded.value] : '' }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
    {% if seats|length > 1 %}<p data-seat-empty="past">No past member is recorded for this seat.</p>{% endif %}
    {% endif %}
  {% endif %}

{% elseif part == 'elections' %}
  {% set elections = craft.entries().section('elections').relatedTo({ targetElement: body, field: 'electionBody' })
      .with(['electionDistrict']).orderBy('electionDateEdtf desc').all() %}
  {% if elections|length %}
    <h2 class="rec-h2 hub-h" id="elections">Elections</h2>
    <ul class="hub-elections" data-seat-list="elections">
      {% for e in elections %}
        {% set d = e.electionDistrict|first %}
        <li data-seat="{{ d ? d.slug : '' }}"><span class="yr">{{ e.electionDateEdtf|slice(0, 4) }}</span><a href="{{ e.url }}">{{ e.electionDate ?: e.electionDateEdtf }}{{ d ? ', ' ~ (short[d.slug] ?? d.title|split(', ')|last) : '' }}</a></li>
      {% endfor %}
    </ul>
    {% if seats|length > 1 %}<p data-seat-empty="elections">No election is recorded for this seat.</p>{% endif %}
  {% else %}
    <p class="hub-gap">The archive does not yet hold an election for this body.</p>
  {% endif %}

{% elseif part == 'people' %}
  {#- The other people the archive ties to the body, who held no seat on it, each with who they are and what the connection
      is (Nathan, 4 October 2026: "anyone listed under 'Other people connected with it' shows who they are as well as the
      connection"). Committees and oversight seats belong here, off the landing view. The connection comes from an affiliation;
      a person linked only by the older fields is listed with that said, until the link is re-read into one. -#}
  {% set holderIds = craft.entries().section('officeHoldings').relatedTo({ targetElement: body, field: 'holdingBody' }).with(['holdingPerson']).all()|map(h => (h.holdingPerson|first).id ?? 0) %}
  {% set KIND = { employed: 'Employed', member: 'Member', founder: 'Founder', owner: 'Owner', 'nonprofit-board': 'Board member', volunteer: 'Volunteer' } %}
  {% set rows = [] %}{% set seenIds = [] %}
  {% for a in craft.entries().section('affiliations').relatedTo({ targetElement: body, field: 'affiliationBody' }).with(['affiliationPerson']).all() %}
    {% set p = a.affiliationPerson|first %}
    {% if p and p.id not in exclude and p.id not in holderIds %}
      {% set yrs = a.termStart or a.termEnd ? (a.termStart ?: '?') ~ ' to ' ~ (a.termEnd ?: (a.affiliationEnded.value == 'serving' ? 'now' : '?')) : '' %}
      {% set rows = rows|merge([{ p: p, why: (a.affiliationTitle ?: KIND[a.affiliationKind.value] ?? 'Connected') ~ (yrs ? ', ' ~ yrs : ''), ev: a.startEvidence }]) %}
      {% set seenIds = seenIds|merge([p.id]) %}
    {% endif %}
  {% endfor %}
  {% set legacy = body.orgFoundedBy.all()|merge(body.orgAssociatedPersons.all())|merge(craft.entries().section('persons').relatedTo({ targetElement: body, field: 'personOrganizations' }).orderBy('title asc').all()) %}
  {% for p in legacy %}{% if p.id not in holderIds and p.id not in exclude and p.id not in seenIds %}{% set rows = rows|merge([{ p: p, why: 'Linked to this record; the connection is not yet recorded', ev: null }]) %}{% set seenIds = seenIds|merge([p.id]) %}{% endif %}{% endfor %}
  {% if rows|length %}
    <h2 class="rec-h2 hub-h" id="people">Other people connected with it</h2>
    <div class="hub-people">
      {% for r in rows %}
        {% set p = r.p %}
        {#- Who they are: a public office they hold now, else their occupation. -#}
        {% set cur = craft.entries().section('officeHoldings').relatedTo({ targetElement: p, field: 'holdingPerson' }).howEnded('serving').with(['holdingOffice', 'holdingBody']).one() %}
        {% set who = cur and (cur.holdingBody|first) ? ((cur.holdingOffice|first).title ?? 'Member') ~ ', ' ~ (cur.holdingBody|first).title : (p.occupation is defined and p.occupation ? p.occupation : '') %}
        {% set pimg = 'featuredImage' in (p.fieldLayout ? p.fieldLayout.customFields|map(f => f.handle) : []) ? p.featuredImage.one() ?? null : null %}
        {% set pp = p.title|split(' ')|filter(x => x|trim) %}
        <div class="rec-person">
          <a class="th" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% if pimg %}{{ portrait.img(pimg, 1, '', true, 120) }}{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : p.title|slice(0,1))|upper }}{% endif %}</a>
          <div style="min-width:0"><a class="n" href="{{ p.url }}" style="text-decoration:none">{{ p.title }}</a><div class="r">{{ who ? who ~ '; ' : '' }}{{ r.why }}{% if r.ev %}{% include "_partials/record/evidence" with { ev: r.ev } only %}{% endif %}</div></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}

{% css %}
.hub-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:0 0 14px}
@media(max-width:900px){.hub-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.hub-cards{grid-template-columns:1fr}}
.hub-card{display:flex;flex-direction:column;background:#fff;border:1px solid #E2E4E8;color:#17254C}
.hub-ph{text-decoration:none;aspect-ratio:4/5;background:#FDF7EA;overflow:hidden;display:flex;align-items:center;justify-content:center}
.hub-ph img{width:100%;height:100%;object-fit:cover;object-position:top}
.hub-ph span{font-family:'Playfair Display',serif;font-size:40px;color:#C4A031}
.hub-tx{padding:12px 14px 14px}
.hub-n{display:block;text-decoration:none;color:#17254C;font-family:'Playfair Display',serif;font-size:18px;line-height:1.2}
.hub-m{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.1em;color:#7A5C1B;margin-top:6px;text-transform:uppercase}
.hub-o{font-size:13.5px;color:#17254C;font-weight:500;margin-top:6px}
.hub-o span{font-weight:400;color:#5B6472;font-size:12.5px}
.hub-t{font-size:13px;color:#5B6472;margin-top:6px;line-height:1.45}
.hub-gap,.hub-lede{font-size:15px;line-height:1.6;color:#4A5260;margin:0 0 20px;max-width:720px}
.hub-past{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 22px;margin-bottom:14px}
@media(max-width:900px){.hub-past{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.hub-past{grid-template-columns:1fr}}
.hub-pp .n{text-decoration:none}
.hub-elections{list-style:none;padding:0;margin:0 0 14px;columns:2 300px;column-gap:28px}
.hub-elections li{break-inside:avoid;padding:6px 0;border-bottom:1px solid #EFE6D0;font-size:15px}
.hub-elections .yr{display:inline-block;width:46px;color:#7A5C1B;font-variant-numeric:tabular-nums}
.hub-elections a{color:#17254C}
.hub-people{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:0 24px;margin-bottom:20px}
{% endcss %}
