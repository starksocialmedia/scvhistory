{#
  A person's public life, read from the records rather than the prose: each
  office, its terms, and under each term the election that won it; then every
  other race stood (Nathan, 2 October 2026: "an office and the election that won
  it are one thing"). Before that, offices held and elections stood were two
  boxes that repeated the same years.

    entry   the person

  A term is matched to a winning candidacy for the same body (an election with
  no body is the City Council's) held within eight months before the term began;
  each candidacy is used once. Appointed and rotated terms have none. Races that
  match no term (lost, or won where no term is recorded) follow under Other
  races. How each term is known is said beside it (_partials/record/evidence).
#}
{%- set holdings = craft.app.entries.getSectionByHandle('officeHoldings') ? craft.entries().section('officeHoldings').relatedTo({ targetElement: entry, field: 'holdingPerson' }).orderBy('termStartEdtf asc').all() : [] -%}
{%- set cands = craft.app.entries.getSectionByHandle('candidacies') ? craft.entries().section('candidacies').relatedTo({ targetElement: entry, field: 'candidacyPerson' }).all() : [] -%}
{%- set derivedAny = false -%}
{#- Each race with its election, place and field, once. -#}
{%- set races = [] -%}
{%- for c in cands -%}
  {%- set el = c.candidacyElection.one() -%}
  {%- if el -%}
    {%- set n = craft.entries().section('candidacies').relatedTo({ targetElement: el, field: 'candidacyElection' }).count() -%}
    {%- set place = craft.entries().section('candidacies').relatedTo({ targetElement: el, field: 'candidacyElection' }).votes('> ' ~ (c.votes ?? 0)).count() + 1 -%}
    {%- set eb = 'electionBody' in el.fieldLayout.customFields|map(f => f.handle) ? el.electionBody.one() : null -%}
    {%- set ed = 'electionDistrict' in el.fieldLayout.customFields|map(f => f.handle) ? el.electionDistrict.one() : null -%}
    {%- set races = races|merge([{ c: c, el: el, n: n, place: place, bodyId: eb ? eb.id : 0, bodySlug: eb ? eb.slug : 'city-of-santa-clarita', bodyLabel: not eb or eb.slug == 'city-of-santa-clarita' ? 'City Council' : eb.title ~ ' board', dist: ed, won: c.outcome.value == 'elected' and c.outcomeEvidence.value != 'uncited', date: el.electionDateEdtf }]) -%}
  {%- endif -%}
{%- endfor -%}
{%- set races = races|sort((a, b) => a.date <=> b.date) -%}
{%- set usedRaces = [] -%}
{% macro raceLine(r) %}{% set sfx = r.place % 100 in [11, 12, 13] ? 'th' : (['th', 'st', 'nd', 'rd'][r.place % 10] ?? 'th') %}<a href="{{ r.el.url }}">{{ r.won ? 'Elected' : (r.c.outcome.value == 'not-elected' ? 'Not elected' : 'Stood') }}</a>{% if r.won and r.c.outcomeEvidence.value == 'derived' %}{% include "_partials/record/evidence" with { ev: r.c.outcomeEvidence } only %}{% endif %} {{ r.el.electionDate ?: r.date|slice(0, 4) }}{#- A race with no count held (the college district's 1967 election) has no place: the place is read from the votes. -#}<span style="color:#5B6472">{% if r.c.votes is null or r.c.votes == '' %}, one of {{ r.n }} candidates; no count is held{% else %}, {{ r.place ~ sfx }} of {{ r.n }}, {{ r.c.votes|number_format }} votes{% endif %}</span>{% endmacro %}
{% import _self as PL %}
{% if holdings|length %}
  {#- Grouped by office and body, in the order first held. -#}
  {% set groups = {} %}
  {% for h in holdings %}
    {% set o = h.holdingOffice.one() %}{% set b = h.holdingBody.one() %}
    {% set k = 'g' ~ (o.id ?? 0) ~ '-' ~ (b.id ?? 0) %}
    {% set groups = groups|merge({ (k): (groups[k] ?? { office: o, body: b, terms: [] })|merge({ terms: ((groups[k] ?? { terms: [] }).terms)|merge([h]) }) }) %}
  {% endfor %}
  <div class="rec-box"><div class="rec-lab">PUBLIC LIFE</div>
    {% for g in groups %}
      {#- The body first, with its avatar as in the Organizations box, then the office and seat beneath (Nathan, 1 October 2026). -#}
      {% set bimg = g.body and 'featuredImage' in (g.body.fieldLayout ? g.body.fieldLayout.customFields|map(f => f.handle) : []) ? g.body.featuredImage.one() ?? null : null %}
      {% set last = g.terms|last %}
      {#- A legislature's terms carry their own district number and plan (districtPlan), shown on each term; the heading then names no seat. -#}
      {% set byPlan = 'districtPlan' in last.fieldLayout.customFields|map(f => f.handle) and g.terms|filter(x => x.districtPlan.value)|length %}
      {#- Terms of one office in different seats (Gibbs at large from 2020, then District 3 from 2024): the seat goes on each term, not the heading. -#}
      {% set seatsIn = g.terms|filter(x => x.selectionMethod.value != 'rotated')|map(x => x.seatLabel|default('')|trim)|reduce((c, v) => v in c ? c : c|merge([v]), []) %}
      {% set mixedSeats = not byPlan and seatsIn|length > 1 %}
      {% set seat = byPlan or mixedSeats ? '' : last.seatLabel|default('')|trim %}
      {% set dist = not seat and not byPlan and not mixedSeats and 'holdingDistrict' in last.fieldLayout.customFields|map(f => f.handle) ? last.holdingDistrict.one() : null %}
      {% if g.body %}
        <a class="rec-person" href="{{ g.body.url }}{{ g.body.slug == 'city-of-santa-clarita' ? '#council' : '' }}" style="margin:{{ loop.first ? '0' : '16px' }} 0 4px">
          <div class="th">{% if bimg %}<img src="{{ bimg.url }}" alt=""{% include '_partials/record/img-pos.twig' with {img: bimg} only %}>{% else %}{{ g.body.title|slice(0,1)|upper }}{% endif %}</div>
          <div style="min-width:0"><div class="n">{{ g.body.title }}</div><div class="r">{{ g.office.title ?? 'Office' }}{{ seat ? ', ' ~ seat : (dist ? ', ' ~ dist.title|split(', ')|last : '') }}</div></div>
        </a>
      {% else %}
        <div style="font-size:15px;line-height:1.45;margin:{{ loop.first ? '0' : '14px' }} 0 6px"><b style="font-weight:600;color:#17254C">{{ g.office.title ?? 'Office' }}</b></div>
      {% endif %}
      <div class="rec-rows">
        {#- An office held by rotation (the mayoralty, Mayor Pro Tem) is a year in the chair, not a term with an election: one line,
            how many times and which years, which is what a reader remembers about a council member (Nathan, 4 October 2026). -#}
        {% set rot = g.terms|filter(x => x.selectionMethod.value == 'rotated')|sort((a, b) => a.termStartEdtf|replace({'[': ''})|slice(0, 4) <=> b.termStartEdtf|replace({'[': ''})|slice(0, 4)) %}
        {% if rot|length and rot|length == g.terms|length %}
          {% set NUMW = ['', 'once', 'twice', 'three times', 'four times', 'five times', 'six times', 'seven times', 'eight times', 'nine times', 'ten times'] %}
          <div class="k">{{ rot|length == 1 ? 'YEAR' : 'YEARS' }}</div>
          <div class="v">{{ NUMW[rot|length] ?? (rot|length ~ ' times') }}{{ rot|filter(x => x.termStart)|length ? ': ' : '' }}{% set evs = rot|map(x => x.startEvidence.value ?? '')|reduce((c, v) => v in c ? c : c|merge([v]), []) %}{% for h in rot %}{{ h.termStart }}{% if h.howEnded.value == 'serving' %} (now){% endif %}{% if evs|length > 1 %}{% include "_partials/record/evidence" with { ev: h.startEvidence } only %}{% endif %}{{ not loop.last ? ', ' : '' }}{% endfor %}{% if evs|length == 1 %}{% include "_partials/record/evidence" with { ev: evs|first } only %}{% endif %}</div>
        {% else %}
        {#- Terms are matched to their elections oldest first (each election is used once), then shown newest first, as every list
            of elections on the site is (Nathan, 5 October 2026). -#}
        {% set termRows = [] %}
        {% for h in g.terms %}
          {% set termOut %}
          {% set d = h.startEvidence.value == 'derived' %}
          {% if d %}{% set derivedAny = true %}{% endif %}
          <div class="k">{{ h.selectionMethod.value in ['appointed', 'sole-candidate'] ? 'APPOINTED' : (h.selectionMethod.value == 'unopposed' ? 'UNOPPOSED' : (h.selectionMethod.value == 'rotated' ? 'ROTATION' : 'TERM')) }}</div>
          {#- How each end of the term is known; once after the range when both ends are known the same way. -#}
          {% set sameEv = not h.termEnd or (h.startEvidence.value ?? '') == (h.endEvidence.value ?? '') %}
          {#- The election that won this term: same body, won, within eight months before the term began, not used already. -#}
          {% set hb = h.holdingBody.one() %}
          {% set ts = h.termStartEdtf|default('')|slice(0, 10) %}
          {% set win = null %}
          {% if h.selectionMethod.value not in ['appointed', 'rotated', 'sole-candidate', 'unopposed'] and ts %}
            {#- Months, since terms are often recorded to the month ("1998-04"): the election falls 0 to 8 months before the term's start month. -#}
            {#- A term known only to the year ("2000") matches an election that year or the year before. -#}
            {% set yearOnly = ts|length == 4 %}
            {% set tsM = (ts|slice(0, 4)) * 12 + ((ts|slice(5, 2)) ?: 1) %}
            {% for r in races %}{% set rM = (r.date|slice(0, 4)) * 12 + ((r.date|slice(5, 2)) ?: 1) %}{% set gap = yearOnly ? (ts|slice(0, 4)) - (r.date|slice(0, 4)) : tsM - rM %}{% if not win and r.won and r.c.id not in usedRaces and (hb ? r.bodyId == hb.id or (r.bodyId == 0 and hb.slug == 'city-of-santa-clarita') : true) and gap >= 0 and gap <= (yearOnly ? 1 : 8) %}{% set win = r %}{% endif %}{% endfor %}
          {% endif %}
          {% if win %}{% set usedRaces = usedRaces|merge([win.c.id]) %}{% endif %}
          {#- Re-elections inside one recorded term (Smyth's 2000 to 2006 holds his 2000 and 2004 wins): same body, won, after the start and before the end. -#}
          {% set again = [] %}
          {% if ts %}
            {% set te = h.termEndEdtf|default('')|slice(0, 10) %}
            {% set startY = ts|slice(0, 4) %}{% set endY = te ? te|slice(0, 4) : '9999' %}
            {% for r in races %}{% if r.won and r.c.id not in usedRaces and (hb ? r.bodyId == hb.id or (r.bodyId == 0 and hb.slug == 'city-of-santa-clarita') : true) and (r.date|slice(0, 4)) > startY and (r.date|slice(0, 4)) < endY %}{% set again = again|merge([r]) %}{% set usedRaces = usedRaces|merge([r.c.id]) %}{% endif %}{% endfor %}
          {% endif %}
          <div class="v">{{ h.termStart }}{% if not sameEv %}{% include "_partials/record/evidence" with { ev: h.startEvidence } only %}{% endif %} to {{ h.termEnd ?: (h.howEnded.value == 'serving' ? 'now' : 'an end not yet recorded') }}{% include "_partials/record/evidence" with { ev: sameEv ? h.startEvidence : h.endEvidence } only %}{% if h.howEnded.value in ['left', 'removed', 'resigned', 'recalled', 'died'] %} <span style="color:#5B6472;font-size:13.5px">({{ { left: 'left office', removed: 'removed from office', resigned: 'resigned', recalled: 'recalled', died: 'died in office' }[h.howEnded.value] }})</span>{% endif %}{% if h.selectionMethod.value == 'sole-candidate' %}<div style="font-size:13.5px;line-height:1.45;margin-top:2px;color:#5B6472">As the sole candidate; no election held</div>{% endif %}{% if mixedSeats %}<div style="font-size:13.5px;line-height:1.45;margin-top:2px;color:#5B6472">{{ h.seatLabel|trim ?: 'At large' }}</div>{% endif %}{% if byPlan and h.districtPlan.value %}<div style="font-size:13.5px;line-height:1.45;margin-top:2px;color:#5B6472">{{ h.seatLabel }}, under the {{ h.districtPlan.label }}</div>{% endif %}{% if win %}<div style="font-size:13.5px;line-height:1.45;margin-top:2px">{{ PL.raceLine(win) }}</div>{% endif %}{% for r in again %}<div style="font-size:13.5px;line-height:1.45;margin-top:2px">{{ PL.raceLine(r) }}</div>{% endfor %}</div>
          {% endset %}
          {% set termRows = termRows|merge([termOut]) %}
        {% endfor %}
        {% for t in termRows|reverse %}{{ t }}{% endfor %}
        {% endif %}
      </div>
    {% endfor %}
    {% if derivedAny %}<p style="font-size:13px;line-height:1.5;color:#5B6472;margin:12px 0 0">A term "read from the count" was won on the vote totals, with the seats up derived from the staggered terms; no declaring document is held yet.</p>{% endif %}
  </div>
{% endif %}
{% set others = races|filter(r => r.c.id not in usedRaces) %}
{% if others|length %}
  <div class="rec-box"><div class="rec-lab">{{ holdings|length ? 'OTHER RACES' : 'ELECTIONS STOOD' }}</div>
    <div class="rec-rows">
      {% for r in others|reverse %}
        <div class="k">{{ r.date|slice(0, 4) }}{{ r.date|slice(5, 2) == '11' ? ' NOV' : '' }}</div>
        <div class="v">{{ PL.raceLine(r) }}<div style="color:#5B6472;font-size:13px;line-height:1.4">{{ r.bodyLabel }}{% if r.dist %}, {{ {'trustee-area': 'Trustee Area', 'council-district': 'District', 'water-division': 'Division'}[r.dist.districtKind.value] ?? 'District' }} {{ r.dist.districtNumber }}{% endif %}</div></div>
      {% endfor %}
    </div>
  </div>
{% endif %}
