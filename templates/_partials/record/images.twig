{#
  PHOTOS section under the prose: a gold rule, a PHOTOS label and a grid of
  square thumbnails. Each opens the full image in a <dialog> lightbox with the
  caption and credit beneath. No library.

  Images already placed inline in the body with an [image:N] token are left out
  here, so nothing appears twice. This partial reads the same tokens that
  _partials/prose.twig acts on.

  Caption comes from photoCaptionExt, credit from photoCredit.

  The lightbox itself is _partials/record/lightbox.twig, included once from the
  base layout. These buttons only mark themselves with data-lightbox.

  Params:
    images   the recordImages assets
    body     the prose, so inline tokens can be excluded
#}
{#- The layer of images that were links to another record. Built by
    scripts/import/link_images_to_records.php and read the same way prose.twig
    reads it. A thumbnail that pointed at a page is a link to that record, not a
    lightbox open: enlarging a 120px thumbnail shows nothing and loses the only
    navigation the legacy page had. -#}
{#- The enlarge index: which pictures have a bigger file to open. See
    _partials/prose.twig for why the magnifier is conditional. -#}
{% set enlarge = {} %}
{% set enlRaw = source('_data/enlarge.json', true) %}
{% if enlRaw|trim %}{% set enlarge = enlRaw|json_decode %}{% endif %}

{% set imgLinks = {} %}
{% if entry is defined and entry %}
  {% set il = source('_data/image-links/' ~ entry.id ~ '.json', true) %}
  {% if il|trim %}{% set imgLinks = (il|json_decode).links ?? {} %}{% endif %}
{% endif %}
{% set imgs = images is defined ? images : [] %}
{% set used = [] %}
{% if body is defined and body %}
  {% for line in body|split("\n") %}
    {% set t = line|trim %}
    {% if t matches '/^\\[image:\\d+\\]$/' %}
      {% set used = used|merge([(t|replace({'[image:': '', ']': ''}))|trim]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set shown = [] %}
{% for a in imgs %}
  {% if (loop.index)|trim not in used %}{% set shown = shown|merge([a]) %}{% endif %}
{% endfor %}

{% if shown|length %}
{% css %}
.rec-photos{margin:48px 0 0;clear:both}
.rec-photos .rule{height:3px;background:#C4A031;width:100%;margin-bottom:14px}
.rec-photos .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.rec-photos button{padding:0;border:1px solid #E2E4E8;background:#FDF7EA;cursor:pointer;display:block;width:100%}
.rec-photos button:hover{border-color:#C4A031}
.rec-photos button img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.rec-photos button{position:relative}
.rec-photos .enh{position:absolute;left:5px;top:5px;font-family:Jost,sans-serif;font-size:9.5px;letter-spacing:.1em;
                 text-transform:uppercase;background:rgba(23,37,76,.88);color:#fff;padding:2px 6px}
.rec-photos .flat{display:block;border:1px solid #E2E4E8;background:#FDF7EA}
.rec-photos .flat img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.rec-photos a.go{display:block;border:1px solid #E2E4E8;background:#FDF7EA;text-decoration:none;color:inherit}
.rec-photos a.go:hover{border-color:#C4A031}
.rec-photos a.go img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.rec-photos a.go .cap{display:block;font-size:12.5px;line-height:1.4;color:#7A5C1B;padding:7px 8px}
.rec-photos a.go:hover .cap{text-decoration:underline}
{% endcss %}

<section class="rec-photos">
  <div class="rule"></div>
  <div class="rec-lab">PHOTOS</div>
  <div class="grid">
    {#- Caption from photoCaptionExt, the field the asset carries for it. The
        title is only a caption when someone set one: Craft names an untitled
        asset after its own file, and a filename under a photograph is worse
        than no caption. Credit from photoCredit, not from alt, which is the
        screen reader's text and not a credit line. -#}
    {% for a in shown %}
      {%- set stem = a.filename|split('.')|slice(0, -1)|join('.') -%}
      {%- set nrm = a.title|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
      {%- set stemNrm = stem|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
      {%- set realTitle = (a.title|trim and nrm != stemNrm) ? a.title|trim : '' -%}
      {%- set cap = a.photoCaptionExt|default('')|trim ?: realTitle -%}
      {%- set credit = a.photoCredit|default('')|trim -%}
      {%- set linkTo = imgLinks[a.filename|lower] ?? null -%}
      {% if linkTo %}
        <a href="{{ linkTo.url }}" class="go" title="{{ linkTo.title }}">
          <img src="{{ a.url }}" alt="{{ a.alt ?: (cap ?: linkTo.title) }}" loading="lazy">
          <span class="cap">{{ linkTo.title }}</span>
        </a>
      {% else %}
        {%- set enl = enlarge[a.filename|lower] ?? null -%}
        {%- set bigFile = (enl and enl.id is defined) ? enl : null -%}
        {#- The tile draws a 560px transform, so the asset's own file is worth
            opening whenever it is meaningfully wider than that. -#}
        {%- set ownBigger = a.width and a.width > 640 -%}
        {%- set zoomSrc = bigFile ? (craft.assets().id(bigFile.id).one().url ?? null) : (ownBigger ? a.url : null) -%}
        {#- An enhanced derivative, looked up in reverse: the relation lives on
            the derivative and points at this original. The original remains the
            tile and the citation; the enhancement is offered in the lightbox. -#}
        {%- set enhanced = null -%}
        {%- set eh = [] -%}
        {%- for f in a.fieldLayout.customFields %}{% set eh = eh|merge([f.handle]) %}{% endfor -%}
        {%- if 'enhancedFrom' in eh -%}
          {%- set enhanced = craft.assets().relatedTo({ targetElement: a, field: 'enhancedFrom' }).one() ?? null -%}
        {%- endif -%}
        {%- set enhNote = '' -%}
        {%- if enhanced -%}
          {%- set enhNote = [enhanced.enhancementMethod|default(''), enhanced.enhancedBy|default(''),
                             enhanced.enhancedDate ? enhanced.enhancedDate|date('F Y') : '']|filter(x => x|trim)|join(' · ') -%}
          {%- set zoomSrc = zoomSrc ?: a.url -%}
        {%- endif -%}
        {% if zoomSrc %}
          <button type="button" data-lightbox data-src="{{ zoomSrc }}"
                  data-caption="{{ cap }}" data-credit="{{ credit }}"
                  {% if linkTo %}data-record="{{ linkTo.url }}"{% endif %}
                  {% if enhanced %}data-enhanced="{{ enhanced.url }}" data-enhanced-note="{{ enhNote }}"{% endif %}>
            <img src="{{ a.url }}" alt="{{ a.alt ?: cap }}" loading="lazy">
            {% if enhanced %}<span class="enh">Enhanced</span>{% endif %}
          </button>
        {% else %}
          <span class="flat"><img src="{{ a.url }}" alt="{{ a.alt ?: cap }}" loading="lazy"></span>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</section>


{% endif %}
