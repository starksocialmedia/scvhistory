{#
  PUBLISHED BY, with the same treatment as the author and editor boxes.

  It used to be a label-and-link row, which made the publisher of a piece read
  like a field value rather than like the body that published it. The Signal
  publishes 26 of these records; it deserves the same footprint as the person
  who wrote them.

  A 56px circle: the organization's featuredImage, or its initials on cream
  inside a gold border where there is none, exactly as the family box does it.
  Most publishers have no image today, so the initials are the common case and
  not the exception.

  Beneath the name, what the organization is, in the muted grey. There is no
  field for that: the person type has occupation and the organization type has
  nothing equivalent. So it falls back to the first sentence of the body, then
  to the record tags, then to nothing, and on most records today it shows
  nothing. An orgType field would fix that and is a decision rather than a
  template change.

  Usage: {% include "_partials/record/publisher" with { orgs: publishers } only %}
#}
{% if orgs|length %}
  {% css %}
  .rec-pub a.p{display:flex;gap:12px;align-items:center;color:inherit;text-decoration:none;padding:9px 0;border-bottom:1px solid #EFE6D0}
  .rec-pub a.p:last-child{border-bottom:0}
  .rec-pub .th{width:56px;height:56px;border-radius:50%;flex:none;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#EEF0F4}
  .rec-pub .th img{width:100%;height:100%;object-fit:cover}
  .rec-pub .th.ini{background:#FDF7EA;border:1px solid #C4A031;font-family:'Jost',sans-serif;font-size:16px;letter-spacing:.06em;color:#7A5C1B}
  .rec-pub .n{font-family:'Playfair Display',serif;font-size:16px;line-height:1.3;color:#17254C}
  .rec-pub a.p:hover .n{color:#7A5C1B}
  .rec-pub .r{font-size:13px;line-height:1.5;color:#5B6472;margin-top:2px}
  {% endcss %}

  <div class="rec-box rec-pub">
    <div class="rec-lab">PUBLISHED BY</div>
    {% for o in orgs %}
      {% set oh = [] %}
      {% for f in (o.fieldLayout ? o.fieldLayout.customFields : []) %}{% set oh = oh|merge([f.handle]) %}{% endfor %}
      {% set img = 'featuredImage' in oh ? o.featuredImage.one() ?? null : null %}

      {#- Initials skip the articles a name opens with, so The Santa Clarita
          Valley Signal reads SC and not TS, and skip anything that does not
          begin with a letter, or "SCVHistory.com — Santa Clarita Valley
          History" reads as S followed by an em dash. -#}
      {% set stop = ['the', 'a', 'an', 'of', 'and'] %}
      {% set words = (o.title ?: o.slug)|split(' ')|filter(w =>
        w|trim != '' and w|lower not in stop and w|trim|first matches '/[a-zA-Z]/')|values %}
      {% set ini = words|length
        ? (words|first|slice(0, 1) ~ (words|length > 1 ? words[1]|slice(0, 1) : ''))|upper
        : (o.title|slice(0, 1))|upper %}

      {#- What it is. No field holds this, so: the body's first sentence, then
          the tags, then nothing rather than something invented. -#}
      {% set sub = '' %}
      {% if 'body' in oh and o.body|trim %}
        {% set flat = o.body|striptags|replace({'\n': ' '})|trim %}
        {% set cut = flat|split('. ')|first|trim %}
        {% if cut|length > 4 and cut|length < 150 %}{% set sub = cut|trim('.') ~ '.' %}{% endif %}
      {% endif %}
      {% if sub == '' and 'recordTags' in oh %}
        {% set tags = o.recordTags.all() %}
        {% if tags|length %}{% set sub = tags|map(t => t.title)|join(', ') %}{% endif %}
      {% endif %}

      <a class="p" href="{{ o.url }}">
        {% if img %}
          <div class="th"><img src="{{ img.url }}" alt=""></div>
        {% else %}
          <div class="th ini" aria-hidden="true">{{ ini }}</div>
        {% endif %}
        <div style="min-width:0">
          <div class="n">{{ o.title ?: o.slug }}</div>
          {% if sub %}<div class="r">{{ sub }}</div>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
{% endif %}
