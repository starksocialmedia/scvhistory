{#
  Record tools row: read time, word count, updated date, Save / Print, and a
  small read-aloud player.

  The player speaks the record one sentence at a time rather than in a single
  utterance, which is what makes progress trackable: the bar fills as sentences
  complete, the sentence being read is highlighted and scrolled into view, and
  clicking or dragging the bar restarts from that sentence. Estimated total
  starts from 165 words per minute and is corrected against real elapsed time
  as sentences complete.

  Everything is hidden when speechSynthesis is missing, and speaking is
  cancelled on navigation so a record does not keep talking after you leave.

  Params:
    entry    required, for the updated date and the spoken heading
    text     the prose the word count is measured from, defaults to entry.body
    textId   DOM id of the prose element, defaults to recText
#}
{% set textId = textId ?? 'recText' %}
{% set source = text is defined and text ? text : (entry.body is defined ? entry.body : '') %}
{% set words = source ? source|striptags|split(' ')|filter(w => w|trim)|length : 0 %}
{% css %}
/* Only what cannot be an inline style: the hover states, the focus ring and
   the speaking highlight. Everything else is inline, reproduced from
   design/article-source.html. */
.rec-tools-btn:hover{border-color:#C4A031}
.rec-listen:hover{background:#C4A031;color:#17254C}
.rec-tools-btn:focus-visible,.rec-listen:focus-visible,.rec-play button:focus-visible,.rec-play .bar:focus-visible{outline:2px solid #7A5C1B;outline-offset:2px}
.rec-play .bar:hover .fill{background:#B3902A}
.rec-speaking{background:#FDF7EA;box-shadow:0 0 0 4px #FDF7EA}
{% endcss %}

<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; padding-bottom: 16px; border-bottom: 1px solid #E2E4E8">
  {#- Listen is hidden until the script has found sentences to read, so a record
      the browser cannot speak never offers the button. -#}
  <button type="button" class="rec-listen" id="recListen" hidden aria-expanded="false" aria-controls="recPlayer"
    style="display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid #C4A031; color: #A9842B; font-family: 'Jost', sans-serif; font-size: 13.5px; letter-spacing: .04em; padding: 8px 14px; cursor: pointer; flex: none">
    <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true"><polygon points="2,1 11,6 2,11"></polygon></svg>Listen
  </button>
  <div style="font-family: 'Jost', sans-serif; font-size: 13px; letter-spacing: .04em; color: #5B6472; flex: 1; min-width: 190px">
    {%- if words > 20 -%}{{ (words / 200)|round(0, 'ceil') }} min read<span style="color: #C4A031; padding: 0 8px">&middot;</span>{{ words|number_format }} words<span style="color: #C4A031; padding: 0 8px">&middot;</span>{%- endif -%}
    Updated {{ entry.dateUpdated|date('M j, Y') }}
  </div>
  <div style="display: flex; gap: 8px; flex: none">
    <button type="button" class="rec-tools-btn" onclick="window.print()" style="background: #fff; border: 1px solid #E2E4E8; font-family: 'Jost', sans-serif; font-size: 13.5px; letter-spacing: .04em; color: #2C2C2C; padding: 8px 14px; cursor: pointer">Print</button>
    <button type="button" class="rec-tools-btn" id="recShare" style="background: #fff; border: 1px solid #E2E4E8; font-family: 'Jost', sans-serif; font-size: 13.5px; letter-spacing: .04em; color: #2C2C2C; padding: 8px 14px; cursor: pointer">Share</button>
  </div>
</div>

{#- The player, hidden until Listen is pressed. It used to be always visible,
    which put the heaviest control on the page above the prose. -#}
<div class="rec-play" id="recPlayer" role="group" aria-label="Read this record aloud" hidden
  style="background: #FDF7EA; border: 1px solid #EFE6D0; border-left: 3px solid #C4A031; padding: 14px 18px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 18px">
  <button type="button" class="pp" id="recPP" aria-label="Play"
    style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid #C4A031; background: #fff; color: #A9842B; cursor: pointer; flex: none; display: flex; align-items: center; justify-content: center; padding: 0">
    <svg viewBox="0 0 12 12" width="11" height="11" fill="currentColor" aria-hidden="true"><polygon id="recPPIcon" points="2,1 11,6 2,11"></polygon></svg>
  </button>
  <div class="bar" id="recBar" role="slider" tabindex="0" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
    style="flex: 1; min-width: 140px; height: 4px; background: #EFE6D0; border: 0; padding: 0; cursor: pointer; position: relative">
    <span class="fill" id="recFill" style="display: block; width: 0; height: 4px; background: #C4A031"></span>
  </div>
  <div style="font-family: ui-monospace, monospace; font-size: 12.5px; color: #5B6472"><span id="recElapsed">0:00</span> / <span id="recTotal">0:00</span></div>
  <div class="speed" role="group" aria-label="Reading speed" style="display: flex; gap: 5px; font-family: 'Jost', sans-serif; font-size: 12.5px">
    <button type="button" data-rate="0.8" aria-pressed="false" style="border: 1px solid #E8E0CC; background: #fff; padding: 4px 8px; color: #5B6472; cursor: pointer">0.8&times;</button>
    <button type="button" data-rate="1" aria-pressed="true" style="border: 1px solid #17254C; background: #17254C; padding: 4px 8px; color: #fff; cursor: pointer">1&times;</button>
    <button type="button" data-rate="1.25" aria-pressed="false" style="border: 1px solid #E8E0CC; background: #fff; padding: 4px 8px; color: #5B6472; cursor: pointer">1.25&times;</button>
    <button type="button" data-rate="1.5" aria-pressed="false" style="border: 1px solid #E8E0CC; background: #fff; padding: 4px 8px; color: #5B6472; cursor: pointer">1.5&times;</button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var listen = document.getElementById('recListen');
  var player = document.getElementById('recPlayer');
  var txt = document.getElementById({{ textId|json_encode|raw }});
  if (!player || !txt || !('speechSynthesis' in window)) { return; }

  var HEADING = {{ (entry.title ?? '')|json_encode|raw }};
  var WPM = 165;
  var pp = document.getElementById('recPP'), ppIcon = document.getElementById('recPPIcon');

  /* Voice selection.

     Taking the first English voice gave whatever the platform happened to list
     first, which on macOS is one of the old compact voices and sounds like a
     1990s screen reader. Preference order:

       1. Google US English, the best of the remote neural voices
       2. anything named Siri, the modern Apple neural voices
       3. any voice with localService false, since remote voices are the
          neural ones on Chrome and Edge
       4. the good named macOS voices: Samantha, Alex, Daniel, Karen
       5. any en-US voice
       6. the first English voice

     There is no picker. The reader gets the best available voice and never has
     to think about it, and the chain falls through silently, so a machine
     without the Google voices still reads in the best thing it has.

     The macOS novelty voices are filtered out first, so a machine that has
     little else still does not read in Bad News or Zarvox. */
  var NAMED = ['samantha', 'alex', 'daniel', 'karen'];
  /* The macOS "novelty" set: sound effects with a voice attached, not reading
     voices. */
  var NOVELTY = [
    'albert', 'bad news', 'bahh', 'bells', 'boing', 'bubbles', 'cellos',
    'good news', 'jester', 'organ', 'superstar', 'trinoids', 'whisper',
    'wobble', 'zarvox'
  ];
  var chosenVoice = null;

  function matchesName(v, want) {
    var n = v.name.toLowerCase();
    return n === want || n.indexOf(want + ' (') === 0;
  }

  function isNovelty(v) {
    return NOVELTY.some(function (bad) { return matchesName(v, bad); });
  }

  function bestVoice(list) {
    if (!list.length) { return null; }
    var contains = function (needle) {
      return list.find(function (v) { return v.name.toLowerCase().indexOf(needle) !== -1; });
    };
    var hit = contains('google us english');
    if (hit) { return hit; }
    hit = contains('siri');
    if (hit) { return hit; }
    hit = list.find(function (v) { return v.localService === false; });
    if (hit) { return hit; }
    hit = list.find(function (v) {
      return NAMED.some(function (want) { return matchesName(v, want); });
    });
    if (hit) { return hit; }
    hit = list.find(function (v) { return /^en[-_]US$/i.test(v.lang); });
    if (hit) { return hit; }
    return list[0];
  }

  function loadVoices() {
    var english = (speechSynthesis.getVoices() || []).filter(function (v) {
      return /^en(-|_|$)/i.test(v.lang) && !isNovelty(v);
    });
    chosenVoice = bestVoice(english);
  }

  loadVoices();

  var bar = document.getElementById('recBar'), fill = document.getElementById('recFill');
  var elapsedEl = document.getElementById('recElapsed'), totalEl = document.getElementById('recTotal');
  var PLAY = 'M1 1l12 7-12 7z', PAUSE = 'M2 1h3v14H2zM9 1h3v14H9z';

  // Wrap each sentence so it can be highlighted and scrolled to.
  var sentences = [];
  (function mark(){
    var walker = document.createTreeWalker(txt, NodeFilter.SHOW_TEXT);
    var nodes = [], n;
    while ((n = walker.nextNode())) { if (n.nodeValue.trim()) { nodes.push(n); } }
    nodes.forEach(function(node){
      var parts = node.nodeValue.match(/[^.!?]+[.!?]*\s*/g);
      if (!parts) { return; }
      var frag = document.createDocumentFragment();
      parts.forEach(function(p){
        if (!p.trim()) { frag.appendChild(document.createTextNode(p)); return; }
        var span = document.createElement('span');
        span.className = 'rec-sentence';
        span.textContent = p;
        frag.appendChild(span);
        sentences.push({ el: span, text: p.trim(), words: p.trim().split(/\s+/).length });
      });
      node.parentNode.replaceChild(frag, node);
    });
  })();
  if (!sentences.length) { return; }

  /* The player is offered, not shown. Listen reveals it and plays; pressing it
     again hides it and stops. */
  if (listen) {
    listen.hidden = false;
    listen.addEventListener('click', function () {
      var open = !player.hidden;
      if (open) { if (playing) { pause(); } player.hidden = true; }
      else { player.hidden = false; if (!playing) { play(); } }
      listen.setAttribute('aria-expanded', String(!open));
    });
  }

  /* Progress model.

     The bar used to move only when a sentence ended, so a four sentence record
     advanced in four jumps. Progress is measured in characters now and driven by
     an animation frame, so it moves continuously.

     Within the current sentence the position comes from, in order:
       1. the utterance's own boundary events, which carry an exact charIndex.
          Chrome and Safari fire these per word.
       2. elapsed wall clock time against the sentence's estimated duration, for
          the voices that never fire a boundary, which includes some remote ones.

     A boundary sets an exact floor and the timer interpolates forward from it,
     so the two combine rather than fight, and a boundary is only accepted when
     it moves forward. When a sentence really ends the bar snaps to its true end
     and the characters per second estimate is recalibrated from the real
     elapsed time.

     The total to the right of the slash is computed once, from the full
     character count at the chosen rate, and held. Recalibration changes the
     remaining estimate, never the displayed total, so that number never moves
     mid read. Changing speed recomputes it, since that is a deliberate change
     by the reader. */
  var CPS = 14.5;               // characters per second at rate 1, before calibration
  var chars = sentences.map(function(s){ return s.text.length || 1; });
  var cumChars = [], runC = 0;
  chars.forEach(function(c){ cumChars.push(runC); runC += c; });
  var totalChars = runC || 1;

  var rate = 1, idx = 0, playing = false, startedAt = 0, elapsedBefore = 0;
  var cps = CPS;                // recalibrated as sentences complete
  var heldTotal = totalChars / (CPS * 1);
  var markChar = 0, markAt = 0; // exact floor within the current sentence, and when
  var markSet = false;          // whether a boundary has landed in this sentence yet
  var heldChar = 0;             // where the bar sits while paused
  var boundaryEver = false;
  var ticker = null;

  function fmt(sec){
    sec = Math.max(0, Math.round(sec));
    return Math.floor(sec / 60) + ':' + ('0' + (sec % 60)).slice(-2);
  }
  function holdTotal(){ heldTotal = totalChars / (CPS * rate); }
  /* Position within the current sentence, from the exact floor a boundary gave
     us plus elapsed time against the estimate for what is left.

     The estimate is never trusted all the way to the sentence end. Clamping
     hard at the end made the bar stall whenever a sentence ran longer than
     estimated, which put the jumps straight back. It runs linear to 90 percent
     of the remainder, then eases asymptotically toward the end, so it is always
     moving, never overshoots into the next sentence, and the snap when the
     sentence really ends is at most the last tenth. */
  function charPos(){
    if (!playing) { return heldChar; }
    var base = cumChars[idx] || 0;
    var remaining = Math.max(0, chars[idx] - markChar);
    if (!remaining) { return base + chars[idx]; }
    var t = Math.max(0, (Date.now() - markAt) / 1000);
    var expected = Math.max(0.2, remaining / (cps * rate));
    var lin = t / expected;
    var eased = lin < 0.9 ? lin : 0.9 + 0.1 * (1 - Math.exp(-(lin - 0.9) * 1.5));
    return base + markChar + remaining * Math.min(0.999, eased);
  }
  function paint(){
    var pct = Math.min(100, Math.max(0, charPos() / totalChars * 100));
    fill.style.width = pct.toFixed(2) + '%';
    bar.setAttribute('aria-valuenow', Math.round(pct));
    var elapsed = elapsedBefore + (playing ? (Date.now() - startedAt) / 1000 : 0);
    elapsedEl.textContent = fmt(elapsed);
    totalEl.textContent = fmt(heldTotal);
  }
  function tick(){
    if (!playing) { ticker = null; return; }
    paint();
    ticker = window.requestAnimationFrame ? requestAnimationFrame(tick) : setTimeout(tick, 100);
  }
  function startTicking(){
    if (ticker !== null) { return; }
    ticker = window.requestAnimationFrame ? requestAnimationFrame(tick) : setTimeout(tick, 100);
  }
  function stopTicking(){
    if (ticker === null) { return; }
    if (window.requestAnimationFrame) { cancelAnimationFrame(ticker); } else { clearTimeout(ticker); }
    ticker = null;
  }
  function highlight(i){
    sentences.forEach(function(s){ s.el.classList.remove('rec-speaking'); });
    if (i < sentences.length) {
      var el = sentences[i].el;
      el.classList.add('rec-speaking');
      var r = el.getBoundingClientRect();
      if (r.top < 80 || r.bottom > window.innerHeight - 80) {
        window.scrollTo({ top: r.top + window.scrollY - window.innerHeight / 3, behavior: 'smooth' });
      }
    }
  }
  function speak(i){
    if (i >= sentences.length) { stop(); return; }
    idx = i; highlight(i);
    markChar = 0; markAt = Date.now(); markSet = false;
    paint();
    var prefix = (i === 0 && HEADING) ? HEADING + '. ' : '';
    var u = new SpeechSynthesisUtterance(prefix + sentences[i].text);
    u.rate = rate;
    if (chosenVoice) { u.voice = chosenVoice; }
    u.onstart = function(){ if (playing && idx === i) { markAt = Date.now(); } };
    u.onboundary = function(ev){
      if (!playing || idx !== i) { return; }
      if (ev.name && ev.name !== 'word' && ev.name !== 'sentence') { return; }
      if (typeof ev.charIndex !== 'number') { return; }
      var ci = ev.charIndex - prefix.length;
      /* Boundaries only ever move forward. markSet rather than markChar > 0, so
         the first boundary of a sentence is accepted even when it reports 0. */
      if (ci < 0 || ci > chars[i] || (markSet && ci <= markChar)) { return; }
      boundaryEver = true; markSet = true;
      markChar = ci; markAt = Date.now();
    };
    u.onend = function(){
      if (!playing) { return; }
      markChar = chars[i]; markAt = Date.now();   // snap to the true end
      paint();
      var secs = (Date.now() - startedAt) / 1000 + elapsedBefore;
      var doneChars = (cumChars[i] || 0) + chars[i];
      if (secs > 1.5) { cps = (doneChars / secs) / rate; }
      speak(i + 1);
    };
    u.onerror = function(){ stop(); };
    speechSynthesis.speak(u);
  }
  function play(){
    playing = true; startedAt = Date.now();
    ppIcon.setAttribute('d', PAUSE); pp.setAttribute('aria-label', 'Pause');
    startTicking();
    speak(idx);
  }
  function pause(){
    elapsedBefore += (Date.now() - startedAt) / 1000;
    heldChar = charPos();
    playing = false; stopTicking(); speechSynthesis.cancel();
    ppIcon.setAttribute('d', PLAY); pp.setAttribute('aria-label', 'Play');
    paint();
  }
  function stop(){
    playing = false; stopTicking(); speechSynthesis.cancel();
    ppIcon.setAttribute('d', PLAY); pp.setAttribute('aria-label', 'Play');
    sentences.forEach(function(s){ s.el.classList.remove('rec-speaking'); });
    idx = 0; elapsedBefore = 0; heldChar = 0; markChar = 0; markSet = false; cps = CPS;
    holdTotal();
    fill.style.width = '0'; bar.setAttribute('aria-valuenow', 0);
    elapsedEl.textContent = '0:00'; paint();
  }
  function seekTo(pct){
    var target = totalChars * pct;
    var i = 0;
    for (var k = 0; k < cumChars.length; k++) { if (cumChars[k] <= target) { i = k; } }
    idx = i;
    elapsedBefore = (cumChars[i] || 0) / (cps * rate);
    heldChar = cumChars[i] || 0;
    markChar = 0; markAt = Date.now(); markSet = false;
    if (playing) { speechSynthesis.cancel(); startedAt = Date.now(); speak(i); }
    else { highlight(i); paint(); }
  }

  pp.addEventListener('click', function(){ playing ? pause() : play(); });

  /* Share: the browser's own sheet where there is one, the clipboard where
     there is not, and the button says which happened. */
  var share = document.getElementById('recShare');
  if (share) {
    share.addEventListener('click', function(){
      var data = { title: document.title, url: location.href };
      if (navigator.share) { navigator.share(data).catch(function(){}); return; }
      if (navigator.clipboard) {
        navigator.clipboard.writeText(location.href).then(function(){
          var was = share.textContent; share.textContent = 'Link copied';
          setTimeout(function(){ share.textContent = was; }, 1600);
        });
      }
    });
  }

  function pctFrom(e){
    var r = bar.getBoundingClientRect();
    return Math.min(1, Math.max(0, ((e.clientX !== undefined ? e.clientX : 0) - r.left) / r.width));
  }
  var dragging = false;
  bar.addEventListener('mousedown', function(e){ dragging = true; seekTo(pctFrom(e)); });
  document.addEventListener('mousemove', function(e){ if (dragging) { seekTo(pctFrom(e)); } });
  document.addEventListener('mouseup', function(){ dragging = false; });
  bar.addEventListener('keydown', function(e){
    var step = 1 / Math.max(1, sentences.length);
    if (e.key === 'ArrowRight') { e.preventDefault(); seekTo(Math.min(1, (cumChars[idx] / totalChars) + step)); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); seekTo(Math.max(0, (cumChars[idx] / totalChars) - step)); }
    if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); playing ? pause() : play(); }
  });

  player.querySelectorAll('.speed button').forEach(function(b){
    b.addEventListener('click', function(){
      rate = parseFloat(b.dataset.rate);
      player.querySelectorAll('.speed button').forEach(function(x){
        var on = x === b;
        x.setAttribute('aria-pressed', String(on));
        x.style.background = on ? '#17254C' : '#fff';
        x.style.borderColor = on ? '#17254C' : '#E8E0CC';
        x.style.color = on ? '#fff' : '#5B6472';
      });
      holdTotal();
      if (playing) { speechSynthesis.cancel(); startedAt = Date.now(); speak(idx); }
      paint();
    });
  });

  window.addEventListener('beforeunload', function(){ speechSynthesis.cancel(); });
  window.addEventListener('pagehide', function(){ speechSynthesis.cancel(); });
  /* Chrome populates the voice list asynchronously, so the first call above can
     come back empty. Rebuild the picker when it arrives. */
  if (speechSynthesis.onvoiceschanged !== undefined) { speechSynthesis.onvoiceschanged = loadVoices; }
  holdTotal();
  paint();

  /* for checking in the console whether this voice fires boundary events */
  player.__boundary = function(){ return boundaryEver; };
});
</script>
