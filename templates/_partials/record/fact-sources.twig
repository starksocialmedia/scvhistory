{#
  Facts and their sources (factSources): each fact on the record, its value,
  the footnotes that support it, and where the sources differ. Differences are
  shown, not settled (Nathan, 2 October 2026; the war memorial sourcing pilot).
  The note numbers link to the footnotes list (#fn-N).

  Params:
    entry   the record; nothing renders unless its layout has factSources rows
#}
{%- set rows = (entry.fieldLayout and 'factSources' in entry.fieldLayout.customFields|map(f => f.handle)) ? (entry.factSources ?? []) : [] -%}
{%- set rows = rows|filter(r => (r.fact ?? '')|trim != '') -%}
{% if rows|length %}
  {% css %}
  .rec-facts-src{margin:36px 0 0}
  .rec-facts-src h2{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#7A5C1B;font-weight:500;margin:0 0 12px}
  .rec-facts-src table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #E2E4E8;font-size:14.5px}
  .rec-facts-src th{text-align:left;font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.12em;color:#7A5C1B;font-weight:500;padding:10px 12px;border-bottom:1px solid #EFE6D0}
  .rec-facts-src td{padding:9px 12px;border-top:1px solid #F1F2F4;vertical-align:top;line-height:1.5}
  .rec-facts-src td.f{color:#5B6472;white-space:nowrap}
  .rec-facts-src td.n{white-space:nowrap}
  .rec-facts-src td.n a{color:#7A5C1B;text-decoration:none;margin-right:4px}
  .rec-facts-src .d{display:block;font-size:13.5px;color:#7A5C1B;margin-top:4px}
  @media (max-width:640px){.rec-facts-src td.f{white-space:normal}}
  {% endcss %}
  <section class="rec-facts-src" id="facts-and-sources">
    <h2>Facts and their sources</h2>
    <table>
      <thead><tr><th>Fact</th><th>As the record holds it</th><th>Notes</th></tr></thead>
      <tbody>
        {% for r in rows %}
          <tr>
            <td class="f">{{ r.fact }}</td>
            <td>{{ r.value }}{% if (r.agreement ?? '')|trim %}<span class="d">{{ r.agreement }}</span>{% endif %}</td>
            <td class="n">{% for n in (r.notes ?? '')|split(',')|map(x => x|trim)|filter(x => x) %}<a href="#fn-{{ n }}">[{{ n }}]</a>{% endfor %}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% endif %}
