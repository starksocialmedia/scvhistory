{#
  The notes under a piece, in the three states the archive actually has.

  229 records print a footnote marker. 2 carry the note text, 6 can point at a
  notes record we hold, and 221 are orphans. The legacy site kept one notes.html
  for a whole series rather than putting the notes on the page that cited them,
  and most of those files did not survive the mirror. A marker whose note is
  gone is still evidence that the author cited something, so it stays visible.
  What it must not do is offer a link to nothing.

    held       footnotes has rows. The notes print here, numbered, each one an
               anchor the marker jumps to.
    elsewhere  footnotesOn points at a record. Nothing prints here; the markers
               in the prose link to that record instead.
    orphan     neither. One line says the notes are not in the source, once, at
               the foot of the piece.

  The fields are read through the layout rather than by name, because
  entry.footnotes is "defined" on a type that has no such field and then throws
  when it is read.

  Params:
    entry   the record
#}
{%- set handles = [] -%}
{%- for f in entry.fieldLayout.customFields -%}{%- set handles = handles|merge([f.handle]) -%}{%- endfor -%}

{%- set rows = 'footnotes' in handles ? (entry.footnotes ?? []) : [] -%}
{%- set notesOn = 'footnotesOn' in handles ? (entry.footnotesOn.one() ?? null) : null -%}

{%- if rows|length or notesOn -%}{%- else -%}
  {#- Orphan. Only say so where the prose actually carries a marker, so a piece
      that simply has no notes stays silent.

      Every text field, not a named three. This read body, wmNarrative and
      mpNarrative and found nothing on records that plainly carry markers,
      because the prose is not always under those handles: an article's notes
      can sit in a webmaster note or in the fine print, and on
      /articles/6-oil-and-newhall the only bracketed numbers in body are the
      broken dates. survey_footnotes.php walks every PlainText field, so this
      has to walk the same ones or the count and the page disagree. -#}
  {%- set prose = '' -%}
  {%- for f in entry.fieldLayout.customFields -%}
    {%- if className(f) == 'craft\\fields\\PlainText' -%}
      {%- set prose = prose ~ "\n" ~ attribute(entry, f.handle) -%}
    {%- endif -%}
  {%- endfor -%}
  {#- Whitespace inside the brackets, because the extraction broke a marker
      across lines: the body holds "[", "21", "]" on three lines of their own and
      prose.twig rejoins them at render time. Reading the raw field for a literal
      [21] finds nothing on a record that plainly prints one. -#}
  {%- set hasMarker = prose matches '/(?<![A-Za-z0-9])\\[\\s*\\d{1,3}\\s*\\](?!\\d)/' -%}
{%- endif -%}

{% if rows|length %}
  {% css %}
  .rec-fn{margin:40px 0 0;clear:both;max-width:700px}
  .rec-fn .rule{height:1px;background:#E2E4E8;margin-bottom:16px}
  .rec-fn .lab{font-family:Jost,sans-serif;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#5B6472;margin-bottom:12px}
  .rec-fn ol{list-style:none;margin:0;padding:0;counter-reset:none}
  .rec-fn li{display:flex;gap:10px;font-size:14.5px;line-height:1.65;color:#2C2C2C;margin-bottom:10px}
  .rec-fn li .n{flex:0 0 auto;font-family:Jost,sans-serif;color:#7A5C1B;min-width:1.8em}
  .rec-fn li:target .n,.rec-fn li:target{background:#FDF7EA}
  .rec-fn .back{margin-left:6px;color:#7A5C1B;text-decoration:none;font-size:12px}
  .rec-fn-away{margin:40px 0 0;clear:both;max-width:700px;font-size:14px;line-height:1.7;color:#5B6472}
  .rec-fn-away a{color:#7A5C1B}
  {% endcss %}
  <section class="rec-fn" id="footnotes">
    <div class="rule"></div>
    <div class="lab">NOTES</div>
    <ol>
      {% for r in rows %}
        {% set num = (r.number ?? '')|trim ?: loop.index %}
        <li id="fn-{{ num }}"><span class="n">{{ num }}.</span><span>{{ r.note|trim|nl2br }}<a class="back" href="#fnref-{{ num }}" aria-label="Back to the text">&#8617;</a></span></li>
      {% endfor %}
    </ol>
  </section>

{% elseif notesOn %}
  {% css %}
  .rec-fn-away{margin:40px 0 0;clear:both;max-width:700px;font-size:14px;line-height:1.7;color:#5B6472}
  .rec-fn-away a{color:#7A5C1B}
  {% endcss %}
  <section class="rec-fn-away" id="footnotes">
    The notes for this piece were published separately, on
    <a href="{{ notesOn.url }}">{{ notesOn.title }}</a>.
  </section>

{% elseif hasMarker|default(false) %}
  {% css %}
  .rec-fn-away{margin:40px 0 0;clear:both;max-width:700px;font-size:14px;line-height:1.7;color:#5B6472}
  .rec-fn-away a{color:#7A5C1B}
  {% endcss %}
  <section class="rec-fn-away" id="footnotes">
    The numbered markers in this piece are the author's. The notes they refer to
    are not in the source we hold, so they are shown without links.
  </section>
{% endif %}
