{#
  Turns blank-line separated text into paragraphs.

  A line consisting only of [image:N] is replaced by a figure floated right at
  300px, where N is the 1-based position in the record's images. Caption comes
  from photoCaptionExt, falling back to the title only when the title is not
  just the filename; credit comes from photoCredit. Images placed this way are
  skipped by the Photos section, which reads the same tokens.

  A line with no letters in it, only punctuation or a bare number, rejoins the
  line above rather than becoming a paragraph of its own. The legacy extraction
  split footnote markers across lines, so a reference printed as [21] arrived as
  three lines and rendered as three paragraphs.

  So does a line that continues the sentence above it: one starting with a
  lowercase letter or a comma, and one that does not end in sentence punctuation
  whose next line starts that way. An italicised species name sat on its own
  line, so "the eriodyction glutinosum, growing profusely" arrived as three
  lines and rendered as three paragraphs with the sentence split around it.

  Mentions of related records are linked from a layer rather than from the text.
  When linksFor is set, templates/_data/prose-links/<id>.json is read and its
  spans are applied to the paragraphs at render time. The body itself is never
  rewritten, so the words stay exactly as they were imported and the whole layer
  can be regenerated or deleted without touching a record.

  Every span carries the text it expects at its offset. A span whose text is not
  there is dropped, so if this partial's rejoin rule ever changes the links go
  quiet rather than cutting through a sentence. Re-running the linker fixes it.

  Params:
    text         the prose
    images       optional, the recordImages assets, needed for [image:N]
    linksFor     optional, an entry id; loads that entry's link layer
    footnotesFor optional, the entry; turns [N] into a marker in one of three
                 states. Omit it and [N] prints as it always did.
#}
{% if images is defined and images|length %}
  {% css %}
  .rec-inline{float:right;width:40%;margin:4px 0 22px 30px;clear:right}
  .rec-inline button{display:block;width:100%;padding:0;border:0;background:none;cursor:zoom-in;font:inherit;text-align:inherit}
  .rec-inline img{width:100%;height:auto;display:block;border:1px solid #E2E4E8;background:#fff}
  .rec-inline button:hover img{border-color:#C4A031}
  .rec-inline figcaption{font-size:13.5px;font-style:italic;color:#5B6472;line-height:1.5;margin-top:8px}
  .rec-inline .cr{display:block;font-style:normal;font-size:12px;color:#5B6472;margin-top:3px}

  {#- A picture too tall to sit beside a paragraph, and one whose paragraph is
      too short to wrap around it, take the column instead of floating. A tall
      portrait floated at 40% pushes text past the end of its own paragraph and
      leaves a channel of white down the page. -#}
  .rec-inline.full{float:none;width:100%;margin:26px 0}
  .rec-inline.full figcaption{max-width:34em}

  {#- Nothing structural may start beside a float. A heading, the signature
      rule, the photographs and the foot of the piece all begin again at the
      full width of the column. -#}
  .rec-body h2,.rec-body h3,.rec-body h4,.rec-body hr,.rec-sig,.rec-photos,.rec-foot{clear:both}

  {#- Below the point where 40% of the column stops being a usable picture. -#}
  @media(max-width:700px){.rec-inline,.rec-inline.full{float:none;width:100%;margin:0 0 22px}}
  {% endcss %}
{% endif %}
{% css %}
.rec-body sup.fn{font-size:.68em;line-height:0;vertical-align:super;font-family:Jost,sans-serif;margin-left:1px}
.rec-body sup.fn a{color:#7A5C1B;text-decoration:none}
.rec-body sup.fn a:hover{text-decoration:underline}
{#- An orphan marker is not a link and must not look like one. It is the
    author's own numbering, kept because it is evidence that something was
    cited, and greyed because there is nothing at the end of it. -#}
.rec-body sup.fn:not(:has(a)){color:#5B6472;cursor:help}
{% endcss %}
{%- set imgs = images is defined ? images : [] -%}

{#- Which of the three footnote states this record is in. Read through the
    layout, because entry.footnotes is "defined" on a type that has no such
    field and throws the moment it is read. -#}
{%- set fnMode = 'off' -%}
{%- set fnHref = '' -%}
{%- if footnotesFor is defined and footnotesFor -%}
  {%- set fnHandles = [] -%}
  {%- for f in footnotesFor.fieldLayout.customFields -%}{%- set fnHandles = fnHandles|merge([f.handle]) -%}{%- endfor -%}
  {%- set fnRows = 'footnotes' in fnHandles ? (footnotesFor.footnotes ?? []) : [] -%}
  {%- set fnOn = 'footnotesOn' in fnHandles ? (footnotesFor.footnotesOn.one() ?? null) : null -%}
  {%- if fnRows|length -%}
    {%- set fnMode = 'here' -%}
  {%- elseif fnOn -%}
    {%- set fnMode = 'away' -%}
    {%- set fnHref = fnOn.url -%}
  {%- else -%}
    {%- set fnMode = 'orphan' -%}
  {%- endif -%}
{%- endif -%}

{%- set spans = [] -%}
{%- if linksFor is defined and linksFor -%}
  {%- set layer = source('_data/prose-links/' ~ linksFor ~ '.json', true) -%}
  {%- if layer|trim -%}{%- set spans = (layer|json_decode).spans ?? [] -%}{%- endif -%}
{%- endif -%}

{#- Rejoin the split footnote markers before anything is rendered. A line is
    rejoinable when it holds no letters at all, which keeps [image:N] out of it. -#}
{%- set TOKEN = '/^\\[image:\\d+\\]$/' -%}
{%- set lines = [] -%}
{%- set raw = [] -%}
{%- for p in text|trim|split("\n") -%}
  {%- if p|trim -%}{%- set raw = raw|merge([p|trim]) -%}{%- endif -%}
{%- endfor -%}
{%- set ENDS = '/[.!?:;\u0022\u201D\u2019)\u2014-]$/u' -%}
{%- set CONT = '/^[a-z,;:)]/u' -%}
{%- for i, l in raw -%}
  {%- set nxt = raw[i + 1] ?? '' -%}
  {%- set isTok = l matches TOKEN -%}
  {%- set afterTok = lines|length and (lines|last matches TOKEN) -%}
  {%- set letterless = l matches '/^[^\\p{L}]+$/u' -%}
  {%- set continues = l matches CONT -%}
  {%- set dangling = not (l matches ENDS) and (nxt matches CONT) -%}
  {%- set joinable = lines|length and not isTok and not afterTok
      and (letterless or continues or dangling) -%}
  {%- if joinable -%}
    {%- set glue = (letterless or l matches '/^[,;:)]/') ? '' : ' ' -%}
    {%- set lines = lines|slice(0, lines|length - 1)|merge([lines|last ~ glue ~ l]) -%}
  {%- else -%}
    {%- set lines = lines|merge([l]) -%}
  {%- endif -%}
{%- endfor -%}

{%- for p in lines -%}
  {%- set line = p|trim -%}
  {%- if line -%}
    {%- set token = line matches '/^\\[image:\\d+\\]$/' ? line|replace({'[image:': '', ']': ''}) : null -%}
    {%- set asset = token and imgs[token - 1] is defined ? imgs[token - 1] : null -%}
    {%- if asset -%}
      {#- Two reasons to take the whole column rather than float. A portrait
          taller than it is wide by a fifth, because the text beside it runs out
          long before the picture does. And a paragraph under about 260
          characters, because there is not enough of it to wrap. Where the
          dimensions are unknown the image floats, which is the common case. -#}
      {%- set nextPara = '' -%}
      {%- for j in 1..3 -%}
        {%- set cand = lines[loop.parent.loop.index0 + j] is defined ? lines[loop.parent.loop.index0 + j]|trim : '' -%}
        {%- if nextPara == '' and cand and not (cand matches '/^\[image:\d+\]$/') -%}
          {%- set nextPara = cand -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set tall = asset.height and asset.width and asset.height > asset.width * 1.2 -%}
      {%- set thin = nextPara == '' or nextPara|striptags|length < 260 -%}
      {#- A great many of the legacy images are 120px thumbnails standing in for
          a full scan that was never fetched. Neither 40% of the column nor the
          whole of it is a width one of those can carry, so nothing is ever
          drawn wider than the pixels it actually has. A small image stays
          floated whatever the paragraph does, because taking the column for a
          120px picture is the worst of both. -#}
      {%- set small = asset.width and asset.width < 300 -%}
      <figure class="rec-inline{{ (tall or thin) and not small ? ' full' : '' }}"
        {%- if asset.width %} style="max-width: {{ asset.width }}px{{ small ? '; width: ' ~ asset.width ~ 'px' : '' }}"{% endif %}>
        {#- The caption is photoCaptionExt, the field the asset carries for it,
            written from the legacy extraction by
            scripts/import/apply_extracted_captions.php.

            Where that is empty the title is tried, but a title is only a
            caption when someone set it. Craft names an untitled asset after its
            own file, so garcesbakersfield.jpg becomes "Garcesbakersfield", and
            a filename presented as a caption on an archive is worse than no
            caption at all. A title matching the filename once punctuation and
            case are removed is treated as absent and nothing is printed.

            The credit is photoCredit. It used to be read from alt, which was
            wrong even before the caption script began writing the caption into
            alt for the screen reader: alt and the credit are different things
            and the archive was printing one as the other. -#}
        {%- set stem = asset.filename|split('.')|slice(0, -1)|join('.') -%}
        {%- set norm = asset.title|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
        {%- set stemNorm = stem|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
        {%- set realTitle = (asset.title|trim and norm != stemNorm) ? asset.title|trim : '' -%}
        {%- set cap = asset.photoCaptionExt|default('')|trim ?: realTitle -%}
        {%- set credit = asset.photoCredit|default('')|trim -%}
        <button type="button" data-lightbox data-src="{{ asset.url }}"
                data-caption="{{ cap }}" data-credit="{{ credit }}"
                aria-label="{{ cap ? 'Open: ' ~ cap : 'Open the full image' }}">
          <img src="{{ asset.url }}" alt="{{ asset.alt ?: cap }}" loading="lazy">
        </button>
        {%- if cap or credit %}
        <figcaption>{{ cap }}{% if credit %}<span class="cr">{{ credit }}</span>{% endif %}</figcaption>
        {%- endif %}
      </figure>
    {%- elseif token -%}
      {# token points at an image that is not there; drop it rather than print it #}
    {%- else -%}
      {#- Spans are applied from the end of the paragraph backwards, so an
          earlier offset is still correct after a later one has been wrapped. -#}
      {%- set out = line -%}
      {%- if spans|length -%}
        {%- set pi = loop.index0 -%}
        {%- set mine = spans|filter(s => s.p == pi)|sort((a, b) => b.s <=> a.s) -%}
        {%- for s in mine -%}
          {%- if out|slice(s.s, s.n) == s.t -%}
            {%- set out = out|slice(0, s.s) ~ '<a href="' ~ s.u ~ '">' ~ s.t ~ '</a>' ~ out|slice(s.s + s.n) -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {#- Footnote markers. A marker is [N] with no word character before it and
          no digit after the bracket, because the extraction broke years across
          lines and "In December [18]54" is a date, not a note.

          There is no regex replace in this Twig, and a plain replace of every
          [N] would wrap that date. So the paragraph is cut on the opening
          bracket and put back together, which is the only way to look at what
          is on either side of the match. -#}
      {%- if fnMode != 'off' -%}
        {%- set chunks = out|split('[') -%}
        {%- set built = chunks|first -%}
        {%- for ch in chunks|slice(1) -%}
          {%- set num = ch|split(']')|first -%}
          {%- set ok = num matches '/^[0-9]{1,3}$/'
                       and ch|slice(num|length, 1) == ']'
                       and not (built|slice(-1) matches '/[A-Za-z0-9]/')
                       and not (ch|slice(num|length + 1, 1) matches '/[0-9]/') -%}
          {%- if ok -%}
            {%- set rest = ch|slice(num|length + 1) -%}
            {%- if fnMode == 'here' -%}
              {%- set mark = '<sup class="fn" id="fnref-' ~ num ~ '"><a href="#fn-' ~ num ~ '">' ~ num ~ '</a></sup>' -%}
            {%- elseif fnMode == 'away' -%}
              {%- set mark = '<sup class="fn"><a href="' ~ fnHref ~ '#fn-' ~ num ~ '">' ~ num ~ '</a></sup>' -%}
            {%- else -%}
              {%- set mark = '<sup class="fn" title="The note is not in the source">' ~ num ~ '</sup>' -%}
            {%- endif -%}
            {%- set built = built ~ mark ~ rest -%}
          {%- else -%}
            {%- set built = built ~ '[' ~ ch -%}
          {%- endif -%}
        {%- endfor -%}
        {%- set out = built -%}
      {%- endif -%}
      <p>{{ out|raw }}</p>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
