{% css %}
/* Shared page structure. A .scv-band is a full-width strip that carries a
   background colour; .scv-band-in is the centred column inside it. Sections
   add their own background and vertical padding on top of these. Never use a
   negative-margin bleed: it overflows the document horizontally. */
.scv-band{display:block;width:100%}
.scv-band-in{max-width:1240px;margin:0 auto;padding:0 40px}
{% endcss %}
{% css %}
.scv-doc{max-width:1180px;margin:0 auto;padding:0 24px}
.scv-crumbs{font-size:13px;color:#6b6560;padding:18px 0 6px}
.scv-crumbs a{color:#b8860b;text-decoration:none}
.scv-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:44px;padding:8px 0 70px;align-items:start}
@media(max-width:900px){.scv-grid{grid-template-columns:1fr}}
.scv-grid h1{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:44px;line-height:1.1;color:#b8860b;margin:6px 0 8px}
.scv-sub{font-family:'Cormorant Garamond',Georgia,serif;font-size:22px;color:#1a2744;margin:0 0 10px}
.scv-byline{font-size:15px;color:#3c3934;margin:0 0 12px}
.scv-era{color:#b8860b;font-weight:500;font-size:15px;margin:10px 0 6px}
.scv-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
.scv-chip{border:1px solid #b8860b;color:#b8860b;font-size:12px;padding:4px 10px;border-radius:2px;text-decoration:none}
.scv-chip.on{background:#1a2744;border-color:#1a2744;color:#fff}
.scv-chip.solid{border-color:#1a2744;color:#1a2744}
.scv-body{background:#fff;border:1px solid #e5ddcd;padding:30px 34px;border-radius:2px;font-size:17px;line-height:1.75}
.scv-body p{margin:0 0 20px}
.scv-body p:last-child{margin-bottom:0}
.scv-note{background:#f5e6c0;border-left:3px solid #b8860b;padding:12px 16px;margin:24px 0;font-size:15px}
.scv-side .scv-box{background:#fff;border:1px solid #e5ddcd;border-top:3px solid #b8860b;padding:16px 18px;margin-bottom:18px;border-radius:2px}
.scv-side h3{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#b8860b;margin:0 0 12px;font-weight:600}
.scv-side ul{list-style:none;margin:0;padding:0}
.scv-side li{padding:7px 0;border-bottom:1px solid #f0ebe0;font-size:15px}
.scv-side li:last-child{border-bottom:0}
.scv-side a{text-decoration:none;color:#1a2744}
.scv-side a:hover{color:#b8860b}
.scv-row{display:flex;justify-content:space-between;font-size:13px;color:#6b6560;padding:4px 0}
.scv-cite{font-size:13px;background:#faf6ef;border:1px solid #e5ddcd;padding:12px;line-height:1.5;word-break:break-word}
.scv-small{font-size:13px;color:#6b6560}
.scv-list{list-style:none;padding:0;margin:0}
.scv-list li{background:#fff;border:1px solid #e5ddcd;padding:14px 18px;margin-bottom:8px;border-radius:2px}
.scv-list a{text-decoration:none;font-weight:500;color:#1a2744}
.scv-list a:hover{color:#b8860b}
.scv-h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:26px;color:#1a2744;margin:34px 0 12px}
.scv-hero{margin:0 0 22px}
.scv-hero img{width:100%;height:auto;display:block;border:1px solid #e5ddcd}
.scv-hero figcaption{font-size:13px;color:#6b6560;padding-top:8px;font-style:italic}
.scv-pager{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:26px 0 0;padding:20px;background:#fff;border:1px solid #e5ddcd}
.scv-pager a{color:#1a2744;text-decoration:none;font-weight:500}
.scv-pager a:hover{color:#b8860b}
.scv-chapters{list-style:none;padding:0;margin:0;counter-reset:ch}
.scv-chapters li{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid #e5ddcd;padding:14px 18px;margin-bottom:8px}
.scv-chapters img{width:120px;height:auto;flex:0 0 120px;border:1px solid #e5ddcd}
.scv-chapters a{text-decoration:none;color:#1a2744;font-weight:500}
.scv-chapters a:hover{color:#b8860b}
{% endcss %}