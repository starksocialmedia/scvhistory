{#
  Shared design system for SCVHistory entry and index pages.

  Type:    Playfair Display (headings), Jost (labels and eyebrows), Public Sans (body)
  Palette: navy #17254C, gold #C4A031, deep gold #A9842B, cream #FDF7EA,
           page #F6F7F9, borders #E2E4E8 (grey) and #EFE6D0 (cream),
           body #2C2C2C, muted #5B6472, faint #8A919E

  Page shape: a cream .scv-hero band, an optional sticky .scv-filters bar, then
  .scv-main. Bands are full width and carry their own background; .scv-wrap is
  the centred column inside. Never use a negative-margin bleed.
#}
{% css %}
/* ── Full-width band and centred column ─────────────────────────── */
.scv-band{display:block;width:100%}
.scv-band-in{max-width:1240px;margin:0 auto;padding:0 40px}
.scv-wrap{max-width:1240px;margin:0 auto;padding:0 40px}

/* ── Page root ──────────────────────────────────────────────────── */
.scv-page{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}

/* ── Cream band ─────────────────────────────────────────────────── */
.scv-hero{background:#FDF7EA;border-bottom:1px solid #EFE6D0;color:#17254C}
.scv-hero .scv-wrap{padding-top:44px;padding-bottom:48px}
.scv-crumbs{font-size:13px;color:#5B6472;margin-bottom:22px}
.scv-crumbs a{color:#8F6E22;text-decoration:none}
.scv-crumbs a:hover{text-decoration:underline}
.scv-kicker{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;color:#8F6E22;margin-bottom:14px;text-transform:uppercase}
.scv-hero h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(34px,4.4vw,52px);line-height:1.06;margin:0 0 16px;color:#17254C}
.scv-lede{font-size:18px;line-height:1.65;margin:0;color:#4A5260;max-width:620px}
.scv-herogrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:end}
.scv-stat{display:flex;gap:40px;flex-wrap:wrap;justify-self:end}
.scv-stat b{display:block;font-family:'Playfair Display',serif;font-weight:500;font-size:44px;line-height:1;color:#17254C}
.scv-stat span{display:block;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.14em;color:#8F6E22;margin-top:8px;text-transform:uppercase}

/* Key facts inside the cream band */
.scv-facts{display:flex;flex-wrap:wrap;gap:8px 32px;margin:16px 0 0;font-size:15px;color:#2C2C2C;line-height:1.7}
.scv-facts b{font-family:'Jost',sans-serif;font-weight:500;font-size:12px;letter-spacing:.12em;color:#8F6E22;margin-right:6px;text-transform:uppercase}
.scv-aka{font-size:16px;color:#5B6472;margin:0 0 12px;font-style:italic}

/* ── Chips ──────────────────────────────────────────────────────── */
.scv-chips{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0}
.scv-chip{background:#fff;border:1px solid #C4A031;color:#8F6E22;font-family:'Jost',sans-serif;font-size:12.5px;padding:6px 12px;border-radius:3px;text-decoration:none;display:inline-block}
.scv-chip:hover{background:#FDF7EA}
.scv-chip.on{background:#17254C;color:#fff;border-color:#17254C}
.scv-chip.solid{border-color:#17254C;color:#17254C}

/* ── Sticky filter bar ──────────────────────────────────────────── */
.scv-filters{background:#fff;border-bottom:1px solid #E2E4E8;position:sticky;top:0;z-index:500}
.scv-filters .scv-wrap{padding-top:16px;padding-bottom:16px;display:flex;align-items:center;gap:12px 10px;flex-wrap:wrap}
.scv-lab{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#5B6472;margin-right:4px;text-transform:uppercase}
.scv-count{margin-left:auto;font-size:14px;color:#5B6472}

/* ── Main column ────────────────────────────────────────────────── */
.scv-main .scv-wrap{padding-top:40px;padding-bottom:96px}
.scv-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:48px;align-items:start}
@media(max-width:900px){.scv-layout{grid-template-columns:1fr}}

/* ── Hero image below the band ──────────────────────────────────── */
.scv-figure{margin:0 0 28px}
.scv-figure img{width:100%;height:auto;display:block;border:1px solid #E2E4E8;background:#fff}
.scv-figure figcaption{font-size:13px;color:#5B6472;padding-top:8px;line-height:1.5}

/* ── Body card ──────────────────────────────────────────────────── */
.scv-card{background:#fff;border:1px solid #E2E4E8;padding:32px 36px;font-size:17px;line-height:1.75;color:#2C2C2C}
.scv-card p{margin:0 0 20px}
.scv-card p:last-child{margin-bottom:0}
.scv-card a{color:#8F6E22}
.scv-note{background:#FDF7EA;border-left:3px solid #C4A031;padding:12px 16px;margin:22px 0 0;font-size:15px;line-height:1.6}
.scv-fine{font-size:13px;color:#5B6472;margin:22px 0 0;line-height:1.6}
.scv-h2{font-family:'Playfair Display',serif;font-weight:500;font-size:28px;color:#17254C;margin:40px 0 14px}
.scv-sub{font-family:'Playfair Display',serif;font-weight:400;font-size:21px;color:#17254C;margin:0 0 14px;line-height:1.35}

/* ── Sidebar boxes ──────────────────────────────────────────────── */
.scv-side{min-width:0}
.scv-box{background:#fff;border:1px solid #E2E4E8;border-top:3px solid #C4A031;padding:18px 20px;margin-bottom:18px}
.scv-box h3{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#8F6E22;margin:0 0 12px;font-weight:500}
.scv-box ul{list-style:none;margin:0;padding:0}
.scv-box li{padding:8px 0;border-bottom:1px solid #F0F1F4;font-size:15px}
.scv-box li:last-child{border-bottom:0}
.scv-box a{color:#17254C;text-decoration:none;font-weight:500}
.scv-box a:hover{color:#8F6E22}
.scv-itemsub{display:block;font-size:13px;color:#5B6472;margin-top:2px;font-weight:400}
.scv-boxlab{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.12em;color:#5B6472;margin:12px 0 2px;text-transform:uppercase}
.scv-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;color:#5B6472;padding:4px 0}
.scv-row span:last-child{color:#2C2C2C;text-align:right}
.scv-cite{font-size:13px;background:#FDF7EA;border:1px solid #EFE6D0;padding:12px;line-height:1.55;word-break:break-word;color:#2C2C2C}

/* ── Related list with 44px thumbnails ──────────────────────────── */
.scv-rel{display:flex;gap:12px;align-items:flex-start}
.scv-thumb{width:44px;height:44px;flex:0 0 44px;object-fit:cover;display:block;border:1px solid #E2E4E8;background:#fff}
.scv-thumb--ph{background:#FDF7EA;border:1px solid #EFE6D0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:17px;color:#C4A031;line-height:1}
.scv-reltext{min-width:0;padding-top:1px}

/* ── Location box ───────────────────────────────────────────────── */
.scv-map{height:200px;background:#EEF0F4;margin:-18px -20px 12px;width:calc(100% + 40px)}

/* ── Index card grid ────────────────────────────────────────────── */
.scv-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px}
.scv-cards--wide{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
.scv-tile{display:flex;flex-direction:column;background:#fff;border:1px solid #E2E4E8;color:inherit;min-width:0;text-decoration:none}
.scv-tile:hover{border-color:#C4A031}
.scv-ph{aspect-ratio:3/4;overflow:hidden;border-bottom:1px solid #EFE6D0;background:#FDF7EA;display:flex;align-items:center;justify-content:center}
.scv-ph--square{aspect-ratio:1/1}
.scv-ph img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
.scv-ph span{font-family:'Playfair Display',serif;font-size:40px;color:#C4A031}
.scv-tilebody{padding:16px 16px 18px;display:flex;flex-direction:column;gap:6px;flex:1}
.scv-tilebody h3{font-family:'Playfair Display',serif;font-weight:500;font-size:19px;line-height:1.2;color:#17254C;margin:0}
.scv-tilemeta{font-size:13px;line-height:1.5;color:#5B6472}
.scv-tilefoot{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.1em;color:#5B6472;margin-top:auto;padding-top:6px;text-transform:uppercase}
.scv-empty{text-align:center;padding:64px 0;color:#5B6472;font-size:16px}
.scv-empty a{color:#8F6E22}

/* ── Plain list rows (used where cards would be noise) ──────────── */
.scv-rows{list-style:none;padding:0;margin:0;background:#fff;border:1px solid #E2E4E8}
.scv-rows li{border-bottom:1px solid #E2E4E8}
.scv-rows li:last-child{border-bottom:0}
.scv-rows a{display:flex;gap:16px;align-items:baseline;padding:14px 20px;text-decoration:none;color:inherit}
.scv-rows a:hover{background:#FDF7EA}
.scv-rows .t{font-family:'Playfair Display',serif;font-size:18px;color:#17254C}
.scv-rows .m{font-size:13px;color:#5B6472;margin-top:3px}

/* ── Previous / next pager ──────────────────────────────────────── */
.scv-pager{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:28px 0 0;padding:20px;background:#fff;border:1px solid #E2E4E8}
.scv-pager a{color:#17254C;text-decoration:none;font-weight:500}
.scv-pager a:hover{color:#8F6E22}
.scv-pager .l{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.12em;color:#5B6472;text-transform:uppercase;display:block;margin-bottom:4px}
{% endcss %}
