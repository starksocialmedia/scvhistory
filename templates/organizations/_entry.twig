{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
  {#- The map may come from a place this organization is tied to: a firm's
      coordinates are where its works stood, and they live on the place record,
      one fact in one home. Computed here as well because head renders first. -#}
  {% set headMapPlace = (entry.orgLat and entry.orgLng) ? null : (craft.entries().section('places')
      .relatedTo({ targetElement: entry, field: 'placeOrganizations' }).districtKind(':empty:').placeLat(':notempty:').placeLng(':notempty:').one() ?? null) %}
  {#- A government whose territory is drawn in communities.geojson shows that
      outline, not only a pin. Keyed by the record's slug to the feature's slug. -#}
  {% set ORG_BOUNDARIES = { 'city-of-santa-clarita': 'santa-clarita' } %}
  {% if (entry.orgLat and entry.orgLng) or headMapPlace or ORG_BOUNDARIES[entry.slug] is defined %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">{% endif %}
  {% css %}.rec-map{height:220px;background:#EEF0F4;margin:-18px -20px 14px;width:calc(100% + 40px)}
  .rec-band--fit{--rec-band-floor:0px}
  .rec-alias .sep{font-style:normal;color:#A9842B;margin:0 .2em}
  .rec-mark img{display:block;width:100%;height:auto;max-height:220px;object-fit:contain;background:#fff;padding:14px;border:1px solid #EFE6D0}
  .rec-mark p{font-size:13px;line-height:1.55;color:#5B6472;margin:10px 0 0}
  .rec-side .sc-map{margin-bottom:0!important;padding:0!important;border:0!important;background:none!important}
  /* The hub's tabs: sticky under the header like every filter bar (base.twig), one pane shown at a time once the script runs;
     with no script, or in print, every pane shows with its heading. */
  .hub-tabs{background:#fff;border:1px solid #E2E4E8;margin:0 0 18px}
  .hub-tabs-in{display:flex;gap:4px;overflow-x:auto;padding:0 6px}
  .hub-tabs a{font-family:'Jost',sans-serif;font-size:14px;letter-spacing:.06em;color:#4A5260;text-decoration:none;padding:10px 14px;border-bottom:3px solid transparent;white-space:nowrap}
  .hub-tabs a[aria-selected="true"]{color:#17254C;border-bottom-color:#C4A031;font-weight:500}
  .hub-pane-h{font-family:'Playfair Display',serif;font-weight:500;font-size:30px;color:#17254C;margin:6px 0 14px}
  .js-tabs .hub-pane{display:none}
  .js-tabs .hub-pane.on{display:block}
  .js-tabs .hub-pane-h{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .hub-pane{margin-bottom:28px}
  .hub-pane .rec-h2.hub-h:first-of-type{margin-top:22px}
  .hub-boxes{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;margin-top:10px}
  @media print{.hub-tabs{display:none}.js-tabs .hub-pane{display:block!important}}{% endcss %}
  {% js %}
  (function(){
    var panes = document.querySelector('.hub-panes'); var tabs = document.querySelector('.hub-tabs'); if (!panes || !tabs) { return; }
    document.documentElement.classList.add('js-tabs');
    function open(id, scroll){
      var pane = document.getElementById('t-' + id); if (!pane) { return; }
      panes.querySelectorAll('.hub-pane').forEach(function(p){ p.classList.toggle('on', p === pane); });
      tabs.querySelectorAll('[data-tab]').forEach(function(a){ a.setAttribute('aria-selected', a.getAttribute('data-tab') === id ? 'true' : 'false'); });
      document.dispatchEvent(new CustomEvent('scv:tab', { detail: { tab: id } }));
      if (scroll) { tabs.scrollIntoView({ block: 'start' }); }
    }
    /* A link to anything inside a pane (a footnote, #past-members, #board) opens that pane first. */
    function fromHash(scroll){
      var h = location.hash.slice(1); if (!h) { open('main'); return; }
      if (h.indexOf('t-') === 0) { open(h.slice(2), scroll); return; }
      var t = document.getElementById(h); var p = t ? t.closest('.hub-pane') : null;
      if (p) { open(p.getAttribute('data-pane')); setTimeout(function(){ t.scrollIntoView(); }, 20); } else { open('main'); }
    }
    tabs.addEventListener('click', function(e){ var a = e.target.closest('[data-tab]'); if (!a) { return; } e.preventDefault(); history.replaceState(null, '', location.pathname + location.search + '#t-' + a.getAttribute('data-tab')); open(a.getAttribute('data-tab'), true); });
    document.addEventListener('click', function(e){ var a = e.target.closest('[data-tab-link]'); if (!a) { return; } e.preventDefault(); history.replaceState(null, '', location.pathname + location.search + a.getAttribute('href')); fromHash(false); });
    window.addEventListener('hashchange', function(){ fromHash(false); });
    fromHash(false);
  })();
  {% endjs %}
{% endblock %}

{% block content %}
{% import "_partials/record/portrait" as portrait %}

{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}
{% set F = {} %}
{% for h in ['body','orgFinePrint','dateFounded','orgAliases','orgAddress','orgLegacyUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{# bandImage first: artwork with no lettering, composed with its subject at the
   right. featuredImage is only a fallback, and where it is a title card it may
   show lettering. The field-layout check is the only reliable test: a custom
   field reads as defined on an element whose type does not have it. #}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}
{% endfor %}
{% set bandImg = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}
{% set img = bandImg ?? ('featuredImage' in (entry.fieldLayout ? entry.fieldLayout.customFields|map(f => f.handle) : []) ? entry.featuredImage.one() ?? null : null) %}
{% set img = img ?? (recImages|length ? recImages|first : null) %}
{% set era = entry.historicalEra.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set periods = entry.historicalPeriod.all() %}
{#- A body's seats are places too, but they are listed by the seat control, not here. -#}
{% set orgPlaces = craft.entries().section('places').relatedTo({ targetElement: entry, field: 'placeOrganizations' }).districtKind(':empty:').orderBy('title asc').all() %}
{% set mapPlace = (entry.orgLat and entry.orgLng) ? null : (orgPlaces|filter(p => p.placeLat and p.placeLng)|first ?: null) %}
{% set mapLat = mapPlace ? mapPlace.placeLat : entry.orgLat %}
{% set mapLng = mapPlace ? mapPlace.placeLng : entry.orgLng %}
{% set mapTitle = mapPlace ? mapPlace.title : entry.title %}
{% set ORG_BOUNDARIES = { 'city-of-santa-clarita': 'santa-clarita' } %}
{% set boundarySlug = ORG_BOUNDARIES[entry.slug] ?? null %}
{% set hasMap = (mapLat and mapLng) or boundarySlug %}
{% set parent = entry.parentOrganization.one() ?? null %}
{% set subjectArticles = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'subjectOrganization' }).orderBy('title asc').all() %}
{#- Documents as well as articles: a school's yearbooks are documents it published. -#}
{% set publishedArticles = craft.entries().section(['articles', 'documents']).relatedTo({ targetElement: entry, field: 'publishedBy' }).orderBy('title asc').all() %}
{#- Schools. gradeSpan and feedsInto arrive with add_school_structure.php and are
    read off the layout, never with `is defined`. -#}
{% set orgHandles = entry.fieldLayout.customFields|map(f => f.handle) %}
{% set isDistrict = 'schoolLevel' in orgHandles and entry.schoolLevel.value == 'district' %}
{% set gradeSpan = 'gradeSpan' in orgHandles ? entry.gradeSpan|trim : '' %}
{% set feedsTo = 'feedsInto' in orgHandles ? entry.feedsInto.all() : [] %}
{% set feedsFrom = 'feedsInto' in orgHandles ? craft.entries().section('organizations').relatedTo({ targetElement: entry, field: 'feedsInto' }).orderBy('title asc').all() : [] %}
{#- termNotes was retired with the board fields: a term belongs in an
    officeHolding record, not in a paragraph on the body. -#}
{% set prose = F.body %}
{#- The body hub (_partials/civic/body-hub): any body with office holdings or
    seats. Its seats are the place records tied to it that carry a districtKind. -#}
{% set seats = craft.entries().section('places').relatedTo({ targetElement: entry, field: 'placeOrganizations' }).districtKind(':notempty:').orderBy('districtNumber asc, title asc').all() %}
{% set seatIds = seats|map(s => s.id) %}
{#- The chief executive shows in the sidebar (_partials/civic/body-executive), so the hub's lower list of people leaves them out. -#}
{#- The executive's title, by kind of body: a district's superintendent; SCV Water's general manager. A body not listed has no executive box yet. -#}
{% set EXEC = isDistrict ? { title: 'Superintendent', label: 'SUPERINTENDENT' } : ({ 'santa-clarita-valley-water': { title: 'General Manager', label: 'GENERAL MANAGER' } }[entry.slug] ?? null) %}
{% set execIds = EXEC ? craft.entries().section('affiliations').relatedTo({ targetElement: entry, field: 'affiliationBody' }).affiliationTitle(EXEC.title).all()|map(a => a.affiliationPerson.one().id ?? 0) : [] %}
{% set hasHub = seats|length or craft.entries().section('officeHoldings').relatedTo({ targetElement: entry, field: 'holdingBody' }).exists() %}
{#- The council's roster partial draws the City's board and its history; the
    other bodies get the hub's own board and past members. -#}
{% set ROSTER = { 'city-of-santa-clarita': 5 } %}
{#- Where the district map sits (Nathan, 4 October 2026: "the body should lead
    with what the district is and who runs it; the map is reference"). In the
    sidebar unless the body's slug is listed here, which puts it large in the
    body; for when the map carries the seat boundaries. -#}
{% set MAP_IN_BODY = [] %}
{% set districtMap = isDistrict and entry.ncesId|trim %}
{% set mapInBody = districtMap and entry.slug in MAP_IN_BODY %}
{#- The body's current mark: in the sidebar with its rights note (Nathan, 4
    October 2026: "a proper identifying image with its rights note under it"),
    no longer small beside the title. -#}
{% set mark = 'currentMark' in orgHandles ? (entry.currentMark.one() ?? null) : null %}
{#- Aliases are stored one per line (a few older records list several on one line with commas, which read as written). -#}
{% set aliases = [] %}
{% for a in F.orgAliases|replace({ "\r": '' })|split("\n") %}{% if a|trim and a|trim not in aliases %}{% set aliases = aliases|merge([a|trim]) %}{% endif %}{% endfor %}

{#- What the archive holds about the body: its sub-bodies, schools, places, events, articles, documents, tags. In the sidebar,
    or on a hub page in the "In the archive" tab (Nathan, 4 October 2026). -#}
{% set archiveBoxes %}
        {#- Sub-bodies were entry.subBoards, the inverse of parentOrganization kept
            in a second place. Read the nesting instead: one fact, one home. -#}
        {% set subBodies = craft.entries().section('organizations')
            .relatedTo({ targetElement: entry, field: 'parentOrganization' }).all() %}
        {% set boxes = [
          { lab: 'PARENT ORGANIZATION', key: 'PARENT', rows: parent ? [parent] : [] },
          { lab: isDistrict ? 'SCHOOLS' : 'BOARDS AND SUBSIDIARIES', key: isDistrict ? 'SCHOOL' : 'BOARD', rows: subBodies },
          { lab: 'PUPILS GO ON TO', key: 'SCHOOL', rows: feedsTo },
          { lab: 'TAKES PUPILS FROM', key: 'SCHOOL', rows: feedsFrom },
          { lab: 'PLACES', key: 'PLACE', rows: orgPlaces },
          { lab: 'EVENTS', key: 'EVENT', rows: entry.orgEvents.all() },
          { lab: 'ARTICLES', key: 'ARTICLE', rows: subjectArticles },
          { lab: 'PUBLISHED BY THIS ORGANIZATION', key: 'ARTICLE', rows: publishedArticles }
        ]|filter(b => b.rows|length) %}
        {% for b in boxes %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            <div class="rec-rows">{% for r in b.rows %}<div class="k">{{ b.key }}</div><div class="v"><a href="{{ r.url }}">{{ r.title ?: r.slug }}</a></div>{% endfor %}</div>
          </div>
        {% endfor %}

        {% if communities|length %}
          <div class="rec-box"><div class="rec-lab">COMMUNITIES</div>
            <div class="rec-rows">{% for c in communities %}<div class="k">AREA</div><div class="v"><a href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% include "_partials/record/documents" with { docs: recDocs } only %}

        {% include "_partials/record/tags" with { el: entry } only %}
{% endset %}

<div class="rec">
  <section class="rec-band{{ img ? '' : ' rec-band--fit' }}">
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('organizations') }}">Organizations</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-head{{ img ? '' : ' rec-head--noart' }}">
        <div>
          <div class="rec-kick"><span class="a">ORGANIZATIONS</span>{% if era %}<span class="sep"></span><span class="b">{{ era.title|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title ?: entry.slug }}</h1>
          {% if aliases|length %}<div class="rec-sub rec-alias">Also known as {% for a in aliases %}{% if not loop.first %}<span class="sep"> · </span>{% endif %}<span>{{ a }}</span>{% endfor %}</div>{% endif %}
          {#- The chain of bodies (Nathan, 2 October 2026): what a body became and what it was formed from, read from both ends, so SCV Water
              lists Newhall County Water District though only the district's record carries the link. -#}
          {% set dissolved = 'dateDissolved' in orgHandles ? entry.dateDissolved|trim : '' %}
          {% set became = 'succeededBy' in orgHandles ? entry.succeededBy.all() : [] %}
          {% set becameIds = became|map(o => o.id) %}
          {% for o in craft.entries().section('organizations').relatedTo({ targetElement: entry, field: 'precededBy' }).all() %}{% if o.id not in becameIds %}{% set became = became|merge([o]) %}{% set becameIds = becameIds|merge([o.id]) %}{% endif %}{% endfor %}
          {% set formedFrom = 'precededBy' in orgHandles ? entry.precededBy.all() : [] %}
          {% set fromIds = formedFrom|map(o => o.id) %}
          {% for o in craft.entries().section('organizations').relatedTo({ targetElement: entry, field: 'succeededBy' }).all() %}{% if o.id not in fromIds %}{% set formedFrom = formedFrom|merge([o]) %}{% set fromIds = fromIds|merge([o.id]) %}{% endif %}{% endfor %}
          {% if F.dateFounded or F.orgAddress or dissolved or became|length or formedFrom|length or gradeSpan or seats|length > 1 %}
            <div class="rec-facts">
              {% if F.dateFounded %}<div><div class="l">FOUNDED</div><div class="v">{{ F.dateFounded }}{% if 'foundedEvidence' in orgHandles %}{% include "_partials/record/evidence" with { ev: entry.foundedEvidence } only %}{% endif %}</div></div>{% endif %}
              {% if dissolved %}<div><div class="l">DISSOLVED</div><div class="v">{{ dissolved }}</div></div>{% endif %}
              {% if formedFrom|length %}<div><div class="l">FORMED FROM</div><div class="v">{% for o in formedFrom|sort((x, y) => x.title <=> y.title) %}<a href="{{ o.url }}">{{ o.title }}</a>{%- if not loop.last %}; {% endif -%}{% endfor %}</div></div>{% endif %}
              {% if became|length %}<div><div class="l">BECAME</div><div class="v">{% for o in became %}<a href="{{ o.url }}">{{ o.title }}</a>{%- if not loop.last %}; {% endif -%}{% endfor %}</div></div>{% endif %}
              {% if gradeSpan %}<div><div class="l">GRADES</div><div class="v">{{ gradeSpan }}</div></div>{% endif %}
              {% if seats|length > 1 %}<div><div class="l">SEATS</div><div class="v">{{ seats|length }} {{ (seats|first).districtKind.label|lower }}s</div></div>{% endif %}
              {% if F.orgAddress %}<div><div class="l">ADDRESS</div><div class="v">{{ F.orgAddress }}</div></div>{% endif %}
            </div>
          {% endif %}
          {% if periods|length or communities|length %}
            <div class="rec-chips">
              {% for p in periods %}<span class="rec-chip">{{ p.title }}</span>{% endfor %}
              {% for c in communities %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
            </div>
          {% endif %}
        </div>
        {% if img %}<div class="rec-portrait"><img src="{{ img.url }}" alt="{{ img.alt ?: entry.title }}"></div>{% endif %}
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: prose, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}
        {#- The archive's own notes (editorNotes), which this page did not render before 2 October 2026: corrections and readers' notes were saved but not shown. -#}
        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'top' } only %}
        {% if hasHub %}
          {#- The body hub in tabs (inventory/review/body-hub-tabs-proposal-2026-10-04.md, approved by Nathan 4 October 2026):
              the body, History, Schools (districts), Elections, In the archive. Every pane is in the page; scripts show one at a
              time, and with scripts off or in print all show in order. The seat control sits above the panes and filters all
              of them. The lead paragraph is on the first tab, the rest of the text under History. -#}
          {% set scope = 'hub' ~ entry.id %}
          {% set isCity = ROSTER[entry.slug] is defined %}
          {% set leadText = prose ? (prose|split("\n\n")|first) : '' %}
          {% set restText = prose ? (prose|split("\n\n")|slice(1)|join("\n\n")) : '' %}
          {% set firstLabel = isDistrict ? 'The district' : (isCity ? 'The city' : 'The body') %}
          {% set TABS = [{ id: 'main', label: firstLabel }, { id: 'history', label: 'History' }]|merge(districtMap ? [{ id: 'schools', label: 'Schools' }] : [])|merge([{ id: 'elections', label: 'Elections' }, { id: 'archive', label: 'In the archive' }]) %}
          {#- The seat control is a filter on the whole page, so it sits above the tab bar and applies to whichever tab is open
              (Nathan, 4 October 2026). It filters inside the panes (scope). -#}
          {% include "_partials/civic/body-hub" with { part: 'control', body: entry, seats: seats, scope: scope } only %}
          <nav class="hub-tabs" aria-label="Sections of this page"><div class="hub-tabs-in" role="tablist">{% for t in TABS %}<a role="tab" href="#t-{{ t.id }}" data-tab="{{ t.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ t.label }}</a>{% endfor %}</div></nav>
          <div id="{{ scope }}" class="hub-panes">
            <section class="hub-pane" id="t-main" data-pane="main">
              <h2 class="hub-pane-h">{{ firstLabel }}</h2>
              {% if leadText %}<div class="rec-body" id="recText">{% include "_partials/prose" with { text: leadText, images: [], footnotesFor: entry } %}</div>{% endif %}
              {% include "_partials/civic/body-map" with { body: entry, leaid: districtMap ? entry.ncesId|trim : null, height: 460, pin: (mapLat and mapLng) ? { lat: mapLat, lng: mapLng, title: mapTitle, address: mapPlace ? '' : F.orgAddress } : null } only %}
              {% if isCity %}{% include "_partials/civic/roster" with { body: entry, seats: ROSTER[entry.slug], part: 'today' } only %}{% else %}{% include "_partials/civic/body-hub" with { part: 'board', body: entry, seats: seats } only %}{% endif %}
            </section>
            <section class="hub-pane" id="t-history" data-pane="history">
              <h2 class="hub-pane-h">History</h2>
              {% if restText %}<div class="rec-body">{% include "_partials/prose" with { text: restText, images: recImages, footnotesFor: entry } %}</div>{% endif %}
              {% if prose %}{% include "_partials/record/footnotes" with { entry: entry } only %}{% endif %}
              {% include "_partials/record/images" with { images: recImages, body: prose, entry: entry } only %}
              {% if isCity %}{% include "_partials/civic/roster" with { body: entry, seats: ROSTER[entry.slug], part: 'history' } only %}{% else %}
                {% include "_partials/civic/terms-timeline" with { body: entry } only %}
                {% include "_partials/civic/body-hub" with { part: 'past', body: entry, seats: seats } only %}
              {% endif %}
              {% if EXEC %}{% include "_partials/civic/body-executive" with { body: entry, title: EXEC.title, label: EXEC.label, as: 'section' } only %}{% endif %}
              {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'inline' } only %}
              {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'bottom' } only %}
            </section>
            {% if districtMap %}
            <section class="hub-pane" id="t-schools" data-pane="schools">
              <h2 class="hub-pane-h">Schools</h2>
              {% include "_partials/district-schools" with { leaid: entry.ncesId|trim } only %}
            </section>
            {% endif %}
            <section class="hub-pane" id="t-elections" data-pane="elections">
              <h2 class="hub-pane-h">Elections</h2>
              {% include "_partials/civic/body-hub" with { part: 'elections', body: entry, seats: seats } only %}
            </section>
            <section class="hub-pane" id="t-archive" data-pane="archive">
              <h2 class="hub-pane-h">In the archive</h2>
              {% include "_partials/civic/body-hub" with { part: 'people', body: entry, seats: seats, exclude: execIds } only %}
              <div class="hub-boxes">{{ archiveBoxes }}</div>
            </section>
          </div>
          {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
          {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}
          {% include "_partials/record/fine-print" with { value: F.orgFinePrint } only %}
        {% else %}
        {% if prose %}<div class="rec-body" id="recText">{% include "_partials/prose" with { text: prose, images: recImages , footnotesFor: entry } %}</div>
{% include "_partials/record/footnotes" with { entry: entry } only %}{% endif %}
        {% include "_partials/record/images" with { images: recImages, body: prose, entry: entry } only %}
        {#- A body with seats gets its roster: every member, every term, from the
            officeHolding records (STRUCTURE.md, the council roster). -#}
        {#- A district's page carries its map and every school in it, not only the
            ones the archive holds (Nathan, 29 September 2026). -#}
        {% if districtMap %}
          {% if mapInBody %}<h2 class="rec-h2">The district</h2>{% include "_partials/school-map" with { leaid: entry.ncesId|trim, height: 420 } %}{% endif %}
          {% include "_partials/district-schools" with { leaid: entry.ncesId|trim } only %}
        {% endif %}
        {% if 'orgType' in orgHandles and entry.orgType.value == 'school' %}{% include "_partials/record/education" with { entry: entry, as: 'school', place: 'body' } only %}{% endif %}
        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'inline' } only %}
        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'bottom' } only %}
        {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}
        {% include "_partials/record/fine-print" with { value: F.orgFinePrint } only %}
        {% endif %}
      </article>

      <aside class="rec-side">
        {% if mark %}
          {% set markHost = (mark.sourceUrl ?? '')|replace({'https://': '', 'http://': '', 'www.': ''})|split('/')|first %}
          <div class="rec-box rec-mark"><div class="rec-lab">{{ isDistrict ? 'THE DISTRICT\'S LOGO' : 'LOGO' }}</div>
            <img src="{{ mark.url }}" alt="{{ mark.alt ?: mark.title }}" width="{{ mark.width }}" height="{{ mark.height }}">
            {#- One line (Nathan, 4 October 2026): the rights reasoning stays in the asset's rightsNote, for a researcher, not on the page. -#}
            <p>{{ isDistrict ? 'The district\'s' : 'Its' }} logo, from {% if mark.sourceUrl %}<a href="{{ mark.sourceUrl }}" rel="noopener">{{ markHost }}</a>{% else %}its website{% endif %}{% if mark.acquiredDate %}, retrieved {{ mark.acquiredDate|date('j F Y') }}{% endif %}.</p>
          </div>
        {% endif %}
        {% if EXEC %}{% include "_partials/civic/body-executive" with { body: entry, title: EXEC.title, label: EXEC.label, as: 'box' } only %}{% endif %}
        {% if districtMap and not mapInBody and not hasHub %}
          <div class="rec-box"><div class="rec-lab">THE DISTRICT</div>
            {% include "_partials/school-map" with { leaid: entry.ncesId|trim, height: 300 } %}
            {% if seats|length > 1 %}<p style="font-size:13px;line-height:1.55;color:#5B6472;margin:8px 0 0">The {{ (seats|first).districtKind.label|lower }} boundaries are not drawn.</p>{% endif %}
          </div>
        {% endif %}
        {% include "_partials/record/cite" with { entry: entry, label: 'Organizations', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
        {% include "_partials/record/named-for" with { el: entry } only %}
        {% include "_partials/record/photo-topics" with { el: entry } only %}
        {% if 'orgType' in orgHandles and entry.orgType.value == 'school' %}{% include "_partials/record/school-facts" with { entry: entry } only %}{% endif %}
        {% if gradeSpan %}
          <div class="rec-box"><div class="rec-lab">{{ isDistrict ? 'SCHOOL DISTRICT' : 'SCHOOL' }}</div>
            <div class="rec-rows"><div class="k">GRADES</div><div class="v">{{ gradeSpan }}</div>{% if isDistrict %}<div class="k">ALL</div><div class="v"><a href="{{ url('schools') }}">Schools of the valley</a></div>{% endif %}</div>
          </div>
        {% endif %}
        {% if hasMap and not hasHub %}
          <div class="rec-box">
            <div class="rec-lab">LOCATION</div>
            <div id="recMap" class="rec-map" role="img" aria-label="Map showing the location of {{ mapTitle }}"></div>
            <p class="scv-sr">The coordinates for this location are listed beside the map.</p>
            {% if mapPlace %}<div class="rec-rows"><div class="k">PLACE</div><div class="v"><a href="{{ mapPlace.url }}">{{ mapPlace.title }}</a></div></div>{% endif %}
            {% set loc = [['FOUNDED', F.dateFounded], ['ADDRESS', mapPlace ? '' : F.orgAddress], ['LAT', mapLat], ['LNG', mapLng]]|filter(r => r[1]) %}
            <div class="rec-rows">{% for r in loc %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}</div>
          </div>
        {% endif %}

        {#- Board members were entry.boardMembers, a relation with no dates, so it
            could not say when anybody served. They are now the holders of offices
            in this body, read from their term records. A comment belongs out here:
            one inside the array literal below is a syntax error, not a comment. -#}
        {% set holders = craft.entries().section('officeHoldings')
            .relatedTo({ targetElement: entry, field: 'holdingBody' }).all()
            |map(h => h.holdingPerson.one())|filter(p => p) %}
        {#- One row per person, however many terms; and none where the roster
            above already lists them. -#}
        {% set seen = [] %}{% set uniq = [] %}
        {% for p in holders %}{% if p.id not in seen %}{% set seen = seen|merge([p.id]) %}{% set uniq = uniq|merge([p]) %}{% endif %}{% endfor %}
        {% set holders = hasHub ? [] : uniq %}
        {% set peopleBoxes = [
          { lab: 'FOUNDED BY', rows: hasHub ? [] : entry.orgFoundedBy.all() },
          { lab: 'ASSOCIATED PEOPLE', rows: hasHub ? [] : entry.orgAssociatedPersons.all() },
          { lab: 'BOARD MEMBERS', rows: holders }
        ]|filter(b => b.rows|length) %}
        {% for b in peopleBoxes %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            {% for p in b.rows %}
              {% set pimg = 'featuredImage' in (p.fieldLayout ? p.fieldLayout.customFields|map(f => f.handle) : []) ? p.featuredImage.one() ?? null : null %}
              {% set pp = p.title|split(' ')|filter(x => x|trim) %}
              <a class="rec-person" href="{{ p.url }}">
                <div class="th">{% if pimg %}{{ portrait.img(pimg, 1, '', true) }}{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : p.title|slice(0,1))|upper }}{% endif %}</div>
                <div style="min-width:0"><div class="n">{{ p.title }}</div>{% if p.occupation is defined and p.occupation %}<div class="r">{{ p.occupation }}</div>{% endif %}</div>
              </a>
            {% endfor %}
          </div>
        {% endfor %}

        {#- The archive's boxes: in the sidebar, or on a hub page in its "In the archive" tab (built above the page as archiveBoxes). -#}
        {% if not hasHub %}{{ archiveBoxes }}{% endif %}

        {% set links = [] %}
        {% if entry.orgWebsite is defined and entry.orgWebsite %}{% set links = links|merge([{u: entry.orgWebsite, t: 'Official website'}]) %}{% endif %}
        {% if entry.orgWikipediaUrl is defined and entry.orgWikipediaUrl %}{% set links = links|merge([{u: entry.orgWikipediaUrl, t: 'Wikipedia'}]) %}{% endif %}
        {% set legacy = F.orgLegacyUrl ?: F.legacyUrl %}
        {# The legacy link moved to the top of the sidebar, in record/source-link.twig.
           A reader comparing our version with Leon's was having to scroll past the
           whole sidebar to reach it. It is not repeated here. #}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>

{#- A hub page draws its map in its first tab (_partials/civic/body-map), which loads Leaflet itself; a second copy of Leaflet
    froze the City's page (4 October 2026). -#}
{% if hasMap and not hasHub %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function(){
  var el = document.getElementById('recMap');
  if (!el || typeof L === 'undefined') { return; }
  var map = L.map(el, { scrollWheelZoom: false });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors', maxZoom: 18 }).addTo(map);
  {% if mapLat and mapLng %}
  map.setView([{{ mapLat }}, {{ mapLng }}], 15);
  L.marker([{{ mapLat }}, {{ mapLng }}]).addTo(map)
    .bindPopup({{ ('<b>' ~ mapTitle ~ '</b>' ~ (mapPlace ? '' : F.orgAddress))|json_encode|raw }});
  {% endif %}
  {% if boundarySlug %}
  {#- Versioned like the index map, so a changed boundary is never drawn from cache. -#}
  {% set geoVersion = (source('_data/community-neighbors.json', ignore_missing = true)|hash)|slice(0, 12) %}
  fetch({{ (siteUrl ~ 'data/communities.geojson?v=' ~ geoVersion)|json_encode|raw }})
    .then(function (r) { return r.json(); })
    .then(function (g) {
      var f = (g.features || []).filter(function (x) { return x.properties && x.properties.slug === {{ boundarySlug|json_encode|raw }}; })[0];
      if (!f) { return; }
      var layer = L.geoJSON(f, { style: { color: '#17254C', weight: 2, fillColor: '#C4A031', fillOpacity: 0.12 } }).addTo(map);
      map.fitBounds(layer.getBounds(), { padding: [8, 8] });
    });
  {% endif %}
});
</script>
{% endif %}
{% endblock %}
