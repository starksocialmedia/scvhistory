{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/scv-extra-css" %}
  {% if entry.orgLat and entry.orgLng %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">{% endif %}
{% endblock %}

{% block content %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
{% set parent = entry.parentOrganization.one() ?? null %}
{% set subjectArticles = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'subjectOrganization' }).status(null).all() %}
{% set publishedArticles = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'publishedBy' }).status(null).all() %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('organizations') }}">Organizations</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">Organization</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if entry.orgAliases %}<p class="scv-aka">Also known as {{ entry.orgAliases }}</p>{% endif %}
      {% if entry.dateFounded or entry.orgAddress %}
        <div class="scv-facts">
          {% if entry.dateFounded %}<div><b>Founded</b>{{ entry.dateFounded }}</div>{% endif %}
          {% if entry.orgAddress %}<div><b>Address</b>{{ entry.orgAddress }}</div>{% endif %}
        </div>
      {% endif %}
      {% if era or entry.historicalPeriod.all()|length or communities|length %}
        <div class="scv-chips">
          {% if era %}<span class="scv-chip">{{ era.title }}</span>{% endif %}
          {% for p in entry.historicalPeriod.all() %}<span class="scv-chip">{{ p.title }}</span>{% endfor %}
          {% for c in communities %}<a class="scv-chip solid" href="{{ url('organizations', { community: c.slug }) }}">{{ c.title }}</a>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}">
            {% if hero.title and hero.title != entry.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}</figure>
          {% endif %}

          {% if entry.body or entry.termNotes or entry.orgFinePrint or entry.culturalSensitivityNote %}
            <article class="scv-card">
              {% if entry.body %}{% include "_partials/prose" with { text: entry.body } %}{% endif %}
              {% if entry.termNotes %}{% include "_partials/prose" with { text: entry.termNotes } %}{% endif %}
              {% if entry.culturalSensitivityNote %}<div class="scv-note">{{ entry.culturalSensitivityNote }}</div>{% endif %}
              {% if entry.orgFinePrint %}<p class="scv-fine">{{ entry.orgFinePrint }}</p>{% endif %}
            </article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/meta" with { entry: entry } only %}
          {% include "_partials/sidebar/cite" with { entry: entry } only %}

          {% include "_partials/sidebar/location" with {
            lat: entry.orgLat, lng: entry.orgLng, title: entry.title,
            address: entry.orgAddress, established: entry.dateFounded,
            zoom: 15, mapId: 'scv-org-map'
          } only %}

          {% include "_partials/sidebar/related-list" with { title: 'Founded by', entries: entry.orgFoundedBy.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Associated people', entries: entry.orgAssociatedPersons.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Board members', entries: entry.boardMembers.all() } only %}
          {% if parent %}
            {% include "_partials/sidebar/related-list" with { title: 'Parent organization', entries: [parent] } only %}
          {% endif %}
          {% include "_partials/sidebar/related-list" with { title: 'Boards and subsidiaries', entries: entry.subBoards.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Events', entries: entry.orgEvents.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles', entries: subjectArticles } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Published by this organization', entries: publishedArticles } only %}

          {% if communities|length %}
            {% embed "_partials/sidebar/box" with { title: 'Communities', communities: communities } only %}
              {% block body %}<ul>{% for c in communities %}<li>{{ c.title }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/external" with {
            website: entry.orgWebsite ?? null,
            wikipedia: entry.orgWikipediaUrl ?? null,
            legacy: entry.orgLegacyUrl ?: entry.legacyUrl
          } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
