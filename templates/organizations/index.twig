{% extends "_layouts/base" %}
{% set metaDescription = 'Companies, agencies, missions, ranchos, newspapers and the institutions that governed, employed and published in the Santa Clarita Valley.' %}
{% block head %}

{% endblock %}

{% block content %}
{#- One template, two pages (Nathan, 4 October 2026: "a civic page under CIVIC holds the bodies that govern or represent").
    /bodies lists the public bodies: the valley's own government, the school districts, and the county, state and federal
    bodies. /organizations lists the rest: businesses, nonprofits, missions and churches, ranchos, newspapers, clubs. Schools
    have their own page. A body's place comes from its data (orgType, orgLevel, schoolLevel), not from this template. -#}
{% set bodiesMode = (craft.app.request.segments|first) in ['civic', 'bodies'] %}
{% set comSlug = craft.app.request.getParam('community') %}
{% set kind = craft.app.request.getParam('kind') %}
{% set level = craft.app.request.getParam('level') %}
{% set all = craft.entries().section('organizations').orderBy('title asc').all() %}

{#- orgType and schoolLevel are added by scripts/import/add_org_taxonomy_fields.php
    and may not be on the layout yet. The handles are read off the layout rather
    than asked for with `is defined`, which answers true on a type that lacks
    the field and then throws when the value is read. -#}
{% set handles = all|length ? all[0].fieldLayout.customFields|map(f => f.handle) : [] %}
{% set hasKinds = 'orgType' in handles %}
{% set hasLevels = 'schoolLevel' in handles %}

{% set KINDS = {
  school:     'Schools',
  government: 'Government',
  business:   'Businesses',
  nonprofit:  'Nonprofits',
  church:     'Churches',
  club:       'Clubs',
  media:      'Newspapers',
  military:   'Military',
  rancho:     'Ranchos',
  other:      'Other'
} %}
{% set KIND_ONE = {
  school: 'School', government: 'Government body', business: 'Business',
  nonprofit: 'Nonprofit', church: 'Church', club: 'Club',
  media: 'Newspaper', military: 'Military', rancho: 'Rancho', other: 'Other'
} %}
{% set LEVELS = {
  elementary: 'Elementary', middle: 'Middle', high: 'High',
  college: 'College', district: 'Districts'
} %}

{% set query = craft.entries().section('organizations').orderBy('title asc') %}
{% if comSlug %}{% set term = craft.categories().group('neighborhood').slug(comSlug).one() %}{% if term %}{% set query = query.relatedTo(term) %}{% endif %}{% endif %}
{% if hasKinds and kind and KINDS[kind] is defined %}{% set query = query.orgType(kind) %}{% endif %}
{#- The level only narrows within schools, so it is ignored unless schools are
    the kind on screen. A level chip on its own would filter to schools without
    saying it had. -#}
{% if hasLevels and kind == 'school' and level and LEVELS[level] is defined %}{% set query = query.schoolLevel(level) %}{% endif %}
{% set places = query.all() %}
{#- Each page holds its own kinds: /bodies the government bodies and the school districts; /organizations everything but those and the schools. -#}
{#- A dissolved body goes where its successor is, to be shown in the successor's card (the Valencia Water Company, a business, sits under SCV Water). -#}
{% set civicIds = [] %}
{% for o in places %}{% if (o.orgType.value ?? '') == 'government' or ((o.orgType.value ?? '') == 'school' and (o.schoolLevel.value ?? '') == 'district') %}{% set civicIds = civicIds|merge([o.id]) %}{% endif %}{% endfor %}
{% set succOf = {} %}
{% for o in places %}{% set sc = 'succeededBy' in (o.fieldLayout ? o.fieldLayout.customFields|map(f => f.handle) : []) and o.dateDissolvedEdtf|default('') ? o.succeededBy.one() : null %}{% if sc %}{% set succOf = succOf|merge({ ('o' ~ o.id): sc.id }) %}{% endif %}{% endfor %}
{% set places = places|filter(o => bodiesMode == (o.id in civicIds or (succOf['o' ~ o.id] ?? 0) in civicIds))|filter(o => bodiesMode or (o.orgType.value ?? '') != 'school') %}
{#- A body of another body (the Planning Commission of the City) is not its peer (Nathan, 1 October 2026): it is folded into its
    parent's card when the parent is on the page, and listed at the top level only when it is not. -#}
{% set onPage = places|map(p => p.id) %}
{% set childrenOf = {} %}
{% set formedOf = {} %}
{% set tops = [] %}
{% for p in places %}
  {% set par = 'parentOrganization' in (p.fieldLayout ? p.fieldLayout.customFields|map(f => f.handle) : []) ? p.parentOrganization.one() : null %}
  {#- Schools keep their own cards under their district's kind: only governing sub-bodies fold. -#}
  {#- A dissolved body that has a successor on the page is shown in the successor's card, "Formed from", not as an entry of its
      own (Nathan, 4 October 2026: "They are dissolved bodies and belong under SCV Water as predecessors"). -#}
  {% set succ = 'succeededBy' in (p.fieldLayout ? p.fieldLayout.customFields|map(f => f.handle) : []) and p.dateDissolvedEdtf|default('') ? p.succeededBy.one() : null %}
  {% if succ and succ.id in onPage %}
    {% set formedOf = formedOf|merge({ ('o' ~ succ.id): (formedOf['o' ~ succ.id] ?? [])|merge([p]) }) %}
  {#- A body is folded into its parent's card only at the parent's level: the SCV Sheriff's Station (the valley's) stands in Valley
      government though it belongs to the County's Sheriff's Department (Nathan, 4 October 2026). -#}
  {% elseif par and par.id in onPage and p.orgType.value != 'school' and ((p.orgLevel.value ?? '') == '' or (p.orgLevel.value ?? '') == (par.orgLevel.value ?? '')) %}
    {% set childrenOf = childrenOf|merge({ ('o' ~ par.id): (childrenOf['o' ~ par.id] ?? [])|merge([p]) }) %}
  {% else %}
    {% set tops = tops|merge([p]) %}
  {% endif %}
{% endfor %}
{% set places = tops %}

{% set kindCounts = {} %}
{% set levelCounts = {} %}
{% if hasKinds %}
  {% for p in all %}
    {% set k = p.orgType.value ?: 'unset' %}
    {% set kindCounts = kindCounts|merge({ (k): (kindCounts[k] ?? 0) + 1 }) %}
    {% if hasLevels and k == 'school' %}
      {% set lv = p.schoolLevel.value ?: 'unset' %}
      {% set levelCounts = levelCounts|merge({ (lv): (levelCounts[lv] ?? 0) + 1 }) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set comIds = [] %}
{% set earliest = null %}
{% for p in all %}
  {% for c in p.neighborhood.all() %}{% if c.id not in comIds %}{% set comIds = comIds|merge([c.id]) %}{% endif %}{% endfor %}
  {% set y = p.dateFounded ? p.dateFounded|slice(-4) : '' %}
  {% if y matches '/^\\d{4}$/' and (earliest is null or y < earliest) %}{% set earliest = y %}{% endif %}
{% endfor %}

{% set pins = [] %}
{% for p in places %}
  {% if p.orgLat and p.orgLng %}
    {% set coms = p.neighborhood.all()|map(c => c.title)|join(', ') %}
    {% set pins = pins|merge([{ id: p.id, t: p.title, c: coms, e: p.dateFounded ?: '', lat: p.orgLat, lng: p.orgLng, u: p.url }]) %}
  {% endif %}
{% endfor %}

<div class="pl">
  <section class="pl-hero">
    <div class="pl-wrap">
      <div class="pl-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>{{ bodiesMode ? 'Civic' : 'Organizations' }}</span></div>
      <div class="pl-grid">
        <div>
          {% if bodiesMode %}
          <div class="pl-kicker">THE PUBLIC RECORD</div>
          <h1>Civic</h1>
          <p>The bodies that govern the valley or represent it: the county, state and federal bodies seated elsewhere, the valley's own city and water agency, and its school districts. Then the <a href="{{ url('elections') }}" style="color:#7A5C1B">elections</a> that fill them, the <a href="{{ url('districts') }}" style="color:#7A5C1B">districts</a> they are elected from, and the <a href="{{ url('schools') }}" style="color:#7A5C1B">schools</a>.</p>
          {% else %}
          <div class="pl-kicker">INSTITUTIONS &amp; ENTERPRISES</div>
          <h1>Organizations</h1>
          <p>Companies, nonprofits, missions and churches, ranchos, newspapers and clubs in the valley's history. The bodies that govern the valley are on <a href="{{ url('civic') }}" style="color:#7A5C1B">Civic</a>, and its schools on <a href="{{ url('schools') }}" style="color:#7A5C1B">Schools</a>.</p>
          {% endif %}
        </div>
        <div class="pl-stat">
          <div><b>{{ all|length }}</b><span>ORGANIZATIONS</span></div>
          <div><b>{{ comIds|length }}</b><span>COMMUNITIES</span></div>
          {% if earliest %}<div><b>{{ earliest }}</b><span>EARLIEST ESTABLISHED</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-filters">
    <div class="pl-wrap">
      {% set keep = {} %}
      {% if kind %}{% set keep = keep|merge({kind: kind}) %}{% endif %}
      {% if kind == 'school' and level %}{% set keep = keep|merge({level: level}) %}{% endif %}

      <div class="pl-lab">COMMUNITY</div>
      <a class="pl-chip {{ not comSlug ? 'on' : '' }}" href="{{ url('organizations', keep) }}">All communities</a>
      {% for c in craft.categories().group('neighborhood').orderBy('title asc').all() %}
        {% set n = craft.entries().section('organizations').relatedTo(c).count() %}
        {% if n %}<a class="pl-chip {{ comSlug == c.slug ? 'on' : '' }}" href="{{ url('organizations', keep|merge({community: c.slug})) }}">{{ c.title }} ({{ n }})</a>{% endif %}
      {% endfor %}

      <div class="pl-count">{{ bodiesMode ? places|length ~ ' public bodies' : (comSlug or kind or level ? places|length ~ ' of ' ~ all|length : all|length) ~ ' organizations' }}</div>
    </div>
  </section>

  <main class="pl-main">
    <div class="pl-wrap">
      {#- /civic has no map (Nathan, 4 October 2026: "a map does not help a reader find one"; each body's own page carries its map). -#}
      {% include "_partials/map-index" with {
        pins: pins,
        mapLabel: 'Map of organizations in the Santa Clarita Valley, with community boundaries',
        polygonsUrl: siteUrl ~ 'data/communities.geojson',
        outlineUrl: url('organizations'),
        activeSlug: comSlug,
        hint: 'Select an organization below to locate it, or a pin to jump to its card.',
        fitAllLabel: 'Fit all organizations',
        showFitValley: true,
        initialValley: true,
        noMap: bodiesMode
      } only %}

      {#- Grouped by kind, not filtered (Nathan, 29 September 2026): 35 records fit
          on a screen, and sections show everything the archive holds at once.
          Each record is in exactly one section, because orgType holds one value;
          school districts and schools are separate because a district governs and
          a school teaches. Past about 60 records this becomes chips on the same
          groups (STRUCTURE.md). -#}
      {#- Government in two groups by the body's level (orgLevel; Nathan, 4 October 2026: "the grouping is a property of the
          body"): the valley's own bodies, and the county, state and federal bodies that govern or represent it from
          elsewhere. A body nested in another's card (the City's commissions, the County's Board of Supervisors and Sheriff's
          Department, the House under Congress) is listed inside that card. -#}
      {% set ALLGROUPS = [
        { key: 'government', label: 'Valley government', note: 'School districts are governing bodies too; they are listed under School districts.' },
        { key: 'beyond',     label: 'County, state and federal', note: 'The larger jurisdictions came first and still contain the rest. The County governed this valley for more than a century before the City existed, and it still governs most of the valley by area: everything outside the City.' },
        { key: 'districts',  label: 'School districts' },
        { key: 'schools',    label: 'Schools and colleges' },
        { key: 'business',   label: 'Businesses' },
        { key: 'nonprofit',  label: 'Nonprofits' },
        { key: 'church',     label: 'Missions and churches' },
        { key: 'rancho',     label: 'Ranchos' },
        { key: 'media',      label: 'Newspapers' },
        { key: 'club',       label: 'Clubs and associations' },
        { key: 'other',      label: 'Other' }
      ] %}
      {% set CIVIC = ['government', 'beyond', 'districts'] %}
      {#- On /civic the larger jurisdictions come first (Nathan, 4 October 2026): they came first and still contain the rest. -#}
      {% set CIVIC_ORDER = { beyond: 1, government: 2, districts: 3 } %}
      {% set GROUPS = bodiesMode ? ALLGROUPS|filter(g => g.key in CIVIC)|sort((a, b) => CIVIC_ORDER[a.key] <=> CIVIC_ORDER[b.key]) : ALLGROUPS|filter(g => g.key not in CIVIC and g.key != 'schools') %}
      {#- Order within the public bodies (Nathan, 4 October 2026): the City first as the valley's own government; Hart first of the
          districts because it covers all the others; Congress, Senate, Assembly, then the County. Anything not named follows by title. -#}
      {% set ORDER = ['city-of-santa-clarita', 'santa-clarita-valley-water', 'william-s-hart-union-high-school-district', 'newhall-school-district', 'saugus-union-school-district', 'sulphur-springs-union-school-district', 'castaic-union-school-district', 'united-states-congress', 'california-state-senate', 'california-state-assembly', 'county-of-los-angeles'] %}
      {% set ORD_IDX = {} %}{% for s in ORDER %}{% set ORD_IDX = ORD_IDX|merge({ (s): loop.index0 }) %}{% endfor %}
      {% set groupOf = {} %}
      {% for p in places %}
        {% set t = hasKinds ? (p.orgType.value ?: 'other') : 'other' %}
        {% set lvl = 'orgLevel' in handles ? (p.orgLevel.value ?? '') : '' %}
        {% set g = t == 'school' ? (hasLevels and p.schoolLevel.value == 'district' ? 'districts' : 'schools') : (t == 'government' and lvl in ['county', 'state', 'federal'] ? 'beyond' : (t in ['government', 'business', 'nonprofit', 'church', 'rancho', 'media', 'club'] ? t : 'other')) %}
        {% set groupOf = groupOf|merge({ (g): (groupOf[g] ?? [])|merge([p]) }) %}
      {% endfor %}
      {% if places|length %}
      {% for grp in GROUPS %}{% if groupOf[grp.key] is defined %}
      <h2 class="pl-group" id="{{ grp.key }}">{{ grp.label }} <span>{{ groupOf[grp.key]|length }}</span></h2>
      {% if grp.note is defined %}<p class="pl-groupnote">{{ grp.note }}</p>{% endif %}
      <div class="pl-cards">
        {% for p in groupOf[grp.key]|sort((a, b) => (ORD_IDX[a.slug] ?? 99) <=> (ORD_IDX[b.slug] ?? 99) ?: a.title <=> b.title) %}
          {% set ph = p.fieldLayout ? p.fieldLayout.customFields|map(f => f.handle) : [] %}
          {% set img = 'featuredImage' in ph ? p.featuredImage.one() ?? null : null %}
          {#- A body with no picture shows its current mark, whole, as identification (the record page carries its source and rights note). -#}
          {% set mk = not img and 'currentMark' in ph ? p.currentMark.one() ?? null : null %}
          {% set coms = p.neighborhood.all()|map(c => c.title)|join(' · ') %}
          <a class="pl-card" id="card{{ p.id }}" data-id="{{ p.id }}" href="{{ p.url }}">
            <div class="pl-ph">{% if img %}<img src="{{ img.url }}" alt="">{% elseif mk %}<span class="pl-mark">{% include "_partials/record/mark-img" with { mark: mk, cap: 400 } only %}</span>{% else %}<span>{{ p.title|slice(0,1) }}</span>{% endif %}</div>
            <div class="pl-body">
              <h3>{{ p.title }}</h3>
              {% if p.dateFounded %}<div class="pl-meta">Est. {{ p.dateFounded }}</div>{% endif %}
              <div class="pl-comm">{{ coms }}{% if hasKinds and p.orgType.value %}{{ coms ? ' · ' : '' }}{{ KIND_ONE[p.orgType.value] ?? p.orgType.value }}{% if hasLevels and p.orgType.value == 'school' and p.schoolLevel.value %}, {{ LEVELS[p.schoolLevel.value]|lower }}{% endif %}{% endif %}</div>
              {% if childrenOf['o' ~ p.id] is defined %}<div class="pl-meta" style="margin-top:6px">Includes {{ childrenOf['o' ~ p.id]|map(c => c.title)|join(', ') }}</div>{% endif %}
              {% if formedOf['o' ~ p.id] is defined %}<div class="pl-meta" style="margin-top:6px">Formed from {{ formedOf['o' ~ p.id]|map(c => c.title)|join(', ') }}</div>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
      {% endif %}{% endfor %}
      {% else %}
        <div class="pl-empty">No organizations in this community yet. <a href="{{ url('organizations') }}" style="color:#7A5C1B">Show all</a></div>
      {% endif %}
    </div>
  </main>
</div>

{% endblock %}
