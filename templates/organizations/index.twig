{% extends "_layouts/base" %}
{% set metaDescription = 'Companies, agencies, missions, ranchos, newspapers and the institutions that governed, employed and published in the Santa Clarita Valley.' %}
{% block head %}

{% endblock %}

{% block content %}
{% set comSlug = craft.app.request.getParam('community') %}
{% set kind = craft.app.request.getParam('kind') %}
{% set level = craft.app.request.getParam('level') %}
{% set all = craft.entries().section('organizations').status(null).orderBy('title asc').all() %}

{#- orgType and schoolLevel are added by scripts/import/add_org_taxonomy_fields.php
    and may not be on the layout yet. The handles are read off the layout rather
    than asked for with `is defined`, which answers true on a type that lacks
    the field and then throws when the value is read. -#}
{% set handles = all|length ? all[0].fieldLayout.customFields|map(f => f.handle) : [] %}
{% set hasKinds = 'orgType' in handles %}
{% set hasLevels = 'schoolLevel' in handles %}

{% set KINDS = {
  school:     'Schools',
  government: 'Government',
  business:   'Businesses',
  nonprofit:  'Nonprofits',
  church:     'Churches',
  club:       'Clubs',
  media:      'Newspapers',
  military:   'Military',
  other:      'Other'
} %}
{% set KIND_ONE = {
  school: 'School', government: 'Government body', business: 'Business',
  nonprofit: 'Nonprofit', church: 'Church', club: 'Club',
  media: 'Newspaper', military: 'Military', other: 'Other'
} %}
{% set LEVELS = {
  elementary: 'Elementary', middle: 'Middle', high: 'High',
  college: 'College', district: 'Districts'
} %}

{% set query = craft.entries().section('organizations').status(null).orderBy('title asc') %}
{% if comSlug %}{% set term = craft.categories().group('neighborhood').slug(comSlug).status(null).one() %}{% if term %}{% set query = query.relatedTo(term) %}{% endif %}{% endif %}
{% if hasKinds and kind and KINDS[kind] is defined %}{% set query = query.orgType(kind) %}{% endif %}
{#- The level only narrows within schools, so it is ignored unless schools are
    the kind on screen. A level chip on its own would filter to schools without
    saying it had. -#}
{% if hasLevels and kind == 'school' and level and LEVELS[level] is defined %}{% set query = query.schoolLevel(level) %}{% endif %}
{% set places = query.all() %}

{% set kindCounts = {} %}
{% set levelCounts = {} %}
{% if hasKinds %}
  {% for p in all %}
    {% set k = p.orgType.value ?: 'unset' %}
    {% set kindCounts = kindCounts|merge({ (k): (kindCounts[k] ?? 0) + 1 }) %}
    {% if hasLevels and k == 'school' %}
      {% set lv = p.schoolLevel.value ?: 'unset' %}
      {% set levelCounts = levelCounts|merge({ (lv): (levelCounts[lv] ?? 0) + 1 }) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set comIds = [] %}
{% set earliest = null %}
{% for p in all %}
  {% for c in p.neighborhood.all() %}{% if c.id not in comIds %}{% set comIds = comIds|merge([c.id]) %}{% endif %}{% endfor %}
  {% set y = p.dateFounded ? p.dateFounded|slice(-4) : '' %}
  {% if y matches '/^\\d{4}$/' and (earliest is null or y < earliest) %}{% set earliest = y %}{% endif %}
{% endfor %}

{% set pins = [] %}
{% for p in places %}
  {% if p.orgLat and p.orgLng %}
    {% set coms = p.neighborhood.all()|map(c => c.title)|join(', ') %}
    {% set pins = pins|merge([{ id: p.id, t: p.title, c: coms, e: p.dateFounded ?: '', lat: p.orgLat, lng: p.orgLng, u: p.url }]) %}
  {% endif %}
{% endfor %}

<div class="pl">
  <section class="pl-hero">
    <div class="pl-wrap">
      <div class="pl-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Organizations</span></div>
      <div class="pl-grid">
        <div>
          <div class="pl-kicker">INSTITUTIONS &amp; ENTERPRISES</div>
          <h1>Organizations</h1>
          <p>Bodies that act in the valley's history: companies, agencies, missions, ranchos, newspapers, and the institutions that governed, employed, and published.</p>
        </div>
        <div class="pl-stat">
          <div><b>{{ all|length }}</b><span>ORGANIZATIONS</span></div>
          <div><b>{{ comIds|length }}</b><span>COMMUNITIES</span></div>
          {% if earliest %}<div><b>{{ earliest }}</b><span>EARLIEST ESTABLISHED</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-filters">
    <div class="pl-wrap">
      {% set keep = {} %}
      {% if kind %}{% set keep = keep|merge({kind: kind}) %}{% endif %}
      {% if kind == 'school' and level %}{% set keep = keep|merge({level: level}) %}{% endif %}

      <div class="pl-lab">COMMUNITY</div>
      <a class="pl-chip {{ not comSlug ? 'on' : '' }}" href="{{ url('organizations', keep) }}">All communities</a>
      {% for c in craft.categories().group('neighborhood').status(null).orderBy('title asc').all() %}
        {% set n = craft.entries().section('organizations').relatedTo(c).status(null).count() %}
        {% if n %}<a class="pl-chip {{ comSlug == c.slug ? 'on' : '' }}" href="{{ url('organizations', keep|merge({community: c.slug})) }}">{{ c.title }} ({{ n }})</a>{% endif %}
      {% endfor %}

      {% if hasKinds %}
        {% set keepCom = comSlug ? {community: comSlug} : {} %}
        <div class="pl-lab" style="margin-top:14px">KIND</div>
        <a class="pl-chip {{ not kind ? 'on' : '' }}" href="{{ url('organizations', keepCom) }}">All kinds</a>
        {% for k, label in KINDS %}
          {% set n = kindCounts[k] ?? 0 %}
          {% if n %}<a class="pl-chip {{ kind == k ? 'on' : '' }}" href="{{ url('organizations', keepCom|merge({kind: k})) }}">{{ label }} ({{ n }})</a>{% endif %}
        {% endfor %}

        {#- The level row appears only when schools are the kind on screen,
            because a level means nothing beside a newspaper. -#}
        {% if hasLevels and kind == 'school' %}
          <div class="pl-lab" style="margin-top:14px">LEVEL</div>
          <a class="pl-chip {{ not level ? 'on' : '' }}" href="{{ url('organizations', keepCom|merge({kind: 'school'})) }}">All levels</a>
          {% for lv, label in LEVELS %}
            {% set n = levelCounts[lv] ?? 0 %}
            {% if n %}<a class="pl-chip {{ level == lv ? 'on' : '' }}" href="{{ url('organizations', keepCom|merge({kind: 'school', level: lv})) }}">{{ label }} ({{ n }})</a>{% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}

      <div class="pl-count">{{ comSlug or kind or level ? places|length ~ ' of ' ~ all|length : all|length }} organizations</div>
    </div>
  </section>

  <main class="pl-main">
    <div class="pl-wrap">
      {% include "_partials/map-index" with {
        pins: pins,
        mapLabel: 'Map of organizations in the Santa Clarita Valley, with community boundaries',
        polygonsUrl: siteUrl ~ 'data/communities.geojson',
        outlineUrl: url('organizations'),
        activeSlug: comSlug,
        hint: 'Select an organization below to locate it, or a pin to jump to its card.',
        fitAllLabel: 'Fit all organizations',
        showFitValley: true,
        initialValley: true
      } only %}

      {% if places|length %}
      <div class="pl-cards">
        {% for p in places %}
          {% set img = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
          {% set coms = p.neighborhood.all()|map(c => c.title)|join(' · ') %}
          <a class="pl-card" id="card{{ p.id }}" data-id="{{ p.id }}" href="{{ p.url }}">
            <div class="pl-ph">{% if img %}<img src="{{ img.url }}" alt="">{% else %}<span>{{ p.title|slice(0,1) }}</span>{% endif %}</div>
            <div class="pl-body">
              <h3>{{ p.title }}</h3>
              {% if p.dateFounded %}<div class="pl-meta">Est. {{ p.dateFounded }}</div>{% endif %}
              <div class="pl-comm">{{ coms ?: 'Beyond the valley' }}{% if hasKinds and p.orgType.value %} &middot; {{ KIND_ONE[p.orgType.value] ?? p.orgType.value }}{% if hasLevels and p.orgType.value == 'school' and p.schoolLevel.value %}, {{ LEVELS[p.schoolLevel.value]|lower }}{% endif %}{% endif %}</div>
            </div>
          </a>
        {% endfor %}
      </div>
      {% else %}
        <div class="pl-empty">No organizations in this community yet. <a href="{{ url('organizations') }}" style="color:#7A5C1B">Show all</a></div>
      {% endif %}
    </div>
  </main>
</div>

{% endblock %}
