{% extends "_layouts/base" %}
{% block title %}Organizations | SCVHistory.com{% endblock %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}
{% block content %}
{% set activeHood = craft.app.request.getParam('neighborhood') %}
{% set query = craft.entries().section('organizations').status(null).orderBy('title asc') %}
{% if activeHood %}
  {% set hoodCat = craft.categories().group('neighborhood').slug(activeHood).status(null).one() %}
  {% if hoodCat %}{% set query = query.relatedTo(hoodCat) %}{% endif %}
{% endif %}
{% set orgs = query.all() %}
<div class="scv-doc">
  <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; Organizations</div>
  <div style="padding:10px 0 60px">
    <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:44px;color:#b8860b;margin:6px 0 8px">Organizations</h1>
    <p style="max-width:660px;color:#3c3934">Bodies that act in the valley's history: companies, agencies, missions, ranchos, newspapers, and the institutions that governed, employed, and published.</p>
    <div class="scv-chips" style="margin-top:22px">
      <a class="scv-chip {{ not activeHood ? 'on' : '' }}" href="{{ url('organizations') }}">All communities</a>
      {% for hood in craft.categories().group('neighborhood').status(null).orderBy('title asc').all() %}
        {% set n = craft.entries().section('organizations').relatedTo(hood).status(null).count() %}
        {% if n %}<a class="scv-chip {{ activeHood == hood.slug ? 'on' : '' }}" href="{{ url('organizations', { neighborhood: hood.slug }) }}">{{ hood.title }} ({{ n }})</a>{% endif %}
      {% endfor %}
    </div>
    <p class="scv-small">{{ orgs|length }} organization{{ orgs|length == 1 ? '' : 's' }}</p>
    {% if orgs|length %}
      <ul class="scv-list">
        {% for org in orgs %}
          {% set hoods = org.neighborhood.all() %}
          <li>
            <a href="{{ org.url }}">{{ org.title ?: org.slug }}</a>
            <div class="scv-small">
              {% if org.dateFounded %}Est. {{ org.dateFounded }}{% endif %}
              {% if org.dateFounded and hoods|length %} &middot; {% endif %}
              {% for h in hoods %}{{ h.title }}{% if not loop.last %}, {% endif %}{% endfor %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="scv-small">No organizations match this filter.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
