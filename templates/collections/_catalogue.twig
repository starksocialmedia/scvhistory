{#
  A catalogue: discrete numbered items rather than a body of prose.

  From design/collection-catalogue-source.html. The one member in the corpus is
  the Old Town Newhall Gazette, thirty numbered issues of a periodical, so the
  controls are a sort and a filter rather than a reading order.

  Sorting by identifier is the run as published. Sorting by date is the same
  thing only while the numbering is unbroken, and differs wherever an issue was
  skipped, doubled or reissued, which is why both exist rather than one.

  A tile with no picture falls back to its identifier. The archive holds the
  text of these issues and not their covers, and an empty frame says "broken"
  where a number says "this is issue 1403".
#}
{% set F = {} %}
{% for h in ['body','legacyUrl','sourceLine','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set editor = entry.editedBy.one() ?? null %}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}{% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}{% endfor %}
{% set bandImg = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}

{% set items = entry.articlesInCollection.all()
   ?: craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'partOfCollection' }).status(null).all() %}

{#- The identifier is the legacy key's trailing digits: gazette1403-editorial
    is issue 1403. Read rather than invented, and blank where there is none. -#}
{% set rows = [] %}
{% for i in items %}
  {% set key = (i.legacyKey is defined ? i.legacyKey : '')|trim %}
  {% set digits = '' %}
  {% for n in 0..(key|length - 4) %}
    {% if digits == '' and key|slice(n, 4) matches '/^[0-9]{4}$/' %}{% set digits = key|slice(n, 4) %}{% endif %}
  {% endfor %}
  {% set img = (i.featuredImage is defined and i.featuredImage) ? i.featuredImage.one() ?? null : null %}
  {% set img = img ?? ((i.recordImages is defined and i.recordImages and i.recordImages.one()) ? i.recordImages.one() : null) %}
  {% set rows = rows|merge([{
    e: i, id: digits,
    date: (i.originalPublishDate is defined and i.originalPublishDate) ? i.originalPublishDate|trim : '',
    img: img }]) %}
{% endfor %}
{% set rows = rows|sort((a, b) => b.id <=> a.id) %}

{% css %}
.cg-bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;border-bottom:1px solid #E2E4E8;padding-bottom:12px;margin-bottom:20px}
.cg-bar .lab{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.14em;color:#5B6472}
.cg-bar button,.cg-bar select{font-family:'Jost',sans-serif;font-size:13px;padding:5px 10px;border:1px solid #DCC98F;background:#fff;color:#7A5C1B;cursor:pointer}
.cg-bar button.on{background:#C4A031;color:#17254C;font-weight:500}
.cg-bar .sp{flex:1}
.cg-bar .count{font-family:'Jost',sans-serif;font-size:12px;color:#8A919E}
.cg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:22px 18px}
.cg-item{margin:0;min-width:0}
.cg-item .sh{position:relative;background:#fff;border:1px solid #E2E4E8;padding:7px}
.cg-item .sh:hover{border-color:#C4A031}
.cg-item img{width:100%;height:auto;display:block;max-height:220px;object-fit:contain;object-position:top}
.cg-item .ph{width:100%;aspect-ratio:4/5;background:#FDF7EA;display:flex;align-items:center;justify-content:center;
             font-family:'Playfair Display',serif;font-size:28px;color:#C4A031}
.cg-item figcaption{margin-top:9px}
.cg-id{display:inline-block;font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#7E6118;border:1px solid #C4A031;padding:2px 6px;margin-bottom:5px}
.cg-t{display:block;font-family:'Playfair Display',serif;font-size:15px;line-height:1.3;color:#17254C;text-decoration:none}
a.cg-t:hover{color:#7A5C1B;text-decoration:underline}
.cg-d{display:block;font-size:12.5px;color:#5B6472;margin-top:3px}
{% endcss %}

<div class="rec cg">
  <section class="rec-band{{ bandImg ? ' rec-band--art' : '' }}">
    {% if bandImg %}
      <div class="rec-bandart" style="background-image:url('{{ bandImg.url }}')" role="presentation"></div>
      <div class="rec-bandfade" role="presentation"></div>
    {% endif %}
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('collections') }}">Collections</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-bandcol">
        <div class="rec-kick">
          <span class="a">COLLECTION</span><span class="r"></span>
          <span class="b">CATALOGUE</span><span class="r"></span>
          <span class="b">{{ items|length }} ITEM{{ items|length == 1 ? '' : 'S' }}</span>
        </div>
        <h1>{{ entry.title ?: entry.slug }}</h1>
        {% if F.sourceLine %}<p class="rec-sub">{{ F.sourceLine }}</p>{% endif %}
        <div class="rec-facts">
          <div><div class="l">ITEMS</div><div class="v">{{ items|length }}</div></div>
          {% if editor %}<div><div class="l">EDITED BY</div><div class="v">{{ editor.title }}</div></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% if F.body %}
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body, images: recImages, footnotesFor: entry } %}</div>
          {% include "_partials/record/footnotes" with { entry: entry, editor: editor } only %}
        {% endif %}

        {% if rows|length %}
          <div class="cg-bar">
            <span class="lab">SORT</span>
            <button class="on" data-sort="id">Identifier</button><button data-sort="date">Date</button>
            <span class="sp"></span><span class="count">{{ rows|length }} item{{ rows|length == 1 ? '' : 's' }}</span>
          </div>
          <div class="cg-grid" id="cgGrid">
            {% for r in rows %}
              <figure class="cg-item" data-id="{{ r.id }}" data-date="{{ r.date }}">
                <div class="sh">
                  {% if r.img %}<a href="{{ r.e.url }}"><img src="{{ r.img.getUrl({ width: 420, mode: 'fit' }) ?: r.img.url }}" alt="{{ r.e.title }}" loading="lazy"></a>
                  {% else %}<a href="{{ r.e.url }}" class="ph">{{ r.id ?: '&mdash;' }}</a>{% endif %}
                </div>
                <figcaption>
                  {% if r.id %}<span class="cg-id">{{ r.id }}</span>{% endif %}
                  <a class="cg-t" href="{{ r.e.url }}">{{ r.e.title ?: r.e.slug }}</a>
                  {% if r.date %}<span class="cg-d">{{ r.date }}</span>{% endif %}
                </figcaption>
              </figure>
            {% endfor %}
          </div>
        {% endif %}
      </article>

      <aside class="rec-side">
        {% include "_partials/record/cite" with { entry: entry, label: 'Collections', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
        {% include "_partials/record/tags" with { el: entry } only %}
      </aside>
    </main>
  </div>
</div>

<script>
(function(){
  var grid=document.getElementById('cgGrid'); if(!grid){return;}
  document.querySelectorAll('.cg-bar [data-sort]').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.cg-bar [data-sort]').forEach(function(x){x.classList.toggle('on',x===b);});
      var k=b.dataset.sort;
      var items=[].slice.call(grid.children);
      items.sort(function(x,y){
        var a=(x.dataset[k]||''),c=(y.dataset[k]||'');
        if(!a&&c) return 1; if(a&&!c) return -1;
        return c.localeCompare(a,undefined,{numeric:true});
      });
      items.forEach(function(i){grid.appendChild(i);});
    });
  });
})();
</script>
