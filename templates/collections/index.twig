{% extends "_layouts/base" %}
{% block title %}Collections | SCVHistory.com{% endblock %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{% set cols = craft.entries().section('collections').status(null).orderBy('title asc').all() %}
{% set totalArticles = 0 %}
{% set authorIds = [] %}
{% for c in cols %}
  {% set n = c.articlesInCollection.count() ?: craft.entries().section('articles').relatedTo({ targetElement: c, field: 'partOfCollection' }).status(null).count() %}
  {% set totalArticles = totalArticles + n %}
  {% set a = c.writtenBy.one() ?? null %}
  {% if a and a.id not in authorIds %}{% set authorIds = authorIds|merge([a.id]) %}{% endif %}
{% endfor %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Collections</span></div>
      <div class="scv-herogrid">
        <div>
          <div class="scv-kicker">Series kept in order</div>
          <h1>Collections</h1>
          <p class="scv-lede">Newspaper series and article runs, kept together and in the order their authors intended.</p>
        </div>
        <div class="scv-stat">
          <div><b>{{ cols|length }}</b><span>Collections</span></div>
          <div><b>{{ totalArticles }}</b><span>Articles</span></div>
          {% if authorIds|length %}<div><b>{{ authorIds|length }}</b><span>{{ authorIds|length == 1 ? 'Author' : 'Authors' }}</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      {% if cols|length %}
        <div class="scv-cards scv-cards--wide">
          {% for c in cols %}
            {% set n = c.articlesInCollection.count() ?: craft.entries().section('articles').relatedTo({ targetElement: c, field: 'partOfCollection' }).status(null).count() %}
            {% set img = (c.featuredImage is defined and c.featuredImage) ? c.featuredImage.one() ?? null : null %}
            {% set author = c.writtenBy.one() ?? null %}
            {% set era = c.historicalEra.one() ?? null %}
            <a class="scv-tile" href="{{ c.url }}">
              <div class="scv-ph scv-ph--square">{% if img %}<img src="{{ img.url }}" alt="">{% else %}<span>{{ (c.title ?: c.slug)|slice(0,1)|upper }}</span>{% endif %}</div>
              <div class="scv-tilebody">
                <h3>{{ c.title ?: c.slug }}</h3>
                {% if author %}<div class="scv-tilemeta">{{ author.title }}</div>{% endif %}
                <div class="scv-tilemeta">{{ n }} article{{ n == 1 ? '' : 's' }}</div>
                <div class="scv-tilefoot">{{ era ? era.title : 'Series' }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="scv-empty">No collections yet.</div>
      {% endif %}
    </div>
  </main>
</div>
{% endblock %}
