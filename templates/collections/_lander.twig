{#
  Landing page for a major collection, rendered from collections/_entry.twig
  when collectionIsMajor is on. An unflagged collection keeps the standard
  record layout.

  Reading order everywhere comes from articlesInCollection and is never
  reordered. Contents groups by the collection's own parts, read from the
  collectionParts table field; a collection with no parts renders one ungrouped
  list in sequence order.

  Era is not how a reader moves through a serialised history, so there is no era
  grouping and no era filter. Era still feeds the kicker and the related
  collections box, where it is context rather than navigation.

  Era ordering there comes from the historicalEra structure's own order (lft),
  which is chronological. Sorting those titles alphabetically would put American
  Frontier before Spanish Colonial.

  The band image is bandImage, artwork with no lettering composed with its
  subject at the right. featuredImage is only a fallback, and where it is a
  title card the masked layer will show its lettering beside the h1.
#}
{% set F = {} %}
{% for h in ['body','archiveUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}

{# bandImage first. The field-layout check is the only reliable test: a custom
   field reads as defined on an element whose type does not have it. #}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}
{% endfor %}
{% set hero = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}
{% set hero = hero ?? ((entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null) %}
{% set hero = hero ?? (recImages|length ? recImages|first : null) %}
{% set author = entry.writtenBy.one() ?? null %}
{% set editor = entry.editedBy.one() ?? null %}
{% set publishers = entry.publishedBy.all() %}

{# reading order #}
{% set chapters = entry.articlesInCollection.all()
   ?: craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'partOfCollection' }).status(null).all() %}

{# era order, straight from the structure #}
{% set eraOrder = craft.categories().group('historicalEra').status(null).all() %}

{# bucket the chapters by era, keeping reading order inside each bucket #}
{% set buckets = {} %}
{% set seq = {} %}
{% for a in chapters %}
  {% set e = a.historicalEra.one() ?? null %}
  {% set k = e ? e.slug : '_none' %}
  {% set buckets = buckets|merge({ (k): (buckets[k] ?? [])|merge([a]) }) %}
  {# string key: merge reindexes integer keys, which would lose the mapping #}
  {% set seq = seq|merge({ ('a' ~ a.id): loop.index }) %}
{% endfor %}

{% set erasPresent = [] %}
{% for t in eraOrder %}
  {% if buckets[t.slug] is defined %}{% set erasPresent = erasPresent|merge([t]) %}{% endif %}
{% endfor %}

{# the collection's own parts, positions into articlesInCollection #}
{% set hasParts = false %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'collectionParts' %}{% set hasParts = true %}{% endif %}
{% endfor %}
{% set parts = [] %}
{% if hasParts and entry.collectionParts %}
  {% for r in entry.collectionParts %}
    {% if (r.label ?? '')|trim %}
      {% set parts = parts|merge([{
        label: r.label|trim,
        note: (r.note ?? '')|trim,
        start: (r.start ?? 1) > 0 ? (r.start + 0) : 1
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set parts = parts|sort((a, b) => a.start - b.start)|values %}

{# groups in sequence order. Anything sitting before the first part keeps its
   place in an unlabelled group so no article can disappear from Contents. #}
{% set groups = [] %}
{% for i, p in parts %}
  {% set from = p.start %}
  {% set to = parts[i + 1] is defined ? parts[i + 1].start - 1 : chapters|length %}
  {% set rows = chapters|slice(from - 1, to - from + 1) %}
  {% if rows|length %}
    {% set groups = groups|merge([{ label: p.label, note: p.note, rows: rows }]) %}
  {% endif %}
{% endfor %}
{% set firstStart = parts|length ? (parts|first).start : 1 %}
{% if firstStart > 1 %}
  {% set groups = [{ label: '', note: '', rows: chapters|slice(0, firstStart - 1) }]|merge(groups) %}
{% endif %}
{% if not groups|length and chapters|length %}
  {% set groups = [{ label: '', note: '', rows: chapters }] %}
{% endif %}

{# Band stats: facts about the collection, not filters.
   Chapters are titles that begin with "Chapter". A publication run is a cluster
   of originalPublishDate years, split wherever five or more years separate one
   from the next. Eras covered counts distinct historicalEra terms. A block that
   computes to zero is omitted, and so is a run or era count of one, which is not
   a statistic worth printing. #}
{% set chapterCount = 0 %}
{% set pubYears = [] %}
{% set eraSeen = {} %}
{% for a in chapters %}
  {% if (a.title|trim) starts with 'Chapter' %}{% set chapterCount = chapterCount + 1 %}{% endif %}
  {% set y = (a.originalPublishDate is defined and a.originalPublishDate) ? a.originalPublishDate|trim|slice(-4) : '' %}
  {% if y matches '/^\\d{4}$/' and y not in pubYears %}{% set pubYears = pubYears|merge([y]) %}{% endif %}
  {% for e in a.historicalEra.all() %}{% set eraSeen = eraSeen|merge({ ('e' ~ e.id): true }) %}{% endfor %}
{% endfor %}

{% set runs = 0 %}
{% set prevYear = null %}
{% for y in pubYears|sort %}
  {% if prevYear is null or (y - prevYear) >= 5 %}{% set runs = runs + 1 %}{% endif %}
  {% set prevYear = y %}
{% endfor %}

{% set stats = [] %}
{% if chapters|length %}
  {% set stats = stats|merge([{ n: chapters|length, l: chapters|length == 1 ? 'Article' : 'Articles' }]) %}
{% endif %}
{% if chapterCount %}
  {% set stats = stats|merge([{ n: chapterCount, l: chapterCount == 1 ? 'Chapter' : 'Chapters' }]) %}
{% endif %}
{% if runs > 1 %}
  {% set stats = stats|merge([{ n: runs, l: 'Publication runs' }]) %}
{% endif %}
{% if eraSeen|length > 1 %}
  {% set stats = stats|merge([{ n: eraSeen|length, l: 'Eras covered' }]) %}
{% endif %}

{% set first = chapters|length ? chapters|first : null %}

<div class="rec cl">
  <section class="cl-band">
    {#- One image layer and one gradient, exactly as the article band has them.
        It used to be two image layers: a dead one at opacity 0 and a second
        carrying a contrast filter, with no gradient at all, so the artwork ran
        the full width behind the words instead of falling away to the right. -#}
    {% if hero %}
      <div class="cl-bg" style="background-image:url('{{ hero.url }}')" role="presentation"></div>
      <div class="cl-fade" role="presentation"></div>
    {% endif %}
    <div class="rec-wrap cl-in">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('collections') }}">Collections</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="cl-col">
      {#- The kicker is a row, not a list joined with dots: label, a short gold
          rule, then the era. -#}
      <div class="cl-kick">
        <span>COLLECTION</span>
        <span class="r"></span>
        <span>{{ chapters|length }} ARTICLE{{ chapters|length == 1 ? '' : 'S' }}</span>
        {% if erasPresent|length %}
          <span class="r"></span>
          <span>{{ (erasPresent|first).title|upper }}{{ erasPresent|length > 1 ? ' TO ' ~ (erasPresent|last).title|upper : '' }}</span>
        {% endif %}
      </div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if author or editor %}
        <p class="cl-by">
          {%- if author %}by <a href="{{ author.url }}">{{ author.title }}</a>{% endif -%}
          {%- if editor %}{% if author %} &nbsp;·&nbsp; {% endif %}edited by <a href="{{ editor.url }}">{{ editor.title }}</a>{% endif -%}
        </p>
      {% endif %}

      {#- Chips, as the article draws them: era gold-outlined, community navy.
          A collection has no era of its own, so these are the eras its chapters
          cover and the communities they are about, which is what a reader is
          choosing between. -#}
      {% set clComs = [] %}
      {% set clComIds = [] %}
      {% for a in chapters %}
        {% for c in a.neighborhood.all() %}
          {% if c.id not in clComIds %}
            {% set clComIds = clComIds|merge([c.id]) %}
            {% set clComs = clComs|merge([c]) %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% if erasPresent|length or clComs|length %}
        <div class="cl-chips">
          {% for e in erasPresent %}<a class="cl-chip" href="{{ e.url ?? '#' }}">{{ e.title }}</a>{% endfor %}
          {% for c in clComs|slice(0, 8) %}<a class="cl-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
        </div>
      {% endif %}

      {% if first or F.body %}
        <div class="cl-ctas">
          {% if first %}
            <a class="cl-cta gold" href="{{ first.url }}">Start reading <span>&rarr;</span> {{ first.title ?: first.slug }}</a>
          {% endif %}
          {% if F.body %}
            <a class="cl-cta ghost" href="#recPlayer" id="clListen">Listen to the collection</a>
          {% endif %}
        </div>
      {% endif %}

      {% if stats|length %}
        <div class="cl-stats">
          {% for s in stats %}
            <div class="cl-stat"><b>{{ s.n }}</b><span>{{ s.l }}</span></div>
          {% endfor %}
        </div>
      {% endif %}
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}

        {% if F.body %}
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body, images: recImages , footnotesFor: entry } %}</div>
{% include "_partials/record/footnotes" with { entry: entry } only %}
        {% endif %}
        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}

        {% include "_partials/record/images" with { images: recImages, body: F.body, entry: entry } only %}
        {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}

        {% if chapters|length %}
          <section class="cl-contents">
            <div class="cl-chead">
              <h2 class="rec-h2" style="margin:0">Contents</h2>
              <div class="cl-showing">{{ chapters|length }} article{{ chapters|length == 1 ? '' : 's' }} in reading order</div>
            </div>

            {% for g in groups %}
              {% if g.label %}
                <div class="cl-part">
                  <span class="l">{{ g.label }}</span>
                  <span class="r" role="presentation"></span>
                  {% if g.note %}<span class="n">{{ g.note }}</span>{% endif %}
                </div>
              {% endif %}
              <ol class="cl-list">
                {% for a in g.rows %}
                  {% set aw = a.writtenBy.one() ?? null %}
                  {% set meta = [aw ? aw.title : null, (a.originalPublishDate is defined and a.originalPublishDate) ? a.originalPublishDate : null]|filter(x => x) %}
                  {% set ae = a.historicalEra.one() ?? null %}
                  <li>
                    <a href="{{ a.url }}">
                      <span class="n">{{ seq['a' ~ a.id] }}</span>
                      <span class="c">
                        <span class="t">{{ a.title ?: a.slug }}</span>
                        {% if meta|length %}<span class="m">{{ meta|join(' · ') }}</span>{% endif %}
                      </span>
                      <span class="e">{{ ae ? ae.title : '' }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ol>
            {% endfor %}
          </section>
        {% endif %}
      </article>

      <aside class="rec-side">
        {% include "_partials/record/cite" with { entry: entry, author: author, source: (entry.sourceLine is defined ? entry.sourceLine : null), label: 'Collections', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}

        {% set people = [{ lab: 'AUTHOR', p: author }, { lab: 'EDITOR', p: editor }]|filter(x => x.p) %}
        {% for x in people %}
          {% set pimg = (x.p.featuredImage is defined and x.p.featuredImage) ? x.p.featuredImage.one() ?? null : null %}
          {% set pp = x.p.title|split(' ')|filter(w => w|trim) %}
          <div class="rec-box"><div class="rec-lab">{{ x.lab }}</div>
            <a class="rec-person" href="{{ x.p.url }}">
              <div class="th">{% if pimg %}<img src="{{ pimg.url }}" alt="">{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : x.p.title|slice(0,1))|upper }}{% endif %}</div>
              <div style="min-width:0"><div class="n">{{ x.p.title }}</div>{% if x.p.occupation is defined and x.p.occupation %}<div class="r">{{ x.p.occupation }}</div>{% endif %}</div>
            </a>
          </div>
        {% endfor %}

        {% if publishers|length or F.archiveUrl %}
          <div class="rec-box"><div class="rec-lab">PUBLISHED BY</div>
            <div class="rec-rows">
              {% for o in publishers %}<div class="k">SOURCE</div><div class="v"><a href="{{ o.url }}">{{ o.title ?: o.slug }}</a></div>{% endfor %}
              {% if F.archiveUrl %}<div class="k">ARCHIVE</div><div class="v"><a href="{{ F.archiveUrl }}" target="_blank" rel="noopener">Archive.org &nearr;</a></div>{% endif %}
            </div>
          </div>
        {% endif %}

        {# other collections sharing this one's author or any of its eras #}
        {% set eraIds = erasPresent|map(t => t.id) %}
        {% set related = [] %}
        {% for c in craft.entries().section('collections').status(null).orderBy('title asc').all() %}
          {% if c.id != entry.id %}
            {% set ca = c.writtenBy.one() ?? null %}
            {% set rows = c.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: c, field: 'partOfCollection' }).status(null).all() %}
            {% set share = author and ca and ca.id == author.id %}
            {% set years = [] %}
            {% for a in rows %}
              {% set ae = a.historicalEra.one() ?? null %}
              {% if ae and ae.id in eraIds %}{% set share = true %}{% endif %}
              {% set y = (a.originalPublishDate is defined and a.originalPublishDate) ? a.originalPublishDate|slice(-4) : '' %}
              {% if y matches '/^\\d{4}$/' %}{% set years = years|merge([y]) %}{% endif %}
            {% endfor %}
            {% if share %}
              {% set related = related|merge([{ c: c, n: rows|length, from: years|length ? min(years) : null, to: years|length ? max(years) : null, by: ca }]) %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if related|length %}
          <div class="rec-box"><div class="rec-lab">RELATED COLLECTIONS</div>
            <div class="rec-rows">
              {% for r in related %}
                <div class="k">{{ r.n }}{{ r.n == 1 ? ' ART' : ' ARTS' }}</div>
                <div class="v"><a href="{{ r.c.url }}">{{ r.c.title ?: r.c.slug }}</a>
                  {% if r.from %}<span class="rec-itemsub">{{ r.from }}{{ r.to != r.from ? '–' ~ r.to : '' }}{% if r.by %} · {{ r.by.title }}{% endif %}</span>
                  {% elseif r.by %}<span class="rec-itemsub">{{ r.by.title }}</span>{% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% include "_partials/record/documents" with { docs: recDocs } only %}
        {% include "_partials/record/tags" with { el: entry } only %}

        {% set links = [] %}
        {% if F.archiveUrl %}{% set links = links|merge([{u: F.archiveUrl, t: 'Archive.org'}]) %}{% endif %}
        {# The legacy link moved to the top of the sidebar, in record/source-link.twig.
           A reader comparing our version with Leon's was having to scroll past the
           whole sidebar to reach it. It is not repeated here. #}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>

<script>
/* The band button just starts the player the tools partial already rendered.
   Without JavaScript the link still jumps to it. */
document.addEventListener('DOMContentLoaded', function () {
  var b = document.getElementById('clListen');
  var pp = document.getElementById('recPP');
  if (!b || !pp) { return; }
  b.addEventListener('click', function () { setTimeout(function () { pp.click(); }, 300); });
});
</script>

{% css %}
/* The band, the type and the chips are the article page's, to the pixel. The
   values below are not chosen here; they are read off templates/articles/
   _entry.twig, which was built from design/article-source.html. */
.cl-band{position:relative;background:#FDF7EA;border-bottom:1px solid #E8E0CC;overflow:hidden}
.cl-bg{position:absolute;inset:0;background-size:cover;background-position:right center;z-index:0}
.cl-fade{position:absolute;inset:0;z-index:1;background:linear-gradient(100deg,rgba(253,247,234,.97) 0%,rgba(253,247,234,.95) 44%,rgba(253,247,234,.5) 64%,rgba(253,247,234,0) 80%)}
.cl-band .cl-in{position:relative;z-index:2;padding:26px 40px 46px}
.cl-band .rec-crumbs{margin-bottom:34px}
/* The artwork is composed with its subject at the right, so everything in the
   band shares one column to the left of it. The stats were already capped here;
   now the title, byline, chips and buttons are too, and none of them can run
   under the drawing. */
.cl-col{max-width:560px}
.cl-kick{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.18em;color:#7E6118;margin-bottom:18px}
.cl-kick .r{width:22px;height:1px;background:#C4A031;flex:0 0 auto}
.cl h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(36px,4vw,54px);line-height:1.05;margin:0;color:#17254C;text-wrap:balance}
.cl-by{font-family:'Playfair Display',serif;font-style:italic;font-size:22px;line-height:1.35;color:#5B6472;margin:14px 0 0}
.cl-chips{display:flex;gap:9px;flex-wrap:wrap;margin:26px 0 0}
.cl-chip{font-family:'Jost',sans-serif;font-size:13px;letter-spacing:.04em;color:#7E6118;border:1px solid #C4A031;background:rgba(255,255,255,.55);padding:7px 13px;text-decoration:none}
.cl-chip.solid{color:#fff;background:#17254C;border-color:#17254C}
/* The grid the article uses: a wider sidebar and a wider gutter than the shared
   record layout, which the other templates keep. */
.cl .rec-main{grid-template-columns:minmax(0,1fr) minmax(300px,344px);gap:56px;padding:40px 0 90px}
@media(max-width:900px){.cl .rec-main{grid-template-columns:1fr}}
.cl-by a{color:#17254C;text-decoration:none}
.cl-by a:hover{color:#7A5C1B}
.cl-ctas{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 30px}
.cl-cta{font-family:'Jost',sans-serif;font-size:15px;padding:13px 22px;text-decoration:none;display:inline-block}
.cl-cta.gold{background:#C4A031;color:#17254C;font-weight:500}
.cl-cta.gold:hover{background:#7A5C1B;color:#fff}
.cl-cta.gold span{margin:0 4px}
.cl-cta.ghost{border:1px solid #C4A031;color:#7A5C1B}
.cl-cta.ghost:hover{background:#fff}
.cl-stats{display:flex;gap:38px;flex-wrap:wrap;border-top:1px solid #EFE6D0;padding-top:22px}
.cl-stat b{display:block;font-family:'Playfair Display',serif;font-weight:500;font-size:30px;line-height:1;color:#17254C}
.cl-stat span{display:block;font-family:'Jost',sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.12em;color:#7E6118;margin-top:6px;text-transform:uppercase}
.cl-contents{margin-top:48px}
.cl-chead{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:3px solid #C4A031;padding-top:14px}
.cl-showing{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.12em;color:#5B6472;text-transform:uppercase}
.cl-part{display:flex;align-items:center;gap:16px;margin:30px 0 10px}
.cl-part .l{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#A9842B;white-space:nowrap}
.cl-part .r{flex:1;height:1px;background:#E2E4E8}
.cl-part .n{font-size:13px;color:#8A919E;white-space:nowrap}
.cl-contents .cl-part:first-of-type{margin-top:22px}
.cl-list{list-style:none;margin:0;padding:0;border:1px solid #E2E4E8;background:#fff}
.cl-list li{border-bottom:1px solid #E2E4E8}
.cl-list li:last-child{border-bottom:0}
.cl-list a{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:14px;align-items:center;padding:13px 18px;text-decoration:none;color:inherit}
.cl-list a:hover{background:#FDF7EA}
.cl-list .n{font-family:'Playfair Display',serif;font-size:20px;color:#7A5C1B}
.cl-list .t{font-family:'Playfair Display',serif;font-size:17.5px;line-height:1.25;color:#17254C;display:block}
.cl-list .m{font-size:13px;color:#5B6472;display:block;margin-top:2px}
.cl-list .e{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.1em;color:#8A919E;text-transform:uppercase;text-align:right}
@media(max-width:700px){.cl-list a{grid-template-columns:34px minmax(0,1fr)}.cl-list .e{display:none}}
{% endcss %}
