{#
  A topic: records by different hands, gathered because they share a subject.

  From design/collection-topic-source.html. A topic has no order of its own —
  nobody reads a subject from the beginning — so the records are grouped by
  what each one IS, and the counts are the substance rather than decoration.
  They say what the archive holds on the subject before the reader clicks
  anything.

  Members are found in both directions: records that name this collection in
  partOfCollection, and records related to it by any field. A topic gathers
  things that were never edited into a series, so the relation is often the
  only thing holding them together.
#}
{% set F = {} %}
{% for h in ['body','legacyUrl','sourceLine','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set editor = entry.editedBy.one() ?? null %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}{% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}{% endfor %}
{% set bandImg = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}

{% set GROUPS = [
  { key: 'articles',     label: 'Articles',     chip: 'Article' },
  { key: 'photographs',  label: 'Photographs',  chip: 'Photograph' },
  { key: 'documents',    label: 'Documents',    chip: 'Document' },
  { key: 'persons',      label: 'People',       chip: 'Person' },
  { key: 'places',       label: 'Places',       chip: 'Place' },
  { key: 'organizations',label: 'Organizations',chip: 'Organization' },
  { key: 'events',       label: 'Events',       chip: 'Event' },
  { key: 'groups',       label: 'Groups',       chip: 'Group' }
] %}

{% set seen = [] %}
{% set buckets = {} %}
{% set total = 0 %}
{% for g in GROUPS %}
  {% set found = craft.entries().section(g.key).status(null)
       .relatedTo({ targetElement: entry })
       .orderBy('title asc').limit(null).all() %}
  {% set keep = [] %}
  {% for r in found %}
    {% if r.id not in seen %}{% set seen = seen|merge([r.id]) %}{% set keep = keep|merge([r]) %}{% endif %}
  {% endfor %}
  {% if keep|length %}
    {% set buckets = buckets|merge({ (g.key): keep }) %}
    {% set total = total + keep|length %}
  {% endif %}
{% endfor %}

{% css %}
.tp-grp{display:flex;align-items:center;gap:16px;margin:34px 0 12px;scroll-margin-top:20px}
.tp-grp h2{font-family:'Playfair Display',serif;font-weight:500;font-size:25px;color:#17254C;margin:0}
.tp-grp .rule{flex:1;height:1px;background:#E2E4E8}
.tp-grp .n{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.12em;color:#8A919E}
.tp-rows{list-style:none;margin:0;padding:0;border:1px solid #E2E4E8;background:#fff}
.tp-rows li{border-bottom:1px solid #E2E4E8}.tp-rows li:last-child{border-bottom:0}
.tp-rows a{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:14px;align-items:center;padding:11px 16px;text-decoration:none;color:inherit}
.tp-rows a:hover{background:#FDF7EA}
.tp-th{width:44px;height:44px;border:1px solid #E2E4E8;background:#FDF7EA;display:flex;align-items:center;justify-content:center;
       overflow:hidden;font-family:'Playfair Display',serif;font-size:14px;color:#7A5C1B;flex:none}
.tp-th img{width:100%;height:100%;object-fit:cover;display:block}
.tp-t{display:block;font-family:'Playfair Display',serif;font-size:16.5px;line-height:1.3;color:#17254C}
.tp-m{display:block;font-size:12.5px;color:#5B6472;margin-top:2px}
.tp-kind{font-family:'Jost',sans-serif;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#7E6118;
         border:1px solid #C4A031;padding:2px 6px;white-space:nowrap}
.tp-tally{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 12px;font-size:14.5px}
.tp-tally div{padding:7px 0;border-bottom:1px solid #EFE6D0}
.tp-tally .c{font-family:'Jost',sans-serif;color:#7A5C1B;text-align:right}
.tp-tally a{color:#17254C;text-decoration:none}.tp-tally a:hover{color:#7A5C1B;text-decoration:underline}
@media(max-width:700px){.tp-rows a{grid-template-columns:44px minmax(0,1fr)}.tp-kind{display:none}}
{% endcss %}

<div class="rec tp">
  <section class="rec-band{{ bandImg ? ' rec-band--art' : '' }}">
    {% if bandImg %}
      <div class="rec-bandart" style="background-image:url('{{ bandImg.url }}')" role="presentation"></div>
      <div class="rec-bandfade" role="presentation"></div>
    {% endif %}
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('collections') }}">Collections</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-bandcol">
        <div class="rec-kick">
          <span class="a">COLLECTION</span><span class="r"></span>
          <span class="b">TOPIC</span><span class="r"></span>
          <span class="b">{{ total }} RECORD{{ total == 1 ? '' : 'S' }}</span>
        </div>
        <h1>{{ entry.title ?: entry.slug }}</h1>
        {% if F.sourceLine %}<p class="rec-sub">{{ F.sourceLine }}</p>{% endif %}
        {% set coms = entry.neighborhood is defined ? entry.neighborhood.all() : [] %}
        {% if coms|length %}
          <div class="rec-chips">
            {% for c in coms %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
          </div>
        {% endif %}
        <div class="rec-facts">
          <div><div class="l">RECORDS</div><div class="v">{{ total }}</div></div>
          <div><div class="l">KINDS</div><div class="v">{{ buckets|length }}</div></div>
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}
        {% if F.body %}
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body, images: recImages, footnotesFor: entry } %}</div>
          {% include "_partials/record/footnotes" with { entry: entry, editor: editor } only %}
        {% endif %}

        {% if total %}
          {% for g in GROUPS %}
            {% if buckets[g.key] is defined %}
              {% set rows = buckets[g.key] %}
              <div class="tp-grp" id="g-{{ g.key }}"><h2>{{ g.label }}</h2><span class="rule"></span><span class="n">{{ rows|length }}</span></div>
              <ul class="tp-rows">
                {% for r in rows %}
                  {% set ri = (r.featuredImage is defined and r.featuredImage) ? r.featuredImage.one() ?? null : null %}
                  {% set ri = ri ?? ((r.recordImages is defined and r.recordImages and r.recordImages.one()) ? r.recordImages.one() : null) %}
                  {% set words = (r.title ?: r.slug)|split(' ')|filter(x => x|trim) %}
                  {% set meta = [] %}
                  {% if r.writtenBy is defined and r.writtenBy.one() %}{% set meta = meta|merge([r.writtenBy.one().title]) %}{% endif %}
                  {% if r.originalPublishDate is defined and r.originalPublishDate %}{% set meta = meta|merge([r.originalPublishDate]) %}{% endif %}
                  {% if r.occupation is defined and r.occupation %}{% set meta = meta|merge([r.occupation]) %}{% endif %}
                  {% if r.photoDate is defined and r.photoDate %}{% set meta = meta|merge([r.photoDate]) %}{% endif %}
                  <li><a href="{{ r.url }}">
                    <span class="tp-th">
                      {%- if ri %}<img src="{{ ri.getUrl({ width: 88, height: 88, mode: 'crop' }) ?: ri.url }}" alt="" loading="lazy">
                      {%- else %}{{ (words|length > 1 ? words|first|slice(0,1) ~ words|last|slice(0,1) : (r.title ?: r.slug)|slice(0,1))|upper }}{% endif -%}
                    </span>
                    <span><span class="tp-t">{{ r.title ?: r.slug }}</span>{% if meta|length %}<span class="tp-m">{{ meta|join(' &middot; ')|raw }}</span>{% endif %}</span>
                    <span class="tp-kind">{{ g.chip }}</span>
                  </a></li>
                {% endfor %}
              </ul>
            {% endif %}
          {% endfor %}
        {% endif %}
      </article>

      <aside class="rec-side">
        {% if total %}
          <div class="rec-box"><div class="rec-lab">WHAT IS HERE</div>
            <div class="tp-tally">
              {% for g in GROUPS %}{% if buckets[g.key] is defined %}
                <div><a href="#g-{{ g.key }}">{{ g.label }}</a></div><div class="c">{{ buckets[g.key]|length }}</div>
              {% endif %}{% endfor %}
            </div>
          </div>
        {% endif %}
        {% include "_partials/record/cite" with { entry: entry, label: 'Collections', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
        {% include "_partials/record/tags" with { el: entry } only %}
      </aside>
    </main>
  </div>
</div>
