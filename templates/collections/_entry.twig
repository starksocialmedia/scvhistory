{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
{% endblock %}

{% block content %}

{#
  A major collection gets the landing page; everything else keeps the standard
  record layout below. The flag is read off the layout rather than trusted to
  exist, so this is safe on an install where collectionIsMajor has not been
  created.
#}
{% import "collections/_kind" as ck %}
{% set kind = ck.of(entry)|trim %}
{% if kind == 'book' %}{% include "collections/_lander" %}
{% elseif kind == 'column' %}{% include "collections/_column" %}
{% elseif kind == 'catalogue' %}{% include "collections/_catalogue" %}
{% elseif kind == 'topic' %}{% include "collections/_topic" %}
{% else %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}
{% set img = recImages|length ? recImages|first : null %}
{% set F = {} %}
{% for h in ['body','archiveUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set articles = entry.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'partOfCollection' }).status(null).all() %}
{% set author = entry.writtenBy.one() ?? null %}
{% set editor = entry.editedBy.one() ?? null %}
{% set era = entry.historicalEra.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set periods = entry.historicalPeriod.all() %}

{#- The band artwork, on the same terms as the article page and the lander: one
    image layer and one gradient. A collection that is not flagged major used to
    render a third way again, with no band image at all and a 4:5 thumbnail
    pinned to the right of the title instead. Where there is artwork it takes
    the band; where there is not, the thumbnail stays as it was. -#}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}
{% endfor %}
{% set bandImg = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}

<div class="rec">
  <section class="rec-band{{ bandImg ? ' rec-band--art' : '' }}">
    {% if bandImg %}
      <div class="rec-bandart" style="background-image:url('{{ bandImg.url }}')" role="presentation"></div>
      <div class="rec-bandfade" role="presentation"></div>
    {% endif %}
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('collections') }}">Collections</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-head{{ (img and not bandImg) ? '' : ' rec-head--noart' }}">
        <div>
          <div class="rec-kick"><span class="a">COLLECTIONS</span>{% if era %}<span class="sep"></span><span class="b">{{ era.title|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title ?: entry.slug }}</h1>
          {% if author %}<div class="rec-sub">by {{ author.title }}</div>{% endif %}
          <div class="rec-facts">
            <div><div class="l">ARTICLES</div><div class="v">{{ articles|length }}</div></div>
            {% if editor %}<div><div class="l">EDITED BY</div><div class="v">{{ editor.title }}</div></div>{% endif %}
          </div>
          {% if periods|length or communities|length %}
            <div class="rec-chips">
              {% for p in periods %}<span class="rec-chip">{{ p.title }}</span>{% endfor %}
              {% for c in communities %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
            </div>
          {% endif %}
        </div>
        {% if img and not bandImg %}<div class="rec-portrait"><img src="{{ img.url }}" alt="{{ img.alt ?: entry.title }}"></div>{% endif %}
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}
        {% if F.body %}<div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body, images: recImages , footnotesFor: entry } %}</div>
{% include "_partials/record/footnotes" with { entry: entry } only %}{% endif %}
        {% include "_partials/record/images" with { images: recImages, body: F.body, entry: entry } only %}
        {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}

        {% if articles|length %}
          <h2 class="rec-h2">{{ articles|length }} article{{ articles|length == 1 ? '' : 's' }} in this collection</h2>
          <div class="rec-listwrap">
            <ul class="rec-list">
              {% for a in articles %}
                {% set aw = a.writtenBy.one() ?? null %}
                {% set line = [aw ? aw.title : null, a.originalPublishDate is defined and a.originalPublishDate ? a.originalPublishDate : null]|filter(x => x) %}
                <li><a href="{{ a.url }}">
                  <span class="num">{{ loop.index }}</span>
                  <span style="min-width:0">
                    <span class="t">{{ a.title ?: a.slug }}</span>
                    {% if line|length %}<span class="m" style="display:block">{{ line|join(' · ') }}</span>{% endif %}
                  </span>
                </a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

      </article>

      <aside class="rec-side">
        {% include "_partials/record/cite" with { entry: entry, author: author, source: (entry.sourceLine is defined ? entry.sourceLine : null), date: null, label: 'Collections', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
        {% set credits = [{ lab: 'AUTHOR', rows: author ? [author] : [] }, { lab: 'EDITOR', rows: editor ? [editor] : [] }]|filter(b => b.rows|length) %}
        {% for b in credits %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            {% for p in b.rows %}
              {% set pimg = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
              {% set pp = p.title|split(' ')|filter(x => x|trim) %}
              <a class="rec-person" href="{{ p.url }}">
                <div class="th">{% if pimg %}<img src="{{ pimg.url }}" alt="">{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : p.title|slice(0,1))|upper }}{% endif %}</div>
                <div style="min-width:0"><div class="n">{{ p.title }}</div>{% if p.occupation is defined and p.occupation %}<div class="r">{{ p.occupation }}</div>{% endif %}</div>
              </a>
            {% endfor %}
          </div>
        {% endfor %}

        {#- PUBLISHED BY left the label-and-link boxes and became the author
            treatment, because the body that published a series is not a field
            value. PART OF stays a row: a series is not a person. -#}
        {% include "_partials/record/publisher" with { orgs: entry.publishedBy.all() } only %}

        {% set boxes = [
          { lab: 'PART OF', key: 'SERIES', rows: entry.collectionGroups.all() }
        ]|filter(b => b.rows|length) %}
        {% for b in boxes %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            <div class="rec-rows">{% for r in b.rows %}<div class="k">{{ b.key }}</div><div class="v"><a href="{{ r.url }}">{{ r.title ?: r.slug }}</a></div>{% endfor %}</div>
          </div>
        {% endfor %}

        {% if communities|length %}
          <div class="rec-box"><div class="rec-lab">COMMUNITIES</div>
            <div class="rec-rows">{% for c in communities %}<div class="k">AREA</div><div class="v"><a href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% include "_partials/record/documents" with { docs: recDocs } only %}

        {% include "_partials/record/tags" with { el: entry } only %}

        {% set links = [] %}
        {% if F.archiveUrl %}{% set links = links|merge([{u: F.archiveUrl, t: 'Archive.org'}]) %}{% endif %}
        {# The legacy link moved to the top of the sidebar, in record/source-link.twig.
           A reader comparing our version with Leon's was having to scroll past the
           whole sidebar to reach it. It is not repeated here. #}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>
{% endif %}
{% endblock %}
