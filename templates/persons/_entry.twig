{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
  {% css %}
  .rec-head--left{grid-template-columns:minmax(240px,300px) minmax(0,1fr)}
  @media(max-width:800px){.rec-head--left{grid-template-columns:1fr}}
  .rec-head--left>.rec-portrait{order:-1}
  .rec-head--left>div:last-child{padding-bottom:44px}
  .rec-head--left>div:first-child{padding-bottom:0}
  {% endcss %}
{% endblock %}

{% block content %}

{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.personWebmasterNoteTop is defined ? entry.personWebmasterNoteTop : null %}
{% set noteBottom = entry.personWebmasterNoteBottom is defined ? entry.personWebmasterNoteBottom : null %}
{% set F = {} %}
{% for h in ['authorBio', 'birthDate', 'birthplace', 'body', 'burialPlace', 'culturalSensitivityNote', 'deathDate', 'occupation', 'personFinePrint', 'personLegacyUrl', 'personWebmasterNoteBottom', 'personWebmasterNoteTop'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{# bandImage first: artwork with no lettering, composed with its subject at the
   right. featuredImage is only a fallback, and where it is a title card it may
   show lettering. The field-layout check is the only reliable test: a custom
   field reads as defined on an element whose type does not have it. #}
{% set hasBandImage = false %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'bandImage' %}{% set hasBandImage = true %}{% endif %}
{% endfor %}
{% set bandImg = hasBandImage and entry.bandImage ? entry.bandImage.one() ?? null : null %}
{% set img = bandImg ?? (entry.featuredImage is defined ? entry.featuredImage.one() ?? null : null) %}
{% set img = img ?? (recImages|length ? recImages|first : null) %}
{% set era = entry.historicalEra.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set periods = entry.historicalPeriod.all() %}
{% set personGroups = entry.personGroups.all() %}
{% set prose = F.body ?: F.authorBio %}

{% set parts = entry.title|split(' ')|filter(p => p|trim) %}
{% set initials = parts|length > 1 ? (parts|first|slice(0,1) ~ parts|last|slice(0,1)) : entry.title|slice(0,1) %}

{% set born = [F.birthDate, F.birthplace]|filter(x => x)|join(' · ') %}
{% set died = [F.deathDate, F.burialPlace]|filter(x => x)|join(' · ') %}
{% set residence = communities|map(c => c.title)|join(' · ') %}

{% set written = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'writtenBy' }).status(null).orderBy('title asc').all() %}
{% set about = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'subjectPerson' }).status(null).orderBy('title asc').all() %}
{% set livedPlaces = craft.entries().section('places').relatedTo({ targetElement: entry, field: 'placePeople' }).status(null).orderBy('title asc').all() %}
{% set obits = entry.personObituaries.all() %}
{% set orgs = entry.personOrganizations.all() %}

{% macro person(p, badge) %}
  {% set pimg = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
  {% set pparts = p.title|split(' ')|filter(x => x|trim) %}
  {% set pini = pparts|length > 1 ? (pparts|first|slice(0,1) ~ pparts|last|slice(0,1)) : p.title|slice(0,1) %}
  {% set life = [p.birthDate is defined ? p.birthDate : null, p.deathDate is defined ? p.deathDate : null]|filter(x => x)|join(' – ') %}
  {% set line = (p.occupation is defined and p.occupation) ? p.occupation : life %}
  <a class="rec-person" href="{{ p.url }}">
    <div class="th">{% if pimg %}<img src="{{ pimg.url }}" alt="">{% else %}{{ pini|upper }}{% endif %}</div>
    <div style="min-width:0">
      <div class="n">{{ p.title }}</div>
      {% if line %}<div class="r">{{ line }}</div>{% endif %}
      {% if badge %}<span class="rec-badge">War Memorial</span>{% endif %}
    </div>
  </a>
{% endmacro %}
{% import _self as ui %}

<div class="rec">
  <section class="rec-band">
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('persons') }}">People</a> &rsaquo; <span>{{ entry.title }}</span></div>
      <div class="rec-head rec-head--left">
        <div class="rec-portrait">
          {% if img %}<img src="{{ img.url }}" alt="{{ img.alt ?: entry.title }}">{% else %}<div class="ph">{{ initials|upper }}</div>{% endif %}
        </div>
        <div>
          <div class="rec-kick"><span class="a">PEOPLE</span>{% if era %}<span class="sep"></span><span class="b">{{ era.title|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title }}</h1>
          {% if F.occupation %}<div class="rec-sub">{{ F.occupation }}</div>{% endif %}
          {% if born or died or residence %}
            <div class="rec-facts">
              {% if born %}<div><div class="l">BORN</div><div class="v">{{ born }}</div></div>{% endif %}
              {% if died %}<div><div class="l">DIED</div><div class="v">{{ died }}</div></div>{% endif %}
              {% if residence %}<div><div class="l">RESIDENCE</div><div class="v">{{ residence }}</div></div>{% endif %}
            </div>
          {% endif %}
          {% if periods|length or communities|length or personGroups|length %}
            <div class="rec-chips">
              {% for p in periods %}<span class="rec-chip">{{ p.title }}</span>{% endfor %}
              {% for c in communities %}<a class="rec-chip" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
              {% for g in personGroups %}<a class="rec-chip solid" href="{{ g.url }}">{{ g.title }}</a>{% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: prose, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}

        {% if prose %}
          <div class="rec-body" id="recText">
            {% include "_partials/prose" with { text: prose, images: recImages , footnotesFor: entry } %}
          </div>
{% include "_partials/record/footnotes" with { entry: entry } only %}
          {% include "_partials/record/images" with { images: recImages, body: prose } only %}
          {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
        {% endif %}

        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}
        {% include "_partials/record/fine-print" with { value: F.personFinePrint } only %}

      </article>

      <aside class="rec-side">
        {% include "_partials/record/cite" with { entry: entry, label: 'People', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
        {# Family is derived from childOf in _layouts/base.twig and handed here
           and to the JSON-LD, so the box and the graph cannot disagree. #}
        {% include "_partials/record/family" with { fam: fam } only %}

        {% if orgs|length %}
          <div class="rec-box"><div class="rec-lab">ORGANIZATIONS</div>
            {% for o in orgs %}
              {% set oimg = o.featuredImage is defined ? o.featuredImage.one() ?? null : null %}
              <a class="rec-person" href="{{ o.url }}">
                <div class="th">{% if oimg %}<img src="{{ oimg.url }}" alt="">{% else %}{{ o.title|slice(0,1)|upper }}{% endif %}</div>
                <div style="min-width:0"><div class="n">{{ o.title }}</div>{% if o.dateFounded is defined and o.dateFounded %}<div class="r">Founded {{ o.dateFounded }}</div>{% endif %}</div>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        {% if personGroups|length %}
          <div class="rec-box"><div class="rec-lab">GROUPS</div>
            <div class="rec-rows">{% for g in personGroups %}<div class="k">GROUP</div><div class="v"><a href="{{ g.url }}">{{ g.title }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% if livedPlaces|length %}
          <div class="rec-box"><div class="rec-lab">PLACES</div>
            <div class="rec-rows">{% for p in livedPlaces %}<div class="k">PLACE</div><div class="v"><a href="{{ p.url }}">{{ p.title }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% if written|length %}
          <div class="rec-box"><div class="rec-lab">WRITTEN BY {{ entry.title|upper }}</div>
            <div class="rec-links">{% for a in written %}<a href="{{ a.url }}">{{ a.title }} <span>&rarr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}

        {% if about|length %}
          <div class="rec-box"><div class="rec-lab">ARTICLES ABOUT</div>
            <div class="rec-links">{% for a in about %}<a href="{{ a.url }}">{{ a.title }} <span>&rarr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}

        {% if obits|length %}
          <div class="rec-box"><div class="rec-lab">OBITUARY</div>
            <div class="rec-links">{% for o in obits %}<a href="{{ o.url }}">{{ o.title }} <span>&rarr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}

        {% include "_partials/record/documents" with { docs: recDocs } only %}

        {% include "_partials/record/tags" with { el: entry } only %}

        {% set links = [] %}
        {% if entry.personWikipediaUrl is defined and entry.personWikipediaUrl %}{% set links = links|merge([{u: entry.personWikipediaUrl, t: 'Wikipedia'}]) %}{% endif %}
        {% if entry.personGraveUrl is defined and entry.personGraveUrl %}{% set links = links|merge([{u: entry.personGraveUrl, t: 'Find a Grave'}]) %}{% endif %}
        {# The legacy link moved to the top of the sidebar, in record/source-link.twig.
           A reader comparing our version with Leon's was having to scroll past the
           whole sidebar to reach it. It is not repeated here. #}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>
{% endblock %}
