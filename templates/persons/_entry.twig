{% extends "_layouts/base" %}
{% block content %}
<div class="crumbs"><a href="/">Home</a> › <a href="/persons">People</a> › {{ entry.title }}</div>
<div class="layout">
  <main>
    <h1>{{ entry.title }}</h1>
    {% if entry.occupation %}<p class="sub">{{ entry.occupation }}</p>{% endif %}
    <p class="byline">
      {% if entry.birthDate %}<strong>Born</strong> {{ entry.birthDate }}{% if entry.birthplace %} · {{ entry.birthplace }}{% endif %}<br>{% endif %}
      {% if entry.deathDate %}<strong>Died</strong> {{ entry.deathDate }}{% if entry.burialPlace %} · {{ entry.burialPlace }}{% endif %}{% endif %}
    </p>
    {% set era = entry.historicalEra.one() ?? null %}
    {% if era %}<div class="era">{{ era.title }}</div>{% endif %}
    <div class="chips">
      {% for p in entry.historicalPeriod.all() %}<span class="chip">{{ p.title }}</span>{% endfor %}
      {% for c in entry.neighborhood.all() %}<span class="chip solid">{{ c.title }}</span>{% endfor %}
    </div>
    <article class="body">
      {{ entry.body|raw }}
      {% if entry.authorBio and not entry.body %}<p>{{ entry.authorBio }}</p>{% endif %}
      {% if entry.personWebmasterNoteBottom %}<div class="note">{{ entry.personWebmasterNoteBottom }}</div>{% endif %}
      {% if entry.personFinePrint %}<p class="fine">{{ entry.personFinePrint }}</p>{% endif %}
    </article>
  </main>
  <aside>
    <div class="box">
      <div class="meta-row"><span>Last updated</span><span>{{ entry.dateUpdated|date('M j, Y') }}</span></div>
    </div>
    <div class="box">
      <h3>Cite this page</h3>
      <div class="cite">"{{ entry.title }}." SCVHistory.com. Accessed {{ now|date('F j, Y') }}. {{ entry.url }}.</div>
    </div>
    {% set fam = {'Parent of': entry.parentOf.all(), 'Child of': entry.childOf.all(), 'Sibling of': entry.siblingOf.all()} %}
    {% set hasFam = false %}
    {% for k, v in fam %}{% if v|length %}{% set hasFam = true %}{% endif %}{% endfor %}
    {% if hasFam %}
    <div class="box"><h3>Family &amp; relationships</h3>
      {% for label, people in fam %}
        {% if people|length %}
          <p class="small" style="margin:8px 0 2px">{{ label|upper }}</p>
          <ul>{% for p in people %}<li><a href="{{ p.url }}">{{ p.title }}</a>{% if p.occupation %}<br><span class="small">{{ p.occupation }}</span>{% endif %}</li>{% endfor %}</ul>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
    {% set orgs = entry.personOrganizations.all() %}
    {% if orgs|length %}<div class="box"><h3>Organizations</h3><ul>{% for o in orgs %}<li><a href="{{ o.url }}">{{ o.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    {% set grps = entry.personGroups.all() %}
    {% if grps|length %}<div class="box"><h3>Groups</h3><ul>{% for g in grps %}<li><a href="{{ g.url }}">{{ g.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    {% set arts = entry.articlesAbout.all() %}
    {% set written = craft.entries().section('articles').relatedTo({targetElement: entry, field: 'writtenBy'}).status(null).all() %}
    {% if written|length %}<div class="box"><h3>Articles by {{ entry.title }}</h3><ul>{% for a in written %}<li><a href="{{ a.url }}">{{ a.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    {% set mentions = craft.entries().section('articles').relatedTo({targetElement: entry, field: 'subjectPerson'}).status(null).all() %}
    {% if mentions|length %}<div class="box"><h3>Articles mentioning {{ entry.title }}</h3><ul>{% for a in mentions %}<li><a href="{{ a.url }}">{{ a.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    {% if entry.personLegacyUrl %}
    <div class="box"><h3>External</h3><ul><li><a href="https://scvhistory.com{{ entry.personLegacyUrl }}">View on legacy site ↗</a></li></ul></div>
    {% endif %}
  </aside>
</div>
{% endblock %}
