{% extends "_layouts/base" %}
{% block content %}
<div class="crumbs"><a href="/">Home</a> › People</div>
{% set entries = craft.entries().section('persons').status(null).orderBy('title asc').all() %}
<h1>People</h1>
<p class="small">{{ entries|length }} in the archive</p>
<ul class="list">
  {% for e in entries %}
    <li><a href="{{ e.url }}">{{ e.title }}</a>
      <div class="small">{{ e.occupation }}{% if e.birthDate %} · b. {{ e.birthDate }}{% endif %}</div>
    </li>
  {% endfor %}
</ul>
{% endblock %}
