<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "_partials/head/meta" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ siteUrl }}assets/css/main">
  <link rel="stylesheet" href="{{ siteUrl }}assets/css/layout">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@400;500&family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}
    a{color:inherit}
    .scv-hdr a{text-decoration:none}
    .scv-hdr-search{margin:0}
    .scv-hdr-links a:hover{color:#C4A031}
    .scv-mtoggle-wrap{display:none}
    .scv-mlabel{display:none}
    .scv-mbtn:hover,.scv-mbtn[aria-expanded="true"]{background:rgba(255,255,255,.07)!important;color:#fff!important;border-bottom-color:#C4A031!important}
    .scv-mbtn:hover .scv-caret,.scv-mbtn[aria-expanded="true"] .scv-caret{color:#C4A031!important}
    .scv-caret{display:inline-block;transition:transform .15s ease}
    .scv-mbtn[aria-expanded="true"] .scv-caret,.scv-mtoggle[aria-expanded="true"] .scv-caret{transform:rotate(180deg)}
    .scv-mbtn:focus-visible,.scv-mtoggle:focus-visible,.scv-hdr-links a:focus-visible,.scv-hdr-brand:focus-visible{outline:2px solid #C4A031;outline-offset:2px}
    .scv-panel-link:hover span{color:#A9842B}
    .scv-panel-link:focus-visible,.scv-feat-cta:focus-visible{outline:2px solid #A9842B;outline-offset:3px}
    .scv-feat-cta:hover{color:#7A5C1B;border-bottom-color:#7A5C1B}
    @media (max-width:980px){
      .scv-hdr-top{flex-direction:column;align-items:stretch!important;gap:16px!important}
      .scv-hdr-util{width:100%;flex-direction:column;align-items:stretch!important;gap:12px!important}
      .scv-hdr-search label{min-width:0!important}
      .scv-hdr-links{justify-content:flex-start}
      .scv-nav{display:none!important}
      .scv-mtoggle-wrap{display:block}
      .scv-panel{position:static!important;box-shadow:none!important;border-bottom:1px solid #E2E4E8!important}
      .scv-panel-in{grid-template-columns:minmax(0,1fr)!important;gap:28px!important;padding:20px!important}
      .scv-panel-cols{grid-template-columns:minmax(0,1fr)!important;gap:24px!important}
      .scv-mlabel{display:block}
    }
    html,body{overflow-x:hidden}
    #content{max-width:none;margin:0;padding:0}
    .scv-footer{background:#17254C;color:#fff}
  </style>
  {% block head %}{% endblock %}
</head>
<body>

  <a class="scv-skip" href="#content">Skip to content</a>

  {% include "_partials/header/site-header" %}

  {# ── Main Content ────────────────────────────────────────────────── #}
  <div id="content" tabindex="-1">
    {% block content %}{% endblock %}
  </div>

  {# ── Footer ──────────────────────────────────────────────────────── #}
  <footer class="scv-footer">
    <div class="scv-footer-inner">

      <div class="scv-footer-brand">
        <a href="{{ siteUrl }}" class="scv-footer-logo">
          <img src="{{ siteUrl }}uploads/archive-media/site/scvhistory-logo.svg"
               alt="SCVHistory.com" style="height:48px;width:auto;">
        </a>
        <p class="scv-footer-tagline">
          A free public archive of Santa Clarita Valley History.<br>
          A service of SCVTV, a 501(c)(3) nonprofit.
        </p>
      </div>

      <div class="scv-footer-col">
        <p class="scv-footer-heading">Browse</p>
        <a href="{{ url('articles', {view: 'era'}) }}">By Era</a>
        <a href="{{ url('articles', {view: 'collection'}) }}">By Collection</a>
        <a href="{{ url('persons') }}"{% if craft.app.request.getSegment(1) == 'persons' %} class="on"{% endif %}>People</a>
        <a href="{{ url('obituaries') }}"{% if craft.app.request.getSegment(1) == 'obituaries' %} class="on"{% endif %}>Obituaries</a>
        <a href="{{ url('on-this-day') }}"{% if craft.app.request.getSegment(1) == 'on-this-day' %} class="on"{% endif %}>On This Day</a>
      </div>

      <div class="scv-footer-col">
        <p class="scv-footer-heading">About</p>
        <a href="{{ url('about') }}">About</a>
        <a href="{{ url('contact') }}">Contact</a>
        <a href="{{ url('permissions') }}">Permissions</a>
        <a href="{{ url('photo-credits') }}">Photo Credits</a>
        <a href="https://scvhs.org" target="_blank" rel="noopener">SCV Historical Society</a>
      </div>

      <div class="scv-footer-col">
        <p class="scv-footer-heading">Connect</p>
        <a href="https://www.facebook.com/groups/scvhistory" target="_blank" rel="noopener">Facebook Group</a>
        <a href="{{ url('newsletter') }}">Newsletter</a>
        <a href="{{ url('submit') }}">Submit a photo/article</a>
      </div>
    </div>

    <div class="scv-footer-bottom">
      <span>&copy; {{ now|date('Y') }} Santa Clarita Valley Historical Society</span>
      <span class="scv-footer-bottom-links">
        <a href="{{ url('nonprofit') }}">Nonprofit</a>
        &bull;
        <a href="{{ url('permissions') }}">Permissions</a>
        &bull;
        <a href="{{ url('privacy') }}">Privacy Policy</a>
      </span>
    </div>
  </footer>

  {# ── Lightbox ────────────────────────────────────────────────────── #}
  <div id="scv-lightbox" class="scv-lightbox" aria-modal="true" role="dialog">
    <button class="scv-lightbox__close" onclick="scvCloseLightbox()" aria-label="Close">&times;</button>
    <button class="scv-lightbox__prev" onclick="scvLightboxNav(-1)" aria-label="Previous">&#8592;</button>
    <button class="scv-lightbox__next" onclick="scvLightboxNav(1)" aria-label="Next">&#8594;</button>
    <div class="scv-lightbox__stage">
      <img id="scv-lb-img" src="" alt="">
      <div class="scv-lightbox__caption">
        <div id="scv-lb-caption"></div>
        <div id="scv-lb-counter"></div>
      </div>
    </div>
  </div>

  <script src="{{ siteUrl }}assets/js/main"></script>
  <script>
  (function () {
    function init() {
      var hdr = document.querySelector('.scv-hdr');
      if (!hdr) { return; }
      var btns = Array.prototype.slice.call(hdr.querySelectorAll('.scv-mbtn'));
      var panels = Array.prototype.slice.call(hdr.querySelectorAll('.scv-panel'));
      var toggle = hdr.querySelector('.scv-mtoggle');
      var row2 = hdr.querySelector('.scv-hdr-row2');
      var open = null;

      function isNarrow() { return window.matchMedia('(max-width: 980px)').matches; }

      function close() {
        btns.forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
        panels.forEach(function (p) { p.hidden = true; });
        open = null;
      }

      function show(id) {
        if (isNarrow()) { return; }
        open = id;
        btns.forEach(function (b) {
          b.setAttribute('aria-expanded', String(b.getAttribute('data-menu') === id));
        });
        panels.forEach(function (p) {
          p.hidden = p.getAttribute('data-menu') !== id;
        });
      }

      btns.forEach(function (b) {
        var id = b.getAttribute('data-menu');
        b.addEventListener('mouseenter', function () { show(id); });
        b.addEventListener('focus', function () { show(id); });
        b.addEventListener('click', function (e) {
          e.preventDefault();
          if (open === id) { close(); } else { show(id); }
        });
      });

      if (row2) {
        row2.addEventListener('mouseleave', function () { if (!isNarrow()) { close(); } });
      }

      function setDrawer(state) {
        hdr.classList.toggle('mopen', state);
        if (toggle) { toggle.setAttribute('aria-expanded', String(state)); }
        panels.forEach(function (p) { p.hidden = !state; });
      }

      if (toggle) {
        toggle.addEventListener('click', function () {
          setDrawer(!hdr.classList.contains('mopen'));
        });
      }

      var narrow = window.matchMedia('(max-width: 980px)');
      var onWidthChange = function () { setDrawer(false); close(); };
      if (narrow.addEventListener) {
        narrow.addEventListener('change', onWidthChange);
      } else if (narrow.addListener) {
        narrow.addListener(onWidthChange);
      }

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') { return; }
        if (open) {
          var btn = hdr.querySelector('.scv-mbtn[data-menu="' + open + '"]');
          close();
          if (btn) { btn.focus(); }
        } else if (hdr.classList.contains('mopen')) {
          setDrawer(false);
          if (toggle) { toggle.focus(); }
        }
      });

      document.addEventListener('click', function (e) {
        if (!hdr.contains(e.target)) { close(); }
      });

      document.addEventListener('focusin', function (e) {
        if (open && !hdr.contains(e.target)) { close(); }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>

  {% block foot %}{% endblock %}

</body>
</html>
