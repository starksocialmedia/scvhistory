{% extends "_layouts/base" %}
{% set metaDescription = 'Every Santa Clarita City Council election from incorporation in 1987 to 2024, and the valley\'s school board elections since 1995: the candidates, the votes, and who turned out.' %}
{% block head %}
{% include "_partials/scv-extra-css" %}
{% css %}
.el{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}
.el-band{background:#FDF7EA;border-bottom:1px solid #EFE6D0}
.el-band-in{padding-top:44px;padding-bottom:44px}
.el-crumbs{font-size:13px;color:#5B6472;margin-bottom:22px}
.el-crumbs a{color:#7A5C1B;text-decoration:none}
.el-kicker{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;color:#7A5C1B;margin-bottom:14px}
.el-band h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(34px,4.6vw,54px);line-height:1.06;margin:0 0 16px;color:#17254C}
.el-band p{font-size:18px;line-height:1.65;margin:0;color:#4A5260;max-width:720px}
.el-main{padding-top:40px;padding-bottom:96px}
.el-h2{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#7A5C1B;margin:0 0 14px}
.el-chart{background:#fff;border:1px solid #E2E4E8;padding:20px 16px 12px;margin-bottom:40px;overflow-x:auto}
.el-chart svg{display:block;min-width:640px;width:100%;height:auto}
.el-key{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:#5B6472;margin-top:8px}
.el-key i{display:inline-block;width:12px;height:12px;vertical-align:-1px;margin-right:6px}
.el-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #E2E4E8;font-size:15px}
.el-table th{text-align:left;font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.12em;color:#7A5C1B;font-weight:500;padding:12px 14px;border-bottom:1px solid #EFE6D0}
.el-table td{padding:11px 14px;border-top:1px solid #F0F1F4;vertical-align:top}
.el-table a{color:#17254C;font-weight:500}
.el-table .dim{color:#5B6472;font-size:13.5px}
.el-note{font-size:14px;line-height:1.6;color:#5B6472;margin-top:24px;max-width:760px}
{% endcss %}
{% endblock %}

{% block content %}
{% set everyElection = craft.entries().section('elections').orderBy('electionDateEdtf asc').all() %}
{#- The council's elections carry the City as their body (or no body, before
    add_election_body.php); every other body's are the boards, listed below. -#}
{% set hasBody = craft.app.fields.getFieldByHandle('electionBody') is not null %}
{% set bodyOf = {} %}
{% for e in everyElection %}{% set b = hasBody and 'electionBody' in e.fieldLayout.customFields|map(f => f.handle) ? e.electionBody.one() : null %}{% set bodyOf = bodyOf|merge({ ('e' ~ e.id): b }) %}{% endfor %}
{% set elections = everyElection|filter(e => not bodyOf['e' ~ e.id] or bodyOf['e' ~ e.id].slug == 'city-of-santa-clarita') %}
{% set boardEls = everyElection|filter(e => bodyOf['e' ~ e.id] and bodyOf['e' ~ e.id].slug != 'city-of-santa-clarita') %}
{#- Turnout, where both counts are held, and the April/November split the story
    turns on: computed from the records, not typed into the page. -#}
{% set rows = [] %}
{% for e in elections %}
  {% set t = e.registeredVoters and e.ballotsCast ? (e.ballotsCast / e.registeredVoters * 100) : null %}
  {% set nov = e.electionDateEdtf|slice(5, 2) == '11' %}
  {% set rows = rows|merge([{ e: e, t: t, nov: nov, y: e.electionDateEdtf|slice(0, 4) }]) %}
{% endfor %}
{% set april = rows|filter(r => not r.nov and r.t is not null) %}
{% set aprilOrd = april|filter(r => r.y != '1992') %}
{% set y1992 = (april|filter(r => r.y == '1992')|first) ?: null %}
{% set nov = rows|filter(r => r.nov and r.t is not null) %}
{% set aMin = aprilOrd|length ? min(aprilOrd|map(r => r.t)) : 0 %}{% set aMax = aprilOrd|length ? max(aprilOrd|map(r => r.t)) : 0 %}
{% set nMin = nov|length ? min(nov|map(r => r.t)) : 0 %}{% set nMax = nov|length ? max(nov|map(r => r.t)) : 0 %}

<div class="el">
  <section class="scv-band el-band">
    <div class="scv-band-in el-band-in">
      <div class="el-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Elections</span></div>
      <div class="el-kicker">THE COUNCIL AND THE BOARDS</div>
      <h1>Elections{% if everyElection|length %}, {{ (everyElection|first).electionDateEdtf|slice(0, 4) }} to {{ (everyElection|last).electionDateEdtf|slice(0, 4) }}{% endif %}</h1>
      <p>Every Santa Clarita City Council election since the city was incorporated, {{ elections|length }} of them{% if boardEls|length %}, and {{ boardEls|length }} school board contests since 1995{% endif %}: every candidate, winners and losers alike, from the City Clerk's records, the County's statements of votes and the state's compilation of local results.
      {% if aprilOrd|length and nov|length %}April elections drew {{ aMin|round }} to {{ aMax|round }} percent of registered voters{% if y1992 %}, except in 1992, when {{ y1992.t|round }} percent turned out with growth control, Measure A-92, on the ballot{% endif %}. Consolidated with the November general election, turnout rose to {{ nMin|round }} to {{ nMax|round }} percent.{% endif %}</p>
    </div>
  </section>

  <main class="scv-band-in el-main">
    <h2 class="el-h2" id="council" style="font-size:13px">THE CITY COUNCIL</h2>
    <h2 class="el-h2">WHO TURNED OUT</h2>
    <div class="el-chart">
      {% set W = 980 %}{% set H = 280 %}{% set pad = 36 %}{% set n = rows|filter(r => r.t is not null)|length %}
      {% set bw = n ? (W - pad * 2) / n : 0 %}
      <svg viewBox="0 0 {{ W }} {{ H + 40 }}" role="img" aria-label="Turnout at each Santa Clarita City Council election, as a share of registered voters">
        {% for g in [0, 25, 50, 75, 100] %}
          {% set gy = H - g / 100 * (H - 20) %}
          <line x1="{{ pad }}" x2="{{ W - pad }}" y1="{{ gy }}" y2="{{ gy }}" stroke="#EEF0F4"/>
          <text x="{{ pad - 6 }}" y="{{ gy + 4 }}" font-size="11" fill="#8A93A3" text-anchor="end" font-family="Jost, sans-serif">{{ g }}%</text>
        {% endfor %}
        {% set i = 0 %}
        {% for r in rows|filter(r => r.t is not null) %}
          {% set h = r.t / 100 * (H - 20) %}{% set x = pad + i * bw + bw * 0.18 %}
          <a href="{{ r.e.url }}"><title>{{ r.e.title }}: {{ r.t|number_format(1) }}% turnout</title>
            <rect x="{{ x }}" y="{{ H - h }}" width="{{ bw * 0.64 }}" height="{{ h }}" fill="{{ r.nov ? '#17254C' : (r.y == '1992' ? '#A9842B' : '#C4A031') }}"/></a>
          <text x="{{ x + bw * 0.32 }}" y="{{ H - h - 6 }}" font-size="11" fill="#17254C" text-anchor="middle" font-family="Jost, sans-serif">{{ r.t|round }}</text>
          <text x="{{ x + bw * 0.32 }}" y="{{ H + 18 }}" font-size="11.5" fill="#5B6472" text-anchor="middle" font-family="Jost, sans-serif">{{ r.nov ? 'Nov ' : '' }}{{ r.y }}</text>
          {% set i = i + 1 %}
        {% endfor %}
      </svg>
      <div class="el-key"><span><i style="background:#C4A031"></i>April, the city's own election</span><span><i style="background:#A9842B"></i>April 1992, with Measure A-92</span><span><i style="background:#17254C"></i>November, consolidated with the general election</span></div>
    </div>

    <h2 class="el-h2">EVERY ELECTION</h2>
    <table class="el-table">
      <thead><tr><th>ELECTION</th><th>CANDIDATES</th><th>SEATS</th><th>TURNOUT</th><th>ELECTED</th></tr></thead>
      <tbody>
      {% for r in rows|reverse %}
        {% set e = r.e %}
        {% set cands = craft.entries().section('candidacies').relatedTo({ targetElement: e, field: 'candidacyElection' }).all() %}
        {% set won = cands|filter(c => c.outcome.value == 'elected' and c.outcomeEvidence.value != 'uncited')|sort((a, b) => (b.votes ?? 0) <=> (a.votes ?? 0)) %}
        <tr>
          <td><a href="{{ e.url }}">{{ e.electionDate }}</a>{% if e.consolidatedWith %}<div class="dim">{{ e.consolidatedWith }}</div>{% endif %}</td>
          <td>{{ cands|length }}</td>
          <td>{{ e.seatsUp }}{% if e.seatsUpEvidence.value in ['uncited', 'derived'] %} <span class="dim">(derived)</span>{% endif %}</td>
          <td>{{ r.t is not null ? r.t|number_format(1) ~ '%' : '—' }}</td>
          <td>{% if won|length %}{{ won|map(c => (c.candidacyPerson.one() ? '<a href="' ~ c.candidacyPerson.one().url ~ '">' ~ c.nameAsPrinted|e ~ '</a>' : c.nameAsPrinted|e) ~ (c.outcomeEvidence.value == 'derived' ? '&dagger;' : ''))|join(', ')|raw }}{% else %}<span class="dim">Not declared in the documents held</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% set roster = craft.entries().section('organizations').slug('city-of-santa-clarita').one() %}
    <p class="el-note">Winners are named on the strongest record the archive holds, and each election's page says which. Resolution 12-9 declares the winners of April 2012, and the City's own account names the first council of 1987. For every other election no declaring resolution is held yet, but the count agrees with two compilations: the council ledger held in the archive, 1990 to 2018, and CEDA, the state's compilation of local results, 2004 to 2024. Any winner still resting on the count alone is marked &dagger;.{% if roster %} Who served, and when: <a href="{{ roster.url }}#council" style="color:#7A5C1B">the council roster</a>.{% endif %}</p>

    {% if boardEls|length %}
      {% set countyDoc = craft.entries().section('documents').search('"cancelled elections"').one() %}
      <h2 class="el-h2" id="boards" style="margin-top:56px;font-size:13px">THE SCHOOL BOARDS</h2>
      <p class="el-note" style="margin:0 0 20px">Every contested school board election in the valley from 1995 to 2024, from CEDA, the state's compilation of local results, which marks the winners. A seat with no more candidates than places went unvoted and was filled by appointment; those contests are not here{% if countyDoc %}, and the County's <a href="{{ countyDoc.url }}" style="color:#7A5C1B">lists of cancelled elections</a> name them{% endif %}. The boards moved from at-large seats to trustee areas between 2015 and 2020.</p>
      {% set byBody = {} %}
      {% for e in boardEls|reverse %}{% set b = bodyOf['e' ~ e.id] %}{% set byBody = byBody|merge({ ('b' ~ b.id): (byBody['b' ~ b.id] ?? { body: b, els: [] })|merge({ els: ((byBody['b' ~ b.id] ?? { els: [] }).els)|merge([e]) }) }) %}{% endfor %}
      {% for g in byBody|sort((a, b) => a.body.title <=> b.body.title) %}
        <h3 id="{{ g.body.slug }}" style="font-family:'Playfair Display',serif;font-weight:500;font-size:24px;color:#17254C;margin:30px 0 10px"><a href="{{ g.body.url }}" style="color:inherit;text-decoration:none">{{ g.body.title }}</a> <span style="font-family:'Jost',sans-serif;font-size:13px;color:#8A93A3">{{ g.els|length }}</span></h3>
        <table class="el-table">
          <thead><tr><th>ELECTION</th><th>SEAT</th><th>CANDIDATES</th><th>ELECTED</th></tr></thead>
          <tbody>
          {% for e in g.els %}
            {% set d = e.electionDistrict.one() %}
            {% set cands = craft.entries().section('candidacies').relatedTo({ targetElement: e, field: 'candidacyElection' }).all() %}
            {% set won = cands|filter(c => c.outcome.value == 'elected' and c.outcomeEvidence.value != 'uncited')|sort((a, b) => (b.votes ?? 0) <=> (a.votes ?? 0)) %}
            <tr>
              <td><a href="{{ e.url }}">{{ e.electionDate }}</a></td>
              <td>{{ d ? 'Trustee Area ' ~ d.districtNumber : 'At large' }}{% if 'short term' in (e.footnotes ?? [])|map(r => r.note ?? '')|join(' ')|lower %} <span class="dim">(short term)</span>{% endif %}<div class="dim">{{ e.seatsUp }} seat{{ e.seatsUp == 1 ? '' : 's' }}</div></td>
              <td>{{ cands|length }}</td>
              <td>{{ won|map(c => (c.candidacyPerson.one() ? '<a href="' ~ c.candidacyPerson.one().url ~ '">' ~ c.nameAsPrinted|e ~ '</a>' : c.nameAsPrinted|e))|join(', ')|raw }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      {% endfor %}
    {% endif %}
  </main>
</div>
{% endblock %}
