{% extends "_layouts/base" %}
{% block head %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Jost:wght@400;500&family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet">

{% endblock %}

{% block content %}
{% set comSlug = craft.app.request.getParam('community') %}
{% set all = craft.entries().section('places').status(null).orderBy('title asc').all() %}
{% set query = craft.entries().section('places').status(null).orderBy('title asc') %}
{% if comSlug %}{% set term = craft.categories().group('neighborhood').slug(comSlug).status(null).one() %}{% if term %}{% set query = query.relatedTo(term) %}{% endif %}{% endif %}
{% set places = query.all() %}

{% set comIds = [] %}
{% set earliest = null %}
{% for p in all %}
  {% for c in p.neighborhood.all() %}{% if c.id not in comIds %}{% set comIds = comIds|merge([c.id]) %}{% endif %}{% endfor %}
  {% set y = p.dateEstablished ? p.dateEstablished|slice(-4) : '' %}
  {% if y matches '/^\\d{4}$/' and (earliest is null or y < earliest) %}{% set earliest = y %}{% endif %}
{% endfor %}

{% set pins = [] %}
{% for p in places %}
  {% if p.placeLat and p.placeLng %}
    {% set com = p.neighborhood.one() ?? null %}
    {% set pins = pins|merge([{ id: p.id, t: p.title, c: com ? com.title : '', e: p.dateEstablished ?: '', lat: p.placeLat, lng: p.placeLng, u: p.url }]) %}
  {% endif %}
{% endfor %}

<div class="pl">
  <section class="pl-hero">
    <div class="pl-wrap">
      <div class="pl-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Places</span></div>
      <div class="pl-grid">
        <div>
          <div class="pl-kicker">SITES &amp; LANDMARKS</div>
          <h1>Places</h1>
          <p>Specific sites in the Santa Clarita Valley with their own history: buildings, landmarks, stations, ranchos, and natural features. Communities are filters, not places.</p>
        </div>
        <div class="pl-stat">
          <div><b>{{ all|length }}</b><span>PLACES</span></div>
          <div><b>{{ comIds|length }}</b><span>COMMUNITIES</span></div>
          {% if earliest %}<div><b>{{ earliest }}</b><span>EARLIEST ESTABLISHED</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-filters">
    <div class="pl-wrap">
      <div class="pl-lab">COMMUNITY</div>
      <a class="pl-chip {{ not comSlug ? 'on' : '' }}" href="{{ url('places') }}">All communities</a>
      {% for c in craft.categories().group('neighborhood').status(null).orderBy('title asc').all() %}
        {% set n = craft.entries().section('places').relatedTo(c).status(null).count() %}
        {% if n %}<a class="pl-chip {{ comSlug == c.slug ? 'on' : '' }}" href="{{ url('places', {community: c.slug}) }}">{{ c.title }} ({{ n }})</a>{% endif %}
      {% endfor %}
      <div class="pl-count">{{ comSlug ? places|length ~ ' of ' ~ all|length : all|length }} places</div>
    </div>
  </section>

  <main class="pl-main">
    <div class="pl-wrap">
      {% include "_partials/map-index" with {
        pins: pins,
        hint: 'Select a place below to locate it, or a pin to jump to its card.',
        fitAllLabel: 'Fit all places'
      } only %}

      {% if places|length %}
      <div class="pl-cards">
        {% for p in places %}
          {% set img = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
          {% set com = p.neighborhood.one() ?? null %}
          <a class="pl-card" id="card{{ p.id }}" data-id="{{ p.id }}" href="{{ p.url }}">
            <div class="pl-ph">{% if img %}<img src="{{ img.url }}" alt="">{% else %}<span>{{ p.title|slice(0,1) }}</span>{% endif %}</div>
            <div class="pl-body">
              <h3>{{ p.title }}</h3>
              {% if p.dateEstablished %}<div class="pl-meta">Est. {{ p.dateEstablished }}</div>{% endif %}
              <div class="pl-comm">{{ com ? com.title : 'Community not set' }}</div>
            </div>
          </a>
        {% endfor %}
      </div>
      {% else %}
        <div class="pl-empty">No places in this community yet. <a href="{{ url('places') }}" style="color:#A9842B">Show all</a></div>
      {% endif %}
    </div>
  </main>
</div>

{% endblock %}
