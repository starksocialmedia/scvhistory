{% extends "_layouts/base" %}
{% set metaDescription = 'Specific sites in the Santa Clarita Valley with their own history: buildings, landmarks, stations, ranchos and natural features.' %}
{% block head %}

{% endblock %}

{% block content %}
{% set comSlug = craft.app.request.getParam('community') %}
{% set kind = craft.app.request.getParam('kind') %}
{% set all = craft.entries().section('places').status(null).orderBy('title asc').all() %}

{#- placeType is added by scripts/import/add_place_type_field.php and may not be
    on the layout yet. Read the handles off the layout rather than asking `is
    defined`, which answers true on a type that lacks the field and then throws
    when the value is read. -#}
{% set handles = all|length ? all[0].fieldLayout.customFields|map(f => f.handle) : [] %}
{% set hasKinds = 'placeType' in handles %}

{% set KINDS = {
  natural:  'Natural features',
  road:     'Roads',
  ranch:    'Ranches',
  building: 'Buildings',
  park:     'Parks',
  site:     'Sites',
  trail:    'Trails and routes'
} %}

{% set query = craft.entries().section('places').status(null).orderBy('title asc') %}
{% if comSlug %}{% set term = craft.categories().group('neighborhood').slug(comSlug).status(null).one() %}{% if term %}{% set query = query.relatedTo(term) %}{% endif %}{% endif %}
{% if hasKinds and kind and KINDS[kind] is defined %}{% set query = query.placeType(kind) %}{% endif %}
{% set places = query.all() %}

{#- Counts for the chips, taken from the whole set so a chip still says how many
    it would show while another filter is on. A chip that reads zero because of
    a filter the reader forgot they set is how a filter row loses their trust. -#}
{% set kindCounts = {} %}
{% if hasKinds %}
  {% for p in all %}
    {% set k = p.placeType ?: 'unset' %}
    {% set kindCounts = kindCounts|merge({ (k): (kindCounts[k] ?? 0) + 1 }) %}
  {% endfor %}
{% endif %}

{% set comIds = [] %}
{% set earliest = null %}
{% for p in all %}
  {% for c in p.neighborhood.all() %}{% if c.id not in comIds %}{% set comIds = comIds|merge([c.id]) %}{% endif %}{% endfor %}
  {% set y = p.dateEstablished ? p.dateEstablished|slice(-4) : '' %}
  {% if y matches '/^\\d{4}$/' and (earliest is null or y < earliest) %}{% set earliest = y %}{% endif %}
{% endfor %}

{% set pins = [] %}
{% for p in places %}
  {% if p.placeLat and p.placeLng %}
    {% set com = p.neighborhood.one() ?? null %}
    {% set pins = pins|merge([{ id: p.id, t: p.title, c: com ? com.title : '', e: p.dateEstablished ?: '', lat: p.placeLat, lng: p.placeLng, u: p.url }]) %}
  {% endif %}
{% endfor %}

<div class="pl">
  <section class="pl-hero">
    <div class="pl-wrap">
      <div class="pl-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Places</span></div>
      <div class="pl-grid">
        <div>
          <div class="pl-kicker">SITES &amp; LANDMARKS</div>
          <h1>Places</h1>
          <p>Specific sites in the Santa Clarita Valley with their own history: buildings, landmarks, stations, ranchos, and natural features. Communities are filters, not places.</p>
        </div>
        <div class="pl-stat">
          <div><b>{{ all|length }}</b><span>PLACES</span></div>
          <div><b>{{ comIds|length }}</b><span>COMMUNITIES</span></div>
          {% if earliest %}<div><b>{{ earliest }}</b><span>EARLIEST ESTABLISHED</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-filters">
    <div class="pl-wrap">
      <div class="pl-lab">COMMUNITY</div>
      <a class="pl-chip {{ not comSlug ? 'on' : '' }}" href="{{ url('places', kind ? {kind: kind} : {}) }}">All communities</a>
      {% for c in craft.categories().group('neighborhood').status(null).orderBy('title asc').all() %}
        {% set n = craft.entries().section('places').relatedTo(c).status(null).count() %}
        {% if n %}<a class="pl-chip {{ comSlug == c.slug ? 'on' : '' }}" href="{{ url('places', kind ? {community: c.slug, kind: kind} : {community: c.slug}) }}">{{ c.title }} ({{ n }})</a>{% endif %}
      {% endfor %}

      {% if hasKinds %}
        <div class="pl-lab" style="margin-top:14px">KIND</div>
        <a class="pl-chip {{ not kind ? 'on' : '' }}" href="{{ url('places', comSlug ? {community: comSlug} : {}) }}">All kinds</a>
        {% for k, label in KINDS %}
          {% set n = kindCounts[k] ?? 0 %}
          {% if n %}<a class="pl-chip {{ kind == k ? 'on' : '' }}" href="{{ url('places', comSlug ? {community: comSlug, kind: k} : {kind: k}) }}">{{ label }} ({{ n }})</a>{% endif %}
        {% endfor %}
      {% endif %}

      <div class="pl-count">{{ comSlug or kind ? places|length ~ ' of ' ~ all|length : all|length }} places</div>
    </div>
  </section>

  <main class="pl-main">
    <div class="pl-wrap">
      {% include "_partials/map-index" with {
        pins: pins,
        mapLabel: 'Map of places in the Santa Clarita Valley, with community boundaries',
        polygonsUrl: siteUrl ~ 'data/communities.geojson',
        outlineUrl: url('places'),
        activeSlug: comSlug,
        hint: 'Select a place below to locate it, or a pin to jump to its card.',
        fitAllLabel: 'Fit all places'
      } only %}

      {% if places|length %}
      <div class="pl-cards">
        {% for p in places %}
          {% set img = p.featuredImage is defined ? p.featuredImage.one() ?? null : null %}
          {% set com = p.neighborhood.one() ?? null %}
          <a class="pl-card" id="card{{ p.id }}" data-id="{{ p.id }}" href="{{ p.url }}">
            <div class="pl-ph">{% if img %}<img src="{{ img.url }}" alt="">{% else %}<span>{{ p.title|slice(0,1) }}</span>{% endif %}</div>
            <div class="pl-body">
              <h3>{{ p.title }}</h3>
              {% if p.dateEstablished %}<div class="pl-meta">Est. {{ p.dateEstablished }}</div>{% endif %}
              <div class="pl-comm">{{ com ? com.title : 'Community not set' }}{% if hasKinds and p.placeType %} &middot; {{ KINDS[p.placeType] ?? p.placeType }}{% endif %}</div>
            </div>
          </a>
        {% endfor %}
      </div>
      {% else %}
        <div class="pl-empty">No places match these filters yet. <a href="{{ url('places') }}" style="color:#7A5C1B">Show all</a></div>
      {% endif %}
    </div>
  </main>
</div>

{% endblock %}
