{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/scv-extra-css" %}
  {% if entry.placeLat and entry.placeLng %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">{% endif %}
{% endblock %}

{% block content %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
{% set depicted = craft.entries().section('articles').relatedTo({ targetElement: entry, field: 'depictsPlace' }).status(null).all() %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('places') }}">Places</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">Place</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if entry.placeAliases %}<p class="scv-aka">Also known as {{ entry.placeAliases }}</p>{% endif %}
      {% if entry.dateEstablished or entry.placeAddress or entry.placeChlNumber %}
        <div class="scv-facts">
          {% if entry.dateEstablished %}<div><b>Established</b>{{ entry.dateEstablished }}</div>{% endif %}
          {% if entry.placeAddress %}<div><b>Address</b>{{ entry.placeAddress }}</div>{% endif %}
          {% if entry.placeChlNumber %}<div><b>Landmark</b>CHL No. {{ entry.placeChlNumber }}</div>{% endif %}
        </div>
      {% endif %}
      {% if era or entry.historicalPeriod.all()|length or communities|length %}
        <div class="scv-chips">
          {% if era %}<span class="scv-chip">{{ era.title }}</span>{% endif %}
          {% for p in entry.historicalPeriod.all() %}<span class="scv-chip">{{ p.title }}</span>{% endfor %}
          {% for c in communities %}<a class="scv-chip solid" href="{{ url('places', { community: c.slug }) }}">{{ c.title }}</a>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}">
            {% if hero.title and hero.title != entry.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}</figure>
          {% endif %}

          {% if entry.body %}
            <article class="scv-card">
              {% include "_partials/prose" with { text: entry.body } %}
              {% if entry.culturalSensitivityNote %}<div class="scv-note">{{ entry.culturalSensitivityNote }}</div>{% endif %}
            </article>
          {% elseif entry.culturalSensitivityNote %}
            <article class="scv-card"><div class="scv-note">{{ entry.culturalSensitivityNote }}</div></article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/location" with {
            lat: entry.placeLat, lng: entry.placeLng, title: entry.title,
            address: entry.placeAddress, established: entry.dateEstablished,
            mapId: 'scv-place-map'
          } only %}

          {% include "_partials/sidebar/meta" with { entry: entry } only %}
          {% include "_partials/sidebar/cite" with { entry: entry } only %}

          {% include "_partials/sidebar/related-list" with { title: 'Associated people', entries: entry.placePeople.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Organizations', entries: entry.placeOrganizations.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Events', entries: entry.placeEvents.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles', entries: entry.placeArticles.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Articles depicting this place', entries: depicted } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Related places', entries: entry.relatedPlaces.all() } only %}

          {% if communities|length %}
            {% embed "_partials/sidebar/box" with { title: 'Communities', communities: communities } only %}
              {% block body %}<ul>{% for c in communities %}<li><a href="{{ url('places', { community: c.slug }) }}">{{ c.title }}</a></li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/external" with {
            wikipedia: entry.placeWikipediaUrl ?? null,
            chl: entry.placeChlUrl ?? null,
            chlNumber: entry.placeChlNumber,
            scvhl: entry.placeScvhlUrl ?? null,
            legacy: entry.placeLegacyUrl ?: entry.legacyUrl
          } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
