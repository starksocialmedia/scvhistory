{% extends "_layouts/base" %}
{% set metaDescription = 'Columns, histories and documents from three decades of Santa Clarita Valley research, presented as their authors wrote them.' %}
{% block head %}
{% include "_partials/scv-extra-css" %}
{% css %}
.ap{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}
.ap-band{background:#FDF7EA;border-bottom:1px solid #EFE6D0;color:#17254C}
.ap-band-in{padding-top:44px;padding-bottom:48px}
.ap-crumbs{font-size:13px;color:#5B6472;margin-bottom:22px}
.ap-crumbs a{color:#C4A031;text-decoration:none}
.ap-head{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:end}
.ap-head h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(40px,5vw,56px);line-height:1.05;margin:0 0 16px;color:#17254C}
.ap-head p{font-size:18px;line-height:1.65;margin:0;color:#4A5260;max-width:560px}
.ap-stats{display:flex;gap:40px;flex-wrap:wrap;justify-self:end}
.ap-stats .n{font-family:'Playfair Display',serif;font-size:44px;line-height:1;color:#17254C}
.ap-stats .l{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.14em;color:#C4A031;margin-top:8px}
.ap-filters{background:#fff;border-bottom:1px solid #E2E4E8;position:sticky;top:0;z-index:5}
.ap-filters-in{padding-top:16px;padding-bottom:16px;display:flex;flex-direction:column;gap:12px}
.ap-countlab{margin-left:auto;font-size:14px;color:#5B6472}
.ap-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ap-row .lab{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#5B6472;width:96px;flex:none}
.ap-chip{background:#fff;color:#8F6E22;border:1px solid #C4A031;font-family:'Jost',sans-serif;font-size:13px;padding:7px 13px;border-radius:3px;text-decoration:none;display:inline-block}
.ap-chip:hover{background:#FDF7EA}
.ap-chip.on{background:#17254C;color:#fff;border-color:#17254C}
.ap-main{padding-top:48px;padding-bottom:96px;display:flex;flex-direction:column;gap:56px}
.ap-colhead{background:#FDF7EA;border:1px solid #EFE6D0;border-top:3px solid #C4A031;padding:24px 28px;display:flex;gap:28px;flex-wrap:wrap;align-items:center}
.ap-colhead img{width:96px;height:128px;object-fit:cover;flex:none;border:1px solid #EFE6D0}
.ap-colhead h2{font-family:'Playfair Display',serif;font-weight:500;font-size:32px;line-height:1.15;margin:8px 0;color:#17254C}
.ap-topkicker{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;color:#8F6E22;margin-bottom:14px}
.ap-kicker{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.14em;color:#8F6E22}
.ap-meta{font-size:15px;color:#5B6472}
.ap-cta{font-family:'Jost',sans-serif;font-weight:500;font-size:15px;color:#17254C;background:#C4A031;padding:12px 20px;flex:none;text-decoration:none}
.ap-otherhead{display:flex;align-items:baseline;justify-content:space-between;gap:16px;border-top:3px solid #C4A031;padding-top:14px}
.ap-otherhead h2{font-family:'Playfair Display',serif;font-weight:500;font-size:28px;margin:0;color:#17254C}
.ap-grid{background:#fff;border:1px solid #E2E4E8;border-top:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
.ap-item{display:grid;grid-template-columns:44px minmax(0,1fr);gap:14px;padding:16px 20px;border-bottom:1px solid #E2E4E8;border-right:1px solid #E2E4E8;color:inherit;min-height:72px;text-decoration:none}
.ap-item:hover{background:#FDF7EA}
.ap-item .num{font-family:'Playfair Display',serif;font-size:26px;line-height:1;color:#8F6E22;padding-top:2px}
.ap-item .t{font-family:'Jost',sans-serif;font-weight:500;font-size:16.5px;line-height:1.3;color:#17254C}
.ap-item .m{font-size:13px;line-height:1.5;color:#5B6472;margin-top:4px}
.ap-empty{text-align:center;padding:64px 0;color:#5B6472;font-size:16px}
{% endcss %}
{% endblock %}

{% block content %}
{% set eraSlug = craft.app.request.getParam('era') %}
{% set colSlug = craft.app.request.getParam('collection') %}
{% set query = craft.entries().section('articles').status(null).orderBy('title asc') %}
{% if eraSlug %}{% set eraTerm = craft.categories().group('historicalEra').slug(eraSlug).status(null).one() %}{% if eraTerm %}{% set query = query.relatedTo(eraTerm) %}{% endif %}{% endif %}
{% if colSlug %}{% set colEntry = craft.entries().section('collections').slug(colSlug).status(null).one() %}{% if colEntry %}{% set query = query.relatedTo({targetElement: colEntry, field: 'partOfCollection'}) %}{% endif %}{% endif %}
{% set entries = query.all() %}
{% set allArticles = craft.entries().section('articles').status(null).count() %}
{% set authorIds = [] %}
{% for a in craft.entries().section('articles').status(null).all() %}
  {% set w = a.writtenBy.one() ?? null %}
  {% if w and w.id not in authorIds %}{% set authorIds = authorIds|merge([w.id]) %}{% endif %}
{% endfor %}
{% set collectionsWithArticles = [] %}
{% for c in craft.entries().section('collections').status(null).all() %}
  {% set n = craft.entries().section('articles').relatedTo({targetElement: c, field: 'partOfCollection'}).status(null).count() %}
  {% if n %}{% set collectionsWithArticles = collectionsWithArticles|merge([c]) %}{% endif %}
{% endfor %}

<div class="ap">
  <div class="scv-band ap-band">
    <div class="scv-band-in ap-band-in">
      <div class="ap-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>Articles</span></div>
      <div class="ap-head">
        <div>
          <div class="ap-topkicker">COLUMNS &amp; DOCUMENTS</div>
          <h1>Articles</h1>
          <p>Columns, histories, and documents from three decades of Santa Clarita Valley research, presented as their authors wrote them.</p>
        </div>
        <div class="ap-stats">
          <div><div class="n">{{ allArticles }}</div><div class="l">ARTICLES</div></div>
          <div><div class="n">{{ collectionsWithArticles|length }}</div><div class="l">COLLECTIONS</div></div>
          <div><div class="n">{{ authorIds|length }}</div><div class="l">AUTHORS</div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="scv-band ap-filters">
    <div class="scv-band-in ap-filters-in">
      <div class="ap-row">
        <div class="lab">ERA</div>
        <a class="ap-chip {{ not eraSlug ? 'on' : '' }}" href="{{ url('articles', colSlug ? {collection: colSlug} : {}) }}">All</a>
        {% for e in craft.categories().group('historicalEra').status(null).all() %}
          {% set n = craft.entries().section('articles').relatedTo(e).status(null).count() %}
          {% if n %}<a class="ap-chip {{ eraSlug == e.slug ? 'on' : '' }}" href="{{ url('articles', colSlug ? {era: e.slug, collection: colSlug} : {era: e.slug}) }}">{{ e.title }} ({{ n }})</a>{% endif %}
        {% endfor %}
      </div>
      <div class="ap-row">
        <div class="lab">COLLECTION</div>
        <a class="ap-chip {{ not colSlug ? 'on' : '' }}" href="{{ url('articles', eraSlug ? {era: eraSlug} : {}) }}">All</a>
        {% for c in collectionsWithArticles %}
          {% set n = craft.entries().section('articles').relatedTo({targetElement: c, field: 'partOfCollection'}).status(null).count() %}
          <a class="ap-chip {{ colSlug == c.slug ? 'on' : '' }}" href="{{ url('articles', eraSlug ? {collection: c.slug, era: eraSlug} : {collection: c.slug}) }}">{{ c.title ?: c.slug }} ({{ n }})</a>
        {% endfor %}
        <div class="ap-countlab">{{ entries|length }} article{{ entries|length == 1 ? '' : 's' }}</div>
      </div>
    </div>
  </div>

  <main class="scv-band-in ap-main">
    {% if entries|length %}
      {% set grouped = {} %}
      {% for e in entries %}
        {% set c = e.partOfCollection.one() ?? null %}
        {% set key = c ? c.slug : '_other' %}
        {% set grouped = grouped|merge({ (key): (grouped[key] ?? [])|merge([e]) }) %}
      {% endfor %}

      {% for key, items in grouped %}
        {% set col = key != '_other' ? craft.entries().section('collections').slug(key).status(null).one() : null %}
        {% set ordered = col ? col.articlesInCollection.all() : [] %}
        {% set list = [] %}
        {% if ordered|length %}
          {% for a in ordered %}{% for i in items %}{% if i.id == a.id %}{% set list = list|merge([a]) %}{% endif %}{% endfor %}{% endfor %}
        {% else %}
          {% set list = items %}
        {% endif %}

        <section>
          {% if col %}
            {% set img = col.featuredImage.one() ?? null %}
            {% set colAuthor = col.writtenBy.one() ?? null %}
            <div class="ap-colhead">
              {% if img %}<img src="{{ img.url }}" alt="">{% endif %}
              <div style="flex:1;min-width:240px">
                <div class="ap-kicker">COLLECTION</div>
                <h2>{{ col.title ?: col.slug }}</h2>
                <div class="ap-meta">{% if colAuthor %}{{ colAuthor.title }} &middot; {% endif %}{{ list|length }} article{{ list|length == 1 ? '' : 's' }}</div>
              </div>
              <a class="ap-cta" href="{{ col.url }}">Open collection</a>
            </div>
          {% else %}
            <div class="ap-otherhead">
              <h2>Other articles</h2>
              <div class="ap-meta">{{ list|length }} article{{ list|length == 1 ? '' : 's' }}</div>
            </div>
          {% endif %}

          <div class="ap-grid">
            {% for a in list %}
              {% set author = a.writtenBy.one() ?? null %}
              <a class="ap-item" href="{{ a.url }}">
                <div class="num">{{ loop.index }}</div>
                <div style="min-width:0">
                  <div class="t">{{ a.title }}</div>
                  <div class="m">{% if author %}{{ author.title }}{% endif %}{% if a.originalPublishDate %} &middot; {{ a.originalPublishDate }}{% endif %}</div>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    {% else %}
      <div class="ap-empty">No articles match those filters. <a href="{{ url('articles') }}" style="color:#8F6E22">Clear filters</a></div>
    {% endif %}
  </main>
</div>
{% endblock %}
