{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
  {% css %}
  /* ── Article band ─────────────────────────────────────────────── */
  .ar h1{color:#7A5C1B}
  .ar-coll{font-family:'Playfair Display',serif;font-size:21px;line-height:1.3;margin:0 0 14px}
  .ar-coll a{color:#7A5C1B;text-decoration:none}
  .ar-coll a:hover{text-decoration:underline}
  .ar-byline{font-size:15.5px;color:#5B6472;line-height:1.7}
  .ar-byline a{color:#17254C;text-decoration:none}
  .ar-byline a:hover{color:#7A5C1B}

  /* The body was a flex column with a 22px gap, which read correctly and
     silently disabled every float in it: a flex item does not float, so each
     picture the prose placed inline took the full column instead of sitting
     beside the text. Ordinary block flow, and the 22px kept as a margin. */
  .ar .rec-body{display:block}
  .ar .rec-body>p{margin:0 0 22px}
  .ar .rec-body>p:last-child{margin-bottom:0}

  /* ── Hero ─────────────────────────────────────────────────────── */
  .ar-hero{margin:0 0 30px}
  .ar-hero img{width:100%;height:auto;display:block;border:1px solid #E2E4E8;background:#fff}
  .ar-hero figcaption{font-size:13.5px;font-style:italic;color:#5B6472;line-height:1.55;margin-top:9px}

  /* Two layers, exactly as the collection lander has them. */
  .ar .rec-band{position:relative;overflow:hidden}
  .ar-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;z-index:0}
  .ar-bg2{position:absolute;inset:0;background-size:cover;background-position:right center;filter:contrast(1.16) brightness(.92);z-index:1}
  .ar .rec-band .rec-wrap{position:relative;z-index:2}

  /* The artwork is composed with its subject at the right, so the band content
     is capped to the left of it. Everything in the band shares one column:
     kicker, title, collection, byline and chips, so none of them can run under
     the drawing. Without artwork the band is full width as before.

     52 percent at every width, not a wider cap that narrows on small screens.
     Measured on the artwork: the dense figure begins at 55.6 percent of the
     band, mid tone at 53.2, the faintest hair at 44.9, and those fractions hold
     at any width because the image is wider in aspect than the band, so cover
     matches the band width exactly. A 60 percent column therefore sits inside
     the figure at every width and only looks clear while the title happens to
     be short. Reynolds has 71 chapters whose titles we have not seen. */
  .ar-hasband .rec-band .rec-crumbs,
  .ar-hasband .rec-band .rec-head>div:first-child{max-width:52%}
  .ar h1{text-wrap:balance}
  @media(max-width:640px){
    /* 52 percent of a phone is unreadable, so the text takes the full width and
       the artwork drops back to a wash behind it. */
    .ar-hasband .rec-band .rec-crumbs,
    .ar-hasband .rec-band .rec-head>div:first-child{max-width:none}
    .ar-bg2{opacity:.22}
  }

  /* ── Previous / next ──────────────────────────────────────────── */
  .ar-pn{display:grid;grid-template-columns:1fr 1fr;gap:24px;border-top:1px solid #E2E4E8;border-bottom:1px solid #E2E4E8;padding:16px 0;margin:0 0 32px}
  .ar-pn.after{margin:40px 0 0}
  .ar-pn .l{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#7A5C1B;display:block;margin-bottom:5px}
  .ar-pn a{font-family:'Playfair Display',serif;font-size:17px;line-height:1.3;color:#17254C;text-decoration:none;display:block}
  .ar-pn a:hover{color:#7A5C1B}
  .ar-pn .nx{text-align:right}
  @media(max-width:600px){.ar-pn{grid-template-columns:1fr}.ar-pn .nx{text-align:left}}

  /* ── Sign-off ─────────────────────────────────────────────────── */
  /* The author signing the piece, not a caption on it. It was 16px grey, a
     shade smaller than the prose and the same colour as the furniture, which
     read as a label. It is the last thing before the citation and it belongs
     to the text: Playfair, navy, small caps, larger than the prose rather than
     smaller, and enough space above it to end the piece rather than begin the
     furniture.

     Not italic. The small caps already say this is a signature, and italic on
     top of them would make it decorative where it should be an attribution. */
  .ar-sig{margin:60px 0 0;display:flex;align-items:center;gap:18px}
  .ar-sig .r{flex:1;height:1px;background:#E2E4E8}
  .ar-sig .n{font-family:'Playfair Display',serif;font-variant-caps:small-caps;letter-spacing:.06em;font-size:20px;color:#17254C;white-space:nowrap}

  /* ── Sidebar name lists ───────────────────────────────────────── */
  .ar-sb{background:#FDF7EA;border:1px solid #EFE6D0;border-top:3px solid #C4A031;padding:16px 20px 18px}
  .ar-sb .lab{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#7A5C1B;margin-bottom:10px}
  .ar-sb .row{display:grid;grid-template-columns:44px minmax(0,1fr);gap:13px;align-items:center;
              color:inherit;text-decoration:none;padding:7px 0;border-bottom:1px solid #EFE6D0}
  .ar-sb .row:last-child{border-bottom:0}
  .ar-sb .row:hover .n{color:#7A5C1B;text-decoration:underline}
  .ar-sb .th{width:44px;height:44px;border-radius:50%;border:1px solid #C4A031;overflow:hidden;background:#fff;
             display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;
             font-size:15px;color:#C4A031;flex:none}
  .ar-sb .th img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  .ar-sb .tx{min-width:0}
  .ar-sb .n{display:block;font-family:'Playfair Display',serif;font-size:16.5px;line-height:1.25;color:#17254C}
  .ar-sb .r{display:block;font-size:12.5px;color:#5B6472;margin-top:1px}
  /* A derived link is marked, quietly. It is worth following and it is not a
     relationship the archive has confirmed. */
  .ar-sb .dv{color:#C4A031;margin-left:5px;cursor:help}

  /* ── Photos and documents ─────────────────────────────────────── */
  .ar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:22px 18px;margin-top:22px}
  .ar-tile{margin:0;min-width:0}
  .ar-tile .sh{position:relative;background:#fff;border:1px solid #E2E4E8;padding:7px}
  .ar-tile .im{display:block}
  .ar-tile img{width:100%;height:auto;display:block;max-height:300px;object-fit:contain;object-position:top}
  .ar-tile .sh:hover{border-color:#C4A031}
  .ar-tile .zoom{position:absolute;right:9px;bottom:9px;width:26px;height:26px;border:1px solid #E2E4E8;
                 background:rgba(255,255,255,.94);color:#7A5C1B;font-size:14px;line-height:1;cursor:zoom-in;padding:0}
  .ar-tile .zoom:hover{border-color:#C4A031;background:#fff}
  .ar-tile figcaption{margin-top:9px}
  .ar-tile .chip{display:inline-block;font-family:'Jost',sans-serif;font-size:10px;letter-spacing:.12em;
                 text-transform:uppercase;color:#7E6118;border:1px solid #C4A031;padding:2px 6px;margin-bottom:5px}
  .ar-tile .t{display:block;font-family:'Playfair Display',serif;font-size:15px;line-height:1.3;color:#17254C;text-decoration:none}
  .ar-tile a.t:hover{color:#7A5C1B;text-decoration:underline}
  .ar-tile .t.plain{font-family:inherit;font-size:13px;font-style:italic;color:#5B6472}
  .ar-tile .d{display:block;font-size:12.5px;color:#5B6472;margin-top:3px}

  /* ── About the author ─────────────────────────────────────────── */
  .ar-author .lab{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#7A5C1B;margin-bottom:16px}
  .ar-author .in{display:flex;gap:22px;align-items:flex-start;flex-wrap:wrap}
  .ar-author .ph{width:96px;height:96px;border-radius:50%;flex:none;overflow:hidden;background:#fff;border:1px solid #EFE6D0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:30px;color:#C4A031}
  .ar-author .ph img{width:100%;height:100%;object-fit:cover;object-position:top}
  .ar-author .nm{font-family:'Playfair Display',serif;font-size:23px;color:#17254C;line-height:1.2}
  .ar-author .oc{font-size:14px;color:#5B6472;margin-top:4px}
  .ar-author .bio{font-size:15.5px;line-height:1.7;color:#2C2C2C;margin-top:12px}
  .ar-author .bio p{margin:0 0 12px}
  .ar-author .more{display:inline-block;margin-top:10px;font-family:'Jost',sans-serif;font-size:14px;color:#7A5C1B;text-decoration:none}
  .ar-author .more:hover{text-decoration:underline}

  /* ── Sidebar extras ───────────────────────────────────────────── */
  .ar-collcard img{width:100%;height:auto;display:block;border:1px solid #EFE6D0;margin-bottom:10px}
  .ar-collcard a{font-family:'Playfair Display',serif;font-size:18px;line-height:1.3;color:#17254C;text-decoration:none;display:block}
  .ar-collcard a:hover{color:#7A5C1B}
  .ar-chapters{list-style:none;margin:0;padding:0;counter-reset:ch}
  .ar-chapters li{border-bottom:1px solid #EFE6D0}
  .ar-chapters li:last-child{border-bottom:0}
  .ar-chapters a,.ar-chapters span.cur{display:flex;gap:10px;padding:9px 0;font-size:14.5px;line-height:1.4;color:#17254C;text-decoration:none}
  .ar-chapters a:hover{color:#7A5C1B}
  .ar-chapters .n{font-family:'Jost',sans-serif;font-size:11.5px;color:#5B6472;flex:none;width:20px;padding-top:2px}
  .ar-chapters li.on{background:#FDF7EA;border-left:3px solid #C4A031;margin-left:-20px;padding-left:17px}
  .ar-chapters li.on span.cur{font-weight:500}
  .ar-chapters li.gap span{display:block;padding:6px 0 6px 30px;font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.05em;color:#A8AEB8}
  .ar-allch{display:block;margin-top:10px;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#7A5C1B;text-decoration:none}
  .ar-allch:hover{color:#17254C}
  .ar-searchbar{display:flex;background:#fff;border:1px solid #DCC98F}
  .ar-searchbar input{flex:1;min-width:0;border:0;outline:none;padding:11px 13px;font-family:'Public Sans',sans-serif;font-size:15px;color:#2C2C2C;background:transparent}
  .ar-searchbar button{border:0;background:#C4A031;color:#17254C;font-family:'Jost',sans-serif;font-weight:500;font-size:14px;padding:0 16px;cursor:pointer}
  .ar-searchbar button:hover{background:#7A5C1B;color:#fff}
  {% endcss %}
{% endblock %}

{% block content %}
{#
  Article record.

  Markup, inline styles and structure are reproduced from
  design/article-source.html, which governs appearance. Data comes from the
  record. sc-for and sc-if are replaced by Twig; the illustrative numbers in the
  design are live values here.

  Two things in the design are placeholders and are deliberately absent: the
  account menu in the header, and the Save button in the tools row.

  What the data does and does not carry:
  - No tags field exists in this install. The chips are the historical era,
    outlined gold, and the communities, solid navy, as drawn.
  - featuredImage on a collection article is a title card with the headline
    lettered into it, so it never opens the body; it feeds og:image and the
    index thumbnails only. bandImage washes behind the band, with no fallback
    from one to the other.
  - Prev and next come from the collection's own order, which the chapter
    window uses too, so the two always agree.
#}
{% set F = {} %}
{% for h in ['body','subheadline','originalPublishDate','originallyPublishedTitle','sourceLine',
             'photoSources','finePrint','archiveUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}

{#- The annotations table, read through the layout rather than with "is
    defined", which answers true for a field the entry type does not have and
    then throws when it is read. -#}
{% set edNotes = [] %}
{% for f in entry.fieldLayout.customFields %}
  {% if f.handle == 'editorNotes' %}{% set edNotes = entry.editorNotes ?? [] %}{% endif %}
{% endfor %}

{% set collection = entry.partOfCollection.one() ?? null %}

{% set bandImg = null %}
{% for el in [entry, collection]|filter(x => x) %}
  {% if bandImg is null %}
    {% set can = false %}
    {% for f in el.fieldLayout.customFields %}
      {% if f.handle == 'bandImage' %}{% set can = true %}{% endif %}
    {% endfor %}
    {% if can and el.bandImage %}{% set bandImg = el.bandImage.one() ?? null %}{% endif %}
  {% endif %}
{% endfor %}

{% set author = entry.writtenBy.one() ?? null %}
{% set editor = entry.editedBy.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set periods = entry.historicalPeriod.all() %}
{% set people = entry.subjectPerson.all() %}
{% set publishers = entry.publishedBy.all() %}
{% set year = F.originalPublishDate ? F.originalPublishDate|slice(-4) : '' %}

{% set chapters = collection
  ? (collection.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: collection, field: 'partOfCollection' }).status(null).all())
  : [] %}
{% set idx = null %}
{% for c in chapters %}{% if c.id == entry.id %}{% set idx = loop.index0 %}{% endif %}{% endfor %}
{% set prev = idx is not null and idx > 0 ? chapters[idx - 1] : null %}
{% set next = idx is not null and idx < (chapters|length - 1) ? chapters[idx + 1] : null %}

{#- The lead. subheadline where one exists, else the first paragraph promoted
    out of the body, else nothing. Promoting means the body starts at the
    second paragraph, or the same words would be read twice. -#}
{% set bodyText = F.body %}
{% set lead = F.subheadline %}
{% if lead == '' and bodyText %}
  {% set paras = bodyText|split('\n\n')|filter(p => p|trim != '')|values %}
  {#- Not a paragraph that carries a footnote. The lead is printed as plain
      text, outside the prose partial, so a [mfn] block promoted into it was
      rendered as the literal shortcode and a [N] marker as a bare bracket. A
      paragraph that cites something is body text and stays in the body, where
      the note can open under it. -#}
  {#- Same test the prose partial uses, and the same correction: a digit after
      the bracket is what tells a date from a marker. A rule rejecting a marker
      preceded by a word character rejected "in 1921[1]", so that paragraph was
      promoted into the lead and printed as plain text with its bracket showing.
      The first marker on chapter 5 was disappearing for exactly that reason. -#}
  {% set firstHasNote = paras|length > 1 and (
       paras|first|lower matches '/\\[mfn/'
       or paras|first matches '/\\[\\s*\\d{1,3}\\s*\\](?!\\d)/') %}
  {% if paras|length > 1 and not firstHasNote %}
    {% set lead = paras|first|striptags|trim %}
    {% set bodyText = paras|slice(1)|join('\n\n') %}
  {% endif %}
{% endif %}

{% set words = F.body ? F.body|striptags|split(' ')|filter(w => w|trim)|length : 0 %}
{% set media = recImages|merge(recDocs) %}

{#- Images that were links to another record. The same layer prose.twig reads. -#}
{#- The enlarge index. See _partials/prose.twig for why the magnifier is
    conditional rather than always drawn. -#}
{% set enlarge = {} %}
{% set enlRaw = source('_data/enlarge.json', true) %}
{% if enlRaw|trim %}{% set enlarge = enlRaw|json_decode %}{% endif %}

{% set imgLinks = {} %}
{% set il = source('_data/image-links/' ~ entry.id ~ '.json', true) %}
{% if il|trim %}{% set imgLinks = (il|json_decode).links ?? {} %}{% endif %}

{#- The band. Classes, not inline styles, and the classes are the shared ones
    in _partials/record/css.twig. This block carried its own copy of every value
    because it was reproduced from design/article-source.html; the copy has been
    folded back so there is one set of numbers for every band on the site and
    nothing to drift. -#}
<section class="rec-band{{ bandImg ? ' rec-band--art' : '' }}">
  {% if bandImg %}
    <div class="rec-bandart" style="background-image: url('{{ bandImg.url }}')" role="presentation"></div>
    <div class="rec-bandfade" role="presentation"></div>
  {% endif %}
  <div class="rec-wrap">
    <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('articles') }}">Articles</a>{% if collection %} &rsaquo; <a href="{{ collection.url }}">{{ collection.title }}</a>{% endif %} &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
    <div class="rec-bandcol">
      <div class="rec-kick">
        <span class="a">ARTICLES</span>{% if era %}<span class="r"></span><span class="b">{{ era.title|upper }}</span>{% endif %}
      </div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if collection %}<div class="rec-sub"><a href="{{ collection.url }}">{{ collection.title }}</a></div>{% endif %}
      {% if author or editor or F.originalPublishDate %}
        <div class="rec-byline">
          {%- if author %}By <a href="{{ author.url }}">{{ author.title }}</a>{% endif -%}
          {%- if editor %}{% if author %} &middot; {% endif %}Edited by <a href="{{ editor.url }}">{{ editor.title }}</a>{% endif -%}
          {%- if F.originalPublishDate %}{% if author or editor %} &middot; {% endif %}{{ F.originalPublishDate }}{% endif -%}
        </div>
      {% endif %}
      {% if periods|length or communities|length %}
        <div class="rec-chips">
          {% for p in periods %}<a class="rec-chip" href="{{ p.url ?? '#' }}">{{ p.title }}</a>{% endfor %}
          {% for c in communities %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<main style="max-width: 1320px; margin: 0 auto; padding: 40px 40px 90px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 344px); gap: 56px; align-items: start">

  <article style="min-width: 0">

    {% include "_partials/record/note" with { text: noteTop } only %}
    {% include "_partials/record/editor-notes" with { rows: edNotes, position: 'top' } only %}

    {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText', words: words } only %}

    {% if lead %}
      {#- No measure. The prose takes the column, the way the tools row, the
          rule above it and the photographs already do.

          The design caps the lead and the body at 34em, which renders 816 and
          595 because an em in max-width resolves against the element's own font
          size. Reproducing that faithfully put two ragged right edges inside a
          column whose other blocks reach the gutter, and that step is the fault
          in every screenshot. A narrower measure reads better in the abstract
          and reads as a hole here, because nothing else in the column stops
          where the paragraphs stop. -#}
      <p style="font-family: 'Playfair Display', serif; font-size: 24px; line-height: 1.48; color: #17254C; margin: 34px 0 0; text-wrap: pretty">{{ lead }}</p>
    {% endif %}

    <div class="rec-body" id="recText" style="margin-top: 30px; font-size: 17.5px; line-height: 1.78">{% include "_partials/prose" with { text: bodyText, images: recImages, linksFor: entry.id , footnotesFor: entry } %}</div>


    {% if author and year matches '/^[0-9]{4}$/' %}
      <div class="ar-sig">
        <div class="r"></div>
        <div class="n">{{ author.title }} &middot; {{ year }}</div>
      </div>
    {% endif %}

    {#- After the signature, not before it. The signature closes the piece; the
        notes are the apparatus that follows it, and they come before the
        navigation out of the chapter. -#}
    {% include "_partials/record/footnotes" with { entry: entry, editor: editor, source: 'editor' } only %}

    {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
    {% include "_partials/record/editor-notes" with { rows: edNotes, position: 'bottom' } only %}
    {% include "_partials/record/fine-print" with { value: F.finePrint } only %}

    {% if media|length %}
      <div style="margin-top: 52px">
        <div style="display: flex; align-items: baseline; gap: 14px; border-bottom: 3px solid #C4A031; padding-bottom: 12px">
          <div style="font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: .16em; color: #A9842B">PHOTOS &amp; DOCUMENTS</div>
          <div style="flex: 1"></div>
          <div style="font-size: 13px; color: #8A919E">{{ media|length }} item{{ media|length == 1 ? '' : 's' }}</div>
        </div>
        {#- Every tile is a record, and says so: its title, the date as the
            source printed it, and a chip naming what it is. The chip comes off
            the record through the image-link layer rather than being guessed
            from the file.

            No square crop. A crop to 4:5 cut the headline off a clipping and
            the caption off a postcard, which is most of what this section
            holds. The tile is a fixed width and the picture keeps its own
            aspect inside it, top aligned, so the top of a document is what you
            see.

            The tile itself goes to the record. The magnifier opens the picture
            in place, for the reader who wants to look rather than to leave. -#}
        <div class="ar-grid">
          {% for a in media %}
            {%- set linkTo = imgLinks[a.filename|lower] ?? null -%}
            {#- The stem with any Craft rename suffix taken off, or a re-imported
                duplicate's title "Jj2003a" looks like a real one against the
                stem jj2003a_2026-09-18-071338_lure and prints as a tile
                heading. -#}
            {%- set stem = a.filename|lower|split('.')|slice(0, -1)|join('.') -%}
            {%- set stem = stem matches '/_[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}_[a-z]+$/'
                           ? stem|split('_')|slice(0, -2)|join('_') : stem -%}
            {%- set nrm = a.title|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
            {%- set stemNrm = stem|lower|replace({'-': '', '_': '', ' ': '', '.': ''}) -%}
            {%- set realTitle = (a.title|trim and nrm != stemNrm) ? a.title|trim : '' -%}
            {%- set cap = a.photoCaptionExt|default('')|trim ?: realTitle -%}
            <figure class="ar-tile">
              <div class="sh">
                {% if linkTo %}<a href="{{ linkTo.url }}" class="im" aria-label="{{ linkTo.title }}">
                  <img src="{{ a.getUrl({ width: 560, mode: 'fit' }) ?: a.url }}" alt="{{ linkTo.title }}" loading="lazy">
                </a>
                {% else %}<span class="im"><img src="{{ a.getUrl({ width: 560, mode: 'fit' }) ?: a.url }}" alt="{{ cap }}" loading="lazy"></span>
                {% endif %}
                {#- The magnifier only where there is something bigger to open:
                    the larger file the legacy page linked to, or the asset's own
                    pixels when the tile is drawn well below them. A control that
                    reopens what you are already looking at is worse than none. -#}
                {%- set enl = enlarge[a.filename|lower] ?? null -%}
                {%- set bigFile = (enl and enl.id is defined) ? enl : null -%}
                {%- set zoomSrc = bigFile ? (craft.assets().id(bigFile.id).one().url ?? null)
                                  : ((a.width and a.width > 640) ? a.url : null) -%}
                {% if zoomSrc %}
                  <button type="button" class="zoom" data-lightbox data-src="{{ zoomSrc }}"
                          data-caption="{{ linkTo ? linkTo.title : cap }}"
                          data-credit="{{ a.photoCredit|default('')|trim }}"
                          {% if linkTo %}data-record="{{ linkTo.url }}"{% endif %}
                          aria-label="Open the larger image">&#9906;</button>
                {% endif %}
              </div>
              <figcaption>
                {% if linkTo %}
                  <span class="chip">{{ linkTo.kind ?? 'Record' }}</span>
                  <a class="t" href="{{ linkTo.url }}">{{ linkTo.title }}</a>
                  {% if linkTo.date %}<span class="d">{{ linkTo.date }}</span>{% endif %}
                {% elseif cap %}
                  <span class="t plain">{{ cap }}</span>
                {% endif %}
              </figcaption>
            </figure>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if prev or next %}
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 52px">
        {% if prev %}
          <a href="{{ prev.url }}" style="background: #fff; border: 1px solid #E2E4E8; padding: 18px 20px; color: inherit; display: block">
            <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B">&larr; PREVIOUS</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 20px; line-height: 1.25; color: #17254C; margin-top: 8px">{{ prev.title ?: prev.slug }}</div>
          </a>
        {% endif %}
        {% if next %}
          <a href="{{ next.url }}" style="background: #fff; border: 1px solid #E2E4E8; padding: 18px 20px; color: inherit; display: block; text-align: right">
            <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B">NEXT &rarr;</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 20px; line-height: 1.25; color: #17254C; margin-top: 8px">{{ next.title ?: next.slug }}</div>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if author %}
      {% set aimg = (author.featuredImage is defined and author.featuredImage) ? author.featuredImage.one() ?? null : null %}
      {#- Classed so it can be measured and named. The inline styles remain the
          authority, as everywhere else in this template. -#}
      <div class="ar-author" style="background: #FDF7EA; border: 1px solid #EFE6D0; border-top: 3px solid #C4A031; padding: 26px 28px 28px; margin-top: 44px">
        <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B; margin-bottom: 20px">ABOUT THE AUTHOR</div>
        <div style="display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 24px; align-items: start">
          <div style="width: 96px; height: 96px; border-radius: 50%; border: 2px solid #C4A031; overflow: hidden; position: relative">
            {% if aimg %}<img src="{{ aimg.getUrl({ width: 192, height: 192, mode: 'crop', position: 'center-top' }) ?: aimg.url }}" alt="" style="width: 100%; height: 100%; object-fit: cover; object-position: top; display: block">{% endif %}
          </div>
          <div style="min-width: 0">
            <div style="font-family: 'Playfair Display', serif; font-size: 25px; color: #17254C">{{ author.title }}</div>
            {% if author.occupation is defined and author.occupation %}<div style="font-family: 'Jost', sans-serif; font-size: 13.5px; letter-spacing: .04em; color: #7E6118; margin-top: 4px">{{ author.occupation }}</div>{% endif %}
            {% set abio = (author.authorBio is defined and author.authorBio) ? author.authorBio : (author.body is defined ? author.body : '') %}
            {#- No footnotesFor. A biography is not the piece, and a marker in it
                is not one of the piece's notes. -#}
            {% if abio|trim %}<div style="font-size: 16px; line-height: 1.72; color: #2C2C2C; margin: 14px 0 0; max-width: 46em">{% include "_partials/prose" with { text: abio } %}</div>{% endif %}
            {#- The author's own notes, if any, under their bio and inside their
                box. The editor's are a section of their own above it. -#}
            {% include "_partials/record/footnotes" with { entry: entry, source: 'author' } only %}
            <a href="{{ author.url }}" style="display: inline-block; font-family: 'Jost', sans-serif; font-size: 13.5px; letter-spacing: .06em; color: #A9842B; border-bottom: 1px solid #C4A031; margin-top: 18px; padding-bottom: 2px">VIEW FULL PROFILE &rarr;</a>
          </div>
        </div>
      </div>
    {% endif %}
  </article>

  <aside style="min-width: 0; position: sticky; top: 20px; display: flex; flex-direction: column; gap: 18px">

    {#- Who and where, in four lists.

        Two sources, merged. The curated relation fields are what somebody sat
        and confirmed; derivedImageLinks is what the legacy page linked from a
        picture. Curated first, then derived, de-duplicated by id, so a record
        confirmed and also linked appears once and in the confirmed position.

        Routing: a person, place, community or organization belongs here, in a
        list of names. A photograph or document belongs in the grid above, as a
        tile with a picture. The section decides, so nothing has to be tagged.

        The derived links come from the same _data/image-links layer the grid
        reads, which means this works before link_images_to_records.php has ever
        been applied. Once it has, the relation is on the record as well and the
        field is read directly. -#}
    {#- The layout's own handles. A custom field reads as defined on an element
        whose type does not have it and then throws when it is read. -#}
    {% set sbH = [] %}
    {% for f in entry.fieldLayout.customFields %}{% set sbH = sbH|merge([f.handle]) %}{% endfor %}

    {% set sbCurated = { people: [], places: [], communities: [], organizations: [] } %}
    {% set curatedHandles = {
      people: ['subjectPerson', 'relatedPersons', 'photoPeople'],
      places: ['depictsPlace', 'relatedPlaces', 'photoPlaces'],
      organizations: ['subjectOrganization', 'photoOrganizations']
    } %}
    {% for bucket, handles in curatedHandles %}
      {% for h in handles %}
        {% if h in sbH %}
          {% for r in attribute(entry, h).status(null).all() %}
            {% set sbCurated = sbCurated|merge({ (bucket): sbCurated[bucket]|merge([r]) }) %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% for c in communities %}
      {% set sbCurated = sbCurated|merge({ communities: sbCurated.communities|merge([c]) }) %}
    {% endfor %}

    {#- Derived, from the relation field where it exists and from the layer
        otherwise. Both, because one is applied and the other is not yet. -#}
    {% set sbDerived = [] %}
    {% if 'derivedImageLinks' in sbH %}
      {% for r in entry.derivedImageLinks.status(null).all() %}{% set sbDerived = sbDerived|merge([r]) %}{% endfor %}
    {% endif %}
    {% set SB_SECTION = { persons: 'people', places: 'places', communities: 'communities', organizations: 'organizations', groups: 'organizations' } %}

    {% set sbLists = { people: [], places: [], communities: [], organizations: [] } %}
    {% set sbSeen = [] %}
    {% for bucket, rows in sbCurated %}
      {% for r in rows %}
        {% set key = 'i' ~ r.id %}
        {% if key not in sbSeen %}
          {% set sbSeen = sbSeen|merge([key]) %}
          {% set rimg = (r.featuredImage is defined and r.featuredImage) ? r.featuredImage.one() ?? null : null %}
          {% set sbLists = sbLists|merge({ (bucket): sbLists[bucket]|merge([{
            t: r.title ?: r.slug, u: r.url ?? url('communities/' ~ r.slug), d: false,
            img: rimg ? (rimg.getUrl({ width: 88, height: 88, mode: 'crop', position: 'center-top' }) ?: rimg.url) : null,
            r: (r.occupation is defined and r.occupation) ? r.occupation
               : ((r.communityType is defined and r.communityType) ? r.communityType : '') }]) }) %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% for r in sbDerived %}
      {% set bucket = SB_SECTION[r.section.handle] ?? null %}
      {% set key = 'i' ~ r.id %}
      {% if bucket and key not in sbSeen %}
        {% set sbSeen = sbSeen|merge([key]) %}
        {% set rimg = (r.featuredImage is defined and r.featuredImage) ? r.featuredImage.one() ?? null : null %}
        {% set sbLists = sbLists|merge({ (bucket): sbLists[bucket]|merge([{
          t: r.title ?: r.slug, u: r.url, d: true,
          img: rimg ? (rimg.getUrl({ width: 88, height: 88, mode: 'crop', position: 'center-top' }) ?: rimg.url) : null,
          r: (r.occupation is defined and r.occupation) ? r.occupation : '' }]) }) %}
      {% endif %}
    {% endfor %}
    {% for fn, link in imgLinks %}
      {% set bucket = SB_SECTION[link.section] ?? null %}
      {% set key = 'i' ~ link.id %}
      {% if bucket and key not in sbSeen %}
        {% set sbSeen = sbSeen|merge([key]) %}
        {% set sbLists = sbLists|merge({ (bucket): sbLists[bucket]|merge([{
          t: link.title, u: link.url, d: true, img: null, r: link.kind ?? '' }]) }) %}
      {% endif %}
    {% endfor %}

    {#- One card per type, in the format the People block already used: thumbnail,
        name, descriptor. The four bare name lists that used to sit above this
        were a second, worse rendering of the same information, so People
        appeared twice on every article that had any.

        Curated first, then derived, de-duplicated by id. A derived entry carries
        a gold dot: worth following, and not a relationship the archive has
        confirmed. -#}
    {% set sbLabels = { people: 'PEOPLE', places: 'PLACES', communities: 'COMMUNITIES', organizations: 'ORGANIZATIONS' } %}
    {% for bucket, label in sbLabels %}
      {% if sbLists[bucket]|length %}
        <div class="ar-sb">
          <div class="lab">{{ label }}</div>
          {% for r in sbLists[bucket] %}
            {% set words = r.t|split(' ')|filter(x => x|trim) %}
            <a class="row" href="{{ r.u }}">
              <span class="th">
                {%- if r.img %}<img src="{{ r.img }}" alt="" loading="lazy">
                {%- else %}{{ (words|length > 1 ? words|first|slice(0,1) ~ words|last|slice(0,1) : r.t|slice(0,1))|upper }}{% endif -%}
              </span>
              <span class="tx">
                <span class="n">{{ r.t }}{% if r.d %}<span class="dv" title="Linked from an image on the legacy page, not a confirmed relationship">&middot;</span>{% endif %}</span>
                {%- if r.r %}<span class="r">{{ r.r }}</span>{% endif -%}
              </span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

    {% if collection %}
      {% set total = chapters|length %}
      {% set pos = idx is not null ? idx + 1 : 0 %}
      {% set pct = total ? (pos / total * 100)|round : 0 %}
      {% set cAuthor = collection.writtenBy is defined ? collection.writtenBy.one() ?? null : null %}
      {% set cBand = null %}
      {% for f in collection.fieldLayout.customFields %}{% if f.handle == 'bandImage' %}{% set cBand = collection.bandImage.one() ?? null %}{% endif %}{% endfor %}

      <div style="background: #FDF7EA; border: 1px solid #EFE6D0; border-top: 3px solid #C4A031">
        <div style="padding: 18px 20px 16px; border-bottom: 1px solid #EFE6D0">
          <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B">PART OF COLLECTION</div>
          {% if cBand %}
            <a href="{{ collection.url }}" style="display: block; margin-top: 14px; border: 1px solid #E8E0CC; background: #fff; padding: 5px">
              <img src="{{ cBand.url }}" alt="" style="width: 100%; height: 92px; object-fit: cover; object-position: 72% center; display: block">
            </a>
          {% endif %}
          <a href="{{ collection.url }}" style="display: block; font-family: 'Playfair Display', serif; font-size: 20px; line-height: 1.25; color: #17254C; margin-top: 12px">{{ collection.title }}</a>
          <div style="font-size: 13.5px; color: #5B6472; margin-top: 4px">{% if cAuthor %}{{ cAuthor.title }} &middot; {% endif %}{{ total }} article{{ total == 1 ? '' : 's' }}</div>
          {% if pos %}
            <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 16px">
              <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .12em; color: #7E6118">YOU ARE ON {{ pos }} OF {{ total }}</div>
              <div style="font-family: ui-monospace, monospace; font-size: 11.5px; color: #8A919E">{{ pct }}%</div>
            </div>
            <div style="height: 4px; background: #EFE6D0; margin-top: 7px"><div style="width: {{ pct }}%; height: 4px; background: #C4A031"></div></div>
          {% endif %}
        </div>

        <div style="padding: 16px 20px 6px; display: flex; align-items: baseline; justify-content: space-between; gap: 10px">
          <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B">IN THIS COLLECTION</div>
          <a href="{{ collection.url }}" style="font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: .06em">ALL {{ total }} &rarr;</a>
        </div>

        {#- The window as drawn: the first, a gap label, the five either side of
            the current one, another gap label, and the last. Under sixteen the
            whole list fits and is more useful whole. -#}
        {% set WINDOW = 5 %}
        {% set showAll = total <= 15 or idx is null %}
        {% set from = showAll ? 0 : max(0, idx - WINDOW) %}
        {% set to = showAll ? total - 1 : min(total - 1, idx + WINDOW) %}
        {% set shown = [] %}
        {% if not showAll and from > 0 %}{% set shown = shown|merge([0]) %}{% endif %}
        {% for i in from..to %}{% set shown = shown|merge([i]) %}{% endfor %}
        {% if not showAll and to < total - 1 %}{% set shown = shown|merge([total - 1]) %}{% endif %}

        <div style="padding: 0 20px 8px; display: flex; flex-direction: column">
          {% set last = null %}
          {% for i in shown %}
            {% if last is not null and i > last + 1 %}
              {% set n = i - last - 1 %}
              <div style="font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: .1em; color: #A9A08A; padding: 9px 0 9px 36px; border-bottom: 1px solid #F1E9D6">{{ n }} {{ last == 0 ? 'earlier' : 'more' }} article{{ n == 1 ? '' : 's' }}</div>
            {% endif %}
            {% set c = chapters[i] %}
            {% set here = c.id == entry.id %}
            <a href="{{ c.url }}" style="display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; align-items: baseline; color: inherit; padding: {{ here ? '11px 0' : '9px 0' }}; border-bottom: 1px solid #F1E9D6; border-left: 3px solid {{ here ? '#C4A031' : 'transparent' }}; background: {{ here ? '#FFFBF1' : 'transparent' }}; margin-left: -20px; padding-left: {{ here ? '17px' : '20px' }}">
              <span style="font-family: ui-monospace, monospace; font-size: 11.5px; color: {{ here ? '#A9842B' : '#A9A08A' }}; text-align: right">{{ i + 1 }}</span>
              <span style="font-family: {{ here ? "'Playfair Display', serif" : "'Public Sans', sans-serif" }}; font-size: {{ here ? '16px' : '14px' }}; line-height: 1.35; color: {{ here ? '#17254C' : '#4A5260' }}">{{ c.title ?: c.slug }}</span>
            </a>
            {% set last = i %}
          {% endfor %}
          <div style="display: flex; gap: 10px; padding: 12px 0 14px">
            {% if prev %}<a href="{{ prev.url }}" style="flex: 1; text-align: center; font-family: 'Jost', sans-serif; font-size: 12.5px; letter-spacing: .06em; border: 1px solid #E8E0CC; background: #fff; padding: 9px 4px; color: #17254C">&larr; Previous</a>{% endif %}
            {% if next %}<a href="{{ next.url }}" style="flex: 1; text-align: center; font-family: 'Jost', sans-serif; font-size: 12.5px; letter-spacing: .06em; border: 1px solid #C4A031; background: #C4A031; padding: 9px 4px; color: #17254C; font-weight: 600">Next &rarr;</a>{% endif %}
          </div>
        </div>
      </div>
    {% endif %}


    {% include "_partials/record/cite-article" with { entry: entry, author: author, collection: collection, date: F.originalPublishDate, label: 'Articles' } only %}

    {#- Record facts, as drawn: the label column in small Jost, the value beside
        it, then the legacy link and the legacy path in mono beneath. -#}
    {% set facts = [] %}
    {% if F.originalPublishDate %}{% set facts = facts|merge([{ k: 'PUBLISHED', v: F.originalPublishDate }]) %}{% endif %}
    {% if F.originallyPublishedTitle %}{% set facts = facts|merge([{ k: 'AS PRINTED', v: F.originallyPublishedTitle }]) %}{% endif %}
    {% if publishers|length %}{% set facts = facts|merge([{ k: 'PUBLISHER', v: publishers|map(o => o.title)|join('; ') }]) %}{% endif %}
    {% if F.sourceLine %}{% set facts = facts|merge([{ k: 'SOURCE', v: F.sourceLine }]) %}{% endif %}
    {% if era %}{% set facts = facts|merge([{ k: 'ERA', v: era.title }]) %}{% endif %}
    {% set facts = facts|merge([{ k: 'UPDATED', v: entry.dateUpdated|date('M j, Y') }]) %}

    <div style="background: #fff; border: 1px solid #E2E4E8; padding: 18px 20px 14px">
      <div style="font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .16em; color: #A9842B; margin-bottom: 12px">RECORD</div>
      {% for f in facts %}
        <div style="display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 14px; padding: 9px 0; border-bottom: 1px solid #F1F2F5; align-items: baseline">
          <div style="font-family: 'Jost', sans-serif; font-size: 10.5px; letter-spacing: .12em; color: #8A919E">{{ f.k }}</div>
          <div style="font-size: 14.5px; line-height: 1.5; color: #2C2C2C">{{ f.v }}</div>
        </div>
      {% endfor %}
      {% if F.legacyUrl %}
        {% set legacyHref = include('_partials/legacy-url', { value: F.legacyUrl })|trim %}
        <a href="{{ legacyHref }}" target="_blank" rel="noopener" style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 13px 0 4px; font-family: 'Jost', sans-serif; font-size: 13px; letter-spacing: .04em">Read the original page <span>&nearr;</span></a>
        <div style="font-family: ui-monospace, monospace; font-size: 11px; color: #9AA1AD; word-break: break-all; padding-bottom: 8px">{{ F.legacyUrl }}</div>
      {% endif %}
    </div>
  </aside>
</main>
{% endblock %}
