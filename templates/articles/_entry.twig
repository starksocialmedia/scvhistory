{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
  {% css %}
  /* ── Article band ─────────────────────────────────────────────── */
  .ar h1{color:#7A5C1B}
  .ar-coll{font-family:'Playfair Display',serif;font-size:21px;line-height:1.3;margin:0 0 14px}
  .ar-coll a{color:#7A5C1B;text-decoration:none}
  .ar-coll a:hover{text-decoration:underline}
  .ar-byline{font-size:15.5px;color:#5B6472;line-height:1.7}
  .ar-byline a{color:#17254C;text-decoration:none}
  .ar-byline a:hover{color:#7A5C1B}

  /* ── Hero ─────────────────────────────────────────────────────── */
  .ar-hero{margin:0 0 30px}
  .ar-hero img{width:100%;height:auto;display:block;border:1px solid #E2E4E8;background:#fff}
  .ar-hero figcaption{font-size:13.5px;font-style:italic;color:#5B6472;line-height:1.55;margin-top:9px}

  /* Two layers, exactly as the collection lander has them. */
  .ar .rec-band{position:relative;overflow:hidden}
  .ar-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;z-index:0}
  .ar-bg2{position:absolute;inset:0;background-size:cover;background-position:right center;filter:contrast(1.16) brightness(.92);z-index:1}
  .ar .rec-band .rec-wrap{position:relative;z-index:2}

  /* The artwork is composed with its subject at the right, so the band content
     is capped to the left of it. Everything in the band shares one column:
     kicker, title, collection, byline and chips, so none of them can run under
     the drawing. Without artwork the band is full width as before.

     52 percent at every width, not a wider cap that narrows on small screens.
     Measured on the artwork: the dense figure begins at 55.6 percent of the
     band, mid tone at 53.2, the faintest hair at 44.9, and those fractions hold
     at any width because the image is wider in aspect than the band, so cover
     matches the band width exactly. A 60 percent column therefore sits inside
     the figure at every width and only looks clear while the title happens to
     be short. Reynolds has 71 chapters whose titles we have not seen. */
  .ar-hasband .rec-band .rec-crumbs,
  .ar-hasband .rec-band .rec-head>div:first-child{max-width:52%}
  .ar h1{text-wrap:balance}
  @media(max-width:640px){
    /* 52 percent of a phone is unreadable, so the text takes the full width and
       the artwork drops back to a wash behind it. */
    .ar-hasband .rec-band .rec-crumbs,
    .ar-hasband .rec-band .rec-head>div:first-child{max-width:none}
    .ar-bg2{opacity:.22}
  }

  /* ── Previous / next ──────────────────────────────────────────── */
  .ar-pn{display:grid;grid-template-columns:1fr 1fr;gap:24px;border-top:1px solid #E2E4E8;border-bottom:1px solid #E2E4E8;padding:16px 0;margin:0 0 32px}
  .ar-pn.after{margin:40px 0 0}
  .ar-pn .l{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#7A5C1B;display:block;margin-bottom:5px}
  .ar-pn a{font-family:'Playfair Display',serif;font-size:17px;line-height:1.3;color:#17254C;text-decoration:none;display:block}
  .ar-pn a:hover{color:#7A5C1B}
  .ar-pn .nx{text-align:right}
  @media(max-width:600px){.ar-pn{grid-template-columns:1fr}.ar-pn .nx{text-align:left}}

  /* ── Sign-off ─────────────────────────────────────────────────── */
  .ar-signoff{text-align:right;margin:34px 0 0;font-variant-caps:small-caps;font-size:16px;letter-spacing:.06em;color:#5B6472}

  /* ── About the author ─────────────────────────────────────────── */
  .ar-author{margin:48px 0 0;border-top:3px solid #C4A031;background:#FDF7EA;padding:26px 28px}
  .ar-author .lab{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#7A5C1B;margin-bottom:16px}
  .ar-author .in{display:flex;gap:22px;align-items:flex-start;flex-wrap:wrap}
  .ar-author .ph{width:96px;height:96px;border-radius:50%;flex:none;overflow:hidden;background:#fff;border:1px solid #EFE6D0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:30px;color:#C4A031}
  .ar-author .ph img{width:100%;height:100%;object-fit:cover;object-position:top}
  .ar-author .nm{font-family:'Playfair Display',serif;font-size:23px;color:#17254C;line-height:1.2}
  .ar-author .oc{font-size:14px;color:#5B6472;margin-top:4px}
  .ar-author .bio{font-size:15.5px;line-height:1.7;color:#2C2C2C;margin-top:12px}
  .ar-author .bio p{margin:0 0 12px}
  .ar-author .more{display:inline-block;margin-top:10px;font-family:'Jost',sans-serif;font-size:14px;color:#7A5C1B;text-decoration:none}
  .ar-author .more:hover{text-decoration:underline}

  /* ── Sidebar extras ───────────────────────────────────────────── */
  .ar-collcard img{width:100%;height:auto;display:block;border:1px solid #EFE6D0;margin-bottom:10px}
  .ar-collcard a{font-family:'Playfair Display',serif;font-size:18px;line-height:1.3;color:#17254C;text-decoration:none;display:block}
  .ar-collcard a:hover{color:#7A5C1B}
  .ar-chapters{list-style:none;margin:0;padding:0;counter-reset:ch}
  .ar-chapters li{border-bottom:1px solid #EFE6D0}
  .ar-chapters li:last-child{border-bottom:0}
  .ar-chapters a,.ar-chapters span.cur{display:flex;gap:10px;padding:9px 0;font-size:14.5px;line-height:1.4;color:#17254C;text-decoration:none}
  .ar-chapters a:hover{color:#7A5C1B}
  .ar-chapters .n{font-family:'Jost',sans-serif;font-size:11.5px;color:#5B6472;flex:none;width:20px;padding-top:2px}
  .ar-chapters li.on{background:#FDF7EA;border-left:3px solid #C4A031;margin-left:-20px;padding-left:17px}
  .ar-chapters li.on span.cur{font-weight:500}
  .ar-searchbar{display:flex;background:#fff;border:1px solid #DCC98F}
  .ar-searchbar input{flex:1;min-width:0;border:0;outline:none;padding:11px 13px;font-family:'Public Sans',sans-serif;font-size:15px;color:#2C2C2C;background:transparent}
  .ar-searchbar button{border:0;background:#C4A031;color:#17254C;font-family:'Jost',sans-serif;font-weight:500;font-size:14px;padding:0 16px;cursor:pointer}
  .ar-searchbar button:hover{background:#7A5C1B;color:#fff}
  {% endcss %}
{% endblock %}

{% block content %}
{#
  Article record, built to the approved layout of the Reynolds Prologue page.

  Notes on what the data does and does not carry:
  - No tags field exists anywhere in this Craft install, so the TAGS block in
    the design has nothing to render and is left out. Communities and the
    historical period are the chips in the band.
  - What featuredImage means depends on whether the article is in a collection.
    A collection article's featured image is a title card with the headline
    lettered into it, so rendering it in the body would print the headline
    twice; there it is the social and index image only, feeding og:image,
    twitter:image, the articles index thumbnail and the collection contents
    thumbnail. A standalone article's featured image is a real photograph, so
    it still opens the body as the hero figure with its caption.
  - bandImage washes behind the band in either case. There is no fallback from
    bandImage to featuredImage, because that would put a title card back in the
    band on exactly the articles this avoids.
  - Prev and next come from the collection's articlesInCollection order, which
    is the order the chapter list uses too, so the two always agree.
#}
{% set F = {} %}
{% for h in ['body','subheadline','originalPublishDate','originallyPublishedTitle','sourceLine',
             'photoSources','finePrint','archiveUrl','legacyUrl','culturalSensitivityNote'] %}
  {% set F = F|merge({ (h): (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' }) %}
{% endfor %}
{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}

{% set collection = entry.partOfCollection.one() ?? null %}

{# Band artwork: this article's own bandImage, then the bandImage of the
   collection it belongs to, then nothing. A Perkins chapter therefore wears the
   Perkins band and a Reynolds chapter the Reynolds band, while a standalone
   article with no artwork stays plain cream. There is no fallback to
   featuredImage at either step; those are title cards with the headline
   lettered into them.

   The field-layout check is the only reliable test: a custom field reads as
   defined on an element whose type does not have it, then throws when read. #}
{% set bandImg = null %}
{% for el in [entry, collection]|filter(x => x) %}
  {% if bandImg is null %}
    {% set can = false %}
    {% for f in el.fieldLayout.customFields %}
      {% if f.handle == 'bandImage' %}{% set can = true %}{% endif %}
    {% endfor %}
    {% if can and el.bandImage %}{% set bandImg = el.bandImage.one() ?? null %}{% endif %}
  {% endif %}
{% endfor %}

{# The body hero is for standalone articles only. See the note above. #}
{% set hero = null %}
{% if not collection %}
  {% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
  {% set hero = hero ?? (recImages|length ? recImages|first : null) %}
{% endif %}
{% set author = entry.writtenBy.one() ?? null %}
{% set editor = entry.editedBy.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set periods = entry.historicalPeriod.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set people = entry.subjectPerson.all() %}
{% set publishers = entry.publishedBy.all() %}

{% set chapters = collection
  ? (collection.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: collection, field: 'partOfCollection' }).status(null).all())
  : [] %}
{% set idx = null %}
{% for c in chapters %}{% if c.id == entry.id %}{% set idx = loop.index0 %}{% endif %}{% endfor %}
{% set prev = idx is not null and idx > 0 ? chapters[idx - 1] : null %}
{% set next = idx is not null and idx < (chapters|length - 1) ? chapters[idx + 1] : null %}

{% set year = F.originalPublishDate ? F.originalPublishDate|slice(-4) : '' %}
{% set signoff = (year matches '/^\\d{4}$/') and author %}

{% macro pn(prev, next) %}
  {% if prev or next %}
    <nav class="ar-pn{{ after is defined and after ? ' after' : '' }}">
      <div>{% if prev %}<span class="l">&larr; PREVIOUS</span><a href="{{ prev.url }}">{{ prev.title ?: prev.slug }}</a>{% endif %}</div>
      <div class="nx">{% if next %}<span class="l">NEXT &rarr;</span><a href="{{ next.url }}">{{ next.title ?: next.slug }}</a>{% endif %}</div>
    </nav>
  {% endif %}
{% endmacro %}
{% import _self as ui %}


<div class="rec ar{{ bandImg ? ' ar-hasband' : '' }}">
  <section class="rec-band">
    {% if bandImg %}
      <div class="ar-bg" style="background-image:url('{{ bandImg.url }}')" role="presentation"></div>
      <div class="ar-bg2" style="background-image:url('{{ bandImg.url }}')" role="presentation"></div>
    {% endif %}
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('articles') }}">Articles</a>{% if collection %} &rsaquo; <a href="{{ collection.url }}">{{ collection.title }}</a>{% endif %} &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="rec-head rec-head--noart">
        <div>
          <div class="rec-kick"><span class="a">ARTICLES</span>{% if era %}<span class="sep"></span><span class="b">{{ era.title|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title ?: entry.slug }}</h1>
          {% if collection %}<div class="ar-coll"><a href="{{ collection.url }}">{{ collection.title }}</a></div>{% endif %}
          {% if F.subheadline %}<div class="rec-sub">{{ F.subheadline }}</div>{% endif %}
          {% if author or editor or F.originalPublishDate %}
            <p class="ar-byline">
              {%- if author %}By <a href="{{ author.url }}">{{ author.title }}</a>{% endif -%}
              {%- if editor %}{% if author %} &middot; {% endif %}Edited by <a href="{{ editor.url }}">{{ editor.title }}</a>{% endif -%}
              {%- if F.originalPublishDate %}{% if author or editor %} &middot; {% endif %}{{ F.originalPublishDate }}{% endif -%}
            </p>
          {% endif %}
          {% if periods|length or communities|length %}
            <div class="rec-chips">
              {% for p in periods %}<span class="rec-chip">{{ p.title }}</span>{% endfor %}
              {% for c in communities %}<a class="rec-chip solid" href="{{ c.url ?? url('communities/' ~ c.slug) }}">{{ c.title }}</a>{% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% if hero %}
          <figure class="ar-hero">
            <img src="{{ hero.url }}" alt="{{ hero.alt ?: (hero.title ?: entry.title) }}">
            {% if hero.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}
          </figure>
        {% endif %}

        {{ ui.pn(prev, next) }}

        {% include "_partials/record/note" with { text: noteTop } only %}
        {% if F.sourceLine %}<div class="rec-lede">{{ F.sourceLine }}</div>{% endif %}

        {% if F.body %}
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: F.body, images: recImages, linksFor: entry.id } %}</div>
        {% endif %}

        {% if signoff %}
          <div class="ar-signoff">{{ author.title }} &middot; {{ year }}</div>
        {% endif %}

        {% include "_partials/record/images" with { images: recImages, body: F.body } only %}
        {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}
        {% if F.culturalSensitivityNote %}<div class="rec-note" style="margin-top:24px">{{ F.culturalSensitivityNote }}</div>{% endif %}
        {% if F.photoSources %}<p class="rec-fine">{{ F.photoSources }}</p>{% endif %}
        {% if F.finePrint %}<p class="rec-fine">{{ F.finePrint }}</p>{% endif %}

        {% if prev or next %}
          <nav class="ar-pn after">
            <div>{% if prev %}<span class="l">&larr; PREVIOUS</span><a href="{{ prev.url }}">{{ prev.title ?: prev.slug }}</a>{% endif %}</div>
            <div class="nx">{% if next %}<span class="l">NEXT &rarr;</span><a href="{{ next.url }}">{{ next.title ?: next.slug }}</a>{% endif %}</div>
          </nav>
        {% endif %}

        {% if author and author.authorBio is defined and author.authorBio %}
          {% set aimg = (author.featuredImage is defined and author.featuredImage) ? author.featuredImage.one() ?? null : null %}
          {% set ap = author.title|split(' ')|filter(x => x|trim) %}
          <section class="ar-author">
            <div class="lab">ABOUT THE AUTHOR</div>
            <div class="in">
              <div class="ph">{% if aimg %}<img src="{{ aimg.url }}" alt="">{% else %}{{ (ap|length > 1 ? ap|first|slice(0,1) ~ ap|last|slice(0,1) : author.title|slice(0,1))|upper }}{% endif %}</div>
              <div style="flex:1;min-width:220px">
                <div class="nm">{{ author.title }}</div>
                {% if author.occupation is defined and author.occupation %}<div class="oc">{{ author.occupation }}</div>{% endif %}
                <div class="bio">{% include "_partials/prose" with { text: author.authorBio } %}</div>
                <a class="more" href="{{ author.url }}">View Full Profile &rarr;</a>
              </div>
            </div>
          </section>
        {% endif %}
      </article>

      <aside class="rec-side">
        {% include "_partials/record/tools" with { entry: entry, text: F.body, textId: 'recText' } only %}
        {% include "_partials/record/cite" with { entry: entry, author: author, collection: collection, date: F.originalPublishDate, label: 'Articles', sidebar: true } only %}

        <div class="rec-box">
          <div class="rec-lab">SEARCH THE ARCHIVE</div>
          <form class="ar-searchbar" action="{{ url('search') }}" method="get" role="search">
            <label class="scv-sr" for="arq">Search the archive</label>
            <input id="arq" type="search" name="q" placeholder="A name, a place, a year">
            <button type="submit">Go</button>
          </form>
        </div>

        {% if collection %}
          {% set cimg = (collection.featuredImage is defined and collection.featuredImage) ? collection.featuredImage.one() ?? null : null %}
          <div class="rec-box ar-collcard">
            <div class="rec-lab">PART OF COLLECTION</div>
            {% if cimg %}<img src="{{ cimg.url }}" alt="">{% endif %}
            <a href="{{ collection.url }}">{{ collection.title ?: collection.slug }}</a>
          </div>
        {% endif %}

        {% if chapters|length %}
          <div class="rec-box">
            <div class="rec-lab">IN THIS COLLECTION</div>
            <ul class="ar-chapters">
              {% for c in chapters %}
                <li class="{{ c.id == entry.id ? 'on' : '' }}">
                  {% if c.id == entry.id %}
                    <span class="cur"><span class="n">{{ loop.index }}</span><span>{{ c.title ?: c.slug }}</span></span>
                  {% else %}
                    <a href="{{ c.url }}"><span class="n">{{ loop.index }}</span><span>{{ c.title ?: c.slug }}</span></a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if people|length %}
          <div class="rec-box"><div class="rec-lab">PEOPLE IN THIS ARTICLE</div>
            {% for p in people %}
              {% set pimg = (p.featuredImage is defined and p.featuredImage) ? p.featuredImage.one() ?? null : null %}
              {% set pp = p.title|split(' ')|filter(x => x|trim) %}
              <a class="rec-person" href="{{ p.url }}">
                <div class="th">{% if pimg %}<img src="{{ pimg.url }}" alt="">{% else %}{{ (pp|length > 1 ? pp|first|slice(0,1) ~ pp|last|slice(0,1) : p.title|slice(0,1))|upper }}{% endif %}</div>
                <div style="min-width:0"><div class="n">{{ p.title }}</div>{% if p.occupation is defined and p.occupation %}<div class="r">{{ p.occupation }}</div>{% endif %}</div>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        {% if publishers|length %}
          <div class="rec-box"><div class="rec-lab">PUBLISHED BY</div>
            <div class="rec-rows">{% for o in publishers %}<div class="k">SOURCE</div><div class="v"><a href="{{ o.url }}">{{ o.title ?: o.slug }}</a></div>{% endfor %}</div>
          </div>
        {% endif %}

        {% set others = [
          { lab: 'ORGANIZATIONS', key: 'ORG', rows: entry.subjectOrganization.all() },
          { lab: 'GROUPS', key: 'GROUP', rows: entry.subjectGroup.all() },
          { lab: 'PLACES', key: 'PLACE', rows: entry.depictsPlace.all() },
          { lab: 'EVENTS', key: 'EVENT', rows: entry.articleEvents.all() },
          { lab: 'RELATED ARTICLES', key: 'ARTICLE', rows: entry.relatedArticles.all() }
        ]|filter(b => b.rows|length) %}
        {% for b in others %}
          <div class="rec-box"><div class="rec-lab">{{ b.lab }}</div>
            <div class="rec-rows">{% for r in b.rows %}<div class="k">{{ b.key }}</div><div class="v"><a href="{{ r.url }}">{{ r.title ?: r.slug }}</a></div>{% endfor %}</div>
          </div>
        {% endfor %}

        {% include "_partials/record/documents" with { docs: recDocs } only %}

        {% include "_partials/record/tags" with { el: entry } only %}

        {% set links = [] %}
        {% if F.archiveUrl %}{% set links = links|merge([{u: F.archiveUrl, t: 'Archive.org'}]) %}{% endif %}
        {% if F.legacyUrl %}{% set links = links|merge([{u: include('_partials/legacy-url', { value: F.legacyUrl })|trim, t: 'View on legacy site'}]) %}{% endif %}
        {% if links|length %}
          <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}" target="_blank" rel="noopener">{{ l.t }} <span>&nearr;</span></a>{% endfor %}</div>
          </div>
        {% endif %}
      </aside>
    </main>
  </div>
</div>
{% endblock %}
