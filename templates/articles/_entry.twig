{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{% set collection = entry.partOfCollection.one() ?? null %}
{% set author = entry.writtenBy.one() ?? null %}
{% set editor = entry.editedBy.one() ?? null %}
{% set communities = entry.neighborhood.all() %}
{% set era = entry.historicalEra.one() ?? null %}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('articles') }}">Articles</a>{% if collection %} &rsaquo; <a href="{{ collection.url }}">{{ collection.title }}</a>{% endif %} &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">{{ collection ? collection.title : 'Article' }}</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if entry.subheadline %}<p class="scv-lede">{{ entry.subheadline }}</p>{% endif %}
      {% if author or entry.originalPublishDate or editor or entry.originallyPublishedTitle %}
        <div class="scv-facts">
          {% if author %}<div><b>By</b>{{ author.title }}</div>{% endif %}
          {% if editor %}<div><b>Edited by</b>{{ editor.title }}</div>{% endif %}
          {% if entry.originalPublishDate %}<div><b>Published</b>{{ entry.originalPublishDate }}</div>{% endif %}
          {% if entry.originallyPublishedTitle %}<div><b>Originally titled</b>{{ entry.originallyPublishedTitle }}</div>{% endif %}
        </div>
      {% endif %}
      {% if era or entry.historicalPeriod.all()|length or communities|length %}
        <div class="scv-chips">
          {% if era %}<a class="scv-chip" href="{{ url('articles', { era: era.slug }) }}">{{ era.title }}</a>{% endif %}
          {% for p in entry.historicalPeriod.all() %}<span class="scv-chip">{{ p.title }}</span>{% endfor %}
          {% for c in communities %}<span class="scv-chip solid">{{ c.title }}</span>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}">
            {% if hero.title and hero.title != entry.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}</figure>
          {% endif %}

          <article class="scv-card">
            {% if entry.webmasterNoteTop %}<div class="scv-note">{{ entry.webmasterNoteTop }}</div>{% endif %}
            {% if entry.sourceLine %}<p class="scv-sub">{{ entry.sourceLine }}</p>{% endif %}
            {% if entry.body %}{% include "_partials/prose" with { text: entry.body } %}{% endif %}
            {% if entry.culturalSensitivityNote %}<div class="scv-note">{{ entry.culturalSensitivityNote }}</div>{% endif %}
            {% if entry.webmasterNoteBottom %}<div class="scv-note">{{ entry.webmasterNoteBottom }}</div>{% endif %}
            {% if entry.photoSources %}<p class="scv-fine">{{ entry.photoSources }}</p>{% endif %}
            {% if entry.finePrint %}<p class="scv-fine">{{ entry.finePrint }}</p>{% endif %}
          </article>

          {% if collection %}
            {% set siblings = collection.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: collection, field: 'partOfCollection' }).status(null).all() %}
            {% set idx = null %}
            {% for a in siblings %}{% if a.id == entry.id %}{% set idx = loop.index0 %}{% endif %}{% endfor %}
            {% if idx is not null %}
              {% set prev = idx > 0 ? siblings[idx - 1] : null %}
              {% set next = idx < (siblings|length - 1) ? siblings[idx + 1] : null %}
              {% if prev or next %}
                <nav class="scv-pager">
                  <div>{% if prev %}<span class="l">Previous</span><a href="{{ prev.url }}">{{ prev.title }}</a>{% endif %}</div>
                  <div style="text-align:right">{% if next %}<span class="l">Next</span><a href="{{ next.url }}">{{ next.title }}</a>{% endif %}</div>
                </nav>
              {% endif %}
            {% endif %}
          {% endif %}

          {% if author and author.authorBio is defined and author.authorBio %}
            <h2 class="scv-h2">About the author</h2>
            <article class="scv-card">
              <p class="scv-sub"><a href="{{ author.url }}">{{ author.title }}</a></p>
              {% if author.occupation %}<p class="scv-fine" style="margin-top:0">{{ author.occupation }}</p>{% endif %}
              {% include "_partials/prose" with { text: author.authorBio } %}
            </article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/meta" with { entry: entry } only %}
          {% include "_partials/sidebar/cite" with { entry: entry, author: author, collection: collection, date: entry.originalPublishDate } only %}

          {% if collection %}
            {% set siblings = collection.articlesInCollection.all() ?: craft.entries().section('articles').relatedTo({ targetElement: collection, field: 'partOfCollection' }).status(null).all() %}
            {% if siblings|length > 1 %}
              {% embed "_partials/sidebar/box" with { title: 'In this collection', siblings: siblings, currentId: entry.id } only %}
                {% block body %}<ul>{% for s in siblings %}<li>{% if s.id == currentId %}<strong>{{ s.title }}</strong>{% else %}<a href="{{ s.url }}">{{ s.title }}</a>{% endif %}</li>{% endfor %}</ul>{% endblock %}
              {% endembed %}
            {% endif %}
          {% endif %}

          {% if author %}{% include "_partials/sidebar/related-list" with { title: 'Written by', entries: [author] } only %}{% endif %}
          {% if editor %}{% include "_partials/sidebar/related-list" with { title: 'Edited by', entries: [editor] } only %}{% endif %}
          {% include "_partials/sidebar/related-list" with { title: 'People in this article', entries: entry.subjectPerson.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Organizations', entries: entry.subjectOrganization.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Groups', entries: entry.subjectGroup.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Places', entries: entry.depictsPlace.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Events', entries: entry.articleEvents.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Published by', entries: entry.publishedBy.all() } only %}
          {% include "_partials/sidebar/related-list" with { title: 'Related articles', entries: entry.relatedArticles.all() } only %}

          {% if communities|length %}
            {% embed "_partials/sidebar/box" with { title: 'Communities', communities: communities } only %}
              {% block body %}<ul>{% for c in communities %}<li>{{ c.title }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/external" with { archive: entry.archiveUrl, legacy: entry.legacyUrl } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
