{% extends "_layouts/base" %}
{% block head %}
{% include "_partials/scv-extra-css" %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Jost:wght@400;500&family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet">
{% css %}
.hp{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}
.hp-hero{background:#FDF7EA;border-bottom:1px solid #EFE6D0;color:#17254C}
.hp-hero-in{padding-top:72px;padding-bottom:80px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px;align-items:end}
.hp-eyebrow{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;color:#C4A031;margin-bottom:20px}
.hp-hero h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(38px,5vw,60px);line-height:1.08;margin:0 0 22px;letter-spacing:-.005em;color:#17254C}
.hp-hero p{font-size:18px;line-height:1.65;margin:0;color:#4A5260;max-width:520px}
.hp-search{display:flex;background:#fff;border:1px solid #C4A031}
.hp-search input{flex:1;min-width:0;border:0;outline:none;padding:18px 20px;font-family:'Public Sans',sans-serif;font-size:17px;color:#2C2C2C;background:transparent}
.hp-search button{border:0;background:#C4A031;color:#17254C;font-family:'Jost',sans-serif;font-weight:500;font-size:16px;padding:0 28px;cursor:pointer}
.hp-try{display:flex;gap:8px 22px;flex-wrap:wrap;margin-top:16px;font-size:14px;color:#5B6472}
.hp-try a{color:#C4A031;text-decoration:none}
.hp-sec{padding-top:64px}
.hp-head{display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:24px}
.hp-sec h2{font-family:'Playfair Display',serif;font-weight:500;font-size:30px;margin:0;color:#17254C}
.hp-count{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.14em;color:#A9842B}
.hp-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.hp-card{background:#FDF7EA;border:1px solid #EFE6D0;border-top:3px solid #C4A031;padding:22px 22px 20px;display:block;color:inherit;text-decoration:none}
.hp-card:hover{background:#FBF1DB}
.hp-card .n{font-family:'Playfair Display',serif;font-size:44px;line-height:1;color:#17254C}
.hp-card .l{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.14em;color:#A9842B;margin-top:12px}
.hp-card .d{font-size:14px;line-height:1.55;color:#5B6472;margin-top:8px}
.hp-eras{border-top:1px solid #E2E4E8;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0 24px}
.hp-era{display:block;padding:18px 0 20px;border-top:3px solid #C4A031;margin-top:-1px;color:inherit;text-decoration:none}
.hp-era .y{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.12em;color:#8A919E}
.hp-era .t{font-family:'Playfair Display',serif;font-size:19px;color:#17254C;margin-top:6px;line-height:1.3}
.hp-recent{border-top:1px solid #E2E4E8}
.hp-item{display:flex;gap:20px;align-items:baseline;padding:16px 0;border-bottom:1px solid #E2E4E8;text-decoration:none;color:inherit}
.hp-item:hover .t{color:#A9842B}
.hp-item .k{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.14em;color:#8A919E;flex:0 0 130px}
.hp-item .t{font-family:'Playfair Display',serif;font-size:20px;color:#17254C}
.hp-item .s{font-size:14px;color:#5B6472;margin-top:3px}
.hp-pad{padding-bottom:72px}
{% endcss %}
{% endblock %}

{% block content %}
{% set q = craft.app.request.getParam('q') %}
{% set cards = [
  {handle:'warMemorials', uri:'war-memorial', label:'War Memorial', desc:'Valley residents killed in service, with unit and incident records.'},
  {handle:'persons', uri:'persons', label:'People', desc:'Pioneers, ranchers, actors, and civic leaders.'},
  {handle:'articles', uri:'articles', label:'Articles', desc:'Columns and histories as their authors wrote them.'},
  {handle:'places', uri:'places', label:'Places', desc:'Sites you can still stand in, and some you cannot.'},
  {handle:'organizations', uri:'organizations', label:'Organizations', desc:'Ranchos, companies, agencies, and institutions.'},
  {handle:'groups', uri:'groups', label:'Groups', desc:'Families, tribes, expeditions, and military units.'},
  {handle:'collections', uri:'collections', label:'Collections', desc:'Newspaper series kept in their original order.'},
  {handle:'events', uri:'events', label:'Events', desc:'Floods, quakes, and the days the valley changed.'}
] %}
{% set total = 0 %}
{% for c in cards %}{% set total = total + craft.entries().section(c.handle).status(null).count() %}{% endfor %}

<div class="hp">
  <div class="scv-band hp-hero">
    <div class="scv-band-in hp-hero-in">
      <div>
        <div class="hp-eyebrow">A FREE PUBLIC ARCHIVE &middot; A SERVICE OF SCVTV</div>
        <h1>The Santa Clarita Valley, on the record.</h1>
        <p>People, places, events, and documents from the Tataviam through today. Every record is cited and free to read.</p>
      </div>
      <div>
        <form class="hp-search" action="{{ siteUrl }}" method="get" role="search">
          <input type="text" name="q" value="{{ q }}" placeholder="Search people, places, articles..." aria-label="Search the archive">
          <button type="submit">Search</button>
        </form>
        <div class="hp-try">
          <span>Try</span>
          {% for t in ["Beale's Cut", "Newhall Pass", "Rancho San Francisco", "Northridge Earthquake"] %}
            <a href="{{ siteUrl }}?q={{ t|url_encode }}">{{ t }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {% if q %}
    {% set results = craft.entries().search(q).status(null).limit(60).all() %}
    <section class="scv-band-in hp-sec">
      <div class="hp-head"><h2>{{ results|length }} result{{ results|length == 1 ? '' : 's' }} for &ldquo;{{ q }}&rdquo;</h2></div>
      <div class="hp-recent">
        {% for e in results %}
          <a class="hp-item" href="{{ e.url ?? '#' }}">
            <div class="k">{{ (e.section.name ?? '')|upper }}</div>
            <div><div class="t">{{ e.title ?: e.slug }}</div></div>
          </a>
        {% else %}
          <p style="padding:16px 0;color:#5B6472">Nothing found. Try a name, a place, or a year.</p>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="scv-band-in hp-sec">
    <div class="hp-head">
      <h2>In the archive</h2>
      <div class="hp-count">{{ total }} RECORDS</div>
    </div>
    <div class="hp-cards">
      {% for c in cards %}
        {% set n = craft.entries().section(c.handle).status(null).count() %}
        {% if n %}
          <a class="hp-card" href="{{ url(c.uri) }}">
            <div class="n">{{ n }}</div>
            <div class="l">{{ c.label|upper }}</div>
            <div class="d">{{ c.desc }}</div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% set eras = craft.categories().group('historicalEra').status(null).all() %}
  {% if eras|length %}
  <section class="scv-band-in hp-sec">
    <h2 style="margin-bottom:24px">Browse by era</h2>
    <div class="hp-eras">
      {% for e in eras %}
        {% set n = craft.entries().relatedTo(e).status(null).count() %}
        {% if n %}
          {% set parts = e.title|split('(') %}
          <a class="hp-era" href="{{ url('articles', {era: e.slug}) }}">
            <div class="y">{{ parts|length > 1 ? parts[1]|replace({')': ''}) : n ~ ' records' }}</div>
            <div class="t">{{ parts[0]|trim }}</div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="scv-band-in hp-sec hp-pad">
    <div class="hp-head">
      <h2>Recently added</h2>
      <a href="{{ url('articles') }}" style="font-family:'Jost',sans-serif;font-size:14px;letter-spacing:.06em;color:#A9842B;text-decoration:none">ALL ARTICLES &rarr;</a>
    </div>
    <div class="hp-recent">
      {% for e in craft.entries().status(null).orderBy('dateUpdated desc').limit(8).all() %}
        <a class="hp-item" href="{{ e.url ?? '#' }}">
          <div class="k">{{ (e.section.name ?? '')|upper }}</div>
          <div>
            <div class="t">{{ e.title ?: e.slug }}</div>
            {% if e.body is defined and e.body %}<div class="s">{{ e.body|striptags|slice(0, 120)|trim }}…</div>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </section>
</div>
{% endblock %}
