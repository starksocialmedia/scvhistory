{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}
{% block content %}
{% set q = craft.app.request.getParam('q') %}
{% set sections = [
  {handle:'articles',label:'Articles',uri:'articles'},{handle:'persons',label:'People',uri:'persons'},
  {handle:'places',label:'Places',uri:'places'},{handle:'organizations',label:'Organizations',uri:'organizations'},
  {handle:'groups',label:'Groups',uri:'groups'},{handle:'events',label:'Events',uri:'events'},
  {handle:'warMemorials',label:'War Memorial',uri:'war-memorial'},{handle:'obituaries',label:'Obituaries',uri:'obituaries'},
  {handle:'collections',label:'Collections',uri:'collections'}
] %}
<div class="scv-doc" style="padding:34px 0 70px">
  <form action="{{ siteUrl }}" method="get" role="search" style="display:flex;gap:10px;margin-bottom:34px">
    <input type="search" name="q" value="{{ q }}" placeholder="Search people, places, articles…" aria-label="Search the archive"
      style="flex:1;padding:14px 16px;font-size:16px;font-family:inherit;border:1px solid #e5ddcd;background:#fff;border-radius:2px">
    <button type="submit" style="padding:14px 28px;background:#b8860b;color:#fff;border:0;font-family:inherit;font-size:15px;cursor:pointer;border-radius:2px">Search</button>
  </form>

  {% if q %}
    {% set results = craft.entries().search(q).status(null).limit(60).all() %}
    <h2 class="scv-h2">{{ results|length }} result{{ results|length == 1 ? '' : 's' }} for “{{ q }}”</h2>
    <ul class="scv-list">
      {% for e in results %}
        <li><a href="{{ e.url ?? '#' }}">{{ e.title ?: e.slug }}</a><span class="scv-small" style="margin-left:10px">{{ e.section.name ?? '' }}</span></li>
      {% else %}
        <li class="scv-small">Nothing found. Try a name, a place, or a year.</li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2 class="scv-h2">In the archive</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px">
    {% for s in sections %}
      {% set n = craft.entries().section(s.handle).status(null).count() %}
      <a href="{{ url(s.uri) }}" style="text-decoration:none">
        <div style="background:#fff;border:1px solid #e5ddcd;padding:16px;border-radius:2px">
          <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:32px;color:#1a2744;line-height:1">{{ n }}</div>
          <div style="font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:#6b6560;margin-top:6px">{{ s.label }}</div>
        </div>
      </a>
    {% endfor %}
  </div>

  <h2 class="scv-h2">Recently added</h2>
  <ul class="scv-list">
    {% for e in craft.entries().status(null).orderBy('dateUpdated desc').limit(10).all() %}
      <li><a href="{{ e.url ?? '#' }}">{{ e.title ?: e.slug }}</a><span class="scv-small" style="margin-left:10px">{{ e.section.name ?? '' }}</span></li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
