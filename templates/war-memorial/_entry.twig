{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{#
  The warMemorial field layout has no historicalEra, historicalPeriod or
  neighborhood, so this page carries the conflict chip only.
#}
{% set hero = (entry.featuredImage is defined and entry.featuredImage) ? entry.featuredImage.one() ?? null : null %}
{% set subject = entry.wmRelatedPerson.one() ?? null %}
{% set narrative = entry.wmNarrative ?: entry.body %}
{% set rankLine = [entry.wmRank, entry.wmBranch]|filter(v => v)|join(', ') %}

{% set service = [] %}
{% if entry.wmBranch %}{% set service = service|merge([{k: 'Branch', v: entry.wmBranch}]) %}{% endif %}
{% if entry.wmRank %}{% set service = service|merge([{k: 'Rank', v: entry.wmRank}]) %}{% endif %}
{% if entry.wmSpecialty %}{% set service = service|merge([{k: 'Specialty', v: entry.wmSpecialty}]) %}{% endif %}
{% if entry.wmUnit %}{% set service = service|merge([{k: 'Unit', v: entry.wmUnit}]) %}{% endif %}
{% if entry.wmBase %}{% set service = service|merge([{k: 'Base', v: entry.wmBase}]) %}{% endif %}
{% if entry.wmCombatOperations %}{% set service = service|merge([{k: 'Operation', v: entry.wmCombatOperations}]) %}{% endif %}
{% if entry.wmStartTour %}{% set service = service|merge([{k: 'Start of tour', v: entry.wmStartTour}]) %}{% endif %}
{% if entry.wmLengthOfService %}{% set service = service|merge([{k: 'Length of service', v: entry.wmLengthOfService}]) %}{% endif %}
{% if entry.wmServiceId %}{% set service = service|merge([{k: 'Service number', v: entry.wmServiceId}]) %}{% endif %}

{% set incident = [] %}
{% if entry.wmIncidentDate %}{% set incident = incident|merge([{k: 'Date', v: entry.wmIncidentDate}]) %}{% endif %}
{% if entry.wmIncidentLocation %}{% set incident = incident|merge([{k: 'Location', v: entry.wmIncidentLocation}]) %}{% endif %}

{% set life = [] %}
{% if entry.wmDateOfBirth %}{% set life = life|merge([{k: 'Date of birth', v: entry.wmDateOfBirth}]) %}{% endif %}
{% if entry.deathDate %}{% set life = life|merge([{k: 'Date of death', v: entry.deathDate}]) %}{% endif %}
{% if entry.wmAgeAtLoss %}{% set life = life|merge([{k: 'Age at loss', v: entry.wmAgeAtLoss}]) %}{% endif %}
{% if entry.wmHomeOfRecord %}{% set life = life|merge([{k: 'Home of record', v: entry.wmHomeOfRecord}]) %}{% endif %}
{% if entry.wmHighSchool %}{% set life = life|merge([{k: 'High school', v: entry.wmHighSchool}]) %}{% endif %}
{% if entry.burialPlace %}{% set life = life|merge([{k: 'Burial', v: entry.burialPlace}]) %}{% endif %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('war-memorial') }}">War Memorial</a> &rsaquo; <span>{{ entry.title ?: entry.slug }}</span></div>
      <div class="scv-kicker">War Memorial</div>
      <h1>{{ entry.title ?: entry.slug }}</h1>
      {% if rankLine %}<p class="scv-aka">{{ rankLine }}</p>{% endif %}
      {% if entry.wmDateOfBirth or entry.deathDate or entry.wmHomeOfRecord %}
        <div class="scv-facts">
          {% if entry.wmDateOfBirth %}<div><b>Born</b>{{ entry.wmDateOfBirth }}</div>{% endif %}
          {% if entry.deathDate %}<div><b>Died</b>{{ entry.deathDate }}{% if entry.wmAgeAtLoss %}, age {{ entry.wmAgeAtLoss }}{% endif %}</div>{% endif %}
          {% if entry.wmHomeOfRecord %}<div><b>Home of record</b>{{ entry.wmHomeOfRecord }}</div>{% endif %}
        </div>
      {% endif %}
      {% if entry.wmConflict %}
        <div class="scv-chips"><a class="scv-chip" href="{{ url('war-memorial', { conflict: entry.wmConflict }) }}">{{ entry.wmConflict }}</a></div>
      {% endif %}
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      <div class="scv-layout">
        <div>
          {% if hero %}
            <figure class="scv-figure"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}">
            {% if hero.title and hero.title != entry.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}</figure>
          {% endif %}
          {% if narrative %}
            <article class="scv-card">{% include "_partials/prose" with { text: narrative } %}</article>
          {% endif %}
        </div>

        <aside class="scv-side">
          {% include "_partials/sidebar/meta" with { entry: entry } only %}

          {% if service|length %}
            {% embed "_partials/sidebar/box" with { title: 'Service record', rows: service } only %}
              {% block body %}<ul>{% for r in rows %}<li><span class="scv-boxlab">{{ r.k }}</span>{{ r.v }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% if incident|length %}
            {% embed "_partials/sidebar/box" with { title: 'Incident', rows: incident } only %}
              {% block body %}<ul>{% for r in rows %}<li><span class="scv-boxlab">{{ r.k }}</span>{{ r.v }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% if life|length %}
            {% embed "_partials/sidebar/box" with { title: 'Life', rows: life } only %}
              {% block body %}<ul>{% for r in rows %}<li><span class="scv-boxlab">{{ r.k }}</span>{{ r.v }}</li>{% endfor %}</ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% if entry.wmAwards %}
            {% embed "_partials/sidebar/box" with { title: 'Awards', awards: entry.wmAwards } only %}
              {% block body %}<ul><li>{{ awards }}</li></ul>{% endblock %}
            {% endembed %}
          {% endif %}

          {% include "_partials/sidebar/cite" with { entry: entry, label: 'War Memorial' } only %}

          {% if subject %}
            {% include "_partials/sidebar/related-list" with { title: 'Person record', entries: [subject] } only %}
          {% endif %}

          {% include "_partials/sidebar/external" with { legacy: entry.legacyUrl } only %}
        </aside>
      </div>
    </div>
  </main>
</div>
{% endblock %}
