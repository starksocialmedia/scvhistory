{% extends "_layouts/base" %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}
{% block content %}
{% set subject = entry.wmRelatedPerson.one() ?? null %}
{% set narrative = entry.wmNarrative ?: entry.body %}
{% set rankLine = [entry.wmRank, entry.wmBranch]|filter(v => v)|join(', ') %}
<div class="scv-doc">
  <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('war-memorial') }}">War Memorial</a> &rsaquo; {{ entry.title }}</div>
  <div class="scv-grid">
    <main>
      <h1>{{ entry.title }}</h1>
      {% if rankLine %}<p class="scv-sub">{{ rankLine }}</p>{% endif %}
      <p class="scv-byline">
        {% if entry.wmDateOfBirth %}<strong>Born</strong> {{ entry.wmDateOfBirth }}{% if entry.wmHomeOfRecord %} &nbsp;&middot;&nbsp; {{ entry.wmHomeOfRecord }}{% endif %}<br>{% endif %}
        {% if entry.deathDate %}<strong>Died</strong> {{ entry.deathDate }}{% if entry.wmAgeAtLoss %} &nbsp;&middot;&nbsp; age {{ entry.wmAgeAtLoss }}{% endif %}{% endif %}
      </p>

      {% if entry.wmConflict %}
        <div class="scv-chips">
          <a class="scv-chip" href="{{ url('war-memorial', { conflict: entry.wmConflict }) }}">{{ entry.wmConflict }}</a>
        </div>
      {% endif %}

      {% set hero = entry.featuredImage.one() ?? null %}
      {% if hero %}<figure class="scv-hero"><img src="{{ hero.url }}" alt="{{ hero.alt ?: entry.title }}">{% if hero.title and hero.title != entry.title %}<figcaption>{{ hero.title }}</figcaption>{% endif %}</figure>{% endif %}

      {% if narrative %}
        <article class="scv-body">
          {% include "_partials/prose" with { text: narrative } %}
        </article>
      {% endif %}
    </main>

    <aside class="scv-side">
      <div class="scv-box">
        <div class="scv-row"><span>Last updated</span><span>{{ entry.dateUpdated|date('M j, Y') }}</span></div>
      </div>

      {% if entry.wmBranch or entry.wmRank or entry.wmSpecialty or entry.wmUnit or entry.wmBase or entry.wmCombatOperations or entry.wmServiceId or entry.wmLengthOfService or entry.wmStartTour %}
      <div class="scv-box">
        <h3>Service record</h3>
        <ul>
          {% if entry.wmBranch %}<li><span class="scv-small">Branch</span><br>{{ entry.wmBranch }}</li>{% endif %}
          {% if entry.wmRank %}<li><span class="scv-small">Rank</span><br>{{ entry.wmRank }}</li>{% endif %}
          {% if entry.wmSpecialty %}<li><span class="scv-small">Specialty</span><br>{{ entry.wmSpecialty }}</li>{% endif %}
          {% if entry.wmUnit %}<li><span class="scv-small">Unit</span><br>{{ entry.wmUnit }}</li>{% endif %}
          {% if entry.wmBase %}<li><span class="scv-small">Base</span><br>{{ entry.wmBase }}</li>{% endif %}
          {% if entry.wmCombatOperations %}<li><span class="scv-small">Operation</span><br>{{ entry.wmCombatOperations }}</li>{% endif %}
          {% if entry.wmStartTour %}<li><span class="scv-small">Start of tour</span><br>{{ entry.wmStartTour }}</li>{% endif %}
          {% if entry.wmLengthOfService %}<li><span class="scv-small">Length of service</span><br>{{ entry.wmLengthOfService }}</li>{% endif %}
          {% if entry.wmServiceId %}<li><span class="scv-small">Service number</span><br>{{ entry.wmServiceId }}</li>{% endif %}
        </ul>
      </div>
      {% endif %}

      {% if entry.wmIncidentDate or entry.wmIncidentLocation %}
      <div class="scv-box">
        <h3>Incident</h3>
        <ul>
          {% if entry.wmIncidentDate %}<li><span class="scv-small">Date</span><br>{{ entry.wmIncidentDate }}</li>{% endif %}
          {% if entry.wmIncidentLocation %}<li><span class="scv-small">Location</span><br>{{ entry.wmIncidentLocation }}</li>{% endif %}
        </ul>
      </div>
      {% endif %}

      {% if entry.wmDateOfBirth or entry.deathDate or entry.wmAgeAtLoss or entry.wmHomeOfRecord or entry.wmHighSchool or entry.burialPlace %}
      <div class="scv-box">
        <h3>Life</h3>
        <ul>
          {% if entry.wmDateOfBirth %}<li><span class="scv-small">Date of birth</span><br>{{ entry.wmDateOfBirth }}</li>{% endif %}
          {% if entry.deathDate %}<li><span class="scv-small">Date of death</span><br>{{ entry.deathDate }}</li>{% endif %}
          {% if entry.wmAgeAtLoss %}<li><span class="scv-small">Age at loss</span><br>{{ entry.wmAgeAtLoss }}</li>{% endif %}
          {% if entry.wmHomeOfRecord %}<li><span class="scv-small">Home of record</span><br>{{ entry.wmHomeOfRecord }}</li>{% endif %}
          {% if entry.wmHighSchool %}<li><span class="scv-small">High school</span><br>{{ entry.wmHighSchool }}</li>{% endif %}
          {% if entry.burialPlace %}<li><span class="scv-small">Burial</span><br>{{ entry.burialPlace }}</li>{% endif %}
        </ul>
      </div>
      {% endif %}

      {% if entry.wmAwards %}
      <div class="scv-box">
        <h3>Awards</h3>
        <ul><li>{{ entry.wmAwards }}</li></ul>
      </div>
      {% endif %}

      <div class="scv-box">
        <h3>Cite this page</h3>
        <div class="scv-cite">"{{ entry.title }}." War Memorial. SCVHistory.com. Accessed {{ now|date('F j, Y') }}. {{ entry.url }}.</div>
      </div>

      {% if subject %}<div class="scv-box"><h3>Person record</h3><ul><li><a href="{{ subject.url }}">{{ subject.title }}</a></li></ul></div>{% endif %}

      {% if entry.legacyUrl %}
      <div class="scv-box">
        <h3>External</h3>
        <ul><li><a href="https://scvhistory.com{{ entry.legacyUrl }}" target="_blank" rel="noopener">View on legacy site &nearr;</a></li></ul>
      </div>
      {% endif %}
    </aside>
  </div>
</div>
{% endblock %}
