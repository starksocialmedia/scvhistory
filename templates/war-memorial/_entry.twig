{% extends "_layouts/base" %}
{% block head %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@400;500&family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet">
{% css %}
.wm{font-family:'Public Sans',system-ui,sans-serif;color:#2C2C2C;background:#F6F7F9}
.wm-wrap{max-width:1240px;margin:0 auto;padding:0 40px}
.wm-band{background:#FDF7EA;border-bottom:1px solid #EFE6D0}
.wm-band .wm-wrap{padding-top:36px}
.wm-crumbs{font-size:13px;color:#5B6472;margin-bottom:28px}
.wm-crumbs a{color:#A9842B;text-decoration:none}
.wm-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,340px);gap:48px;align-items:end}
@media(max-width:800px){.wm-head{grid-template-columns:1fr}}
.wm-head>div:first-child{padding-bottom:44px}
.wm-kick{display:flex;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em}
.wm-kick .a{color:#A9842B}.wm-kick .sep{width:1px;height:14px;background:#DCC98F}.wm-kick .b{color:#5B6472}
.wm h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(38px,4.6vw,56px);line-height:1.04;margin:0 0 12px;color:#17254C}
.wm-sub{font-family:'Playfair Display',serif;font-style:italic;font-size:22px;color:#5B6472;margin-bottom:28px}
.wm-facts{display:flex;gap:12px 40px;flex-wrap:wrap}
.wm-facts .l{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;color:#A9842B}
.wm-facts .v{font-size:17px;color:#17254C;margin-top:4px}
.wm-chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.wm-award{background:#17254C;color:#fff;font-family:'Jost',sans-serif;font-size:13px;padding:6px 12px;border-radius:3px}
.wm-era{border:1px solid #C4A031;color:#A9842B;font-family:'Jost',sans-serif;font-size:13px;padding:6px 12px;border-radius:3px;text-decoration:none}
.wm-portrait{align-self:end;margin-bottom:-1px;border:1px solid #EFE6D0;border-bottom:0;background:#fff;padding:8px 8px 0}
.wm-portrait img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top;display:block}
.wm-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,340px);gap:48px;align-items:start;padding:48px 0 96px}
@media(max-width:900px){.wm-main{grid-template-columns:1fr}}
.wm-tools{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding-bottom:20px;border-bottom:1px solid #E2E4E8;margin-bottom:32px;font-size:14px;color:#5B6472}
.wm-tools .btns{margin-left:auto;display:flex;gap:10px}
.wm-btn{background:#fff;border:1px solid #E2E4E8;font-family:'Jost',sans-serif;font-size:14px;color:#2C2C2C;padding:9px 14px;cursor:pointer}
.wm-btn.gold{background:#C4A031;border-color:#C4A031;font-weight:500;color:#17254C;padding:9px 16px}
.wm-lede{font-family:'Playfair Display',serif;font-size:23px;line-height:1.5;color:#17254C;margin:0 0 32px}
.wm-body{font-size:17px;line-height:1.75;color:#2C2C2C;max-width:720px}
.wm-body p{margin:0 0 24px}.wm-body p:last-child{margin-bottom:0}
.wm-cite{margin-top:48px;background:#FDF7EA;border:1px solid #EFE6D0;border-top:3px solid #C4A031;padding:22px 24px}
.wm-lab{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#A9842B;margin-bottom:12px}
.wm-citebox{display:flex;gap:12px;flex-wrap:wrap;align-items:stretch}
.wm-citebox .txt{flex:1;min-width:240px;background:#fff;border:1px solid #EFE6D0;padding:14px;font-size:14.5px;line-height:1.65;word-break:break-word}
.wm-citebox button{border:1px solid #C4A031;background:transparent;font-family:'Jost',sans-serif;font-size:14px;color:#A9842B;padding:10px 18px;cursor:pointer;align-self:center}
.wm-side{display:flex;flex-direction:column;gap:20px;min-width:0}
.wm-unit{background:#17254C;border-top:3px solid #C4A031;padding:26px 22px;text-align:center;color:#fff}
.wm-unit .seal{width:84px;height:84px;border-radius:50%;margin:0 auto;border:2px solid #C4A031;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
.wm-unit .seal img{width:72px;height:72px;object-fit:contain}
.wm-unit .br{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#C4A031}
.wm-unit .un{font-family:'Playfair Display',serif;font-size:18px;margin-top:6px;line-height:1.3}
.wm-box{background:#FDF7EA;border:1px solid #EFE6D0;border-top:3px solid #C4A031;padding:18px 20px 20px}
.wm-box .wm-lab{margin-bottom:14px;letter-spacing:.12em}
.wm-rows{display:grid;grid-template-columns:96px minmax(0,1fr);gap:0 14px;font-size:15px;line-height:1.5}
.wm-rows .k{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.1em;color:#8A919E;padding:9px 0;border-bottom:1px solid #EFE6D0}
.wm-rows .v{color:#2C2C2C;padding:8px 0;border-bottom:1px solid #EFE6D0}
.wm-rows .k:nth-last-child(2),.wm-rows .v:last-child{border-bottom:0}
.wm-person{display:flex;gap:12px;align-items:center;color:inherit;text-decoration:none}
.wm-person .th{width:44px;height:44px;border-radius:50%;flex:none;background:#EEF0F4;overflow:hidden}
.wm-person .th img{width:100%;height:100%;object-fit:cover}
.wm-person .n{font-family:'Playfair Display',serif;font-size:16px;color:#17254C}
.wm-person .r{font-size:13px;line-height:1.5;color:#5B6472}
.wm-links a{display:flex;justify-content:space-between;gap:12px;font-size:15.5px;color:#2C2C2C;padding:10px 0;border-bottom:1px solid #EFE6D0;text-decoration:none}
.wm-links a:last-child{border-bottom:0}
.wm-links span{color:#A9842B}
.wm-cta{background:#17254C;color:#fff;border-top:3px solid #C4A031}
.wm-cta .wm-wrap{padding:44px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.wm-cta .k{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#C4A031}
.wm-cta .t{font-family:'Playfair Display',serif;font-size:26px;margin-top:8px;line-height:1.25}
.wm-cta a{font-family:'Jost',sans-serif;font-weight:500;font-size:15px;color:#17254C;background:#C4A031;padding:14px 24px;flex:none;text-decoration:none}
@media print{.scv-site-header,.scv-footer,.wm-tools,.wm-cta,.wm-cite button{display:none}.wm-main{grid-template-columns:1fr}}
{% endcss %}
{% endblock %}

{% block content %}
{% set v = (h) => (attribute(entry, h) is defined and attribute(entry, h) is not empty) ? attribute(entry, h)|trim : '' %}
{% set img = entry.featuredImage is defined ? entry.featuredImage.one() ?? null : null %}
{% set awards = v('wmAwards') ? v('wmAwards')|replace({',': ';'})|split(';')|map(a => a|trim)|filter(a => a) : [] %}
{% set era = entry.historicalEra is defined ? entry.historicalEra.one() ?? null : null %}
{% set related = entry.wmRelatedPerson is defined ? entry.wmRelatedPerson.one() ?? null : null %}
{% set narrative = v('wmNarrative') ?: v('body') %}
{% set died = v('wmIncidentDate') ?: v('deathDate') %}
{% set words = narrative|striptags|split(' ')|length %}
{% set kick = [v('wmBranch'), v('wmCombatOperations') ?: v('wmConflict')]|filter(x => x) %}
{% set sub = [v('wmRank'), v('wmSpecialty')]|filter(x => x)|join(', ') %}
{% set total = craft.entries().section('warMemorials').status(null).count() %}
{% set cite = '"' ~ entry.title ~ '." War Memorial. SCVHistory.com. Accessed ' ~ now|date('F j, Y') ~ '. ' ~ entry.url ~ '.' %}

<div class="wm">
  <section class="wm-band">
    <div class="wm-wrap">
      <div class="wm-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('war-memorial') }}">War Memorial</a> &rsaquo; <span>{{ entry.title }}</span></div>
      <div class="wm-head">
        <div>
          <div class="wm-kick"><span class="a">WAR MEMORIAL</span>{% if kick|length %}<span class="sep"></span><span class="b">{{ kick|join(' · ')|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title }}</h1>
          {% if sub %}<div class="wm-sub">{{ sub }}</div>{% endif %}
          {% if v('wmDateOfBirth') or died or v('wmHomeOfRecord') %}
          <div class="wm-facts">
            {% if v('wmDateOfBirth') %}<div><div class="l">BORN</div><div class="v">{{ v('wmDateOfBirth') }}</div></div>{% endif %}
            {% if died %}<div><div class="l">DIED</div><div class="v">{{ died }}{% if v('wmAgeAtLoss') %} · Age {{ v('wmAgeAtLoss') }}{% endif %}</div></div>{% endif %}
            {% if v('wmHomeOfRecord') %}<div><div class="l">HOME OF RECORD</div><div class="v">{{ v('wmHomeOfRecord') }}</div></div>{% endif %}
          </div>
          {% endif %}
          {% if awards|length or era %}
          <div class="wm-chips">
            {% for a in awards %}<span class="wm-award">{{ a }}</span>{% endfor %}
            {% if era %}<a class="wm-era" href="{{ url('articles', {era: era.slug}) }}">{{ era.title }}</a>{% endif %}
          </div>
          {% endif %}
        </div>
        {% if img %}<div class="wm-portrait"><img src="{{ img.url }}" alt="{{ img.alt ?: entry.title }}"></div>{% endif %}
      </div>
    </div>
  </section>

  <div class="wm-wrap">
    <main class="wm-main">
      <article style="min-width:0">
        <div class="wm-tools">
          <div>{% if words > 20 %}{{ (words / 200)|round(0, 'ceil') }} min read &nbsp;·&nbsp; {{ words }} words &nbsp;·&nbsp; {% endif %}Updated {{ entry.dateUpdated|date('M j, Y') }}</div>
          <div class="btns">
            <button class="wm-btn" onclick="window.print()">Save / Print</button>
            <button class="wm-btn gold" id="wmListen" hidden>Listen</button>
          </div>
        </div>

        {% if narrative %}
          <div class="wm-body" id="wmText">{% include "_partials/prose" with { text: narrative } %}</div>
        {% endif %}

        <div class="wm-cite">
          <div class="wm-lab">CITE THIS RECORD</div>
          <div class="wm-citebox">
            <div class="txt" id="wmCite">{{ cite }}</div>
            <button type="button" id="wmCopy">Copy</button>
          </div>
        </div>
      </article>

      <aside class="wm-side">
        {% if v('wmBranch') or v('wmUnit') %}
        {% set b = v('wmBranch')|lower %}
        {% set seal = b matches '/marine/' ? 'marines' : (b matches '/navy/' ? 'navy' : (b matches '/air/' ? 'air-force' : (b matches '/coast/' ? 'coast-guard' : (b matches '/army/' ? 'army' : '')))) %}
        <div class="wm-unit">
          {% if seal %}<div class="seal"><img src="{{ siteUrl }}uploads/archive-media/site/seals/{{ seal }}.svg" alt=""></div>{% endif %}
          {% if v('wmBranch') %}<div class="br">{{ v('wmBranch')|upper }}</div>{% endif %}
          {% if v('wmUnit') %}<div class="un">{{ v('wmUnit') }}</div>{% endif %}
        </div>
        {% endif %}

        {% set svc = [['BRANCH', v('wmBranch')], ['RANK', v('wmRank')], ['SPECIALTY', v('wmSpecialty')], ['SERVICE ID', v('wmServiceId')], ['UNIT', v('wmUnit')], ['BASE', v('wmBase')], ['TOUR', v('wmStartTour')], ['SERVICE', v('wmLengthOfService')], ['OPERATION', v('wmCombatOperations')], ['CONFLICT', v('wmConflict')]]|filter(r => r[1]) %}
        {% if svc|length %}
        <div class="wm-box"><div class="wm-lab">SERVICE RECORD</div>
          <div class="wm-rows">{% for r in svc %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}</div>
        </div>
        {% endif %}

        {% set inc = [['DATE', v('wmIncidentDate')], ['LOCATION', v('wmIncidentLocation')], ['AGE', v('wmAgeAtLoss')]]|filter(r => r[1]) %}
        {% if inc|length %}
        <div class="wm-box"><div class="wm-lab">INCIDENT</div>
          <div class="wm-rows">{% for r in inc %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}</div>
        </div>
        {% endif %}

        {% set life = [['HOME', v('wmHomeOfRecord')], ['BORN', v('wmDateOfBirth')], ['HIGH SCHOOL', v('wmHighSchool')], ['BURIAL', v('burialPlace')]]|filter(r => r[1]) %}
        {% if life|length %}
        <div class="wm-box"><div class="wm-lab">LIFE</div>
          <div class="wm-rows">{% for r in life %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}</div>
        </div>
        {% endif %}

        {% if related %}
          {% set rimg = related.featuredImage is defined ? related.featuredImage.one() ?? null : null %}
          <div class="wm-box"><div class="wm-lab">RELATED PERSON</div>
            <a class="wm-person" href="{{ related.url }}">
              <div class="th">{% if rimg %}<img src="{{ rimg.url }}" alt="">{% endif %}</div>
              <div style="min-width:0"><div class="n">{{ related.title }}</div>{% if related.occupation is defined and related.occupation %}<div class="r">{{ related.occupation }}</div>{% endif %}</div>
            </a>
          </div>
        {% endif %}

        {% set links = [] %}
        {% if v('legacyUrl') %}{% set links = links|merge([{u: 'https://scvhistory.com' ~ v('legacyUrl'), t: 'View on legacy site', ext: true}]) %}{% endif %}
        {% if links|length %}
        <div class="wm-box"><div class="wm-lab">RELATED</div>
          <div class="wm-links">{% for l in links %}<a href="{{ l.u }}"{% if l.ext %} target="_blank" rel="noopener"{% endif %}>{{ l.t }} <span>{{ l.ext ? '↗' : '→' }}</span></a>{% endfor %}</div>
        </div>
        {% endif %}
      </aside>
    </main>
  </div>

  <section class="wm-cta">
    <div class="wm-wrap">
      <div><div class="k">SANTA CLARITA VALLEY WAR MEMORIAL</div><div class="t">{{ total }} valley residents who died in service, from World War I to Afghanistan.</div></div>
      <a href="{{ url('war-memorial') }}">Browse the memorial →</a>
    </div>
  </section>
</div>

<script>
(function(){
  var copy=document.getElementById('wmCopy'), cite=document.getElementById('wmCite');
  if(copy&&cite){copy.addEventListener('click',function(){navigator.clipboard.writeText(cite.textContent.trim()).then(function(){copy.textContent='Copied';setTimeout(function(){copy.textContent='Copy';},1600);});});}
  var btn=document.getElementById('wmListen'), txt=document.getElementById('wmText');
  if(btn&&txt&&'speechSynthesis' in window){
    btn.hidden=false; var u=null;
    btn.addEventListener('click',function(){
      if(speechSynthesis.speaking){speechSynthesis.cancel();btn.textContent='Listen';return;}
      u=new SpeechSynthesisUtterance({{ entry.title|json_encode|raw }}+'. '+txt.textContent);
      u.onend=function(){btn.textContent='Listen';};
      btn.textContent='Stop'; speechSynthesis.speak(u);
    });
  }
})();
</script>
{% endblock %}
