{% extends "_layouts/base" %}
{% block head %}
  {% include "_partials/record/css" %}
  {% include "_partials/record/print" %}
  {% css %}
  .wm-nophoto{aspect-ratio:4/5;background:#fff;border:1px solid #E2E4E8;display:flex;align-items:center;justify-content:center;padding:28px;text-align:center}
  .wm-nophoto p{font-family:'Playfair Display',serif;font-style:italic;font-size:19px;line-height:1.4;color:#5B6472;margin:0}
  .wm-unit{background:#17254C;border-top:3px solid #C4A031;padding:26px 22px;text-align:center;color:#fff}
  .wm-unit .seal{width:84px;height:84px;border-radius:50%;margin:0 auto;border:2px solid #C4A031;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .wm-unit .seal img{width:72px;height:72px;object-fit:contain}
  .wm-unit .br{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#C4A031}
  .wm-unit .un{font-family:'Playfair Display',serif;font-size:18px;margin-top:6px;line-height:1.3}
  .wm-legacy{border:1px dashed #D5C79A;background:#FFFDF6;padding:10px 14px;margin:0 0 20px;font-size:14px;color:#5B6472;line-height:1.55}
  .wm-legacy summary{cursor:pointer;font-family:'Jost',sans-serif;letter-spacing:.04em;color:#7A5C1B}
  .wm-legacy p{margin:8px 0 0}
  .wm-extra{background:#fff;border:1px solid #E2E4E8;padding:14px 18px;margin:20px 0}
  .wm-extra-h{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#7A5C1B;margin-bottom:6px}
  .wm-extra p{margin:0;font-size:15px;line-height:1.65}
  .wm-facts-h{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}
  .wm-pill{font-family:'Jost',sans-serif;font-size:10.5px;letter-spacing:.08em;border:1px solid #C9A659;color:#7A5C1B;background:#fff;padding:2px 8px;border-radius:10px;white-space:nowrap}
  .wm-nr{font-size:10.5px;vertical-align:super;color:#7A5C1B;text-decoration:none;margin-left:2px}
  .wm-nr::before{content:'['}.wm-nr::after{content:']'}
  .wm-diff{display:block;font-size:12.6px;line-height:1.45;color:#8A5A12;margin-top:3px;padding-left:9px;border-left:2px solid #E2C27A}
  .rec-cta{background:#17254C;color:#fff;border-top:3px solid #C4A031}
  .rec-cta .rec-wrap{padding:44px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .rec-cta .k{font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.16em;color:#C4A031}
  .rec-cta .t{font-family:'Playfair Display',serif;font-size:26px;margin-top:8px;line-height:1.25}
  .rec-cta a{font-family:'Jost',sans-serif;font-weight:500;font-size:15px;color:#17254C;background:#C4A031;padding:14px 24px;flex:none;text-decoration:none}
  {% endcss %}
{% endblock %}
{% block content %}

{% set recImages = entry.recordImages is defined and entry.recordImages ? entry.recordImages.all() : [] %}
{% set recDocs = entry.recordDocuments is defined and entry.recordDocuments ? entry.recordDocuments.all() : [] %}
{% set noteTop = entry.webmasterNoteTop is defined ? entry.webmasterNoteTop : null %}
{% set noteBottom = entry.webmasterNoteBottom is defined ? entry.webmasterNoteBottom : null %}
{# The element's own field layout is the only reliable test. A custom field reads
   as defined on an element whose type does not have it, and then throws when it is
   read, so wmFamily and wmSelectiveServiceDate 500 this page until
   scripts/import/add_wm_community.php has been run. #}
{% set present = {} %}
{% for f in entry.fieldLayout.customFields %}
  {% set present = present|merge({ (f.handle): true }) %}
{% endfor %}
{% set F = {} %}
{% for h in ['body', 'burialPlace', 'deathDate', 'legacyUrl', 'wmAgeAtLoss', 'wmAwards', 'wmBase', 'wmBirthplace', 'wmBranch', 'wmCasualtyDetail', 'wmCasualtyReason', 'wmCasualtyType', 'wmCombatOperations', 'wmConflict', 'wmDateOfBirth', 'wmFamily', 'wmGradeAtLoss', 'wmHighSchool', 'wmHomeOfRecord', 'wmIncidentDate', 'wmIncidentLocation', 'wmLengthOfService', 'wmNarrative', 'wmNotes', 'wmRank', 'wmSelectiveServiceDate', 'wmServiceId', 'wmSpecialty', 'wmStartTour', 'wmUnit', 'wmWallReference'] %}
  {% set v = present[h] is defined ? attribute(entry, h) : null %}
  {% set F = F|merge({ (h): v is not empty ? v|trim : '' }) %}
{% endfor %}
{# bandImage first: artwork with no lettering, composed with its subject at the
   right. featuredImage is only a fallback, and where it is a title card it may
   show lettering. The field-layout check is the only reliable test: a custom
   field reads as defined on an element whose type does not have it. #}
{% set bandImg = present['bandImage'] is defined and entry.bandImage ? entry.bandImage.one() ?? null : null %}
{% set img = bandImg ?? ('featuredImage' in (entry.fieldLayout ? entry.fieldLayout.customFields|map(f => f.handle) : []) ? entry.featuredImage.one() ?? null : null) %}
{#- No fallback to the record's other images: they are photographs of his name on a memorial wall, his grave, a
    letter, which the body shows with their captions, never a stand-in portrait (Nathan, 4 October 2026, on Michael
    Fay's record). With no likeness, the slot says so. -#}
{% set awards = F.wmAwards ? F.wmAwards|replace({',': ';'})|split(';')|map(a => a|trim)|filter(a => a) : [] %}
{% set era = 'historicalEra' in (entry.fieldLayout ? entry.fieldLayout.customFields|map(f => f.handle) : []) ? entry.historicalEra.one() ?? null : null %}
{% set related = 'wmRelatedPerson' in (entry.fieldLayout ? entry.fieldLayout.customFields|map(f => f.handle) : []) ? entry.wmRelatedPerson.one() ?? null : null %}

{# Overflow rows from the legacy service record: labels with no field of their own.
   The field-layout check is the only reliable test, since a custom field reads as
   defined on an element whose type does not have it. #}
{% set serviceExtra = [] %}
{% if present['wmServiceExtra'] is defined and entry.wmServiceExtra %}
  {% for r in entry.wmServiceExtra %}
    {% if (r.label ?? '')|trim or (r.value ?? '')|trim %}
      {% set serviceExtra = serviceExtra|merge([{ label: (r.label ?? '')|trim, value: (r.value ?? '')|trim }]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{# The wall reference is a panel and line on current data, never a URL, but the
   legacy pages are inconsistent enough that a URL has to render as a link. #}
{% set wallIsUrl = F.wmWallReference starts with 'http://' or F.wmWallReference starts with 'https://' %}
{#- The narrative is the summary and the body is the record (Nathan, 29
    September 2026). Where a record holds both and they differ, both show, each
    under its own heading, rather than one hiding the other: Rudy Acosta's page
    showed 426 characters and hid 2,318. Where there is one, it shows alone. -#}
{% set bothTexts = F.wmNarrative and F.body and F.wmNarrative|trim != F.body|trim %}
{% set narrative = F.wmNarrative ?: F.body %}
{#- Leon's fact list (Nathan, 2 October 2026: "Leon's fact list folds into a closed panel. It is legacy data that the sourced facts
    supersede, and a reader should be able to open it rather than wade through it"). Many legacy bodies open with the old page's service
    record flattened into short lines ("Birthplace:" / "Newhall, CA" ...). The lines before the first sentence of prose (twelve words or
    more, not a "Label:" line) are that list; they render in a closed panel, unchanged, and the narrative starts the page. Nothing in the
    record is altered: this is presentation only. A body that opens with prose has no panel. -#}
{% set bodyText = bothTexts ? F.body : narrative %}
{% set paras = bodyText|replace({"\r": ''})|split("\n") %}
{% set cut = 0 %}{% set found = false %}
{% for p in paras %}{% if not found %}{% set t = p|striptags|trim %}{% if t|split(' ')|length >= 12 and not (t matches '/^[A-Z][A-Za-z ()&\\/.-]{1,40}:/') %}{% set found = true %}{% else %}{% set cut = cut + 1 %}{% endif %}{% endif %}{% endfor %}
{% set legacyList = found and cut > 2 ? paras|slice(0, cut)|map(x => x|striptags|trim)|filter(x => x) : [] %}
{% set bodyRest = legacyList|length ? paras|slice(cut)|join("\n") : bodyText %}
{#- DIED is the date of death. It used to prefer the incident date, which for the missing is the day they were lost and the death date a later
    determination (Jimmie Ball), but which for the wounded is not the death at all: Edward Guy North's header said he died in September 1918, when he
    was shot, not April 1919, when he died (2 October 2026). Both show where they differ. -#}
{% set died = F.deathDate ?: F.wmIncidentDate %}
{% set incident = F.wmIncidentDate and F.deathDate and F.wmIncidentDate|trim != F.deathDate|trim ? F.wmIncidentDate : '' %}
{% set kick = [F.wmBranch, F.wmCombatOperations ?: F.wmConflict]|filter(x => x) %}
{% set sub = [F.wmRank, F.wmSpecialty]|filter(x => x)|join(', ') %}
{% set total = craft.entries().section('warMemorials').count() %}

<div class="rec">
  <section class="rec-band">
    <div class="rec-wrap">
      <div class="rec-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <a href="{{ url('war-memorial') }}">War Memorial</a> &rsaquo; <span>{{ entry.title }}</span></div>
      <div class="rec-head">
        <div>
          <div class="rec-kick"><span class="a">WAR MEMORIAL</span>{% if kick|length %}<span class="sep"></span><span class="b">{{ kick|join(' · ')|upper }}</span>{% endif %}</div>
          <h1>{{ entry.title }}</h1>
          {% if sub %}<div class="rec-sub">{{ sub }}</div>{% endif %}
          {% if F.wmDateOfBirth or died or F.wmHomeOfRecord %}
          <div class="rec-facts">
            {% if F.wmDateOfBirth %}<div><div class="l">BORN</div><div class="v">{{ F.wmDateOfBirth }}</div></div>{% endif %}
            {% if incident %}<div><div class="l">INCIDENT</div><div class="v">{{ incident }}</div></div>{% endif %}
            {% if died %}<div><div class="l">DIED</div><div class="v">{{ died }}{% if F.wmAgeAtLoss %} · Age {{ F.wmAgeAtLoss }}{% endif %}</div></div>{% endif %}
            {% if F.wmHomeOfRecord %}<div><div class="l">HOME OF RECORD</div><div class="v">{{ F.wmHomeOfRecord }}</div></div>{% endif %}
          </div>
          {% endif %}
          {% if awards|length or era %}
          <div class="rec-chips">
            {% for a in awards %}<span class="rec-chip solid">{{ a }}</span>{% endfor %}
            {% if era %}<a class="rec-chip" href="{{ url('articles', {era: era.slug}) }}">{{ era.title }}</a>{% endif %}
          </div>
          {% endif %}
        </div>
        {% if img %}<div class="rec-portrait"><img src="{{ img.url }}" alt="{{ img.alt ?: entry.title }}"></div>
        {% else %}<div class="rec-portrait wm-nophoto"><p>No photograph of him is known to the archive.</p></div>{% endif %}
      </div>
    </div>
  </section>

  <div class="rec-wrap">
    <main class="rec-main">
      <article style="min-width:0">
        {% include "_partials/record/tools" with { entry: entry, text: narrative, textId: 'recText' } only %}
        {% include "_partials/record/note" with { text: noteTop } only %}
        {#- The archive's own notes (editorNotes), which this page did not render before 2 October 2026: corrections and readers' notes were saved but not shown. -#}
        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'top' } only %}

        {#- Short rows of the legacy service record (Branch Code, Height, Enlistment City) are legacy data like Leon's list, and join it in
            the closed panel; long ones (a transcription, an oral history) read in the column below. -#}
        {% set shortExtra = serviceExtra|filter(r => r.value|length <= 200) %}
        {% if legacyList|length or shortExtra|length %}
          <details class="wm-legacy"><summary>The service record as the legacy page set it out</summary>
            {% if legacyList|length %}<p>{{ legacyList|join(' · ') }}</p>{% endif %}
            {% if shortExtra|length %}<p>{% for r in shortExtra %}{{ r.label }}{{ r.label ? ': ' : '' }}{{ r.value }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
          </details>
        {% endif %}
        {% if bothTexts %}
          <h2 class="rec-h2" style="margin-top:8px">Summary</h2>
          <div class="rec-body">{% include "_partials/prose" with { text: F.wmNarrative, images: [], footnotesFor: null } %}</div>
          <h2 class="rec-h2">The record</h2>
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: bodyRest, images: recImages , footnotesFor: entry } %}</div>
        {% elseif narrative %}
          <div class="rec-body" id="recText">{% include "_partials/prose" with { text: bodyRest, images: recImages , footnotesFor: entry } %}</div>
        {% endif %}
        {#- The overflow rows of the legacy service record (a clipping's transcription, further reading) read in the column, beside the
            narrative they belong to, not as a sidebar box (2 October 2026); not at all where the narrative already carries the same text. -#}
        {% set bodyFlat = (F.body ~ ' ' ~ F.wmNarrative)|striptags|replace({"\n": ' '})|lower %}
        {% for r in serviceExtra|filter(r => r.value|length > 200 and (r.value|striptags|replace({"\n": ' '})|lower|slice(0, 80)|trim) not in bodyFlat) %}
          <div class="wm-extra"><div class="wm-extra-h">{{ r.label ?: 'From the service record' }}</div><p>{{ r.value }}</p></div>
        {% endfor %}
        {% if narrative %}
{% include "_partials/record/footnotes" with { entry: entry } only %}
          {% include "_partials/record/images" with { images: recImages, body: narrative, entry: entry } only %}
        {% endif %}

        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'inline' } only %}
        {% include "_partials/record/editor-notes" with { rows: (entry.fieldLayout and 'editorNotes' in entry.fieldLayout.customFields|map(f => f.handle) ? entry.editorNotes : []), position: 'bottom' } only %}
        {% include "_partials/record/note" with { text: F.wmNotes, bottom: true } only %}
        {% include "_partials/record/note" with { text: noteBottom, bottom: true } only %}

      </article>

      <aside class="rec-side">
        {% include "_partials/record/education" with { entry: entry, as: 'person' } only %}
        {# Renders nothing until the casualty record carries childOf; see
           scripts/import/settle_family_relations.php. #}
        {% include "_partials/record/family" with { fam: fam } only %}
        {% if F.wmBranch or F.wmUnit %}
        {% set b = F.wmBranch|lower %}
        {% set seal = b matches '/marine/' ? 'marines' : (b matches '/navy/' ? 'navy' : (b matches '/air/' ? 'air-force' : (b matches '/coast/' ? 'coast-guard' : (b matches '/army/' ? 'army' : '')))) %}
        <div class="wm-unit">
          {% if seal %}<div class="seal"><img src="{{ siteUrl }}uploads/archive-media/site/seals/{{ seal }}.svg" alt=""></div>{% endif %}
          {% if F.wmBranch %}<div class="br">{{ F.wmBranch|upper }}</div>{% endif %}
          {% if F.wmUnit %}<div class="un">{{ F.wmUnit }}</div>{% endif %}
        </div>
        {% endif %}

        {#- ONE PLACE PER FACT (Nathan, 2 October 2026, approving the mockup): one box in the order of a life. On a sourced record the
            rows are its factSources: each value with the notes that support it, and, where the sources differ, a line saying what each
            says. Fields the table does not cover follow, unmarked. An unsourced record shows its fields in the same order. -#}
        {% set fieldRows = [['BORN', F.wmDateOfBirth], ['BIRTHPLACE', F.wmBirthplace], ['HOME', F.wmHomeOfRecord], ['HIGH SCHOOL', F.wmHighSchool], ['FAMILY', F.wmFamily], ['DRAFT REGISTERED', F.wmSelectiveServiceDate], ['BRANCH', F.wmBranch], ['RANK', F.wmRank], ['GRADE AT LOSS', F.wmGradeAtLoss], ['SPECIALTY', F.wmSpecialty], ['SERVICE NUMBER', F.wmServiceId], ['UNIT', F.wmUnit], ['BASE', F.wmBase], ['TOUR', F.wmStartTour], ['SERVICE', F.wmLengthOfService], ['OPERATION', F.wmCombatOperations], ['CONFLICT', F.wmConflict], ['INCIDENT', F.wmIncidentDate], ['PLACE', F.wmIncidentLocation], ['REASON', F.wmCasualtyReason], ['TYPE', F.wmCasualtyType], ['DETAIL', F.wmCasualtyDetail], ['DATE OF DEATH', F.deathDate], ['AGE', F.wmAgeAtLoss], ['BURIAL', F.burialPlace]]|filter(r => r[1]) %}
        {% set facts = present['factSources'] is defined ? (entry.factSources ?? [])|filter(r => (r.fact ?? '')|trim) : [] %}
        {#- A field is covered when a fact row says the same thing; these are the labels each field's fact rows use. -#}
        {% set COVERS = { 'BORN': ['born'], 'BIRTHPLACE': ['birthplace', 'born'], 'HOME': ['home', 'home, 1919'], 'HIGH SCHOOL': ['high school'], 'DRAFT REGISTERED': ['registered for the draft', 'enlisted'], 'BRANCH': ['branch'], 'RANK': ['rank'], 'SERVICE NUMBER': ['service number'], 'UNIT': ['unit', 'ship'], 'BASE': ['base'], 'TOUR': ['tour began', 'enlisted', 'entered service'], 'OPERATION': ['operation'], 'INCIDENT': ['wounded', 'casualty', 'date of death'], 'PLACE': ['place', 'place of death'], 'REASON': ['cause', 'cause of death', 'casualty', 'circumstances'], 'TYPE': ['casualty', 'cause'], 'DETAIL': ['cause of death', 'cause'], 'DATE OF DEATH': ['date of death'], 'AGE': ['age'], 'BURIAL': ['burial', 'memorial', 'remains'], 'SPECIALTY': ['specialty'] } %}
        {% set factLabels = facts|map(r => (r.fact ?? '')|lower|trim) %}
        {#- Covered only when a fact row with a matching label also says the same thing: the opening words of one appear in the other.
            Ward's "Born" row covers his birth date, not his birthplace; Larsen's "Memorial" row is the cenotaph, not where his ashes went.
            A field that is not covered shows as its own row, so nothing the record holds goes missing from the page. -#}
        {% set extra = [] %}
        {% for r in fieldRows %}
          {% set fv = r[1]|lower|replace({'(': '', ')': '', ',': '', '.': '', ';': ''})|split(' ')|filter(w => w)|join(' ') %}
          {% set covered = false %}
          {% for f in facts %}{% if not covered and ((f.fact ?? '')|lower|trim) in (COVERS[r[0]] ?? []) %}
            {% set xv = (f.value ?? '')|lower|replace({'(': '', ')': '', ',': '', '.': '', ';': ''})|split(' ')|filter(w => w)|join(' ') %}
            {% if (fv|slice(0, 16)) in xv or (xv|slice(0, 16)) in fv %}{% set covered = true %}{% endif %}
          {% endif %}{% endfor %}
          {% if not covered %}{% set extra = extra|merge([r]) %}{% endif %}
        {% endfor %}
        {% set noteCount = present['footnotes'] is defined ? (entry.footnotes ?? [])|filter(n => (n.note ?? '')|trim)|length : 0 %}
        {% set differ = facts|filter(r => (r.agreement ?? '')|trim)|length %}
        {% if facts|length or extra|length %}
        <div class="rec-box wm-facts"><div class="wm-facts-h"><span class="rec-lab" style="margin:0">SERVICE AND LIFE</span>{% if facts|length %}<span class="wm-pill">{{ noteCount }} SOURCE{{ noteCount == 1 ? '' : 'S' }}{% if differ %} · {{ differ }} DIFFER{% endif %}</span>{% endif %}</div>
          <div class="rec-rows">
            {% for r in facts %}
              <div class="k">{{ r.fact|upper }}</div>
              <div class="v">{{ r.value }}{% for n in (r.notes ?? '')|split(',')|map(x => x|trim)|filter(x => x) %}<a class="wm-nr" href="#fn-{{ n }}">{{ n }}</a>{% endfor %}{% if (r.agreement ?? '')|trim %}<span class="wm-diff">{{ r.agreement }}</span>{% endif %}</div>
            {% endfor %}
            {% for r in extra %}<div class="k">{{ r[0] }}</div><div class="v">{{ r[1] }}</div>{% endfor %}
          </div>
        </div>
        {% endif %}

        {# The Related person box is retired where a family box renders: whoever
           it showed is folded into that box, under their relationship where one
           is recorded and under Other relations otherwise. It still renders on
           a record with no family at all, so nothing is lost. #}
        {% if related and not fam %}
          {% set rimg = 'featuredImage' in (related.fieldLayout ? related.fieldLayout.customFields|map(f => f.handle) : []) ? related.featuredImage.one() ?? null : null %}
          <div class="rec-box"><div class="rec-lab">RELATED PERSON</div>
            <a class="rec-person" href="{{ related.url }}">
              <div class="th">{% if rimg %}<img src="{{ rimg.url }}" alt="">{% endif %}</div>
              <div style="min-width:0"><div class="n">{{ related.title }}</div>{% if related.occupation is defined and related.occupation %}<div class="r">{{ related.occupation }}</div>{% endif %}</div>
            </a>
          </div>
        {% endif %}


        {% include "_partials/record/documents" with { docs: recDocs } only %}

        {% include "_partials/record/tags" with { el: entry } only %}

        {% set links = [] %}
        {% if F.wmWallReference and wallIsUrl %}{% set links = links|merge([{u: F.wmWallReference, t: 'Memorial wall entry', ext: true}]) %}{% endif %}
        {# The legacy link moved to the top of the sidebar, in record/source-link.twig.
           A reader comparing our version with Leon's was having to scroll past the
           whole sidebar to reach it. It is not repeated here. #}
        {% if links|length or (F.wmWallReference and not wallIsUrl) %}
        <div class="rec-box"><div class="rec-lab">EXTERNAL</div>
          {% if F.wmWallReference and not wallIsUrl %}
            <div class="rec-rows"><div class="k">MEMORIAL WALL</div><div class="v">{{ F.wmWallReference }}</div></div>
          {% endif %}
          {% if links|length %}
            <div class="rec-links">{% for l in links %}<a href="{{ l.u }}"{% if l.ext %} target="_blank" rel="noopener"{% endif %}>{{ l.t }} <span>{{ l.ext ? '↗' : '→' }}</span></a>{% endfor %}</div>
          {% endif %}
        </div>
        {% endif %}
        {#- Tools, not content: below the facts (2 October 2026). -#}
        {% include "_partials/record/cite" with { entry: entry, label: 'War Memorial', sidebar: true } only %}
        {% include "_partials/record/source-link" with { el: entry } only %}
      </aside>
    </main>
  </div>

  <section class="rec-cta">
    <div class="rec-wrap">
      <div><div class="k">SANTA CLARITA VALLEY WAR MEMORIAL</div><div class="t">{{ total }} valley residents who died in service, from World War I to Afghanistan.</div></div>
      <a href="{{ url('war-memorial') }}">Browse the memorial →</a>
    </div>
  </section>
</div>

{% endblock %}
