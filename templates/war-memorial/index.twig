{% extends "_layouts/base" %}
{% block title %}War Memorial | SCVHistory.com{% endblock %}
{% block head %}{% include "_partials/scv-extra-css" %}{% endblock %}

{% block content %}
{% set activeConflict = craft.app.request.getParam('conflict') %}
{% set all = craft.entries().section('warMemorials').status(null).orderBy('title asc').all() %}

{% set counts = {} %}
{% for e in all %}
  {% set key = e.wmConflict ?: 'Conflict not recorded' %}
  {% set counts = counts|merge({ (key): (counts[key] ?? 0) + 1 }) %}
{% endfor %}
{% set conflictOrder = ['World War I', 'World War II', 'Korean War', 'Vietnam War', 'War on Terror'] %}
{% set ordered = [] %}
{% for c in conflictOrder %}{% if counts[c] is defined %}{% set ordered = ordered|merge([c]) %}{% endif %}{% endfor %}
{% for c, n in counts %}{% if c not in ordered %}{% set ordered = ordered|merge([c]) %}{% endif %}{% endfor %}

{% set shown = activeConflict ? all|filter(e => (e.wmConflict ?: 'Conflict not recorded') == activeConflict) : all %}

{% set branchIds = [] %}
{% for e in all %}{% if e.wmBranch and e.wmBranch not in branchIds %}{% set branchIds = branchIds|merge([e.wmBranch]) %}{% endif %}{% endfor %}

<div class="scv-page">
  <section class="scv-hero">
    <div class="scv-wrap">
      <div class="scv-crumbs"><a href="{{ siteUrl }}">Home</a> &rsaquo; <span>War Memorial</span></div>
      <div class="scv-herogrid">
        <div>
          <div class="scv-kicker">In memoriam</div>
          <h1>War Memorial</h1>
          <p class="scv-lede">Santa Clarita Valley service members who died in war. Each record carries the service history, the incident, and the account as it was written.</p>
        </div>
        <div class="scv-stat">
          <div><b>{{ all|length }}</b><span>Names</span></div>
          <div><b>{{ ordered|length }}</b><span>Conflicts</span></div>
          {% if branchIds|length %}<div><b>{{ branchIds|length }}</b><span>Branches</span></div>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="scv-filters">
    <div class="scv-wrap">
      <div class="scv-lab">Conflict</div>
      <a class="scv-chip {{ not activeConflict ? 'on' : '' }}" href="{{ url('war-memorial') }}">All</a>
      {% for c in ordered %}
        <a class="scv-chip {{ activeConflict == c ? 'on' : '' }}" href="{{ url('war-memorial', { conflict: c }) }}">{{ c }} ({{ counts[c] }})</a>
      {% endfor %}
      <div class="scv-count">{{ activeConflict ? shown|length ~ ' of ' ~ all|length : all|length }} names</div>
    </div>
  </section>

  <main class="scv-main">
    <div class="scv-wrap">
      {% for c in ordered %}
        {% set items = shown|filter(e => (e.wmConflict ?: 'Conflict not recorded') == c) %}
        {% if items|length %}
          <h2 class="scv-h2">{{ c }}</h2>
          <div class="scv-cards">
            {% for e in items %}
              {% set img = (e.featuredImage is defined and e.featuredImage) ? e.featuredImage.one() ?? null : null %}
              {% set parts = (e.title ?: e.slug)|split(' ')|filter(w => w|trim) %}
              {% set initials = parts|length > 1 ? (parts|first|slice(0,1) ~ parts|last|slice(0,1)) : (e.title ?: e.slug)|slice(0,1) %}
              <a class="scv-tile" href="{{ e.url }}">
                <div class="scv-ph">{% if img %}<img src="{{ img.url }}" alt="">{% else %}<span>{{ initials|upper }}</span>{% endif %}</div>
                <div class="scv-tilebody">
                  <h3>{{ e.title ?: e.slug }}</h3>
                  {% set rankLine = [e.wmRank, e.wmBranch]|filter(v => v)|join(', ') %}
                  {% if rankLine %}<div class="scv-tilemeta">{{ rankLine }}</div>{% endif %}
                  {% if e.deathDate %}<div class="scv-tilemeta">Died {{ e.deathDate }}</div>{% endif %}
                  <div class="scv-tilefoot">{{ e.wmIncidentLocation ?: c }}</div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
      {% if not shown|length %}
        <div class="scv-empty">No memorial entries for this conflict. <a href="{{ url('war-memorial') }}">Show all</a></div>
      {% endif %}
    </div>
  </main>
</div>
{% endblock %}
