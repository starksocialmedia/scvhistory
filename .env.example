# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

PRIMARY_SITE_URL=
DB_TABLE_PREFIX=scvh_
DB_SERVER=
DB_PORT=3306
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_DRIVER=mysql

# Base URL of the legacy archive that legacy URL fields resolve against.
# Stored legacy URLs are root-relative paths; this is the host they hang off.
# Read in templates as craft.app.config.custom.legacyHost.
LEGACY_HOST=https://scvhistory.com
